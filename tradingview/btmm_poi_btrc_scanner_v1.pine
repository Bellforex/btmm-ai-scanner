//@version=6

// =============================================================================
// BTMM + POI + BTRC Scanner  [P1 DEV]
// -----------------------------------------------------------------------------
// PHASE P1 — MEASUREMENTS PORT (development / parity indicator, NOT a product).
//
// This is an ANALYTICAL indicator. It contains NO order execution, NO
// entries/SL/TP, NO strategy.* calls. It ports the VALIDATED Python scanner
// measurement layer (the authoritative semantic reference) onto Pine v6, on the
// CURRENT chart feed and timeframe only. Multi-timeframe orchestration, canonical
// FXCM mode, market structure (BOS/CHOCH), POI, BTMM and BTRC all belong to later
// phases and are intentionally absent here.
//
// Semantic source of truth (byte-cited in docs/architecture/
// BTRC_V1_P1_PINE_MEASUREMENTS_PORT.md):
//   measurements/candle_metrics.py   — candle metrics + range_speed_ratio
//   measurements/atr.py              — Wilder ATR (incremental image ported)
//   measurements/legs.py             — measure_leg
//   domain/swings.py                 — detect_confirmed_swings (full pipeline)
//   domain/displacement.py           — detect_displacement_observations
//   domain/equal_levels.py           — detect_equal_level_clusters
//   domain/support_resistance.py     — detect_support_resistance_zones
//   domain/trendlines.py             — detect_trendlines
//   domain/configuration.py          — MarketMeasurementConfiguration (defaults)
//   contracts/normalized_candle.py + historical_backtest/csv_parser.py
//                                    — availability = close of the bar
//
// NON-REPAINT CONTRACT: every confirmed analytical record is produced ONLY on a
// CONFIRMED/CLOSED bar (barstate.isconfirmed). The forming realtime bar never
// mutates confirmed state. No future indexing, no lookahead, no request.security.
//
// GOVERNING RULE: data structures are adapted (Python UUIDs -> semantic time/price
// anchors; Python dicts -> Pine arrays/UDTs; unbounded history -> a bounded rolling
// window). Analytical MEANING (swing definition, confirmation timing, tolerances,
// displacement/equal-level/zone semantics) is preserved unchanged.
// =============================================================================

// P1-PERF-4: calc_bars_count bounds the HISTORICAL EXECUTION HORIZON — the
// number of trailing bars TradingView runs the script over. It is NOT the
// analytical window (that is `lookbackWindow`, still 300) and it changes no
// analytical rule. 1800 is the validated horizon; see C_P1_MIN_CALC_BARS below
// and docs/architecture/BTRC_V1_P1_PERFORMANCE_OPTIMIZATION.md §18.
indicator("BTMM + POI + BTRC Scanner [P1 DEV]", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, calc_bars_count = 1800)

// -----------------------------------------------------------------------------
// INPUTS — debug/visual controls (client defaults: conservative & clean).
// -----------------------------------------------------------------------------
grpDev = "P1 Development / Parity"
debugMode        = input.bool(false, "P1 Debug Mode (visuals + parity table)", group = grpDev)
showSwings       = input.bool(true,  "  Show confirmed swings",         group = grpDev)
showDisplacement = input.bool(true,  "  Show displacement markers",     group = grpDev)
showEqualLevels  = input.bool(true,  "  Show equal-high/low lines",     group = grpDev)
showSR           = input.bool(false, "  Show support/resistance zones", group = grpDev)
showTrendlines   = input.bool(false, "  Show trendline debug",          group = grpDev)
maxDrawPerFamily = input.int(20, "  Max drawings per family", minval = 1, maxval = 200, group = grpDev)

// ENGINEERING-PROVISIONAL: rolling analytical window. This is a Pine practical
// retention bound (Python retains full history). Larger = more faithful to the
// batch scanner but heavier per confirmed bar. Not a strategy parameter.
lookbackWindow = input.int(300, "Analytical window (bars, provisional)", minval = 60, maxval = 1000, group = grpDev)

// -----------------------------------------------------------------------------
// CONFIGURATION — EXACT defaults from MarketMeasurementConfiguration.
// ENGINEERING-PROVISIONAL, centralized, NOT production-approved, NOT tuned here.
// -----------------------------------------------------------------------------
int   C_WINDOW_RADIUS                 = 2        // domain/swings.py:20 _WINDOW_RADIUS
int   C_ATR_PERIOD                    = 14       // configuration.py:24
int   C_RANGE_CONTEXT_WINDOW          = 20       // configuration.py:25
float C_PIVOT_TIE_TOL_ATR             = 0.02     // configuration.py:27
float C_MEANINGFUL_REVERSAL_ATR       = 0.50     // configuration.py:28
float C_EQUAL_LEVEL_TOL_ATR           = 0.10     // configuration.py:30
int   C_TL_MIN_ANCHOR_SPACING         = 5        // configuration.py:32
float C_TL_HORIZONTAL_ATR             = 0.02     // configuration.py:33
float C_TL_TOO_STEEP_ATR              = 0.35     // configuration.py:34
float C_TL_TOUCH_TOL_ATR              = 0.10     // configuration.py:35
float C_TL_PIERCE_TOL_ATR             = 0.20     // configuration.py:36
float C_SR_ZONE_DEPTH_ATR             = 0.10     // configuration.py:38
float C_SR_TOUCH_TOL_ATR              = 0.05     // configuration.py:39
float C_SR_PIERCE_TOL_ATR             = 0.15     // configuration.py:40
float C_DISP_FAST_RATIO               = 1.50     // configuration.py:42
float C_DISP_VERY_FAST_RATIO          = 2.00     // configuration.py:43
int   C_REACTION_WINDOW_BARS          = 5        // configuration.py:45
float C_REACTION_STD_ATR_RATIO        = 0.75     // configuration.py:46
float C_REACTION_STD_ZONE_CLEAR_RATIO = 1.00     // configuration.py:47
float C_REACTION_STD_DIR_EFF          = 0.50     // configuration.py:48
float C_REACTION_STD_DIR_SHARE        = 0.60     // configuration.py:49
float C_LEG_FAST_SPEED                = 0.50     // configuration.py:55
float C_LEG_FAST_EFF                  = 0.60     // configuration.py:56
float C_LEG_FAST_SHARE                = 0.67     // configuration.py:57
float C_LEG_STRONG_SPEED              = 0.75     // configuration.py:58
float C_LEG_STRONG_EFF                = 0.75     // configuration.py:59
float C_LEG_STRONG_SHARE              = 0.80     // configuration.py:60

// Swing type codes (Python SwingType). Displacement classification codes.
int SWING_HIGH = 1
int SWING_LOW  = -1

// -----------------------------------------------------------------------------
// P1-PERF-4 — BOUNDED HISTORICAL EXECUTION
//
// The engine reads history through exactly one channel that outlives the
// analytical window: the incremental Wilder ATR in `wAtr`. Everything else a
// bar reads (candles, pivots, swings, trackers, folds) is pruned to
// `lookbackWindow`. So a truncated execution differs from a full-history one
// only while its ATR still remembers its own seed.
//
// Wilder ATR is an IIR filter: a seed discrepancy decays by (P-1)/P per bar.
// The largest warm-up measured before the truncated series became IDENTICAL to
// the full-history series was 920 bars on canonical FXCM data and 945 bars on
// adversarial fixtures that deliberately distort the seed.
//
//   C_P1_MIN_CALC_BARS = lookbackWindow + warm-up = 300 + 950 = 1250
//     A bar is analytically valid once the engine has processed this many
//     confirmed bars, because only then is the ATR exact at the LEFT EDGE of
//     that bar's 300-bar window.
//
//   C_P1_CALC_BARS = 1800 (also the calc_bars_count in the declaration above)
//     The selected execution horizon AND the required dataset capacity. Makes
//     the earliest of the last 300 bars valid with 251 bars to spare, while
//     cutting D1 historical execution by roughly two thirds.
//
// Three numbers that are easy to confuse, so state them plainly:
//
//   300  = the analytical rolling window (`lookbackWindow`).
//   1250 = the per-bar warm-up floor INSIDE an adequately sized run.
//   1800 = the dataset capacity the product requires, and the default the
//          declaration asks TradingView for.
//
// 1250 is deliberately NOT the minimum allowed "Calculated bars" setting. It is
// the point at which an individual bar inside a full-size run becomes exact; it
// says nothing about whether the validated horizon is present at all. A 1300-bar
// run would contain a few warm bars and still be outside the validated contract,
// so P1-PERF-4A checks capacity against 1800 and warm-up against 1250, and
// publishes only when both hold.
int C_P1_CALC_BARS     = 1800
int C_P1_MIN_CALC_BARS = 1250

// =============================================================================
// USER-DEFINED TYPES — minimal analytical records (semantic content only; no UUID).
// =============================================================================
type SwingRec
    int   swingType            // SWING_HIGH / SWING_LOW
    float price                // pivot_price
    int   pivotStartIdx        // window index of pivot start
    int   pivotEndIdx          // window index of pivot end (= last pivot candle)
    int   pivotEndTime         // event/open time of pivot end candle (anchor)
    int   localConfTime        // local_confirmation_time (availability of end+radius bar)
    int   meaningfulConfTime   // meaningful_confirmation_time (availability of reversal bar)
    float referenceAtr         // pivot_reference_atr
    float tieTolerance         // pivot_tie_tolerance
    float reversalThreshold    // reversal_threshold
    float reversalExcursion    // reversal_excursion

type EqualLevelRec
    int   clusterType          // SWING_HIGH => EQUAL_HIGH, SWING_LOW => EQUAL_LOW
    float zoneBottom
    float zoneTop
    float representativePrice
    float clusterSpread
    float equalityTolerance
    int   memberCount
    int   firstTime            // earliest member meaningful confirmation time
    int   confirmationTime     // max member meaningful confirmation time

type SRRec
    int   zoneType             // SWING_LOW origin => SUPPORT, SWING_HIGH origin => RESISTANCE
    float zoneTop
    float zoneBottom
    float zoneDepth
    int   touchCount
    int   confirmationTime     // availability of first confirming candle

type SRCand
    int   key                  // pivotEndTime — the stable semantic swing identity
    int   swingType
    float price
    float referenceAtr         // carried directly; never re-derived from zoneDepth
    int   meaningfulConfTime
    int   pivotEndAbs          // ABSOLUTE pivot-end index, so a window shift cannot stale it

type SRFold
    int   originKey            // SRCand.key of this fold's origin; the cache is ascending on it
    int   originAbs            // absolute pivot-end index, matched against the dirty set
    int   originType
    float zoneTop
    float zoneBottom
    float referenceAtr         // authoritative value, stored not reconstructed
    float zoneDepth
    bool  hasZone              // false = "cached: this origin publishes nothing"
    int   touchCount
    int   confirmationTime

type SRTracker
    int   originAbs            // absolute index of the origin swing's pivot-end candle
    int   searchStartAbs       // absolute index of the first candle this reaction may use
    float zoneTop
    float zoneBottom
    bool  isSupport
    int   lastCheckedAbs       // highest absolute index already examined for a reaction start
    int   reactionStartAbs     // na until the first qualifying close is found
    float anchor               // running min(low) / max(high) from searchStartAbs
    bool  permanent            // the bounded window is full; nothing can change it now
    int   confirmingAbs        // na unless the reaction currently qualifies
    int   confirmingTime       // availability time of the confirming candle

type TrendlineRec
    int   orientation          // SWING_LOW anchors => BULLISH, SWING_HIGH anchors => BEARISH
    float anchor1Price
    float anchor2Price
    int   anchor1Time
    int   anchor2Time
    float rawSlope             // price per bar
    float normalizedSlope
    int   confirmationTime

// =============================================================================
// PRIMITIVE HELPERS — measurements/candle_metrics.py
// =============================================================================
// Median of an ALREADY ascending-sorted array. O(1). Same value as f_median for
// the same multiset — the median depends only on the multiset, not on how it was
// ordered — so a caller that maintains sorted order incrementally may use this.
f_medianOfSorted(array<float> sorted) =>
    int n = array.size(sorted)
    float out = 0.0
    if n > 0
        int mid = int(n / 2)
        out := (n % 2 == 1) ? array.get(sorted, mid) : (array.get(sorted, mid - 1) + array.get(sorted, mid)) / 2.0
    out

// P1-PERF-1: median that CONSUMES its argument — it sorts in place instead of
// allocating a copy. Every call site builds a fresh (or scratch) array and never
// reads it again afterwards, so consuming it is safe and removes one array
// allocation plus one full copy from every median in the hot path. The returned
// value is identical to the previous copy-then-sort implementation.
f_medianConsume(array<float> vals) =>
    array.sort(vals, order.ascending)
    f_medianOfSorted(vals)

// median of total_range over window slice [startIncl, endExcl)  (median_total_range)
// P1-PERF-1: writes into a caller-owned scratch array instead of allocating.
f_medianRange(array<float> highs, array<float> lows, int startIncl, int endExcl, array<float> scratch) =>
    array.clear(scratch)
    if endExcl > startIncl and startIncl >= 0 and endExcl <= array.size(highs)
        for i = startIncl to endExcl - 1
            array.push(scratch, array.get(highs, i) - array.get(lows, i))
    f_medianConsume(scratch)

// =============================================================================
// ROLLING WINDOW STATE — confirmed candles + exact incremental Wilder ATR.
// atr.py: true_range uses previous close; seed = mean of first `period` TRs at
// index period-1 (na before); Wilder recurrence thereafter. This mirrors
// advance_incremental_atr (append-stable, exact image of compute_atr_series).
// =============================================================================
var array<float> wHigh   = array.new<float>()
var array<float> wLow    = array.new<float>()
var array<float> wOpen   = array.new<float>()
var array<float> wClose  = array.new<float>()
var array<int>   wOpenT  = array.new<int>()   // bar open time (event_time_utc analogue)
var array<int>   wAvailT = array.new<int>()   // availability time = bar close time
var array<float> wAtr    = array.new<float>() // ATR at this candle (na during warm-up)

// Incremental ATR carry state (var; advances only on confirmed bars).
var float atrPrevClose = na
var float atrWarmSum   = 0.0
var int   atrWarmCount = 0
var float atrPrevFinal = na

// -----------------------------------------------------------------------------
// P1-PERF-1 — SINGLE-CANDLE PIVOT FRONTIER (persistent, absolute-indexed).
//
// _find_single_candle_pivots tests every window index in [R, n-R-1]. That test
// reads only highs/lows/atr[idx-R .. idx+R], so a bar's pivot status is FINAL as
// soon as it has R closed bars to its right and can never change afterwards.
// Re-deriving the whole window on every confirmed bar therefore recomputed an
// identical answer O(W) times. Instead we decide exactly ONE new candle per
// confirmed bar (the bar at window index n-1-R) and retire entries that have
// fallen out of the batch's scan range.
//
// Pivots are stored by ABSOLUTE confirmed-bar index so that a window shift does
// not invalidate them; f_detectSwings converts to window indices on read. The
// resulting pivot multiset is identical to the batch scan (proof in
// docs/architecture/BTRC_V1_P1_PERFORMANCE_OPTIMIZATION.md).
// -----------------------------------------------------------------------------
var int confirmedBarCount = 0                 // absolute count of confirmed bars seen
var array<int>   pvAbs   = array.new<int>()   // absolute index of the pivot candle
var array<int>   pvType  = array.new<int>()
var array<float> pvPrice = array.new<float>()
var array<float> pvAtr   = array.new<float>()
var array<float> pvTie   = array.new<float>()

// -----------------------------------------------------------------------------
// P1-SR-PERF-2 — persistent S/R reaction frontier state.
//
// srKeys is kept ASCENDING and packs originAbs into the high bits, so retiring
// every tracker whose origin has left the active window is a prefix removal.
// srTrk is parallel to it. srCached holds the last walk result so that a bar
// which changes neither the swing set nor any tracker resolution costs nothing
// beyond the tracker advances.
// -----------------------------------------------------------------------------
var array<int>       srKeys   = array.new<int>()
var array<SRTracker> srTrk    = array.new<SRTracker>()
var array<SRRec>     srCached = array.new<SRRec>()
var bool             srSeeded = false

// -----------------------------------------------------------------------------
// P1-SR-PERF-3 — semantic pair/fold frontier state.
//
// Measured on canonical FXCM M1/M5/M15 (900-bar replays, lookback 300): the walk
// performed ~650-680 origin x touch visits for every genuinely NEW semantic pair,
// so almost all of it re-derived relationships that had not changed. Caching each
// origin's fold and invalidating it from the swing DELTA removed ~60% of that
// work with byte-identical output, proven at every prefix against the production
// Python oracle (tests/unit/test_pine_p1_sr_frontier_model.py).
//
// srCand* hold ABSOLUTE pivot indices, never window indices, so a cached
// candidate cannot go stale when the 300-bar window slides. srSnap is the
// previous swing set in ascending key order, which makes the delta an O(A) merge
// (detect_confirmed_swings emits swings ascending by pivot-end time).
// -----------------------------------------------------------------------------
var array<SRCand> srCandSupport = array.new<SRCand>()   // support origins, ascending confirmation time
var array<SRCand> srCandResist  = array.new<SRCand>()   // resistance origins, ascending confirmation time
var array<int>    srOppSupport  = array.new<int>()      // HIGH confirmation times, ascending
var array<int>    srOppResist   = array.new<int>()      // LOW  confirmation times, ascending
var array<SRCand> srSnap        = array.new<SRCand>()   // previous swing set, ascending key
var array<SRFold> srFold        = array.new<SRFold>()   // fold cache, ascending originKey
var array<SRFold> srFoldKeep    = array.new<SRFold>()   // reusable survivor buffer for retirement
var array<int>    srDirty       = array.new<int>()      // origin ABS indices whose reaction moved

// Reusable scratch buffers (P1-PERF-1): avoid per-call array allocation in the
// hot path. Each is cleared by its owner before use and is never aliased across
// two live users at the same time.
var array<float> scDispRange = array.new<float>()   // f_medianRange, displacement
var array<float> scTlAtr     = array.new<float>()   // trendline anchor-slice ATRs (kept sorted)

f_trueRange(float h, float l, float prevClose) =>
    float hl = h - l
    na(prevClose) ? hl : math.max(hl, math.abs(h - prevClose), math.abs(l - prevClose))

// Persistent "latest confirmed" summaries for the parity interface.
var float latestSwingHighPrice = na
var int   latestSwingHighTime  = na
var float latestSwingLowPrice  = na
var int   latestSwingLowTime   = na
var int   latestDispCode       = na   // signed: +/-(0 normal,1 fast,2 very_fast); sign = direction
var float latestDispRatio      = na
var float latestEqualHigh      = na
var float latestEqualLow       = na
var float latestSRTop          = na
var float latestSRBottom       = na
var int   latestSRType         = na
var float latestTLNormSlope    = na
var int   latestTLOrient       = na

// Swing-set change detection (so SWING-DERIVED detectors run only on change).
// S/R is deliberately NOT behind this gate — see the P1-CLOSEOUT note in MAIN.
var int lastSwingCount       = na
var int lastSwingConfTime    = na
var int lastSwingFingerprint = na
// S/R zone-set fingerprint — debug-drawing gate only, never an analytical gate.
var int lastSRFingerprint    = na

// Persistent draw-object handles (bounded, redrawn on change).
var array<label> swingLabelObjs = array.new<label>()
var array<line>  eqLineObjs     = array.new<line>()
var array<box>   srBoxObjs      = array.new<box>()
var array<line>  tlLineObjs     = array.new<line>()

f_clearLabels(array<label> a) =>
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            label.delete(array.get(a, i))
        array.clear(a)

f_clearLines(array<line> a) =>
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            line.delete(array.get(a, i))
        array.clear(a)

f_clearBoxes(array<box> a) =>
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            box.delete(array.get(a, i))
        array.clear(a)

// =============================================================================
// SWING PIPELINE — domain/swings.py (single-candle pivots -> plateau merge ->
// same-direction supersede -> alternation + meaningful-reversal confirmation).
// Parallel arrays are used instead of the Python _Pivot NamedTuple.
//
// P1-PERF-1: single-candle pivots are now maintained incrementally (one new
// candle decided per confirmed bar). Everything downstream of that — merge,
// supersede, alternation, meaningful-reversal confirmation — still runs over the
// bounded window on every confirmed bar and remains batch-faithful; it is cheap
// because it walks the pivot list (tens of entries), not the candle window.
// =============================================================================
// P1-PERF-1 — advance the single-candle pivot frontier by exactly one candle.
//
// Decides the newest candle that has just acquired C_WINDOW_RADIUS closed bars to
// its right (window index n-1-R), then retires pivots that have dropped out of
// the range the batch scan would cover. The resulting pivot set is identical to
// re-running _find_single_candle_pivots over the whole window.
f_advancePivotFrontier(array<float> highs, array<float> lows, array<float> atr, int absFirst, array<int> pAbs, array<int> pType, array<float> pPrice, array<float> pAtr, array<float> pTie) =>
    int n = array.size(highs)
    int idx = n - 1 - C_WINDOW_RADIUS
    if idx >= C_WINDOW_RADIUS
        float a = array.get(atr, idx)
        if not na(a)
            float tie = C_PIVOT_TIE_TOL_ATR * a
            float candHigh = array.get(highs, idx)
            float candLow  = array.get(lows, idx)
            bool qHigh = true
            bool qLow  = true
            for j = idx - C_WINDOW_RADIUS to idx + C_WINDOW_RADIUS
                if j != idx
                    if array.get(highs, j) > candHigh + tie
                        qHigh := false
                    if array.get(lows, j) < candLow - tie
                        qLow := false
            if qHigh and qLow
                qHigh := qHigh   // ambiguous (register 33I): emit neither
            else if qHigh
                array.push(pAbs, absFirst + idx)
                array.push(pType, SWING_HIGH)
                array.push(pPrice, candHigh)
                array.push(pAtr, a)
                array.push(pTie, tie)
            else if qLow
                array.push(pAbs, absFirst + idx)
                array.push(pType, SWING_LOW)
                array.push(pPrice, candLow)
                array.push(pAtr, a)
                array.push(pTie, tie)
    // The batch scan starts at window index C_WINDOW_RADIUS, i.e. absolute
    // absFirst + C_WINDOW_RADIUS. Anything older is outside its range.
    int minAbs = absFirst + C_WINDOW_RADIUS
    while array.size(pAbs) > 0 and array.get(pAbs, 0) < minAbs
        array.shift(pAbs)
        array.shift(pType)
        array.shift(pPrice)
        array.shift(pAtr)
        array.shift(pTie)
    array.size(pAbs)   // explicit return: live pivot count (callers may ignore it)

f_detectSwings(array<float> highs, array<float> lows, array<int> openT, array<int> availT, array<float> atr, array<int> pAbs, array<int> pType, array<float> pPrice, array<float> pAtr, array<float> pTie, int absFirst) =>
    array<SwingRec> outSwings = array.new<SwingRec>()
    int n = array.size(highs)
    int np = array.size(pAbs)
    if n >= 2 * C_WINDOW_RADIUS + 1 and np > 0
        // ---- _merge_adjacent_plateaus (swings.py:139): merge pivots of the same
        // type at consecutive indices within tie tolerance.
        //
        // P1-PERF-1: the frontier is already in ascending index order and holds at
        // most ONE pivot per candle, so two same-type pivots at consecutive
        // indices are necessarily neighbours in this list — nothing can sit
        // between them. A single ordered pass therefore produces exactly the
        // records Python's group-by-type pass produces, and emits them already
        // ordered by start index, which is what swings.py:179 sorts for. The
        // O(M^2) insertion sort is provably redundant and has been removed.
        // The two-element median is written as the mean of the pair — identical
        // by definition, without allocating a temporary array per merge.
        mType  = array.new<int>()
        mStart = array.new<int>()
        mEnd   = array.new<int>()
        mPrice = array.new<float>()
        mAtr   = array.new<float>()
        mTie   = array.new<float>()
        int gidx = 0
        while gidx < np
            int curType = array.get(pType, gidx)
            bool merged = false
            if gidx + 1 < np
                if array.get(pType, gidx + 1) == curType and array.get(pAbs, gidx + 1) == array.get(pAbs, gidx) + 1 and math.abs(array.get(pPrice, gidx + 1) - array.get(pPrice, gidx)) <= array.get(pTie, gidx)
                    float price = curType == SWING_HIGH ? math.max(array.get(pPrice, gidx), array.get(pPrice, gidx + 1)) : math.min(array.get(pPrice, gidx), array.get(pPrice, gidx + 1))
                    array.push(mType, curType)
                    array.push(mStart, array.get(pAbs, gidx) - absFirst)
                    array.push(mEnd, array.get(pAbs, gidx + 1) - absFirst)
                    array.push(mPrice, price)
                    array.push(mAtr, (array.get(pAtr, gidx) + array.get(pAtr, gidx + 1)) / 2.0)
                    array.push(mTie, array.get(pTie, gidx + 1))
                    gidx += 2
                    merged := true
            if not merged
                array.push(mType, curType)
                array.push(mStart, array.get(pAbs, gidx) - absFirst)
                array.push(mEnd, array.get(pAbs, gidx) - absFirst)
                array.push(mPrice, array.get(pPrice, gidx))
                array.push(mAtr, array.get(pAtr, gidx))
                array.push(mTie, array.get(pTie, gidx))
                gidx += 1

        // ---- _supersede_same_direction_runs (swings.py:183): keep extreme per run ----
        cType  = array.new<int>()
        cStart = array.new<int>()
        cEnd   = array.new<int>()
        cPrice = array.new<float>()
        cAtr   = array.new<float>()
        cTie   = array.new<float>()
        int runType = na
        int bestRel = na
        for [rel, _u337] in mType
            int thisType = array.get(mType, rel)
            if na(runType)
                runType := thisType
                bestRel := rel
            else if thisType != runType
                array.push(cType, array.get(mType, bestRel))
                array.push(cStart, array.get(mStart, bestRel))
                array.push(cEnd, array.get(mEnd, bestRel))
                array.push(cPrice, array.get(mPrice, bestRel))
                array.push(cAtr, array.get(mAtr, bestRel))
                array.push(cTie, array.get(mTie, bestRel))
                runType := thisType
                bestRel := rel
            else
                bool better = thisType == SWING_HIGH ? array.get(mPrice, rel) > array.get(mPrice, bestRel) : array.get(mPrice, rel) < array.get(mPrice, bestRel)
                if better
                    bestRel := rel
        if not na(bestRel)
            array.push(cType, array.get(mType, bestRel))
            array.push(cStart, array.get(mStart, bestRel))
            array.push(cEnd, array.get(mEnd, bestRel))
            array.push(cPrice, array.get(mPrice, bestRel))
            array.push(cAtr, array.get(mAtr, bestRel))
            array.push(cTie, array.get(mTie, bestRel))

        // ---- confirmation loop (swings.py:219): alternation + meaningful reversal ----
        int lastConfirmedType = na
        for [p, _u366] in cType
            int endIdx = array.get(cEnd, p)
            int localConfIdx = endIdx + C_WINDOW_RADIUS
            // swings.py:228 `pivot.swing_type == last_confirmed_type` is False while
            // last_confirmed_type is None, so the FIRST eligible pivot is never skipped.
            // Pine `!=` against an na int yields na (falsy), which would permanently
            // block that first confirmation; the na() guard restores the Python state.
            if localConfIdx < n and (na(lastConfirmedType) or array.get(cType, p) != lastConfirmedType)
                float refAtr = array.get(cAtr, p)
                float threshold = C_MEANINGFUL_REVERSAL_ATR * refAtr
                float pivotPrice = array.get(cPrice, p)
                int confIdx = na
                float excursion = 0.0
                int searchStart = localConfIdx + 1
                // P1-PERF-1: this is Python's `for j in range(search_start, n)`.
                // The previous `for [j, _] in lows` + `if j < searchStart: continue`
                // form re-walked the whole window from index 0 on every candidate
                // (~W/2 wasted iterations each) before reaching the first index it
                // could actually use. A `while` bounded at both ends visits exactly
                // the same indices in the same order, and cannot run backwards.
                if array.get(cType, p) == SWING_HIGH
                    float lowestLow = array.get(lows, localConfIdx)
                    int j = searchStart
                    while j < n
                        lowestLow := math.min(lowestLow, array.get(lows, j))
                        float exc = pivotPrice - lowestLow
                        if exc >= threshold
                            confIdx := j
                            excursion := exc
                            break
                        j += 1
                else
                    float highestHigh = array.get(highs, localConfIdx)
                    int j = searchStart
                    while j < n
                        highestHigh := math.max(highestHigh, array.get(highs, j))
                        float exc = highestHigh - pivotPrice
                        if exc >= threshold
                            confIdx := j
                            excursion := exc
                            break
                        j += 1
                if not na(confIdx)
                    SwingRec s = SwingRec.new(array.get(cType, p), pivotPrice, array.get(cStart, p), endIdx, array.get(openT, endIdx), array.get(availT, localConfIdx), array.get(availT, confIdx), refAtr, array.get(cTie, p), threshold, excursion)
                    array.push(outSwings, s)
                    lastConfirmedType := array.get(cType, p)
    outSwings

// =============================================================================
// EQUAL LEVELS — domain/equal_levels.py. Per type, ordered by meaningful
// confirmation time (record_id tiebreak replaced by deterministic
// (time, pivotEndTime, price) order — content preserved); grow a cluster while
// spread <= tolerance(median atr).
// =============================================================================
f_sweepEqualType(array<SwingRec> swings, int wantType) =>
    array<EqualLevelRec> out = array.new<EqualLevelRec>()
    idxs = array.new<int>()
    for [k, _u409] in swings
        if array.get(swings, k).swingType == wantType
            array.push(idxs, k)
    // insertion sort idxs by (meaningfulConfTime, pivotEndTime, price)
    for [a, _u413] in idxs
        if a < 1
            continue
        int key = array.get(idxs, a)
        SwingRec ks = array.get(swings, key)
        int b = a - 1
        bool placed = false
        while b >= 0 and not placed
            SwingRec bs = array.get(swings, array.get(idxs, b))
            bool greater = bs.meaningfulConfTime > ks.meaningfulConfTime or (bs.meaningfulConfTime == ks.meaningfulConfTime and (bs.pivotEndTime > ks.pivotEndTime or (bs.pivotEndTime == ks.pivotEndTime and bs.price > ks.price)))
            if greater
                array.set(idxs, b + 1, array.get(idxs, b))
                b -= 1
            else
                placed := true
        array.set(idxs, b + 1, key)

    members = array.new<int>()
    for [a, _u429] in idxs
        int si = array.get(idxs, a)
        bool closeIt = false
        if array.size(members) == 0
            array.push(members, si)
        else
            candPrices = array.new<float>()
            candAtrs = array.new<float>()
            for [m, _u437] in members
                SwingRec ms = array.get(swings, array.get(members, m))
                array.push(candPrices, ms.price)
                array.push(candAtrs, ms.referenceAtr)
            array.push(candPrices, array.get(swings, si).price)
            array.push(candAtrs, array.get(swings, si).referenceAtr)
            float refAtr = f_medianConsume(candAtrs)
            float tol = C_EQUAL_LEVEL_TOL_ATR * refAtr
            float spread = array.max(candPrices) - array.min(candPrices)
            if spread <= tol
                array.push(members, si)
            else
                closeIt := true
        if closeIt
            if array.size(members) >= 2
                prices = array.new<float>()
                atrs = array.new<float>()
                int firstT = na
                int confT = na
                for [m, _u456] in members
                    SwingRec ms = array.get(swings, array.get(members, m))
                    array.push(prices, ms.price)
                    array.push(atrs, ms.referenceAtr)
                    firstT := na(firstT) ? ms.meaningfulConfTime : math.min(firstT, ms.meaningfulConfTime)
                    confT := na(confT) ? ms.meaningfulConfTime : math.max(confT, ms.meaningfulConfTime)
                float refAtr = f_medianConsume(atrs)
                float zb = array.min(prices)
                float zt = array.max(prices)
                array.push(out, EqualLevelRec.new(wantType, zb, zt, (zb + zt) / 2.0, zt - zb, C_EQUAL_LEVEL_TOL_ATR * refAtr, array.size(members), firstT, confT))
            array.clear(members)
            array.push(members, si)
    // final close
    if array.size(members) >= 2
        prices = array.new<float>()
        atrs = array.new<float>()
        int firstT = na
        int confT = na
        for [m, _u474] in members
            SwingRec ms = array.get(swings, array.get(members, m))
            array.push(prices, ms.price)
            array.push(atrs, ms.referenceAtr)
            firstT := na(firstT) ? ms.meaningfulConfTime : math.min(firstT, ms.meaningfulConfTime)
            confT := na(confT) ? ms.meaningfulConfTime : math.max(confT, ms.meaningfulConfTime)
        float refAtr = f_medianConsume(atrs)
        float zb = array.min(prices)
        float zt = array.max(prices)
        array.push(out, EqualLevelRec.new(wantType, zb, zt, (zb + zt) / 2.0, zt - zb, C_EQUAL_LEVEL_TOL_ATR * refAtr, array.size(members), firstT, confT))
    out

f_detectEqualLevels(array<SwingRec> swings) =>
    out = array.new<EqualLevelRec>()
    highs = f_sweepEqualType(swings, SWING_HIGH)
    lows = f_sweepEqualType(swings, SWING_LOW)
    for [i, _u490] in highs
        array.push(out, array.get(highs, i))
    for [i, _u492] in lows
        array.push(out, array.get(lows, i))
    out

// =============================================================================
// LEG MEASUREMENT — measurements/legs.py measure_leg. Returns
// [classification (2=STRONG_FAST,1=FAST,0=SLOW/UNCLEAR), dirEfficiency, dirShare].
// =============================================================================
f_measureLeg(array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, int startIncl, int endIncl, bool isBull) =>
    int barCount = endIncl - startIncl + 1
    int classification = 0
    float dirEff = 0.0
    float dirShare = 0.0
    if barCount > 0
        float startPrice = array.get(opens, startIncl)
        float endPrice = array.get(closes, endIncl)
        float netDist = math.abs(endPrice - startPrice)
        atrs = array.new<float>()
        float legPath = 0.0
        int dirCloses = 0
        for i = startIncl to endIncl
            float av = array.get(atr, i)
            if not na(av)
                array.push(atrs, av)
            legPath += array.get(highs, i) - array.get(lows, i)
            bool dir = isBull ? array.get(closes, i) >= array.get(opens, i) : array.get(closes, i) <= array.get(opens, i)
            if dir
                dirCloses += 1
        float refAtr = f_medianConsume(atrs)
        dirShare := dirCloses / barCount
        if refAtr != 0.0 and legPath != 0.0
            float normSpeed = netDist / (barCount * refAtr)
            dirEff := netDist / legPath
            if normSpeed >= C_LEG_STRONG_SPEED and dirEff >= C_LEG_STRONG_EFF and dirShare >= C_LEG_STRONG_SHARE
                classification := 2
            else if normSpeed >= C_LEG_FAST_SPEED and dirEff >= C_LEG_FAST_EFF and dirShare >= C_LEG_FAST_SHARE
                classification := 1
    [classification, dirEff, dirShare]

// =============================================================================
// P1-SR-PERF-2 — INCREMENTAL SUPPORT/RESISTANCE REACTION FRONTIER
//
// support_resistance.py:80 searches `range(search_start_index, n)` for the
// reaction start and then evaluates a bounded window from there, so a reaction
// resolves as candles arrive, independently of swings — analyzer.py:923 states
// the requirement outright. P1-CLOSEOUT therefore lifted S/R out of the
// swing-change gate, but recomputing the whole detector every confirmed bar put
// the script back on TradingView's Basic 20s boundary (intermittent RE10110 on
// M1).
//
// This frontier keeps the corrected publication timing and removes the rescan.
// Per confirmed bar it advances only UNRESOLVED trackers; the origin x touch
// walk re-runs only when the swing set or some tracker's resolution actually
// changed, because the walk's output is a pure function of exactly those two
// things. Everything else is carried forward.
//
// A tracker is identified by (originAbs, searchStartAbs) — both absolute
// confirmed-bar indices, so a window shift cannot invalidate the key, and no
// UUID or random identity is introduced. Keys are packed into one int and kept
// ASCENDING, which makes retirement a prefix removal: the origin index lives in
// the high bits, so "every tracker whose origin has left the window" is exactly
// the front of the array.
//
// Window safety: a tracker is retired the moment its origin leaves the active
// window, and originAbs < reactionStartAbs < confirmingAbs < end always holds,
// so a live tracker can never reference a candle that has already scrolled out.
//
// The algorithm is validated against the production Python implementation at
// every prefix — including the 300-bar rollover — in
// tests/unit/test_pine_p1_sr_frontier_model.py.
// =============================================================================

// Key stride: 2^22. Both components are absolute bar indices, so this is safe
// for any chart shorter than 4,194,304 confirmed bars.
int C_SR_KEY_STRIDE = 4194304

// Index of `key` in an ascending array, or -1.
f_srFind(array<int> keys, int key) =>
    int lo = 0
    int hi = array.size(keys) - 1
    int found = -1
    while lo <= hi
        int mid = int((lo + hi) / 2)
        int probe = array.get(keys, mid)
        if probe == key
            found := mid
            break
        if probe < key
            lo := mid + 1
        else
            hi := mid - 1
    found

// First position in an ascending array whose key is >= `key`.
f_srLowerBound(array<int> keys, int key) =>
    int lo = 0
    int hi = array.size(keys)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(keys, mid) < key
            lo := mid + 1
        else
            hi := mid
    lo

// Advance one tracker by the candles that have arrived since it was last seen.
// Returns a tracker whose confirmingAbs is what a full _evaluate_reaction over
// the candles available NOW would return — reached without any rescan:
//   * before the reaction starts, each candle is examined at most ONCE per
//     tracker, and the anchor is accumulated in that same pass (which also
//     keeps it valid after the window's left edge passes searchStart);
//   * after it starts, only the bounded <= C_REACTION_WINDOW_BARS slice is read,
//     at most C_REACTION_WINDOW_BARS times, before `permanent` latches.
f_advanceSRTracker(SRTracker t, array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, array<int> availT, int absFirst) =>
    SRTracker outT = t
    if not t.permanent
        int nAbs = absFirst + array.size(highs)
        float zoneHeight = t.zoneTop - t.zoneBottom
        if zoneHeight <= 0.0
            outT := SRTracker.new(t.originAbs, t.searchStartAbs, t.zoneTop, t.zoneBottom, t.isSupport, nAbs - 1, na, na, true, na, na)
        else
            int reactionStart = t.reactionStartAbs
            float anchor = t.anchor
            int lastChecked = t.lastCheckedAbs
            if na(reactionStart)
                int scanFrom = math.max(lastChecked + 1, t.searchStartAbs)
                int i = scanFrom
                while i < nAbs
                    int w = i - absFirst
                    float extreme = t.isSupport ? array.get(lows, w) : array.get(highs, w)
                    anchor := na(anchor) ? extreme : (t.isSupport ? math.min(anchor, extreme) : math.max(anchor, extreme))
                    bool breached = t.isSupport ? (array.get(closes, w) > t.zoneTop) : (array.get(closes, w) < t.zoneBottom)
                    if breached
                        reactionStart := i
                        break
                    i += 1
                lastChecked := nAbs - 1
            if na(reactionStart)
                outT := SRTracker.new(t.originAbs, t.searchStartAbs, t.zoneTop, t.zoneBottom, t.isSupport, lastChecked, na, anchor, false, na, na)
            else
                int windowEnd = math.min(reactionStart + C_REACTION_WINDOW_BARS, nAbs)  // exclusive
                bool isFull = windowEnd == reactionStart + C_REACTION_WINDOW_BARS
                int confAbs = na
                int confTime = na
                if windowEnd > reactionStart
                    int rsW = reactionStart - absFirst
                    int weW = windowEnd - absFirst
                    float mfe = na
                    float zoneClearance = na
                    int mfeW = rsW
                    if t.isSupport
                        float hh = array.get(highs, rsW)
                        for i2 = rsW to weW - 1
                            if array.get(highs, i2) > hh
                                hh := array.get(highs, i2)
                                mfeW := i2
                        mfe := hh - anchor
                        zoneClearance := math.max(0.0, hh - t.zoneTop)
                    else
                        float ll = array.get(lows, rsW)
                        for i2 = rsW to weW - 1
                            if array.get(lows, i2) < ll
                                ll := array.get(lows, i2)
                                mfeW := i2
                        mfe := anchor - ll
                        zoneClearance := math.max(0.0, t.zoneBottom - ll)
                    float refAtr = array.get(atr, rsW)
                    if not na(refAtr) and refAtr != 0.0
                        float atrRatio = mfe / refAtr
                        float clearanceRatio = zoneClearance / zoneHeight
                        [legClass, legEff, legShare] = f_measureLeg(highs, lows, opens, closes, atr, rsW, mfeW, t.isSupport)
                        if atrRatio >= C_REACTION_STD_ATR_RATIO and clearanceRatio >= C_REACTION_STD_ZONE_CLEAR_RATIO and legEff >= C_REACTION_STD_DIR_EFF and legShare >= C_REACTION_STD_DIR_SHARE
                            confAbs := reactionStart + (mfeW - rsW)
                            confTime := array.get(availT, mfeW)
                outT := SRTracker.new(t.originAbs, t.searchStartAbs, t.zoneTop, t.zoneBottom, t.isSupport, lastChecked, reactionStart, anchor, isFull, confAbs, confTime)
    outT

// Find the tracker for (originAbs, searchStartAbs), creating and advancing it on
// first sight. Returns its index in the ascending key/tracker arrays.
f_srTrackerIndex(array<int> keys, array<SRTracker> trk, int originAbs, int searchStartAbs, float zoneTop, float zoneBottom, bool isSupport, array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, array<int> availT, int absFirst) =>
    int key = originAbs * C_SR_KEY_STRIDE + searchStartAbs
    int idx = f_srFind(keys, key)
    if idx < 0
        SRTracker fresh = SRTracker.new(originAbs, searchStartAbs, zoneTop, zoneBottom, isSupport, searchStartAbs - 1, na, na, false, na, na)
        SRTracker advanced = f_advanceSRTracker(fresh, highs, lows, opens, closes, atr, availT, absFirst)
        int pos = f_srLowerBound(keys, key)
        array.insert(keys, pos, key)
        array.insert(trk, pos, advanced)
        idx := pos
    idx


// =============================================================================
// P1-SR-PERF-3 — fold-cache helpers.
//
// Every loop below is bounded by A (confirmed swings inside the 300-bar window;
// measured max 73, theoretical max 150) or by F (cached folds, F <= A). No loop
// crosses two unbounded collections, and no array is mutated while an index into
// it is being reused.
// =============================================================================

// Index of `key` in a fold array kept ascending by originKey, or -1. Safe on an
// empty array: hi = -1 makes the loop body unreachable.
f_srFoldFind(array<SRFold> folds, int key) =>
    int lo = 0
    int hi = array.size(folds) - 1
    int found = -1
    while lo <= hi
        int mid = int((lo + hi) / 2)
        int probe = array.get(folds, mid).originKey
        if probe == key
            found := mid
            break
        if probe < key
            lo := mid + 1
        else
            hi := mid - 1
    found

// First position whose originKey is >= key. Safe on an empty array: returns 0.
f_srFoldLowerBound(array<SRFold> folds, int key) =>
    int lo = 0
    int hi = array.size(folds)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(folds, mid).originKey < key
            lo := mid + 1
        else
            hi := mid
    lo

// Is `key` present among the live swings? They are ascending by pivotEndTime, so
// this is a binary search. Safe on an empty array.
f_srSwingHasKey(array<SwingRec> swings, int key) =>
    int lo = 0
    int hi = array.size(swings) - 1
    bool found = false
    while lo <= hi
        int mid = int((lo + hi) / 2)
        int probe = array.get(swings, mid).pivotEndTime
        if probe == key
            found := true
            break
        if probe < key
            lo := mid + 1
        else
            hi := mid - 1
    found

// Insertion sort SRCand by meaningfulConfTime. The size never changes, so
// iterating with `for ... in` while reordering elements is safe, and the a < 1
// guard keeps the counted prefix out of Pine's reversed-range trap. The previous
// build ran this sort on EVERY walk; it now runs only on a swing delta.
f_srSortCandByConfTime(array<SRCand> cands) =>
    for [a, _u910] in cands
        if a < 1
            continue
        SRCand keyCand = array.get(cands, a)
        int b = a - 1
        bool placed = false
        while b >= 0 and not placed
            if array.get(cands, b).meaningfulConfTime > keyCand.meaningfulConfTime
                array.set(cands, b + 1, array.get(cands, b))
                b -= 1
            else
                placed := true
        array.set(cands, b + 1, keyCand)

// Rebuild the orientation candidate lists and the ascending snapshot. O(A) plus
// two insertion sorts over a small A. Absolute indices are baked in here, once.
f_srRebuildCandidates(array<SwingRec> swings, int absFirst, array<SRCand> candS, array<SRCand> candR, array<int> oppS, array<int> oppR, array<SRCand> snap) =>
    array.clear(candS)
    array.clear(candR)
    array.clear(oppS)
    array.clear(oppR)
    array.clear(snap)
    for [k, _u911] in swings
        SwingRec sw = array.get(swings, k)
        SRCand cand = SRCand.new(sw.pivotEndTime, sw.swingType, sw.price, sw.referenceAtr, sw.meaningfulConfTime, sw.pivotEndIdx + absFirst)
        array.push(snap, cand)
        if sw.swingType == SWING_LOW
            array.push(candS, cand)
            array.push(oppR, sw.meaningfulConfTime)
        else
            array.push(candR, cand)
            array.push(oppS, sw.meaningfulConfTime)
    f_srSortCandByConfTime(candS)
    f_srSortCandByConfTime(candR)
    array.sort(oppS, order.ascending)
    array.sort(oppR, order.ascending)

// Apply a swing delta to the fold cache.
//
// The delta itself is an O(A) merge of two ascending-by-key lists — the previous
// snapshot and the live swing set — so it never scans the old array once per new
// item. Invalidation then follows the rule proven in the model:
//
//   * an OPPOSITE-type change feeds the has-opposite-between test for every
//     origin of that orientation, so it takes the whole orientation;
//   * a SAME-type change can only alter a fold if it lies inside that origin's
//     zone, because zone geometry is the fold's first gate on every touch and
//     depends on nothing else;
//   * an origin that no longer exists retires outright.
//
// Retirement rebuilds the array from survivors instead of removing by index, so
// no index can be invalidated mid-loop — safe for empty, single, adjacent, first,
// last and all-removed cases alike.
f_srApplyDelta(array<SwingRec> swings, array<SRCand> snap, array<SRFold> folds, array<SRFold> keep) =>
    chgType  = array.new<int>()
    chgPrice = array.new<float>()
    int i = 0
    int j = 0
    int oldN = array.size(snap)
    int newN = array.size(swings)
    while i < oldN or j < newN
        bool haveOld = i < oldN
        bool haveNew = j < newN
        bool takeOld = false
        bool takeNew = false
        // The two keys are read ONLY where both cursors are in range, so neither
        // is ever na and neither array is ever indexed one past the end. That
        // also keeps the comparison out of Pine's na-comparison trap, which is
        // the defect class that produced the original zero-swing bug.
        if haveOld and haveNew
            int oldKey = array.get(snap, i).key
            int newKey = array.get(swings, j).pivotEndTime
            if oldKey == newKey
                i += 1
                j += 1
            else if oldKey < newKey
                takeOld := true
            else
                takeNew := true
        else if haveOld
            takeOld := true
        else
            takeNew := true
        if takeOld
            SRCand gone = array.get(snap, i)
            array.push(chgType, gone.swingType)
            array.push(chgPrice, gone.price)
            i += 1
        if takeNew
            SwingRec added = array.get(swings, j)
            array.push(chgType, added.swingType)
            array.push(chgPrice, added.price)
            j += 1

    bool supportOppDelta = false
    bool resistOppDelta = false
    for [c, _u912] in chgType
        if array.get(chgType, c) == SWING_HIGH
            supportOppDelta := true    // a HIGH is the opposite of a SUPPORT origin
        else
            resistOppDelta := true

    array.clear(keep)
    for [f, _u913] in folds
        SRFold fold = array.get(folds, f)
        bool isSupport = fold.originType == SWING_LOW
        bool drop = not f_srSwingHasKey(swings, fold.originKey)
        if not drop and (isSupport ? supportOppDelta : resistOppDelta)
            drop := true
        if not drop
            float touchTol = C_SR_TOUCH_TOL_ATR * fold.referenceAtr
            float pierceTol = C_SR_PIERCE_TOL_ATR * fold.referenceAtr
            for [c2, _u914] in chgType
                if not drop and array.get(chgType, c2) == fold.originType
                    float p = array.get(chgPrice, c2)
                    bool inside = isSupport ? (p <= fold.zoneTop + touchTol and p >= fold.zoneBottom - pierceTol) : (p >= fold.zoneBottom - touchTol and p <= fold.zoneTop + pierceTol)
                    if inside
                        drop := true
        if not drop
            array.push(keep, fold)
    array.clear(folds)
    for [g, _u915] in keep
        array.push(folds, array.get(keep, g))

// =============================================================================
// SUPPORT / RESISTANCE WALK — domain/support_resistance.detect_support_resistance_zones.
//
// Identical control flow, ordering and tie-breaking to the previous batch
// detector; the ONLY change is that each reaction evaluation is now a tracker
// lookup instead of a forward scan. The `has opposite between` existence test
// also uses a monotone cursor over the opposite-type confirmation times rather
// than rescanning every swing per touch — `oi` is ascending by confirmation
// time and `lastTouchTime` never decreases, so the cursor only moves forward.
// =============================================================================
f_walkSR(array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, array<int> availT, array<SRCand> candS, array<SRCand> candR, array<int> oppS, array<int> oppR, array<SRFold> folds, array<int> dirty, array<int> keys, array<SRTracker> trk, int absFirst) =>
    array<SRRec> out = array.new<SRRec>()
    for ot = 0 to 1
        bool isSupport = ot == 0
        int originType = isSupport ? SWING_LOW : SWING_HIGH
        array<SRCand> oi = isSupport ? candS : candR
        array<int> opp = isSupport ? oppS : oppR

        for [oo, _u615] in oi
            SRCand origin = array.get(oi, oo)

            // P1-SR-PERF-3: reuse this origin's fold unless one of ITS OWN
            // reactions moved. Everything else the fold depends on — ordering,
            // geometry, the opposite-swing test — is swing-derived, and a swing
            // change has already invalidated the affected folds via f_srApplyDelta.
            bool isDirty = false
            for [d, _u916] in dirty
                if array.get(dirty, d) == origin.pivotEndAbs
                    isDirty := true
                    break
            int foldIdx = f_srFoldFind(folds, origin.key)
            if foldIdx >= 0 and not isDirty
                SRFold cached = array.get(folds, foldIdx)
                if cached.hasZone
                    array.push(out, SRRec.new(cached.originType, cached.zoneTop, cached.zoneBottom, cached.zoneDepth, cached.touchCount, cached.confirmationTime))
                continue

            float zoneDepth = C_SR_ZONE_DEPTH_ATR * origin.referenceAtr
            float zoneTop = na
            float zoneBottom = na
            if isSupport
                zoneBottom := origin.price
                zoneTop := zoneBottom + zoneDepth
            else
                zoneTop := origin.price
                zoneBottom := zoneTop - zoneDepth
            int originTi = f_srTrackerIndex(keys, trk, origin.pivotEndAbs, origin.pivotEndAbs + 1, zoneTop, zoneBottom, isSupport, highs, lows, opens, closes, atr, availT, absFirst)
            int touchCount = 0
            int firstConfTime = na
            if not na(array.get(trk, originTi).confirmingAbs)
                float touchTol = C_SR_TOUCH_TOL_ATR * origin.referenceAtr
                float pierceTol = C_SR_PIERCE_TOL_ATR * origin.referenceAtr
                int lastTouchTime = origin.meaningfulConfTime
                int cursor = 0
                for [tt, _u634] in oi
                    SRCand touch = array.get(oi, tt)
                    if touch.meaningfulConfTime > lastTouchTime
                        bool geomOk = isSupport ? (touch.price <= zoneTop + touchTol and touch.price >= zoneBottom - pierceTol) : (touch.price >= zoneBottom - touchTol and touch.price <= zoneTop + pierceTol)
                        if geomOk
                            while cursor < array.size(opp) and array.get(opp, cursor) <= lastTouchTime
                                cursor += 1
                            bool oppositeBetween = cursor < array.size(opp) and array.get(opp, cursor) < touch.meaningfulConfTime
                            if oppositeBetween
                                int touchTi = f_srTrackerIndex(keys, trk, origin.pivotEndAbs, touch.pivotEndAbs + 1, zoneTop, zoneBottom, isSupport, highs, lows, opens, closes, atr, availT, absFirst)
                                SRTracker touchTracker = array.get(trk, touchTi)
                                if not na(touchTracker.confirmingAbs)
                                    touchCount += 1
                                    if na(firstConfTime)
                                        firstConfTime := touchTracker.confirmingTime
                                    lastTouchTime := touch.meaningfulConfTime
            bool hasZone = not na(firstConfTime)
            SRFold fresh = SRFold.new(origin.key, origin.pivotEndAbs, originType, zoneTop, zoneBottom, origin.referenceAtr, zoneDepth, hasZone, touchCount, firstConfTime)
            if foldIdx >= 0
                array.set(folds, foldIdx, fresh)
            else
                array.insert(folds, f_srFoldLowerBound(folds, origin.key), fresh)
            if hasZone
                array.push(out, SRRec.new(originType, zoneTop, zoneBottom, zoneDepth, touchCount, firstConfTime))

    // P1-SR-ORDERING: Python closes detect_support_resistance_zones with
    // `results.sort(key=confirmation_time_utc)` (support_resistance.py:303), and
    // list.sort is STABLE — so equal confirmation times keep the insertion order
    // built above (SUPPORT orientation first, then RESISTANCE; within each,
    // ascending origin meaningfulConfTime). Pine had no final sort at all, which
    // let it publish an older zone than Python's canonical latest whenever both
    // directions qualified. Both halves of the rule are reproduced explicitly
    // with a composite (confirmationTime, insertionIndex) key, so nothing rests
    // on incidental Pine array behaviour. Runs only when the resolved set is
    // rebuilt, and the set is tiny (bounded by the qualifying origins).
    ordIdx = array.new<int>()
    for [z0, _u860] in out
        array.push(ordIdx, z0)
    for [a2, _u862] in ordIdx
        if a2 < 1
            continue
        int keyIdx = array.get(ordIdx, a2)
        int keyTime = array.get(out, keyIdx).confirmationTime
        int b2 = a2 - 1
        bool placed2 = false
        while b2 >= 0 and not placed2
            int probeIdx = array.get(ordIdx, b2)
            int probeTime = array.get(out, probeIdx).confirmationTime
            if probeTime > keyTime or (probeTime == keyTime and probeIdx > keyIdx)
                array.set(ordIdx, b2 + 1, probeIdx)
                b2 -= 1
            else
                placed2 := true
        array.set(ordIdx, b2 + 1, keyIdx)
    ordered = array.new<SRRec>()
    for [s2, _u876] in ordIdx
        array.push(ordered, array.get(out, array.get(ordIdx, s2)))
    ordered

// =============================================================================
// TRENDLINES — domain/trendlines.detect_trendlines.
// =============================================================================
f_detectTrendlines(array<float> closes, array<float> atr, array<SwingRec> swings, array<float> atrSlice) =>
    array<TrendlineRec> out = array.new<TrendlineRec>()
    orientTypes = array.from(SWING_LOW, SWING_HIGH)  // BULLISH uses lows, BEARISH uses highs
    for ot = 0 to 1
        int orientation = array.get(orientTypes, ot)
        bool isBull = orientation == SWING_LOW
        si = array.new<int>()
        for [k, _u665] in swings
            if array.get(swings, k).swingType == orientation
                array.push(si, k)
        // order by pivotEndIdx (insertion sort)
        for [a, _u669] in si
            if a < 1
                continue
            int key = array.get(si, a)
            int b = a - 1
            bool placed = false
            while b >= 0 and not placed
                if array.get(swings, array.get(si, b)).pivotEndIdx > array.get(swings, key).pivotEndIdx
                    array.set(si, b + 1, array.get(si, b))
                    b -= 1
                else
                    placed := true
            array.set(si, b + 1, key)

        for [i, _u681] in si
            SwingRec a1 = array.get(swings, array.get(si, i))
            int a1Idx = a1.pivotEndIdx
            // P1-PERF-1: `si` is ordered by pivotEndIdx, so for a fixed first
            // anchor the ATR slice [a1Idx .. a2Idx] only ever GROWS as j advances.
            // Rebuilding and re-allocating it for every candidate pair re-read the
            // same bars O(pairs) times; instead extend one reused buffer. The
            // median is over a multiset, so growth order is irrelevant.
            array.clear(atrSlice)
            int slicedTo = a1Idx - 1
            for [j, _u684] in si
                if j <= i
                    continue
                SwingRec a2 = array.get(swings, array.get(si, j))
                int a2Idx = a2.pivotEndIdx
                if a2Idx - a1Idx >= C_TL_MIN_ANCHOR_SPACING
                    bool progressOk = isBull ? (a2.price > a1.price + a1.tieTolerance) : (a2.price < a1.price - a1.tieTolerance)
                    if progressOk
                        float rawSlope = (a2.price - a1.price) / (a2Idx - a1Idx)
                        if a2Idx > slicedTo
                            for bi = slicedTo + 1 to a2Idx
                                float av = array.get(atr, bi)
                                if not na(av)
                                    array.push(atrSlice, av)
                            slicedTo := a2Idx
                        if array.size(atrSlice) > 0
                            float refAtr = f_medianConsume(atrSlice)
                            if refAtr != 0.0
                                float normSlope = math.abs(rawSlope) / refAtr
                                if normSlope >= C_TL_HORIZONTAL_ATR and normSlope <= C_TL_TOO_STEEP_ATR
                                    float pierceTol = C_TL_PIERCE_TOL_ATR * refAtr
                                    float touchTol = C_TL_TOUCH_TOL_ATR * refAtr
                                    // P1-PERF-1: stop at the first pierce instead of
                                    // scanning the remaining bars with the result
                                    // already decided. Same verdict, fewer reads.
                                    bool integrityOk = true
                                    int ii = a1Idx + 1
                                    while ii <= a2Idx - 1
                                        float projected = a1.price + rawSlope * (ii - a1Idx)
                                        float cc = array.get(closes, ii)
                                        if isBull
                                            if projected - cc > pierceTol
                                                integrityOk := false
                                                break
                                        else
                                            if cc - projected > pierceTol
                                                integrityOk := false
                                                break
                                        ii += 1
                                    if integrityOk
                                        // P1-PERF-1: `si` is ascending by pivotEndIdx,
                                        // so the first qualifying touch encountered is
                                        // the one the original scan kept; break there.
                                        int confTime = na
                                        for [t, _u716] in si
                                            SwingRec touch = array.get(swings, array.get(si, t))
                                            int tIdx = touch.pivotEndIdx
                                            if tIdx > a2Idx
                                                float projected = a1.price + rawSlope * (tIdx - a1Idx)
                                                float diff = isBull ? (touch.price - projected) : (projected - touch.price)
                                                bool qualifies = math.abs(diff) <= touchTol or (diff >= -pierceTol and diff < -touchTol)
                                                if qualifies
                                                    confTime := touch.meaningfulConfTime
                                                    break
                                        if not na(confTime)
                                            array.push(out, TrendlineRec.new(orientation, a1.price, a2.price, a1.pivotEndTime, a2.pivotEndTime, rawSlope, normSlope, confTime))
    out

// =============================================================================
// DISPLACEMENT — domain/displacement for the most-recent confirmed candle.
// =============================================================================
f_latestDisplacement(array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> scratch) =>
    int n = array.size(highs)
    int code = na
    float ratio = na
    if n > C_RANGE_CONTEXT_WINDOW
        int idx = n - 1
        float rangeValue = array.get(highs, idx) - array.get(lows, idx)
        int cls = 0
        if rangeValue == 0.0
            ratio := 0.0
            cls := 0
        else
            float baseline = f_medianRange(highs, lows, idx - C_RANGE_CONTEXT_WINDOW, idx, scratch)
            ratio := baseline == 0.0 ? 0.0 : rangeValue / baseline
            cls := ratio >= C_DISP_VERY_FAST_RATIO ? 2 : (ratio >= C_DISP_FAST_RATIO ? 1 : 0)
        bool isBull = array.get(closes, idx) >= array.get(opens, idx)
        code := isBull ? cls : -cls
    [code, ratio]

// =============================================================================
// MAIN — advance state ONLY on confirmed/closed bars (non-repaint).
// =============================================================================
if barstate.isconfirmed
    // ---- exact incremental Wilder ATR for THIS candle ----
    float tr = f_trueRange(high, low, atrPrevClose)
    float atrValue = na
    if not na(atrPrevFinal)
        atrValue := (atrPrevFinal * (C_ATR_PERIOD - 1) + tr) / C_ATR_PERIOD
        atrPrevFinal := atrValue
    else
        atrWarmSum := atrWarmSum + tr
        atrWarmCount := atrWarmCount + 1
        if atrWarmCount < C_ATR_PERIOD
            atrValue := na
        else
            atrValue := atrWarmSum / C_ATR_PERIOD
            atrPrevFinal := atrValue
    atrPrevClose := close

    // ---- push into rolling window; prune to lookbackWindow ----
    confirmedBarCount := confirmedBarCount + 1
    array.push(wHigh, high)
    array.push(wLow, low)
    array.push(wOpen, open)
    array.push(wClose, close)
    array.push(wOpenT, time)
    array.push(wAvailT, time_close)
    array.push(wAtr, atrValue)
    while array.size(wHigh) > lookbackWindow
        array.shift(wHigh)
        array.shift(wLow)
        array.shift(wOpen)
        array.shift(wClose)
        array.shift(wOpenT)
        array.shift(wAvailT)
        array.shift(wAtr)

    // ---- displacement (latest confirmed candle) ----
    [dispCode, dispRatio] = f_latestDisplacement(wHigh, wLow, wOpen, wClose, scDispRange)
    latestDispCode := dispCode
    latestDispRatio := dispRatio

    // ---- single-candle pivot frontier: decide ONE new candle, retire stale ----
    int absFirst = confirmedBarCount - array.size(wHigh)
    f_advancePivotFrontier(wHigh, wLow, wAtr, absFirst, pvAbs, pvType, pvPrice, pvAtr, pvTie)

    // ---- swing pipeline (every confirmed bar, from the maintained frontier) ----
    array<SwingRec> swings = f_detectSwings(wHigh, wLow, wOpenT, wAvailT, wAtr, pvAbs, pvType, pvPrice, pvAtr, pvTie, absFirst)

    // Latest confirmed of each direction. The list is append-ordered, so the last
    // entry of each type wins; scanning backwards lets us stop as soon as both
    // directions are known.
    int sc = array.size(swings)
    bool haveHigh = false
    bool haveLow = false
    int si2 = sc - 1
    while si2 >= 0 and not (haveHigh and haveLow)
        SwingRec s = array.get(swings, si2)
        if s.swingType == SWING_HIGH
            if not haveHigh
                latestSwingHighPrice := s.price
                latestSwingHighTime := s.pivotEndTime
                haveHigh := true
        else
            if not haveLow
                latestSwingLowPrice := s.price
                latestSwingLowTime := s.pivotEndTime
                haveLow := true
        si2 -= 1

    // ---- swing-set fingerprint (needed by BOTH gates below) ----
    // P1-PERF-1: (count, last confirmation time) alone could not see a change
    // confined to the MIDDLE of the list — which the window's left edge can cause,
    // because the alternation chain is re-seeded at that edge on every bar. The
    // fingerprint below is an order-sensitive rolling accumulator over EVERY
    // member, so a same-length reshuffle is detected too. It is O(S) and cheap,
    // and it can only ever trigger MORE recomputation than before, never less.
    int newCount = sc
    int newConfTime = sc > 0 ? array.get(swings, sc - 1).meaningfulConfTime : na
    int newFingerprint = 0
    for [k, _u797] in swings
        SwingRec sf = array.get(swings, k)
        newFingerprint := (newFingerprint * 31 + sf.swingType + sf.meaningfulConfTime % 1000000 + k) % 1000000007
    bool changed = na(lastSwingCount) or newCount != lastSwingCount or newConfTime != lastSwingConfTime or newFingerprint != lastSwingFingerprint

    // ---- SUPPORT / RESISTANCE — advanced on EVERY confirmed bar ----
    //
    // P1-CLOSEOUT (C1): S/R must NOT sit behind the swing-set change gate. Its
    // reaction search runs forward to the end of the available candles
    // (support_resistance.py:80 `for index in range(search_start_index, n)`), so a
    // reaction can first satisfy its gate on a candle that introduces NO new
    // swing. The Python incremental analyzer states this explicitly at
    // analyzer.py:923 — "Must run every candle (not only when confirmed_swings
    // changes): a reaction's bounded window can newly resolve purely from candle
    // growth with no new swing involved." Gating S/R on the swing fingerprint
    // therefore DELAYED a real state transition until the next swing mutation.
    //
    // Equal levels and trendlines are NOT exposed to this: both are pure
    // functions of the confirmed-swing set (a trendline's confirmation comes from
    // a touch SWING, not from a bar), so they stay behind the gate.
    //
    // P1-SR-PERF-2: recomputing the whole detector here every bar was correct but
    // put the script back on the Basic 20s boundary. The reaction frontier below
    // keeps the timing and removes the rescan.

    // (a) retire trackers whose origin has left the active window. Keys are
    //     ascending with originAbs in the high bits, so this is a prefix removal.
    int srMinKey = absFirst * C_SR_KEY_STRIDE
    while array.size(srKeys) > 0 and array.get(srKeys, 0) < srMinKey
        array.shift(srKeys)
        array.shift(srTrk)

    // (b) the ONLY unconditional per-bar S/R work: advance unresolved trackers.
    //     Permanent ones are skipped outright. A tracker whose resolution moves
    //     names its origin via SRTracker.originAbs, which is what P1-SR-PERF-3
    //     uses to re-run exactly that one fold instead of all of them.
    bool srTrackerChanged = false
    array.clear(srDirty)
    for [ti, _u940] in srKeys
        SRTracker before = array.get(srTrk, ti)
        if not before.permanent
            SRTracker after = f_advanceSRTracker(before, wHigh, wLow, wOpen, wClose, wAtr, wAvailT, absFirst)
            array.set(srTrk, ti, after)
            bool resolutionMoved = na(after.confirmingAbs) != na(before.confirmingAbs)
            if not resolutionMoved and not na(after.confirmingAbs)
                resolutionMoved := after.confirmingAbs != before.confirmingAbs
            if resolutionMoved
                srTrackerChanged := true
                int dirtyOrigin = before.originAbs
                bool alreadyDirty = false
                for [dd, _u941] in srDirty
                    if array.get(srDirty, dd) == dirtyOrigin
                        alreadyDirty := true
                        break
                if not alreadyDirty
                    array.push(srDirty, dirtyOrigin)
            else if after.permanent != before.permanent
                srTrackerChanged := true

    // (c) P1-SR-PERF-3: a swing change rebuilds the orientation candidate lists
    //     and retires only the folds the delta can reach. The delta must run
    //     BEFORE the rebuild, because it compares the previous snapshot against
    //     the live swing set.
    if changed or not srSeeded
        f_srApplyDelta(swings, srSnap, srFold, srFoldKeep)
        f_srRebuildCandidates(swings, absFirst, srCandSupport, srCandResist, srOppSupport, srOppResist, srSnap)

    // (d) the walk's output is a pure function of (swing set, tracker
    //     resolutions), so re-run it only when one of those actually moved — and
    //     inside it, only the folds those changes actually reach.
    if not srSeeded or srTrackerChanged or changed
        srSeeded := true
        array<SRRec> srFresh = f_walkSR(wHigh, wLow, wOpen, wClose, wAtr, wAvailT, srCandSupport, srCandResist, srOppSupport, srOppResist, srFold, srDirty, srKeys, srTrk, absFirst)
        array.clear(srCached)
        for [fi, _u950] in srFresh
            array.push(srCached, array.get(srFresh, fi))

    // srCached is in Python's canonical order (ascending confirmationTime,
    // stable), so its LAST element is the most recently confirmed zone — which
    // is what this parity scalar means.
    array<SRRec> srs = srCached
    latestSRTop := na
    latestSRBottom := na
    latestSRType := na
    if array.size(srs) > 0
        SRRec srLast = array.get(srs, array.size(srs) - 1)
        latestSRTop := srLast.zoneTop
        latestSRBottom := srLast.zoneBottom
        latestSRType := srLast.zoneType

    // Debug-only: gate the DRAWING on whether the zone set actually changed, so
    // that analytical progression never becomes a per-bar clear-and-redraw.
    int newSRFingerprint = 0
    for [k2, _u898] in srs
        SRRec srf = array.get(srs, k2)
        newSRFingerprint := (newSRFingerprint * 31 + srf.zoneType + srf.confirmationTime % 1000000 + srf.touchCount + k2) % 1000000007
    bool srChanged = na(lastSRFingerprint) or newSRFingerprint != lastSRFingerprint
    lastSRFingerprint := newSRFingerprint

    // ---- recompute SWING-DERIVED detectors only when the swing set changes ----
    if changed
        lastSwingCount := newCount
        lastSwingConfTime := newConfTime
        lastSwingFingerprint := newFingerprint

        // EQUAL LEVELS
        array<EqualLevelRec> eqs = f_detectEqualLevels(swings)
        latestEqualHigh := na
        latestEqualLow := na
        for [k, _u818] in eqs
            EqualLevelRec e = array.get(eqs, k)
            if e.clusterType == SWING_HIGH
                latestEqualHigh := e.representativePrice
            else
                latestEqualLow := e.representativePrice

        // TRENDLINES
        array<TrendlineRec> tls = f_detectTrendlines(wClose, wAtr, swings, scTlAtr)
        latestTLNormSlope := na
        latestTLOrient := na
        if array.size(tls) > 0
            TrendlineRec tl = array.get(tls, array.size(tls) - 1)
            latestTLNormSlope := tl.normalizedSlope
            latestTLOrient := tl.orientation

        // ---- bounded debug drawings (only on change; each family capped) ----
        if debugMode and showSwings
            f_clearLabels(swingLabelObjs)
            int startK = math.max(0, array.size(swings) - maxDrawPerFamily)
            for [k, _u849] in swings
                if k < startK
                    continue
                SwingRec s = array.get(swings, k)
                bool isHigh = s.swingType == SWING_HIGH
                label lb = label.new(x = s.pivotEndTime, y = s.price, xloc = xloc.bar_time, style = isHigh ? label.style_label_down : label.style_label_up, color = isHigh ? color.new(color.teal, 20) : color.new(color.maroon, 20), textcolor = color.white, size = size.tiny, text = isHigh ? "SH" : "SL")
                array.push(swingLabelObjs, lb)
        if debugMode and showEqualLevels
            f_clearLines(eqLineObjs)
            int startK = math.max(0, array.size(eqs) - maxDrawPerFamily)
            for [k, _u857] in eqs
                if k < startK
                    continue
                EqualLevelRec e = array.get(eqs, k)
                line ln = line.new(x1 = e.firstTime, y1 = e.representativePrice, x2 = e.confirmationTime, y2 = e.representativePrice, xloc = xloc.bar_time, color = e.clusterType == SWING_HIGH ? color.orange : color.blue, style = line.style_dotted, width = 1)
                array.push(eqLineObjs, ln)
        if debugMode and showTrendlines
            f_clearLines(tlLineObjs)
            int startK = math.max(0, array.size(tls) - maxDrawPerFamily)
            for [k, _u871] in tls
                if k < startK
                    continue
                TrendlineRec tl = array.get(tls, k)
                line ln = line.new(x1 = tl.anchor1Time, y1 = tl.anchor1Price, x2 = tl.anchor2Time, y2 = tl.anchor2Price, xloc = xloc.bar_time, color = tl.orientation == SWING_LOW ? color.green : color.red, style = line.style_solid, width = 1)
                array.push(tlLineObjs, ln)

    // S/R drawings sit OUTSIDE the swing-change gate because the zone set now
    // advances on candle growth alone; they are redrawn only when that set
    // actually changed, and stay capped per family.
    if debugMode and showSR and srChanged
        f_clearBoxes(srBoxObjs)
        int startSR = math.max(0, array.size(srs) - maxDrawPerFamily)
        for [k, _u1030] in srs
            if k < startSR
                continue
            SRRec srd = array.get(srs, k)
            box bx = box.new(left = srd.confirmationTime, top = srd.zoneTop, right = time_close, bottom = srd.zoneBottom, xloc = xloc.bar_time, border_color = srd.zoneType == SWING_LOW ? color.green : color.red, bgcolor = color.new(srd.zoneType == SWING_LOW ? color.green : color.red, 88))
            array.push(srBoxObjs, bx)

// P1-PERF-4A — HISTORY GUARD: CAPACITY *and* WARM-UP.
//
// These are two different questions and PERF-4 answered only the second:
//
//   CAPACITY — does the dataset TradingView actually handed this script contain
//              the approved execution horizon at all? A user who lowers the
//              generated "Calculated bars" input, or a symbol with a short
//              history, silently shrinks the run. Answered from dataset
//              metadata in O(1); no scan, no state.
//
//   WARM-UP  — has THIS bar accumulated enough causal history INSIDE that
//              dataset for its own 300-bar window to carry an exact ATR?
//              Answered from confirmedBarCount.
//
// last_bar_index is documented as one less than the total number of bars
// available to the script, so the accessible count is last_bar_index + 1 =
// min(chart bars, "Calculated bars"). Both terms are monotonically
// non-decreasing while the script runs: a newly opened realtime bar can only
// add to the chart, and the cap is fixed for the run. An open realtime bar can
// therefore never push the count BELOW what the historical pass saw, so no
// downward tolerance is needed here and none is applied — 1799 accessible bars
// must fail, because 1800 is the validated product horizon.
//
// FAIL CLOSED. Insufficient history is not a reason to publish a partially
// validated answer computed from whatever happens to exist; that answer sits
// outside the validated P1 history contract. All nine outputs go na and the
// debug table says so, without guessing which of the two causes applied.
//
// Publication guard only: no analytical rule, no stored state and no
// confirmed-bar boundary is affected, and last_bar_index is used NOWHERE else.
int  p1DatasetBars = last_bar_index + 1
bool p1CapacityOk  = p1DatasetBars >= C_P1_CALC_BARS
bool p1WarmupOk    = confirmedBarCount >= C_P1_MIN_CALC_BARS
bool p1HistoryOk   = p1CapacityOk and p1WarmupOk

// -----------------------------------------------------------------------------
// DISPLACEMENT MARKER (per-bar shape; drawn on the confirmed bar only).
// -----------------------------------------------------------------------------
bool dispFastNow = p1HistoryOk and barstate.isconfirmed and debugMode and showDisplacement and not na(latestDispCode) and math.abs(latestDispCode) >= 1
plotshape(dispFastNow and latestDispCode > 0, title = "Displacement up", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.tiny)
plotshape(dispFastNow and latestDispCode < 0, title = "Displacement down", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.tiny)

// =============================================================================
// PARITY INTERFACE — machine-readable latest-state values (Data Window) + table.
// =============================================================================
plot(p1HistoryOk ? latestSwingHighPrice : na, "P1_swing_high_price", color = color.teal,   display = display.data_window)
plot(p1HistoryOk ? latestSwingLowPrice  : na, "P1_swing_low_price",  color = color.maroon, display = display.data_window)
plot(p1HistoryOk ? latestDispCode       : na, "P1_disp_code",        color = color.gray,   display = display.data_window)
plot(p1HistoryOk ? latestDispRatio      : na, "P1_disp_ratio",       color = color.gray,   display = display.data_window)
plot(p1HistoryOk ? latestEqualHigh      : na, "P1_equal_high",       color = color.orange, display = display.data_window)
plot(p1HistoryOk ? latestEqualLow       : na, "P1_equal_low",        color = color.blue,   display = display.data_window)
plot(p1HistoryOk ? latestSRTop          : na, "P1_sr_top",           color = color.green,  display = display.data_window)
plot(p1HistoryOk ? latestSRBottom       : na, "P1_sr_bottom",        color = color.red,    display = display.data_window)
plot(p1HistoryOk ? latestTLNormSlope    : na, "P1_tl_norm_slope",    color = color.purple, display = display.data_window)

f_row(table t, int r, string k, string v) =>
    table.cell(t, 0, r, k, text_size = size.tiny, text_halign = text.align_left, text_color = color.gray)
    table.cell(t, 1, r, v, text_size = size.tiny, text_halign = text.align_right, text_color = color.white)

// P1-PERF-1: the parity table is development instrumentation. Declaring it here
// (inside the guarded branch) means no table object is created at all in normal
// client-style mode.
if barstate.islast and debugMode
    var table dbg = table.new(position.top_right, 2, 11, border_width = 1)
    f_row(dbg, 0, "P1 DEV — latest confirmed", "")
    f_row(dbg, 1, "Swing High", na(latestSwingHighPrice) ? "-" : str.tostring(latestSwingHighPrice, format.mintick))
    f_row(dbg, 2, "Swing Low",  na(latestSwingLowPrice)  ? "-" : str.tostring(latestSwingLowPrice, format.mintick))
    f_row(dbg, 3, "Disp code",  na(latestDispCode)  ? "-" : str.tostring(latestDispCode))
    f_row(dbg, 4, "Disp ratio", na(latestDispRatio) ? "-" : str.tostring(latestDispRatio, "#.###"))
    f_row(dbg, 5, "Equal High", na(latestEqualHigh) ? "-" : str.tostring(latestEqualHigh, format.mintick))
    f_row(dbg, 6, "Equal Low",  na(latestEqualLow)  ? "-" : str.tostring(latestEqualLow, format.mintick))
    f_row(dbg, 7, "SR top",     na(latestSRTop)     ? "-" : str.tostring(latestSRTop, format.mintick))
    f_row(dbg, 8, "SR bottom",  na(latestSRBottom)  ? "-" : str.tostring(latestSRBottom, format.mintick))
    f_row(dbg, 9, "TL n-slope", na(latestTLNormSlope) ? "-" : str.tostring(latestTLNormSlope, "#.###"))
    f_row(dbg, 10, "Calc history", p1HistoryOk ? str.tostring(p1DatasetBars) + " bars, warm " + str.tostring(confirmedBarCount) + " OK" : "INSUFFICIENT CALCULATED HISTORY (dataset " + str.tostring(p1DatasetBars) + "/" + str.tostring(C_P1_CALC_BARS) + ", warm " + str.tostring(confirmedBarCount) + "/" + str.tostring(C_P1_MIN_CALC_BARS) + ")")

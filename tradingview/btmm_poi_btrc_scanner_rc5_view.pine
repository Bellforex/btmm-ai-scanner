//@version=6
import bellcare1994/bah_pine_ui_helpers/1 as bahui

// =============================================================================
// BTMM + POI + BTRC Scanner  [P1 DEV]
// -----------------------------------------------------------------------------
// PHASE P1 — MEASUREMENTS PORT (development / parity indicator, NOT a product).
//
// This is an ANALYTICAL indicator. It contains NO order execution, NO
// entries/SL/TP, NO strategy.* calls. It ports the VALIDATED Python scanner
// measurement layer (the authoritative semantic reference) onto Pine v6, on the
// CURRENT chart feed and timeframe only. Multi-timeframe orchestration, canonical
// FXCM mode, market structure (BOS/CHOCH), POI, BTMM and BTRC all belong to later
// phases and are intentionally absent here.
//
// Semantic source of truth (byte-cited in docs/architecture/
// BTRC_V1_P1_PINE_MEASUREMENTS_PORT.md):
//   measurements/candle_metrics.py   — candle metrics + range_speed_ratio
//   measurements/atr.py              — Wilder ATR (incremental image ported)
//   measurements/legs.py             — measure_leg
//   domain/swings.py                 — detect_confirmed_swings (full pipeline)
//   domain/displacement.py           — detect_displacement_observations
//   domain/equal_levels.py           — detect_equal_level_clusters
//   domain/support_resistance.py     — detect_support_resistance_zones
//   domain/trendlines.py             — detect_trendlines
//   domain/configuration.py          — MarketMeasurementConfiguration (defaults)
//   contracts/normalized_candle.py + historical_backtest/csv_parser.py
//                                    — availability = close of the bar
//
// NON-REPAINT CONTRACT: every confirmed analytical record is produced ONLY on a
// CONFIRMED/CLOSED bar (barstate.isconfirmed). The forming realtime bar never
// mutates confirmed state. No future indexing, no lookahead, no request.security.
//
// GOVERNING RULE: data structures are adapted (Python UUIDs -> semantic time/price
// anchors; Python dicts -> Pine arrays/UDTs; unbounded history -> a bounded rolling
// window). Analytical MEANING (swing definition, confirmation timing, tolerances,
// displacement/equal-level/zone semantics) is preserved unchanged.
// =============================================================================

// P1-PERF-4: calc_bars_count bounds the HISTORICAL EXECUTION HORIZON — the
// number of trailing bars TradingView runs the script over. It is NOT the
// analytical window (that is `lookbackWindow`, still 300) and it changes no
// analytical rule. 1800 is the validated horizon; see C_P1_MIN_CALC_BARS below
// and docs/architecture/BTRC_V1_P1_PERFORMANCE_OPTIMIZATION.md §18.
indicator("BTMM + POI + BTRC Scanner [RC5 VIEW]", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, calc_bars_count = 1800)

// -----------------------------------------------------------------------------
// INPUTS — debug/visual controls (client defaults: conservative & clean).
// -----------------------------------------------------------------------------
grpDev = "P1 Development / Parity"
// RC3 USER: the P1/P2/P4 debug drawings, debug table and debug data-window
// plots were developer instrumentation behind Debug Mode (default off). They
// computed nothing, and their tokens now carry the ORDER BLOCK movement-origin
// gate. The capture build (btmm_poi_btrc_scanner_rc3_parity_dev.pine) keeps
// every capture stream.

// ENGINEERING-PROVISIONAL: rolling analytical window. This is a Pine practical
// retention bound (Python retains full history). Larger = more faithful to the
// batch scanner but heavier per confirmed bar. Not a strategy parameter.
lookbackWindow = input.int(300, "Analytical window (bars, provisional)", minval = 60, maxval = 1000, group = grpDev)

// ---- RC3 display layers (presentation only; no semantic value reads these) --
grpView = "Display layers"
dspMs    = input.bool(false, "Show Market Structure (BOS / CHOCH / swings)", group = grpView)
dspBtmm  = input.bool(false, "Show BTMM Cycle (markers)", tooltip = "Diamond under the bar on which a POI's BTMM pre-trade cycle (DISTRACTION / DELAY / WIPEOUT) becomes valid -- the same event as the P8 BTMM_VALIDATED alert.", group = grpView)
dspTl    = input.bool(false, "Show Trendlines", group = grpView)
dspRange = input.bool(false, "Show Consolidation / Range (high, low, midpoint)", group = grpView)
dspLiq   = input.bool(false, "Show Liquidity (BSL / SSL pools, sweeps)", group = grpView)
maxDrawPerFamily = input.int(20, "Objects drawn per layer", minval = 1, maxval = 200, group = grpView)

// ---- RC3 POI TYPE FILTERS (presentation only) ------------------------------
// One checkbox per P3 core type, all ON by default, in type-code order
// (C_POI_* 1..18), so p7zTypeOn[code - 1] is that type's switch. They only
// decide which fresh POIs are DRAWN and LISTED in the POI table; the registry,
// freshness, terminal state, P5 rows/scores/permission and P8 events never
// read them. There is no DOJI type: a Doji is only the star middle-candle test,
// and a Doji candle is never part of an engulfing / order-block formation.
grpTypes = "POI type filters"
tBuyOb = input.bool(true, "BUY ORDER BLOCK", group = grpTypes)
tSellOb = input.bool(true, "SELL ORDER BLOCK", group = grpTypes)
tBuyFvg = input.bool(true, "BUY FVG", group = grpTypes)
tSellFvg = input.bool(true, "SELL FVG", group = grpTypes)
tB2S = input.bool(true, "BUY TO SELL CANDLE (B2S)", group = grpTypes)
tS2B = input.bool(true, "SELL TO BUY CANDLE (S2B)", group = grpTypes)
tBaseRally = input.bool(true, "BASE RALLY", group = grpTypes)
tBaseDrop = input.bool(true, "BASE DROP", group = grpTypes)
tBullPw = input.bool(true, "BULLISH PRESSURE WICK", group = grpTypes)
tBearPw = input.bool(true, "BEARISH PRESSURE WICK", group = grpTypes)
tBullEng = input.bool(true, "BULLISH ENGULFING", group = grpTypes)
tBearEng = input.bool(true, "BEARISH ENGULFING", group = grpTypes)
tHammer = input.bool(true, "HAMMER", group = grpTypes)
tShootStar = input.bool(true, "SHOOTING STAR", group = grpTypes)
tMorning = input.bool(true, "MORNING STAR", group = grpTypes)
tEvening = input.bool(true, "EVENING STAR", group = grpTypes)
tSupport = input.bool(true, "SUPPORT ZONE", group = grpTypes)
tResist = input.bool(true, "RESISTANCE ZONE", group = grpTypes)
tDoji = input.bool(true, "DOJI", group = grpTypes)
p7zTypeOn = array.from(tBuyOb, tSellOb, tBuyFvg, tSellFvg, tB2S, tS2B, tBaseRally, tBaseDrop, tBullPw, tBearPw, tBullEng, tBearEng, tHammer, tShootStar, tMorning, tEvening, tSupport, tResist, false, false, false, false, false, false, false, false, false, false, false, false, false, false, tDoji)


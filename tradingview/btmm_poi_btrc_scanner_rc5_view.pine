float C_LEG_FAST_EFF                  = 0.60     // configuration.py:56
float C_LEG_FAST_SHARE                = 0.67     // configuration.py:57
float C_LEG_STRONG_SPEED              = 0.75     // configuration.py:58
float C_LEG_STRONG_EFF                = 0.75     // configuration.py:59
float C_LEG_STRONG_SHARE              = 0.80     // configuration.py:60

// Swing type codes (Python SwingType). Displacement classification codes.
int SWING_HIGH = 1
int SWING_LOW  = -1

// =============================================================================
// P2-I1 — STRUCTURE CODES (structure/enums.py)
// -----------------------------------------------------------------------------
// Integer codes for the three Python StrEnums. Pine has no string enums, so each
// member gets a stable named constant; nothing here is behaviour.
//
// The enums are CLOSED. structure/enums.py defines exactly these members, so
// there is deliberately no RANGE, NEUTRAL, MSS, internal/external or major/minor
// code — inventing one would fabricate a state the Python contract cannot emit.
//
// C_ST_NA is the unset sentinel. It is -99, not 0 and not na: 0 is a live
// direction code (UNDETERMINED) and Pine `int x = na` degrades to `const int`,
// which cannot be reassigned (the defect that broke the first forensic probe).
int C_ST_NA = -99

// StructureDirection
int C_ST_DIR_UNDETERMINED = 0
int C_ST_DIR_BULLISH      = 1
int C_ST_DIR_BEARISH      = -1

// SwingRelationshipLabel — sign carries the relation, magnitude the side, so
// `code > 0` is HIGHER and `abs(code) == 1` is the high side.
int C_ST_REL_HIGHER_HIGH = 1
int C_ST_REL_LOWER_HIGH  = -1
int C_ST_REL_EQUAL_HIGH  = 10
int C_ST_REL_HIGHER_LOW  = 2
int C_ST_REL_LOWER_LOW   = -2
int C_ST_REL_EQUAL_LOW   = 20

// StructureTransitionType
int C_ST_TR_BULLISH_BOS   = 1
int C_ST_TR_BEARISH_BOS   = -1
int C_ST_TR_BULLISH_CHOCH = 2
int C_ST_TR_BEARISH_CHOCH = -2

// StructureConfiguration.swing_relationship_equal_tolerance_atr_multiplier
// (structure/configuration.py:10). Author-approved by reuse from the 1B-H
// equal-level tolerance; it is the ONLY numeric threshold the Structure
// milestone owns. Named rather than inlined so the multiplier never appears as
// an anonymous 0.10 literal in the classifier.
float C_ST_REL_EQUAL_TOL_ATR = 0.10

// -----------------------------------------------------------------------------
// P1-PERF-4 — BOUNDED HISTORICAL EXECUTION
//
// The engine reads history through exactly one channel that outlives the
// analytical window: the incremental Wilder ATR in `wAtr`. Everything else a
// bar reads (candles, pivots, swings, trackers, folds) is pruned to
// `lookbackWindow`. So a truncated execution differs from a full-history one
// only while its ATR still remembers its own seed.
//
// Wilder ATR is an IIR filter: a seed discrepancy decays by (P-1)/P per bar.
// The largest warm-up measured before the truncated series became IDENTICAL to
// the full-history series was 920 bars on canonical FXCM data and 945 bars on
// adversarial fixtures that deliberately distort the seed.
//
//   C_P1_MIN_CALC_BARS = lookbackWindow + warm-up = 300 + 950 = 1250
//     A bar is analytically valid once the engine has processed this many
//     confirmed bars, because only then is the ATR exact at the LEFT EDGE of
//     that bar's 300-bar window.
//
//   C_P1_CALC_BARS = 1800 (also the calc_bars_count in the declaration above)
//     The selected execution horizon AND the required dataset capacity. Makes
//     the earliest of the last 300 bars valid with 251 bars to spare, while
//     cutting D1 historical execution by roughly two thirds.
//
// Three numbers that are easy to confuse, so state them plainly:
//
//   300  = the analytical rolling window (`lookbackWindow`).
//   1250 = the per-bar warm-up floor INSIDE an adequately sized run.
//   1800 = the dataset capacity the product requires, and the default the
//          declaration asks TradingView for.
//
// 1250 is deliberately NOT the minimum allowed "Calculated bars" setting. It is
// the point at which an individual bar inside a full-size run becomes exact; it
// says nothing about whether the validated horizon is present at all. A 1300-bar
// run would contain a few warm bars and still be outside the validated contract,
// so P1-PERF-4A checks capacity against 1800 and warm-up against 1250, and
// publishes only when both hold.
int C_P1_CALC_BARS     = 1800
int C_P1_MIN_CALC_BARS = 1250

// =============================================================================
// USER-DEFINED TYPES — minimal analytical records (semantic content only; no UUID).
// =============================================================================
type SwingRec
    int   swingType            // SWING_HIGH / SWING_LOW
    float price                // pivot_price
    int   pivotStartIdx        // window index of pivot start
    int   pivotEndIdx          // window index of pivot end (= last pivot candle)
    int   pivotEndTime         // event/open time of pivot end candle (anchor)
    int   localConfTime        // local_confirmation_time (availability of end+radius bar)
    int   meaningfulConfTime   // meaningful_confirmation_time (availability of reversal bar)
    float referenceAtr         // pivot_reference_atr
    float tieTolerance         // pivot_tie_tolerance
    float reversalThreshold    // reversal_threshold
    float reversalExcursion    // reversal_excursion

type EqualLevelRec
    int   clusterType          // SWING_HIGH => EQUAL_HIGH, SWING_LOW => EQUAL_LOW
    float zoneBottom
    float zoneTop
    float representativePrice
    float clusterSpread
    float equalityTolerance
    int   memberCount
    int   firstTime            // earliest member meaningful confirmation time
    int   confirmationTime     // max member meaningful confirmation time

type SRRec
    int   zoneType             // SWING_LOW origin => SUPPORT, SWING_HIGH origin => RESISTANCE
    float zoneTop
    float zoneBottom
    float zoneDepth
    int   touchCount
    int   confirmationTime     // availability of first confirming candle
    int   originPivotEndTime   // RC3: origin swing's pivot-end candle == the zone's SOURCE instant

type SRCand
    int   key                  // pivotEndTime — the stable semantic swing identity
    int   swingType
    float price
    float referenceAtr         // carried directly; never re-derived from zoneDepth
    int   meaningfulConfTime
    int   pivotEndAbs          // ABSOLUTE pivot-end index, so a window shift cannot stale it

type SRFold
    int   originKey            // SRCand.key of this fold's origin; the cache is ascending on it
    int   originAbs            // absolute pivot-end index, matched against the dirty set
    int   originType
    float zoneTop
    float zoneBottom
    float referenceAtr         // authoritative value, stored not reconstructed
    float zoneDepth
    bool  hasZone              // false = "cached: this origin publishes nothing"
    int   touchCount
    int   confirmationTime

type SRTracker
    int   originAbs            // absolute index of the origin swing's pivot-end candle
    int   searchStartAbs       // absolute index of the first candle this reaction may use
    float zoneTop
    float zoneBottom
    bool  isSupport
    int   lastCheckedAbs       // highest absolute index already examined for a reaction start
    int   reactionStartAbs     // na until the first qualifying close is found
    float anchor               // running min(low) / max(high) from searchStartAbs
    bool  permanent            // the bounded window is full; nothing can change it now
    int   confirmingAbs        // na unless the reaction currently qualifies
    int   confirmingTime       // availability time of the confirming candle

type TrendlineRec
    int   orientation          // SWING_LOW anchors => BULLISH, SWING_HIGH anchors => BEARISH
    float anchor1Price
    float anchor2Price
    int   anchor1Time
    int   anchor2Time
    float rawSlope             // price per bar
    float normalizedSlope
    int   confirmationTime

// =============================================================================
// P2-I1 — STRUCTURE RECORDS (structure/relationships.py, structure/transitions.py)
// -----------------------------------------------------------------------------
// Declarations only. No P2 behaviour exists yet: nothing constructs a
// StructRelRec or a StructEventRec, and no analytical value reads one.
// =============================================================================

// Adapter-facing projection of ONE canonical P1 confirmed swing. Every field is
// either copied straight from SwingRec or derived from it plus the live window —
// nothing is re-detected, so this cannot become a second source of truth.
//
// Python counterpart: domain.swings.ConfirmedSwing, restricted to the fields
// structure/ actually consumes.
type StructSwingView
    int   stableKey            // == SwingRec.pivotEndTime; P1's own swing identity
    int   swingType            // SWING_HIGH / SWING_LOW  <- SwingRec.swingType
    float pivotPrice           // <- SwingRec.price            (pivot_price)
    float referenceAtr         // <- SwingRec.referenceAtr     (pivot_reference_atr)
    int   meaningfulConfTime   // <- SwingRec.meaningfulConfTime; also the swing's
                               //    availability_time_utc (domain/analyzer.py:318
                               //    assigns availability FROM meaningful confirmation)
    int   pivotStartTime       // <- wOpenT[pivotStartIdx]     (pivot_start_time_utc)
    int   pivotStartAbs        // <- absFirst + pivotStartIdx  (pivot_bar_index)

// A swing-to-predecessor relationship. Python: relationships.SwingRelationship.
type StructRelRec
    int   swingKey             // current swing's stableKey
    int   previousSameTypeKey  // predecessor of the SAME type
    int   relationshipCode     // C_ST_REL_*
    int   availabilityTime     // max(current, predecessor) availability
    int   currentPivotStartAbs // P2-I4 ordering key. Python's merged event sort
                               // breaks relationship ties on the CURRENT swing's
                               // pivot_bar_index (transitions.py:127-130), so the
                               // record must carry it. Published relationship
                               // order does NOT carry it — see f_p2OrderRelationships.

// An emitted BOS / CHOCH. Python: transitions.StructureTransition.
type StructEventRec
    int   transitionCode       // C_ST_TR_*
    int   brokenSwingKey
    float brokenLevel
    float breakClose
    int   breakTime            // break candle event_time_utc
    int   availabilityTime     // max(break candle, broken swing) availability
    int   protectedSwingKey    // P2-I5. Python publishes protected_swing_id on
                               // every StructureTransition (transitions.py:36);
                               // it is the post-break protected level and is not
                               // derivable from the other fields on this record.

// =============================================================================
// PRIMITIVE HELPERS — measurements/candle_metrics.py
// =============================================================================
// Median of an ALREADY ascending-sorted array. O(1). Same value as f_median for
// the same multiset — the median depends only on the multiset, not on how it was
// ordered — so a caller that maintains sorted order incrementally may use this.
// P1-PERF-1: median that CONSUMES its argument — it sorts in place instead of
// allocating a copy. Every call site builds a fresh (or scratch) array and never
// reads it again afterwards, so consuming it is safe and removes one array
// allocation plus one full copy from every median in the hot path. The returned
// value is identical to the previous copy-then-sort implementation.
f_medianConsume(array<float> vals) =>
    array.sort(vals, order.ascending)
    bahui.medianOfSorted(vals)

// median of total_range over window slice [startIncl, endExcl)  (median_total_range)
// P1-PERF-1: writes into a caller-owned scratch array instead of allocating.
f_medianRange(array<float> highs, array<float> lows, int startIncl, int endExcl, array<float> scratch) =>
    array.clear(scratch)
    if endExcl > startIncl and startIncl >= 0 and endExcl <= array.size(highs)
        for i = startIncl to endExcl - 1
            array.push(scratch, array.get(highs, i) - array.get(lows, i))
    f_medianConsume(scratch)

// =============================================================================
// ROLLING WINDOW STATE — confirmed candles + exact incremental Wilder ATR.
// atr.py: true_range uses previous close; seed = mean of first `period` TRs at
// index period-1 (na before); Wilder recurrence thereafter. This mirrors
// advance_incremental_atr (append-stable, exact image of compute_atr_series).
// =============================================================================
var array<float> wHigh   = array.new<float>()
var array<float> wLow    = array.new<float>()
var array<float> wOpen   = array.new<float>()
var array<float> wClose  = array.new<float>()
var array<int>   wOpenT  = array.new<int>()   // bar open time (event_time_utc analogue)
var array<int>   wAvailT = array.new<int>()   // availability time = bar close time
var array<float> wAtr    = array.new<float>() // ATR at this candle (na during warm-up)

// Incremental ATR carry state (var; advances only on confirmed bars).
var float atrPrevClose = na
var float atrWarmSum   = 0.0
var int   atrWarmCount = 0
var float atrPrevFinal = na

// -----------------------------------------------------------------------------
// P1-PERF-1 — SINGLE-CANDLE PIVOT FRONTIER (persistent, absolute-indexed).
//
// _find_single_candle_pivots tests every window index in [R, n-R-1]. That test
// reads only highs/lows/atr[idx-R .. idx+R], so a bar's pivot status is FINAL as
// soon as it has R closed bars to its right and can never change afterwards.
// Re-deriving the whole window on every confirmed bar therefore recomputed an
// identical answer O(W) times. Instead we decide exactly ONE new candle per
// confirmed bar (the bar at window index n-1-R) and retire entries that have
// fallen out of the batch's scan range.
//
// Pivots are stored by ABSOLUTE confirmed-bar index so that a window shift does
// not invalidate them; f_detectSwings converts to window indices on read. The
// resulting pivot multiset is identical to the batch scan (proof in
// docs/architecture/BTRC_V1_P1_PERFORMANCE_OPTIMIZATION.md).
// -----------------------------------------------------------------------------
var int confirmedBarCount = 0                 // absolute count of confirmed bars seen
var array<int>   pvAbs   = array.new<int>()   // absolute index of the pivot candle
var array<int>   pvType  = array.new<int>()
var array<float> pvPrice = array.new<float>()
var array<float> pvAtr   = array.new<float>()
var array<float> pvTie   = array.new<float>()

// -----------------------------------------------------------------------------
// P1-SR-PERF-2 — persistent S/R reaction frontier state.
//
// srKeys is kept ASCENDING and packs originAbs into the high bits, so retiring
// every tracker whose origin has left the active window is a prefix removal.
// srTrk is parallel to it. srCached holds the last walk result so that a bar
// which changes neither the swing set nor any tracker resolution costs nothing
// beyond the tracker advances.
// -----------------------------------------------------------------------------
var array<int>       srKeys   = array.new<int>()
var array<SRTracker> srTrk    = array.new<SRTracker>()
var array<SRRec>     srCached = array.new<SRRec>()
var bool             srSeeded = false

// -----------------------------------------------------------------------------
// P1-SR-PERF-3 — semantic pair/fold frontier state.
//
// Measured on canonical FXCM M1/M5/M15 (900-bar replays, lookback 300): the walk
// performed ~650-680 origin x touch visits for every genuinely NEW semantic pair,
// so almost all of it re-derived relationships that had not changed. Caching each
// origin's fold and invalidating it from the swing DELTA removed ~60% of that
// work with byte-identical output, proven at every prefix against the production
// Python oracle (tests/unit/test_pine_p1_sr_frontier_model.py).
//
// srCand* hold ABSOLUTE pivot indices, never window indices, so a cached
// candidate cannot go stale when the 300-bar window slides. srSnap is the
// previous swing set in ascending key order, which makes the delta an O(A) merge
// (detect_confirmed_swings emits swings ascending by pivot-end time).
// -----------------------------------------------------------------------------
var array<SRCand> srCandSupport = array.new<SRCand>()   // support origins, ascending confirmation time
var array<SRCand> srCandResist  = array.new<SRCand>()   // resistance origins, ascending confirmation time
var array<int>    srOppSupport  = array.new<int>()      // HIGH confirmation times, ascending
var array<int>    srOppResist   = array.new<int>()      // LOW  confirmation times, ascending
var array<SRCand> srSnap        = array.new<SRCand>()   // previous swing set, ascending key
var array<SRFold> srFold        = array.new<SRFold>()   // fold cache, ascending originKey
var array<SRFold> srFoldKeep    = array.new<SRFold>()   // reusable survivor buffer for retirement
var array<int>    srDirty       = array.new<int>()      // origin ABS indices whose reaction moved

// Reusable scratch buffers (P1-PERF-1): avoid per-call array allocation in the
// hot path. Each is cleared by its owner before use and is never aliased across
// two live users at the same time.
var array<float> scDispRange = array.new<float>()   // f_medianRange, displacement
var array<float> scTlAtr     = array.new<float>()   // trendline anchor-slice ATRs (kept sorted)

f_trueRange(float h, float l, float prevClose) =>
    float hl = h - l
    na(prevClose) ? hl : math.max(hl, math.abs(h - prevClose), math.abs(l - prevClose))

// Persistent "latest confirmed" summaries for the parity interface.
var float latestSwingHighPrice = na
var int   latestSwingHighTime  = na
var float latestSwingLowPrice  = na
var int   latestSwingLowTime   = na
var int   latestDispCode       = na   // signed: +/-(0 normal,1 fast,2 very_fast); sign = direction
var float latestDispRatio      = na
var float latestEqualHigh      = na
var float latestEqualLow       = na
var float latestSRTop          = na
var float latestSRBottom       = na
var int   latestSRType         = na
var float latestTLNormSlope    = na
var int   latestTLOrient       = na

// ---- P2-I2 adapter observation state (diagnostic only) ----------------------
// Written by the adapter, read only by the debug-gated P2_* plots below. No
// analytical value consumes these, so they cannot influence P1 output.
var int   p2SwingCount    = na
var int   p2LastKey       = na   // retained for I4+; not plotted (budget)
var int   p2LastType      = na
var float p2LastPrice     = na   // retained for I5+; not plotted (budget)
var float p2LastAtr       = na   // retained for I5+; not plotted (budget)
var int   p2LastConfTime  = na
var int   p2LastStartAbs  = na
var int   p2RelCount      = na   // P2-I3
var int   p2LastHighRel   = na
var int   p2LastLowRel    = na
var int   p2Direction     = C_ST_NA  // P2-I4. Seeded to the sentinel, not na:
                                    // these are compared against C_ST_NA, and
                                    // `na == x` propagates na in Pine.
var int   p2ProtHighKey   = C_ST_NA
var int   p2ProtLowKey    = C_ST_NA
var int   p2WeakHighKey   = C_ST_NA
var int   p2WeakLowKey    = C_ST_NA
var int   p2TransCount    = C_ST_NA  // P2-I5
var int   p2LastTransCode = C_ST_NA
var int   p2LastBrokenKey = C_ST_NA
var float p2LastBrokenLvl = na
var int   p2WeakHighBound = C_ST_NA  // not plotted; TD-B/I6 consumes it
var int   p2WeakLowBound  = C_ST_NA
var int   p2ChochAborts   = C_ST_NA  // not plotted; CHOCH abort count

// Swing-set change detection (so SWING-DERIVED detectors run only on change).
// S/R is deliberately NOT behind this gate — see the P1-CLOSEOUT note in MAIN.
var int lastSwingCount       = na
var int lastSwingConfTime    = na
var int lastSwingFingerprint = na
// S/R zone-set fingerprint — debug-drawing gate only, never an analytical gate.
var int lastSRFingerprint    = na

// Persistent draw-object handles (bounded, redrawn on change).
var array<SwingRec> p3Swings = array.new<SwingRec>()   // this bar's P1 confirmed swings, for the OB leg-origin gate
var array<StructEventRec> p3Events = array.new<StructEventRec>()   // this bar's P2 breaks, for the OB leg-origin gate

// ---- RC4 MARKET FRAMEWORK state (framework/engine.py FrameworkTracker) -----
// Append-only: a level / range / swing is registered the first time it is
// seen and never retracted, and every confirmed candle is swept exactly once,
// so the framework never repaints. Host timeframe only (P6 stays closed).
type FwLv
    float p     // price at the anchor
    float s     // price change per bar (trendlines)
    int   a     // anchor absolute bar index
    int   d     // +1 buy-side (above price), -1 sell-side
    int   k     // known from (availability)
    int   x     // bar of a pending close-through
    int   t     // 0 swing, 1 equal level, 2 trendline, 3 range, 4 POI far edge
    string id   // RC5 G: the level's own identity, so a sweep can name it
    string src  // RC5 G: '|'-joined identities of the underlying level
    int   a1    // RC5 G: defining swing (trendline anchor 1), by pivot-end time
    int   a2    // RC5 G: trendline anchor 2
type FwEv
    int   t     // sweep availability (bar close)
    int   d
    float p
    int   o     // sweep bar open (drawing only)
    string id   // RC5 G: identity of the level that was swept
    string src  // RC5 G: its underlying level sources
    int   ty    // RC5 G: the level family
    int   a1
    int   a2
// RC5 G: one qualified reference a raw sweep hit, before deduplication.
type RcCand
    int    t
    int    d
    float  p
    int    kind
    string ref
    string src
    string lk
    string why
type FwRg
    int   c     // confirmation
    int   e     // end (na = active)
    float h
    float l
type FwSw
    int   s     // pivot start time
    int   y
    float q
type FwPoi
    int    cur  // next sweep event to read
    bool   dis  // DISTRACTION seen
    bool   swp  // approach-side sweep since availability
    float  ext  // impulse extreme since the source candle
    string txt  // table text (presentation)
    int    perm // P7 table: permission (colour)
    string row  // P7 table: the row's cells
    bool   kn   // P8: already seen
    bool   pb   // P8: previous BTMM-valid
    int    pp   // P8: previous permission
    bool   ta   // P8: terminal alerted
    bool   fd   // P5: final (terminal) row emitted
    int    scr  // P5: last weighted confluence score, for display arbitration

// RC4 USER compaction: the P7 table and the P7-Z boxes share one
// nearest-to-price ordering (repeated minimum, ties to the lower key).
// RC4 USER compaction: one record per P7-Z zone group (presentation only).
type P7zG
    float  top
    float  bot
    int    left
    bool   bull
    int    key
    string names
    bool   term
var map<string, bool> fwSeen = map.new<string, bool>()
var array<FwLv>  fwLv  = array.new<FwLv>()
var array<FwEv>  fwEv  = array.new<FwEv>()
var array<FwRg>  fwRgs = array.new<FwRg>()
var map<int, FwRg> fwRgByC = map.new<int, FwRg>()
var array<FwSw>  fwSw  = array.new<FwSw>()
var array<float> msPrevHL = array.from(float(na), float(na))   // last meaningful high, last meaningful low

// ---- RC5 G1: MEANINGFUL SWINGS -------------------------------------------
var map<int, int> rc5SwingRole = map.new<int, int>()
int C_RC5_ROLE_BROKEN    = 1
int C_RC5_ROLE_PROTECTED = 2

f_rc5SwingMeaningful(int pivotEndTime) =>
    map.contains(rc5SwingRole, pivotEndTime)

f_rc5MarkSwing(int pivotEndTime, int role) =>
    if pivotEndTime > 0 and not map.contains(rc5SwingRole, pivotEndTime)
        map.put(rc5SwingRole, pivotEndTime, role)
var array<FwPoi> fwPoi = array.new<FwPoi>()
var array<EqualLevelRec> fwEqs = array.new<EqualLevelRec>()
var array<TrendlineRec>  fwTls = array.new<TrendlineRec>()
var FwRg fwR = na
var array<line>  msLines  = array.new<line>()
var array<label> msLabels = array.new<label>()

// =============================================================================
// SWING PIPELINE — domain/swings.py (single-candle pivots -> plateau merge ->
// same-direction supersede -> alternation + meaningful-reversal confirmation).
// Parallel arrays are used instead of the Python _Pivot NamedTuple.
//
// P1-PERF-1: single-candle pivots are now maintained incrementally (one new
// candle decided per confirmed bar). Everything downstream of that — merge,
// supersede, alternation, meaningful-reversal confirmation — still runs over the
// bounded window on every confirmed bar and remains batch-faithful; it is cheap
// because it walks the pivot list (tens of entries), not the candle window.
// =============================================================================
// P1-PERF-1 — advance the single-candle pivot frontier by exactly one candle.
//
// Decides the newest candle that has just acquired C_WINDOW_RADIUS closed bars to
// its right (window index n-1-R), then retires pivots that have dropped out of
// the range the batch scan would cover. The resulting pivot set is identical to
// re-running _find_single_candle_pivots over the whole window.
f_advancePivotFrontier(array<float> highs, array<float> lows, array<float> atr, int absFirst, array<int> pAbs, array<int> pType, array<float> pPrice, array<float> pAtr, array<float> pTie) =>
    int n = array.size(highs)
    int idx = n - 1 - C_WINDOW_RADIUS
    if idx >= C_WINDOW_RADIUS
        float a = array.get(atr, idx)
        if not na(a)
            float tie = C_PIVOT_TIE_TOL_ATR * a
            float candHigh = array.get(highs, idx)
            float candLow  = array.get(lows, idx)
            bool qHigh = true
            bool qLow  = true
            for j = idx - C_WINDOW_RADIUS to idx + C_WINDOW_RADIUS
                if j != idx
                    if array.get(highs, j) > candHigh + tie
                        qHigh := false
                    if array.get(lows, j) < candLow - tie
                        qLow := false
            if qHigh and qLow
                qHigh := qHigh   // ambiguous (register 33I): emit neither
            else if qHigh
                array.push(pAbs, absFirst + idx)
                array.push(pType, SWING_HIGH)
                array.push(pPrice, candHigh)
                array.push(pAtr, a)
                array.push(pTie, tie)
            else if qLow
                array.push(pAbs, absFirst + idx)
                array.push(pType, SWING_LOW)
                array.push(pPrice, candLow)
                array.push(pAtr, a)
                array.push(pTie, tie)
    // The batch scan starts at window index C_WINDOW_RADIUS, i.e. absolute
    // absFirst + C_WINDOW_RADIUS. Anything older is outside its range.
    int minAbs = absFirst + C_WINDOW_RADIUS
    while array.size(pAbs) > 0 and array.get(pAbs, 0) < minAbs
        array.shift(pAbs)
        array.shift(pType)
        array.shift(pPrice)
        array.shift(pAtr)
        array.shift(pTie)
    array.size(pAbs)   // explicit return: live pivot count (callers may ignore it)

f_detectSwings(array<float> highs, array<float> lows, array<int> openT, array<int> availT, array<float> atr, array<int> pAbs, array<int> pType, array<float> pPrice, array<float> pAtr, array<float> pTie, int absFirst) =>
    array<SwingRec> outSwings = array.new<SwingRec>()
    int n = array.size(highs)
    int np = array.size(pAbs)
    if n >= 2 * C_WINDOW_RADIUS + 1 and np > 0
        // ---- _merge_adjacent_plateaus (swings.py:139): merge pivots of the same
        // type at consecutive indices within tie tolerance.
        //
        // P1-PERF-1: the frontier is already in ascending index order and holds at
        // most ONE pivot per candle, so two same-type pivots at consecutive
        // indices are necessarily neighbours in this list — nothing can sit
        // between them. A single ordered pass therefore produces exactly the
        // records Python's group-by-type pass produces, and emits them already
        // ordered by start index, which is what swings.py:179 sorts for. The
        // O(M^2) insertion sort is provably redundant and has been removed.
        // The two-element median is written as the mean of the pair — identical
        // by definition, without allocating a temporary array per merge.
        mType  = array.new<int>()
        mStart = array.new<int>()
        mEnd   = array.new<int>()
        mPrice = array.new<float>()
        mAtr   = array.new<float>()
        mTie   = array.new<float>()
        int gidx = 0
        while gidx < np
            int curType = array.get(pType, gidx)
            bool merged = false
            if gidx + 1 < np
                if array.get(pType, gidx + 1) == curType and array.get(pAbs, gidx + 1) == array.get(pAbs, gidx) + 1 and math.abs(array.get(pPrice, gidx + 1) - array.get(pPrice, gidx)) <= array.get(pTie, gidx)
                    float price = curType == SWING_HIGH ? math.max(array.get(pPrice, gidx), array.get(pPrice, gidx + 1)) : math.min(array.get(pPrice, gidx), array.get(pPrice, gidx + 1))
                    array.push(mType, curType)
                    array.push(mStart, array.get(pAbs, gidx) - absFirst)
                    array.push(mEnd, array.get(pAbs, gidx + 1) - absFirst)
                    array.push(mPrice, price)
                    array.push(mAtr, (array.get(pAtr, gidx) + array.get(pAtr, gidx + 1)) / 2.0)
                    array.push(mTie, array.get(pTie, gidx + 1))
                    gidx += 2
                    merged := true
            if not merged
                array.push(mType, curType)
                array.push(mStart, array.get(pAbs, gidx) - absFirst)
                array.push(mEnd, array.get(pAbs, gidx) - absFirst)
                array.push(mPrice, array.get(pPrice, gidx))
                array.push(mAtr, array.get(pAtr, gidx))
                array.push(mTie, array.get(pTie, gidx))
                gidx += 1

        // ---- _supersede_same_direction_runs (swings.py:183): keep extreme per run ----
        cType  = array.new<int>()
        cStart = array.new<int>()
        cEnd   = array.new<int>()
        cPrice = array.new<float>()
        cAtr   = array.new<float>()
        cTie   = array.new<float>()
        int runType = na
        int bestRel = na
        for [rel, _u337] in mType
            int thisType = array.get(mType, rel)
            if na(runType)
                runType := thisType
                bestRel := rel
            else if thisType != runType
                array.push(cType, array.get(mType, bestRel))
                array.push(cStart, array.get(mStart, bestRel))
                array.push(cEnd, array.get(mEnd, bestRel))
                array.push(cPrice, array.get(mPrice, bestRel))
                array.push(cAtr, array.get(mAtr, bestRel))
                array.push(cTie, array.get(mTie, bestRel))
                runType := thisType
                bestRel := rel
            else
                bool better = thisType == SWING_HIGH ? array.get(mPrice, rel) > array.get(mPrice, bestRel) : array.get(mPrice, rel) < array.get(mPrice, bestRel)
                if better
                    bestRel := rel
        if not na(bestRel)
            array.push(cType, array.get(mType, bestRel))
            array.push(cStart, array.get(mStart, bestRel))
            array.push(cEnd, array.get(mEnd, bestRel))
            array.push(cPrice, array.get(mPrice, bestRel))
            array.push(cAtr, array.get(mAtr, bestRel))
            array.push(cTie, array.get(mTie, bestRel))

        // ---- confirmation loop (swings.py:219): alternation + meaningful reversal ----
        int lastConfirmedType = na
        for [p, _u366] in cType
            int endIdx = array.get(cEnd, p)
            int localConfIdx = endIdx + C_WINDOW_RADIUS
            // swings.py:228 `pivot.swing_type == last_confirmed_type` is False while
            // last_confirmed_type is None, so the FIRST eligible pivot is never skipped.
            // Pine `!=` against an na int yields na (falsy), which would permanently
            // block that first confirmation; the na() guard restores the Python state.
            if localConfIdx < n and (na(lastConfirmedType) or array.get(cType, p) != lastConfirmedType)
                float refAtr = array.get(cAtr, p)
                float threshold = C_MEANINGFUL_REVERSAL_ATR * refAtr
                float pivotPrice = array.get(cPrice, p)
                int confIdx = na
                float excursion = 0.0
                int searchStart = localConfIdx + 1
                // P1-PERF-1: this is Python's `for j in range(search_start, n)`.
                // The previous `for [j, _] in lows` + `if j < searchStart: continue`
                // form re-walked the whole window from index 0 on every candidate
                // (~W/2 wasted iterations each) before reaching the first index it
                // could actually use. A `while` bounded at both ends visits exactly
                // the same indices in the same order, and cannot run backwards.
                if array.get(cType, p) == SWING_HIGH
                    float lowestLow = array.get(lows, localConfIdx)
                    int j = searchStart
                    while j < n
                        lowestLow := math.min(lowestLow, array.get(lows, j))
                        float exc = pivotPrice - lowestLow
                        if exc >= threshold
                            confIdx := j
                            excursion := exc
                            break
                        j += 1
                else
                    float highestHigh = array.get(highs, localConfIdx)
                    int j = searchStart
                    while j < n
                        highestHigh := math.max(highestHigh, array.get(highs, j))
                        float exc = highestHigh - pivotPrice
                        if exc >= threshold
                            confIdx := j
                            excursion := exc
                            break
                        j += 1
                if not na(confIdx)
                    SwingRec s = SwingRec.new(array.get(cType, p), pivotPrice, array.get(cStart, p), endIdx, array.get(openT, endIdx), array.get(availT, localConfIdx), array.get(availT, confIdx), refAtr, array.get(cTie, p), threshold, excursion)
                    array.push(outSwings, s)
                    lastConfirmedType := array.get(cType, p)
    outSwings

// =============================================================================
// P2-I2 — CANONICAL P1 SWING ADAPTER
// -----------------------------------------------------------------------------
// Projects the canonical confirmed-swing list onto StructSwingView. This is the
// ONLY way P2 may obtain swings: it performs no detection, applies no threshold
// and makes no ordering decision of its own.
//
// ORDERING. P1 emits `outSwings` in append order, which is ascending by
// pivotEndTime (f_srSwingHasKey binary-searches on exactly that invariant). That
// order is also what Python's validated swing stream requires, so the adapter
// maps 1:1 and NEVER sorts — re-sorting would silently redefine canonical order
// and is a semantic bug, not an optimisation.
//
// ALTERNATION. Python's _validate_swings rejects two consecutive same-type
// swings, and P1's own alternation gate guarantees the same, so the projection
// preserves alternation for free. The within-type predecessor a later phase needs
// is therefore always two positions back.
//
// pivotStartIdx is a WINDOW index and the window slides, but f_detectSwings is
// re-run over the live window on every confirmed bar, so pivotStartIdx is always
// valid against the `openT` passed here. Nothing can stale between the two.
//
// COST. O(number of live swings) per confirmed bar — tens of entries, the same
// class as the swing walk that produced them. No history traversal is added.
f_p2BuildSwingView(array<SwingRec> swings, array<int> openT, int absFirst) =>
    array<StructSwingView> out = array.new<StructSwingView>()
    int nT = array.size(openT)
    for [i, _p2a] in swings
        SwingRec s = array.get(swings, i)
        int startTime = s.pivotStartIdx >= 0 and s.pivotStartIdx < nT ? array.get(openT, s.pivotStartIdx) : s.pivotEndTime
        array.push(out, StructSwingView.new(s.pivotEndTime, s.swingType, s.price, s.referenceAtr, s.meaningfulConfTime, startTime, absFirst + s.pivotStartIdx))
    out

// =============================================================================
// P2-I3 — RELATIONSHIP CLASSIFICATION (structure/relationships.py)
// -----------------------------------------------------------------------------
// Labels ONLY. This phase does not bootstrap direction, does not select
// protected or weak levels, and emits no BOS or CHOCH.
// =============================================================================

// Pure transcription of _classify_label (relationships.py:53-79). No state, no
// mutation, no candle access.
//
//   tolerance = 0.10 * CURRENT swing's referenceAtr        <- current, not
//     predecessor, not a median, not the bar ATR (relationships.py:59-61)
//   price >  predecessor + tolerance -> HIGHER   (strict, :63)
//   price <  predecessor - tolerance -> LOWER    (strict, :69)
//   otherwise                        -> EQUAL    (:74)
//
// Because both comparisons are strict, a delta of exactly +tolerance or exactly
// -tolerance lands in the EQUAL band.
f_p2ClassifyRelationship(StructSwingView cur, StructSwingView prev) =>
    int code = C_ST_NA
    if cur.swingType == prev.swingType
        float tol = C_ST_REL_EQUAL_TOL_ATR * cur.referenceAtr
        bool isHigh = cur.swingType == SWING_HIGH
        if cur.pivotPrice > prev.pivotPrice + tol
            code := isHigh ? C_ST_REL_HIGHER_HIGH : C_ST_REL_HIGHER_LOW
        else if cur.pivotPrice < prev.pivotPrice - tol
            code := isHigh ? C_ST_REL_LOWER_HIGH : C_ST_REL_LOWER_LOW
        else
            code := isHigh ? C_ST_REL_EQUAL_HIGH : C_ST_REL_EQUAL_LOW
    code

// Transcription of detect_swing_relationships (relationships.py:82-116).
//
// ORDERING. Python filters `highs` then `lows` and appends in that order
// (:86-91), so the published tuple is ALL HIGH relationships followed by ALL LOW
// relationships — NOT chronologically interleaved. The two passes below
// reproduce that exactly; interleaving would silently change the output order.
//
// PREDECESSOR. Python compares `group[index]` to `group[index-1]` within the
// type-filtered list. This walks per type rather than assuming the predecessor
// is two positions back: alternation does make `i-2` correct today, but the
// per-type walk needs no such assumption and matches the Python shape directly.
//
// HISTORY BOUNDARY. Python classifies exactly the bounded input it is handed.
// `views` is P1's live canonical swing list, so when the window advances and the
// oldest same-type swing drops out, the new first swing of that type simply has
// no predecessor and yields no relationship — the same result Python gives for
// the same bounded input. No predecessor state is retained behind P1's window;
// retaining any would diverge from Python.
f_p2BuildRelationships(array<StructSwingView> views) =>
    array<StructRelRec> out = array.new<StructRelRec>()
    for pass = 0 to 1
        int wantType = pass == 0 ? SWING_HIGH : SWING_LOW
        int prevIdx = -1
        for [i, _p2r] in views
            StructSwingView v = array.get(views, i)
            if v.swingType == wantType
                if prevIdx >= 0
                    StructSwingView pv = array.get(views, prevIdx)
                    array.push(out, StructRelRec.new(v.stableKey, pv.stableKey, f_p2ClassifyRelationship(v, pv), math.max(v.meaningfulConfTime, pv.meaningfulConfTime), v.pivotStartAbs))
                prevIdx := i
    out

// =============================================================================
// P2-I4 — INITIAL DIRECTION BOOTSTRAP (transitions.py:355-381)
// -----------------------------------------------------------------------------
// UNDETERMINED -> BULLISH or BEARISH, once only. This phase emits NO transition,
// consumes no candle, and implements neither BOS nor CHOCH.
// =============================================================================

// Which side of the book a relationship code belongs to.
f_p2RelIsHigh(int relCode) =>
    relCode == C_ST_REL_HIGHER_HIGH or relCode == C_ST_REL_LOWER_HIGH or relCode == C_ST_REL_EQUAL_HIGH

// MERGED EVENT ORDER — the single highest-risk detail of this phase.
//
// f_p2BuildRelationships emits ALL HIGH relationships and then ALL LOW
// relationships, because that is the order detect_swing_relationships builds them
// in (relationships.py:86-91). That is an API/serialization artifact. It is NOT
// chronology, and neither Python consumer reads it as chronology:
// run_structure_walk re-sorts every event by availability (transitions.py:135) and
// analyze_structure_state re-sorts for publication (analyzer.py:346-353).
//
// Python's merged key is (availability_time, kind, tiebreak) with
// kind = _EVENT_RELATIONSHIP for all relationships, so restricted to
// relationships the effective key is
//     (availability_time_utc, current_swing.pivot_bar_index, str(record_id))
// (transitions.py:122-133). The record_id leg is UNREACHABLE in production:
// _find_single_candle_pivots emits at most one pivot per candle index and skips
// any index qualifying as both high and low (swings.py:112-114), so
// pivot_bar_index is unique across confirmed swings and (availability, index) is
// already a total order. Pine therefore reproduces the order exactly.
//
// Insertion sort over a bounded live relationship list (tens of entries), on
// integer comparisons only — deterministic and stable.
f_p2OrderRelationships(array<StructRelRec> rels) =>
    array<int> order = array.new<int>()
    for [i, _p2o] in rels
        StructRelRec r = array.get(rels, i)
        int n = array.size(order)
        int pos = n
        if n > 0
            for j = 0 to n - 1
                StructRelRec o = array.get(rels, array.get(order, j))
                bool earlier = r.availabilityTime < o.availabilityTime or (r.availabilityTime == o.availabilityTime and r.currentPivotStartAbs < o.currentPivotStartAbs)
                if earlier
                    pos := j
                    break
        if pos >= array.size(order)
            array.push(order, i)
        else
            array.insert(order, pos, i)
    order

// Transcription of the _EVENT_RELATIONSHIP branch of run_structure_walk
// (transitions.py:355-381).
//
//   latest_relationship_label[type] and latest_relationship_swing[type] are
//   overwritten UNCONDITIONALLY on every relationship event (:358-361). An EQUAL
//   therefore erases prior directional evidence for that side, and later
//   contradictory evidence replaces earlier evidence. Bootstrap is then re-tested
//   after every event while direction is still UNDETERMINED.
//
//   HH + HL -> BULLISH: protected_low = latest LOW swing, weak_high = latest HIGH
//                       swing; protected_high and weak_low stay unset (:366-373)
//   LH + LL -> BEARISH: protected_high = latest HIGH swing, weak_low = latest LOW
//                       swing; protected_low and weak_high stay unset (:374-381)
//
//   The swing that becomes protected/weak is the latest RELATIONSHIP's current
//   swing for that side, which may come from an EARLIER event than the one that
//   triggers the bootstrap.
//
//   last_change_availability is the TRIGGERING event's own availability (:373),
//   not the max of the two contributing relationships.
//
// ONCE-ONLY. The `dir == UNDETERMINED` guard means relationship evidence can
// never flip BULLISH <-> BEARISH afterwards; direction flips belong to CHOCH
// (P2-I5+). No transition is emitted here — Python appends none in this branch.
//
// BOUNDED. Rebuilt from the bounded relationship list on every confirmed bar and
// discarded; no evidence is retained behind P1's window.
// -----------------------------------------------------------------------------
// P2-I5 SUPPORT HELPERS
// -----------------------------------------------------------------------------

// Resolve a stableKey back to its index in the bounded view list. Called at most
// twice per walk (only when the bootstrap fires), so the linear scan is free.
f_p2ViewIndexByKey(array<StructSwingView> views, int key) =>
    int found = -1
    for [i, _p2v] in views
        if found < 0 and array.get(views, i).stableKey == key
            found := i
    found

// SWING_VISIBLE event order (transitions.py:109-121):
//   (meaningful_confirmation_time, pivot_bar_index, pivot_start_time, record_id)
// The record_id leg is unreachable for the same reason as in I4 (pivot_bar_index
// is unique across confirmed swings), but pivotStartTime is transcribed anyway
// because it costs nothing and keeps the key structurally identical.
f_p2OrderSwings(array<StructSwingView> views) =>
    array<int> order = array.new<int>()
    for [i, _p2s] in views
        StructSwingView v = array.get(views, i)
        int n = array.size(order)
        int pos = n
        if n > 0
            for j = 0 to n - 1
                StructSwingView o = array.get(views, array.get(order, j))
                bool earlier = v.meaningfulConfTime < o.meaningfulConfTime or (v.meaningfulConfTime == o.meaningfulConfTime and (v.pivotStartAbs < o.pivotStartAbs or (v.pivotStartAbs == o.pivotStartAbs and (v.pivotStartTime < o.pivotStartTime or (v.pivotStartTime == o.pivotStartTime and v.stableKey < o.stableKey)))))
                if earlier
                    pos := j
                    break
        if pos >= array.size(order)
            array.push(order, i)
        else
            array.insert(order, pos, i)
    order

// Transcription of _most_recent_unbroken (transitions.py:80-89).
//
//   candidates = [s for s in visible if s.record_id not in broken_ids]
//   return None if not candidates else max(
//       candidates, key=(pivot_bar_index, pivot_start_time_utc, str(record_id)))
//
// `visOrder` holds the indices of swings whose SWING_VISIBLE event has already
// fired, so the candidate set is exactly Python's visible_swings_by_type entry.
// All three key tiers are transcribed: the lower two are unreachable for valid
// production swings, but omitting them would silently bake that invariant into
// the port. Returns -1 for "no candidate" (Python's None).
f_p2MostRecentUnbroken(array<StructSwingView> views, array<int> visOrder, int wantType, array<int> brokenKeys) =>
    int best = -1
    for [_p2m, vi] in visOrder
        StructSwingView v = array.get(views, vi)
        if v.swingType == wantType and array.indexof(brokenKeys, v.stableKey) < 0
            if best < 0
                best := vi
            else
                StructSwingView b = array.get(views, best)
                bool newer = v.pivotStartAbs > b.pivotStartAbs or (v.pivotStartAbs == b.pivotStartAbs and (v.pivotStartTime > b.pivotStartTime or (v.pivotStartTime == b.pivotStartTime and v.stableKey > b.stableKey)))
                if newer
                    best := vi
    best

// =============================================================================
// P2-I4 / P2-I5 — MERGED STRUCTURE WALK
// -----------------------------------------------------------------------------
// One pass over the merged event stream, transcribing run_structure_walk
// (transitions.py:92-392) for the subset implemented so far:
//
//   I4  direction bootstrap on RELATIONSHIP events           (:355-381)
//   I5  BULLISH_BOS / BEARISH_BOS on CANDLE events           (:255-321)
//   I6  weak re-arm on SWING_VISIBLE events                  (:328-353)
//   I7  BULLISH_CHOCH / BEARISH_CHOCH on CANDLE events       (:183-253)
//
// The bounded batch-equivalent Structure walk is now semantically complete.
// What remains for a later phase is the PERSISTENT INCREMENTAL FRONTIER: this
// walk is still recomputed from the bounded window on every confirmed bar.
//
// EVENT ORDER. Python sorts every event by (availability_time, kind, tiebreak)
// with CANDLE=0 < SWING_VISIBLE=1 < RELATIONSHIP=2 (:75-77, :135). Each of the
// three streams is already sorted on its own key -- candles are chronological by
// construction, swings by f_p2OrderSwings, relationships by
// f_p2OrderRelationships -- so this is a linear 3-way merge rather than a sort of
// the combined list. Ties in availability are resolved by the kind ordinal,
// exactly as Python's tuple comparison does: the streams are tested in kind
// order and only a STRICTLY earlier time displaces the incumbent.
//
// CHOCH PRECEDENCE -- BOS SUPPRESSION ONLY, NOT CHOCH IMPLEMENTATION.
// Python evaluates CHOCH first and `continue`s past the BOS block on BOTH exits:
// the successful one (:253) and the aborting one (:190/:224). So the rule
// governing BOS emission is exactly "CHOCH predicate true => no BOS on this
// candle", with no dependence on whether the CHOCH would have succeeded. The
// guard below is that price test and nothing else: it creates no transition,
// flips no direction, consumes no swing and mutates no state. On such a candle
// this walk simply does nothing, which is incomplete relative to Python but
// never WRONG about BOS. Full CHOCH behaviour is a later phase.
f_p2StructureWalk(array<StructSwingView> views, array<StructRelRec> rels, array<int> relOrder, array<int> swingOrder, array<float> closes, array<int> availT, array<int> openT, int absFirst) =>
    int dir        = C_ST_DIR_UNDETERMINED
    int protHighIx = -1
    int protLowIx  = -1
    int weakHighIx = -1
    int weakLowIx  = -1
    int weakHighBoundaryAbs = -1
    int weakLowBoundaryAbs  = -1
    int lastChange = C_ST_NA
    int hiLabel    = C_ST_NA
    int loLabel    = C_ST_NA
    int hiSwingKey = C_ST_NA
    int loSwingKey = C_ST_NA
    int chochAborts = 0
    array<int> brokenKeys = array.new<int>()
    array<int> visOrder   = array.new<int>()
    array<StructEventRec> events = array.new<StructEventRec>()

    int ci = 0
    int si = 0
    int ri = 0
    int nc = array.size(closes)
    int ns = array.size(swingOrder)
    int nr = array.size(relOrder)
    int total = nc + ns + nr

    if total > 0
        for _p2e = 0 to total - 1
            // ---- pick the next event by (availability, kind) ----
            int pick  = -1
            int bestT = 0
            if ci < nc
                pick := 0
                bestT := array.get(availT, ci)
            if si < ns
                StructSwingView sv = array.get(views, array.get(swingOrder, si))
                if pick < 0 or sv.meaningfulConfTime < bestT
                    pick := 1
                    bestT := sv.meaningfulConfTime
            if ri < nr
                StructRelRec rr = array.get(rels, array.get(relOrder, ri))
                if pick < 0 or rr.availabilityTime < bestT
                    pick := 2
                    bestT := rr.availabilityTime

            if pick == 0
                float barClose = array.get(closes, ci)
                int   barAbs   = absFirst + ci

                // ---- P2-I7: CHOCH (transitions.py:170-175, :183-253).
                //
                // Exactly one candidate can be set, because the direction is
                // either BULLISH or BEARISH, never both. Strict, close-only:
                //   BEARISH and close > protectedHigh -> BULLISH_CHOCH
                //   BULLISH and close < protectedLow  -> BEARISH_CHOCH
                bool chochHigh = dir == C_ST_DIR_BEARISH and protHighIx >= 0 and barClose > array.get(views, protHighIx).pivotPrice
                bool chochLow  = dir == C_ST_DIR_BULLISH and protLowIx  >= 0 and barClose < array.get(views, protLowIx).pivotPrice

                if chochHigh or chochLow
                    // PRECEDENCE. Python handles CHOCH first and `continue`s past
                    // the BOS block on BOTH exits -- success (:253) and abort
                    // (:190/:224). So once the CHOCH predicate is true, BOS is
                    // never evaluated on this candle, whatever happens below.
                    // This `if` IS that precedence: there is no separate
                    // suppression path any more.
                    int chochBrokenIx = chochHigh ? protHighIx : protLowIx
                    StructSwingView chochBroken = array.get(views, chochBrokenIx)
                    int chochWant = chochHigh ? SWING_LOW : SWING_HIGH
                    // PRE-MUTATION ABORT. The replacement search happens BEFORE
                    // anything is consumed or written: Python tests the result
                    // for None and `continue`s while broken_ids, direction,
                    // protected, weak and the boundaries are all still untouched
                    // (:186-190 / :220-224). brokenKeys is deliberately NOT
                    // written above this line -- doing so would leak state on
                    // the abort path.
                    int chochReplIx = f_p2MostRecentUnbroken(views, visOrder, chochWant, brokenKeys)
                    if chochReplIx < 0
                        // ABORT: zero mutation, and BOS still skipped.
                        chochAborts := chochAborts + 1
                    else
                        array.push(brokenKeys, chochBroken.stableKey)
                        int chochAvail = math.max(array.get(availT, ci), chochBroken.meaningfulConfTime)
                        array.push(events, StructEventRec.new(chochHigh ? C_ST_TR_BULLISH_CHOCH : C_ST_TR_BEARISH_CHOCH, chochBroken.stableKey, chochBroken.pivotPrice, barClose, array.get(openT, ci), chochAvail, array.get(views, chochReplIx).stableKey))
                        // Only ONE boundary moves -- the NEW direction's weak
                        // side (:217 / :251). The opposite boundary is left
                        // exactly as it was.
                        if chochHigh
                            dir        := C_ST_DIR_BULLISH
                            protHighIx := -1
                            protLowIx  := chochReplIx
                            weakHighBoundaryAbs := barAbs
                        else
                            dir        := C_ST_DIR_BEARISH
                            protLowIx  := -1
                            protHighIx := chochReplIx
                            weakLowBoundaryAbs := barAbs
                        // BOTH weak levels clear -- unlike BOS, which clears only
                        // its own side (:215-216 / :249-250).
                        weakHighIx := -1
                        weakLowIx  := -1
                        lastChange := chochAvail
                else
                    // Strict, close-only, no tolerance (transitions.py:176-181).
                    bool bosHigh = dir == C_ST_DIR_BULLISH and weakHighIx >= 0 and barClose > array.get(views, weakHighIx).pivotPrice
                    bool bosLow  = dir == C_ST_DIR_BEARISH and weakLowIx  >= 0 and barClose < array.get(views, weakLowIx).pivotPrice
                    if bosHigh or bosLow
                        int brokenIx = bosHigh ? weakHighIx : weakLowIx
                        StructSwingView broken = array.get(views, brokenIx)
                        // Python consumes the broken swing BEFORE searching for a
                        // replacement (:260 precedes :262).
                        array.push(brokenKeys, broken.stableKey)
                        int wantType = bosHigh ? SWING_LOW : SWING_HIGH
                        int replIx   = f_p2MostRecentUnbroken(views, visOrder, wantType, brokenKeys)
                        int existing = bosHigh ? protLowIx : protHighIx
                        // DEFENSIVE FALLBACK (architecture doc 17.5a). Proven
                        // unreachable in valid production state and deliberately
                        // retained for structural parity with Python; it must not
                        // be optimised away, and no runtime assertion asserts the
                        // invariant here.
                        int newProtIx = replIx >= 0 ? replIx : existing
                        int availability = math.max(array.get(availT, ci), broken.meaningfulConfTime)
                        array.push(events, StructEventRec.new(bosHigh ? C_ST_TR_BULLISH_BOS : C_ST_TR_BEARISH_BOS, broken.stableKey, broken.pivotPrice, barClose, array.get(openT, ci), availability, newProtIx >= 0 ? array.get(views, newProtIx).stableKey : C_ST_NA))
                        if bosHigh
                            protLowIx  := newProtIx
                            weakHighIx := -1
                            weakHighBoundaryAbs := barAbs
                        else
                            protHighIx := newProtIx
                            weakLowIx  := -1
                            weakLowBoundaryAbs := barAbs
                        lastChange := availability
                ci := ci + 1

            else if pick == 1
                int vIx = array.get(swingOrder, si)
                StructSwingView vs = array.get(views, vIx)
                // Becomes eligible as a PROTECTED replacement candidate.
                array.push(visOrder, vIx)

                // ---- P2-I6: WEAK RE-ARM (transitions.py:328-353).
                //
                // Five conditions per side, and nothing else -- no price
                // relation, no relationship label, no protected-side relation:
                //   1 swing type matches the weak side
                //   2 direction matches
                //   3 the weak slot is UNSET
                //   4 pivot index STRICTLY past the boundary
                //   5 the swing is not already broken
                //
                // FIRST QUALIFYING SWING WINS -- not the newest. Condition 3
                // blocks every later candidate, so the slot fills once and is
                // never replaced; a swing passed over while the slot was
                // occupied does NOT return when it later empties. This is the
                // OPPOSITE of protected replacement, which deliberately takes
                // the NEWEST candidate, so f_p2MostRecentUnbroken must NOT be
                // used here.
                //
                // Condition 5 is defensive: a swing cannot already be broken at
                // its own SWING_VISIBLE, because broken keys always refer to
                // swings that were previously protected or weak and therefore
                // already visible. Retained deliberately (architecture 17.5a),
                // and no runtime assertion claims it cannot occur.
                //
                // ORIGIN-AGNOSTIC. This reads the boundary variables without
                // asking which transition wrote them, so when CHOCH lands it
                // will populate the same state with no change here. The boundary
                // is READ ONLY in this branch -- re-arming never moves it.
                if vs.swingType == SWING_HIGH and dir == C_ST_DIR_BULLISH and weakHighIx < 0 and vs.pivotStartAbs > weakHighBoundaryAbs and array.indexof(brokenKeys, vs.stableKey) < 0
                    weakHighIx := vIx
                    lastChange := lastChange == C_ST_NA ? vs.meaningfulConfTime : math.max(lastChange, vs.meaningfulConfTime)
                if vs.swingType == SWING_LOW and dir == C_ST_DIR_BEARISH and weakLowIx < 0 and vs.pivotStartAbs > weakLowBoundaryAbs and array.indexof(brokenKeys, vs.stableKey) < 0
                    weakLowIx := vIx
                    lastChange := lastChange == C_ST_NA ? vs.meaningfulConfTime : math.max(lastChange, vs.meaningfulConfTime)
                si := si + 1

            else
                StructRelRec r = array.get(rels, array.get(relOrder, ri))
                if f_p2RelIsHigh(r.relationshipCode)
                    hiLabel    := r.relationshipCode
                    hiSwingKey := r.swingKey
                else
                    loLabel    := r.relationshipCode
                    loSwingKey := r.swingKey
                if dir == C_ST_DIR_UNDETERMINED
                    if hiLabel == C_ST_REL_HIGHER_HIGH and loLabel == C_ST_REL_HIGHER_LOW
                        dir        := C_ST_DIR_BULLISH
                        protLowIx  := f_p2ViewIndexByKey(views, loSwingKey)
                        weakHighIx := f_p2ViewIndexByKey(views, hiSwingKey)
                        lastChange := r.availabilityTime
                    else if hiLabel == C_ST_REL_LOWER_HIGH and loLabel == C_ST_REL_LOWER_LOW
                        dir        := C_ST_DIR_BEARISH
                        protHighIx := f_p2ViewIndexByKey(views, hiSwingKey)
                        weakLowIx  := f_p2ViewIndexByKey(views, loSwingKey)
                        lastChange := r.availabilityTime
                ri := ri + 1

    int protHighKey = protHighIx >= 0 ? array.get(views, protHighIx).stableKey : C_ST_NA
    int protLowKey  = protLowIx  >= 0 ? array.get(views, protLowIx).stableKey  : C_ST_NA
    int weakHighKey = weakHighIx >= 0 ? array.get(views, weakHighIx).stableKey : C_ST_NA
    int weakLowKey  = weakLowIx  >= 0 ? array.get(views, weakLowIx).stableKey  : C_ST_NA
    [dir, protHighKey, protLowKey, weakHighKey, weakLowKey, lastChange, events, brokenKeys, weakHighBoundaryAbs, weakLowBoundaryAbs, chochAborts]

// =============================================================================
// MAIN — advance state ONLY on confirmed/closed bars (non-repaint).
// =============================================================================
if barstate.isconfirmed
    // ---- exact incremental Wilder ATR for THIS candle ----
    float tr = f_trueRange(high, low, atrPrevClose)
    float atrValue = na
    if not na(atrPrevFinal)
        atrValue := (atrPrevFinal * (C_ATR_PERIOD - 1) + tr) / C_ATR_PERIOD
        atrPrevFinal := atrValue
    else
        atrWarmSum := atrWarmSum + tr
        atrWarmCount := atrWarmCount + 1
        if atrWarmCount < C_ATR_PERIOD
            atrValue := na
        else
            atrValue := atrWarmSum / C_ATR_PERIOD
            atrPrevFinal := atrValue
    atrPrevClose := close

    // ---- push into rolling window; prune to lookbackWindow ----
    confirmedBarCount := confirmedBarCount + 1
    array.push(wHigh, high)
    array.push(wLow, low)
    array.push(wOpen, open)
    array.push(wClose, close)
    array.push(wOpenT, time)
    array.push(wAvailT, time_close)
    array.push(wAtr, atrValue)
    while array.size(wHigh) > lookbackWindow
        array.shift(wHigh)
        array.shift(wLow)
        array.shift(wOpen)
        array.shift(wClose)
        array.shift(wOpenT)
        array.shift(wAvailT)
        array.shift(wAtr)


    // ---- single-candle pivot frontier: decide ONE new candle, retire stale ----
    int absFirst = confirmedBarCount - array.size(wHigh)
    f_advancePivotFrontier(wHigh, wLow, wAtr, absFirst, pvAbs, pvType, pvPrice, pvAtr, pvTie)

    // ---- swing pipeline (every confirmed bar, from the maintained frontier) ----
    array<SwingRec> swings = f_detectSwings(wHigh, wLow, wOpenT, wAvailT, wAtr, pvAbs, pvType, pvPrice, pvAtr, pvTie, absFirst)
    p3Swings := swings

    // ---- P2-I2: canonical swing view. Built from CONFIRMED P1 state only, so a
    // forming bar cannot move it; no P1 value reads it back.
    array<StructSwingView> p2Swings = f_p2BuildSwingView(swings, wOpenT, absFirst)

    // ---- P2-I3: relationship labels. Derived purely from the adapted view, so
    // it inherits the confirmed-bar gate; no candle or forming-bar value is read.
    array<StructRelRec> p2Rels = f_p2BuildRelationships(p2Swings)

    // ---- P2-I4 + P2-I5: merged structure walk (bootstrap + BOS). Consumes only
    // CONFIRMED window state -- wClose/wOpenT/wAvailT are pushed above from the
    // just-closed bar -- so it inherits the confirmed-bar gate and never reads a
    // forming value, an intrabar price, or a wick.
    [p2bDir, p2bProtHigh, p2bProtLow, p2bWeakHigh, p2bWeakLow, _p2bLastChange, p2bEvents, _p2bBroken, p2bWhBound, p2bWlBound, p2bAborts] = f_p2StructureWalk(p2Swings, p2Rels, f_p2OrderRelationships(p2Rels), f_p2OrderSwings(p2Swings), wClose, wAvailT, wOpenT, absFirst)
    p2Direction   := p2bDir
    p2TransCount    := array.size(p2bEvents)
    p3Events := p2bEvents

    if dspMs and bar_index >= last_bar_index - 1
        bahui.clearLines(msLines)
        bahui.clearLabels(msLabels)
        for [k, ev] in p2bEvents
            if k >= p2TransCount - maxDrawPerFamily
                color msC = ev.transitionCode > 0 ? color.green : color.red
                array.push(msLines, line.new(ev.brokenSwingKey, ev.brokenLevel, ev.breakTime, ev.brokenLevel, xloc.bar_time, color = msC, style = line.style_dotted))
                array.push(msLabels, label.new(ev.breakTime, ev.brokenLevel, math.abs(ev.transitionCode) == 2 ? "CHOCH" : "BOS", xloc.bar_time, color = color(na), textcolor = msC, style = label.style_label_left, size = size.tiny))
        for [k, sw] in swings
            if k >= array.size(swings) - maxDrawPerFamily
                bool msHigh = sw.swingType == SWING_HIGH
                if f_rc5SwingMeaningful(sw.pivotEndTime)
                    float prevPx = msHigh ? array.get(msPrevHL, 0) : array.get(msPrevHL, 1)
                    if not na(prevPx) and math.abs(sw.price - prevPx) > sw.referenceAtr * 0.0
                        array.push(msLabels, label.new(sw.pivotEndTime, sw.price, msHigh ? (sw.price > prevPx ? "HH" : "LH") : (sw.price > prevPx ? "HL" : "LL"), xloc.bar_time, color = color(na), textcolor = color.gray, style = msHigh ? label.style_label_down : label.style_label_up, size = size.tiny))
                    array.set(msPrevHL, msHigh ? 0 : 1, sw.price)
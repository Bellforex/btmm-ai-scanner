float C_LEG_STRONG_EFF                = 0.75     // configuration.py:59
float C_LEG_STRONG_SHARE              = 0.80     // configuration.py:60

// Swing type codes (Python SwingType). Displacement classification codes.
int SWING_HIGH = 1
int SWING_LOW  = -1

// =============================================================================
// P2-I1 — STRUCTURE CODES (structure/enums.py)
// -----------------------------------------------------------------------------
// Integer codes for the three Python StrEnums. Pine has no string enums, so each
// member gets a stable named constant; nothing here is behaviour.
//
// The enums are CLOSED. structure/enums.py defines exactly these members, so
// there is deliberately no RANGE, NEUTRAL, MSS, internal/external or major/minor
// code — inventing one would fabricate a state the Python contract cannot emit.
//
// C_ST_NA is the unset sentinel. It is -99, not 0 and not na: 0 is a live
// direction code (UNDETERMINED) and Pine `int x = na` degrades to `const int`,
// which cannot be reassigned (the defect that broke the first forensic probe).
int C_ST_NA = -99

// StructureDirection
int C_ST_DIR_UNDETERMINED = 0
int C_ST_DIR_BULLISH      = 1
int C_ST_DIR_BEARISH      = -1

// SwingRelationshipLabel — sign carries the relation, magnitude the side, so
// `code > 0` is HIGHER and `abs(code) == 1` is the high side.
int C_ST_REL_HIGHER_HIGH = 1
int C_ST_REL_LOWER_HIGH  = -1
int C_ST_REL_EQUAL_HIGH  = 10
int C_ST_REL_HIGHER_LOW  = 2
int C_ST_REL_LOWER_LOW   = -2
int C_ST_REL_EQUAL_LOW   = 20

// StructureTransitionType
int C_ST_TR_BULLISH_BOS   = 1
int C_ST_TR_BEARISH_BOS   = -1
int C_ST_TR_BULLISH_CHOCH = 2
int C_ST_TR_BEARISH_CHOCH = -2

// StructureConfiguration.swing_relationship_equal_tolerance_atr_multiplier
// (structure/configuration.py:10). Author-approved by reuse from the 1B-H
// equal-level tolerance; it is the ONLY numeric threshold the Structure
// milestone owns. Named rather than inlined so the multiplier never appears as
// an anonymous 0.10 literal in the classifier.
float C_ST_REL_EQUAL_TOL_ATR = 0.10

// -----------------------------------------------------------------------------
// P1-PERF-4 — BOUNDED HISTORICAL EXECUTION
//
// The engine reads history through exactly one channel that outlives the
// analytical window: the incremental Wilder ATR in `wAtr`. Everything else a
// bar reads (candles, pivots, swings, trackers, folds) is pruned to
// `lookbackWindow`. So a truncated execution differs from a full-history one
// only while its ATR still remembers its own seed.
//
// Wilder ATR is an IIR filter: a seed discrepancy decays by (P-1)/P per bar.
// The largest warm-up measured before the truncated series became IDENTICAL to
// the full-history series was 920 bars on canonical FXCM data and 945 bars on
// adversarial fixtures that deliberately distort the seed.
//
//   C_P1_MIN_CALC_BARS = lookbackWindow + warm-up = 300 + 950 = 1250
//     A bar is analytically valid once the engine has processed this many
//     confirmed bars, because only then is the ATR exact at the LEFT EDGE of
//     that bar's 300-bar window.
//
//   C_P1_CALC_BARS = 1800 (also the calc_bars_count in the declaration above)
//     The selected execution horizon AND the required dataset capacity. Makes
//     the earliest of the last 300 bars valid with 251 bars to spare, while
//     cutting D1 historical execution by roughly two thirds.
//
// Three numbers that are easy to confuse, so state them plainly:
//
//   300  = the analytical rolling window (`lookbackWindow`).
//   1250 = the per-bar warm-up floor INSIDE an adequately sized run.
//   1800 = the dataset capacity the product requires, and the default the
//          declaration asks TradingView for.
//
// 1250 is deliberately NOT the minimum allowed "Calculated bars" setting. It is
// the point at which an individual bar inside a full-size run becomes exact; it
// says nothing about whether the validated horizon is present at all. A 1300-bar
// run would contain a few warm bars and still be outside the validated contract,
// so P1-PERF-4A checks capacity against 1800 and warm-up against 1250, and
// publishes only when both hold.
int C_P1_CALC_BARS     = 1800
int C_P1_MIN_CALC_BARS = 1250

// =============================================================================
// USER-DEFINED TYPES — minimal analytical records (semantic content only; no UUID).
// =============================================================================
type SwingRec
    int   swingType            // SWING_HIGH / SWING_LOW
    float price                // pivot_price
    int   pivotStartIdx        // window index of pivot start
    int   pivotEndIdx          // window index of pivot end (= last pivot candle)
    int   pivotEndTime         // event/open time of pivot end candle (anchor)
    int   localConfTime        // local_confirmation_time (availability of end+radius bar)
    int   meaningfulConfTime   // meaningful_confirmation_time (availability of reversal bar)
    float referenceAtr         // pivot_reference_atr
    float tieTolerance         // pivot_tie_tolerance
    float reversalThreshold    // reversal_threshold
    float reversalExcursion    // reversal_excursion

type EqualLevelRec
    int   clusterType          // SWING_HIGH => EQUAL_HIGH, SWING_LOW => EQUAL_LOW
    float zoneBottom
    float zoneTop
    float representativePrice
    float clusterSpread
    float equalityTolerance
    int   memberCount
    int   firstTime            // earliest member meaningful confirmation time
    int   confirmationTime     // max member meaningful confirmation time

type SRRec
    int   zoneType             // SWING_LOW origin => SUPPORT, SWING_HIGH origin => RESISTANCE
    float zoneTop
    float zoneBottom
    float zoneDepth
    int   touchCount
    int   confirmationTime     // availability of first confirming candle

type SRCand
    int   key                  // pivotEndTime — the stable semantic swing identity
    int   swingType
    float price
    float referenceAtr         // carried directly; never re-derived from zoneDepth
    int   meaningfulConfTime
    int   pivotEndAbs          // ABSOLUTE pivot-end index, so a window shift cannot stale it

type SRFold
    int   originKey            // SRCand.key of this fold's origin; the cache is ascending on it
    int   originAbs            // absolute pivot-end index, matched against the dirty set
    int   originType
    float zoneTop
    float zoneBottom
    float referenceAtr         // authoritative value, stored not reconstructed
    float zoneDepth
    bool  hasZone              // false = "cached: this origin publishes nothing"
    int   touchCount
    int   confirmationTime

type SRTracker
    int   originAbs            // absolute index of the origin swing's pivot-end candle
    int   searchStartAbs       // absolute index of the first candle this reaction may use
    float zoneTop
    float zoneBottom
    bool  isSupport
    int   lastCheckedAbs       // highest absolute index already examined for a reaction start
    int   reactionStartAbs     // na until the first qualifying close is found
    float anchor               // running min(low) / max(high) from searchStartAbs
    bool  permanent            // the bounded window is full; nothing can change it now
    int   confirmingAbs        // na unless the reaction currently qualifies
    int   confirmingTime       // availability time of the confirming candle

type TrendlineRec
    int   orientation          // SWING_LOW anchors => BULLISH, SWING_HIGH anchors => BEARISH
    float anchor1Price
    float anchor2Price
    int   anchor1Time
    int   anchor2Time
    float rawSlope             // price per bar
    float normalizedSlope
    int   confirmationTime

// =============================================================================
// P2-I1 — STRUCTURE RECORDS (structure/relationships.py, structure/transitions.py)
// -----------------------------------------------------------------------------
// Declarations only. No P2 behaviour exists yet: nothing constructs a
// StructRelRec or a StructEventRec, and no analytical value reads one.
// =============================================================================

// Adapter-facing projection of ONE canonical P1 confirmed swing. Every field is
// either copied straight from SwingRec or derived from it plus the live window —
// nothing is re-detected, so this cannot become a second source of truth.
//
// Python counterpart: domain.swings.ConfirmedSwing, restricted to the fields
// structure/ actually consumes.
type StructSwingView
    int   stableKey            // == SwingRec.pivotEndTime; P1's own swing identity
    int   swingType            // SWING_HIGH / SWING_LOW  <- SwingRec.swingType
    float pivotPrice           // <- SwingRec.price            (pivot_price)
    float referenceAtr         // <- SwingRec.referenceAtr     (pivot_reference_atr)
    int   meaningfulConfTime   // <- SwingRec.meaningfulConfTime; also the swing's
                               //    availability_time_utc (domain/analyzer.py:318
                               //    assigns availability FROM meaningful confirmation)
    int   pivotStartTime       // <- wOpenT[pivotStartIdx]     (pivot_start_time_utc)
    int   pivotStartAbs        // <- absFirst + pivotStartIdx  (pivot_bar_index)

// A swing-to-predecessor relationship. Python: relationships.SwingRelationship.
type StructRelRec
    int   swingKey             // current swing's stableKey
    int   previousSameTypeKey  // predecessor of the SAME type
    int   relationshipCode     // C_ST_REL_*
    int   availabilityTime     // max(current, predecessor) availability
    int   currentPivotStartAbs // P2-I4 ordering key. Python's merged event sort
                               // breaks relationship ties on the CURRENT swing's
                               // pivot_bar_index (transitions.py:127-130), so the
                               // record must carry it. Published relationship
                               // order does NOT carry it — see f_p2OrderRelationships.

// An emitted BOS / CHOCH. Python: transitions.StructureTransition.
type StructEventRec
    int   transitionCode       // C_ST_TR_*
    int   brokenSwingKey
    float brokenLevel
    float breakClose
    int   breakTime            // break candle event_time_utc
    int   availabilityTime     // max(break candle, broken swing) availability
    int   protectedSwingKey    // P2-I5. Python publishes protected_swing_id on
                               // every StructureTransition (transitions.py:36);
                               // it is the post-break protected level and is not
                               // derivable from the other fields on this record.

// =============================================================================
// PRIMITIVE HELPERS — measurements/candle_metrics.py
// =============================================================================
// Median of an ALREADY ascending-sorted array. O(1). Same value as f_median for
// the same multiset — the median depends only on the multiset, not on how it was
// ordered — so a caller that maintains sorted order incrementally may use this.
f_medianOfSorted(array<float> sorted) =>
    int n = array.size(sorted)
    float out = 0.0
    if n > 0
        int mid = int(n / 2)
        out := (n % 2 == 1) ? array.get(sorted, mid) : (array.get(sorted, mid - 1) + array.get(sorted, mid)) / 2.0
    out

// P1-PERF-1: median that CONSUMES its argument — it sorts in place instead of
// allocating a copy. Every call site builds a fresh (or scratch) array and never
// reads it again afterwards, so consuming it is safe and removes one array
// allocation plus one full copy from every median in the hot path. The returned
// value is identical to the previous copy-then-sort implementation.
f_medianConsume(array<float> vals) =>
    array.sort(vals, order.ascending)
    f_medianOfSorted(vals)

// median of total_range over window slice [startIncl, endExcl)  (median_total_range)
// P1-PERF-1: writes into a caller-owned scratch array instead of allocating.
f_medianRange(array<float> highs, array<float> lows, int startIncl, int endExcl, array<float> scratch) =>
    array.clear(scratch)
    if endExcl > startIncl and startIncl >= 0 and endExcl <= array.size(highs)
        for i = startIncl to endExcl - 1
            array.push(scratch, array.get(highs, i) - array.get(lows, i))
    f_medianConsume(scratch)

// =============================================================================
// ROLLING WINDOW STATE — confirmed candles + exact incremental Wilder ATR.
// atr.py: true_range uses previous close; seed = mean of first `period` TRs at
// index period-1 (na before); Wilder recurrence thereafter. This mirrors
// advance_incremental_atr (append-stable, exact image of compute_atr_series).
// =============================================================================
var array<float> wHigh   = array.new<float>()
var array<float> wLow    = array.new<float>()
var array<float> wOpen   = array.new<float>()
var array<float> wClose  = array.new<float>()
var array<int>   wOpenT  = array.new<int>()   // bar open time (event_time_utc analogue)
var array<int>   wAvailT = array.new<int>()   // availability time = bar close time
var array<float> wAtr    = array.new<float>() // ATR at this candle (na during warm-up)

// Incremental ATR carry state (var; advances only on confirmed bars).
var float atrPrevClose = na
var float atrWarmSum   = 0.0
var int   atrWarmCount = 0
var float atrPrevFinal = na

// -----------------------------------------------------------------------------
// P1-PERF-1 — SINGLE-CANDLE PIVOT FRONTIER (persistent, absolute-indexed).
//
// _find_single_candle_pivots tests every window index in [R, n-R-1]. That test
// reads only highs/lows/atr[idx-R .. idx+R], so a bar's pivot status is FINAL as
// soon as it has R closed bars to its right and can never change afterwards.
// Re-deriving the whole window on every confirmed bar therefore recomputed an
// identical answer O(W) times. Instead we decide exactly ONE new candle per
// confirmed bar (the bar at window index n-1-R) and retire entries that have
// fallen out of the batch's scan range.
//
// Pivots are stored by ABSOLUTE confirmed-bar index so that a window shift does
// not invalidate them; f_detectSwings converts to window indices on read. The
// resulting pivot multiset is identical to the batch scan (proof in
// docs/architecture/BTRC_V1_P1_PERFORMANCE_OPTIMIZATION.md).
// -----------------------------------------------------------------------------
var int confirmedBarCount = 0                 // absolute count of confirmed bars seen
var array<int>   pvAbs   = array.new<int>()   // absolute index of the pivot candle
var array<int>   pvType  = array.new<int>()
var array<float> pvPrice = array.new<float>()
var array<float> pvAtr   = array.new<float>()
var array<float> pvTie   = array.new<float>()

// -----------------------------------------------------------------------------
// P1-SR-PERF-2 — persistent S/R reaction frontier state.
//
// srKeys is kept ASCENDING and packs originAbs into the high bits, so retiring
// every tracker whose origin has left the active window is a prefix removal.
// srTrk is parallel to it. srCached holds the last walk result so that a bar
// which changes neither the swing set nor any tracker resolution costs nothing
// beyond the tracker advances.
// -----------------------------------------------------------------------------
var array<int>       srKeys   = array.new<int>()
var array<SRTracker> srTrk    = array.new<SRTracker>()
var array<SRRec>     srCached = array.new<SRRec>()
var bool             srSeeded = false

// -----------------------------------------------------------------------------
// P1-SR-PERF-3 — semantic pair/fold frontier state.
//
// Measured on canonical FXCM M1/M5/M15 (900-bar replays, lookback 300): the walk
// performed ~650-680 origin x touch visits for every genuinely NEW semantic pair,
// so almost all of it re-derived relationships that had not changed. Caching each
// origin's fold and invalidating it from the swing DELTA removed ~60% of that
// work with byte-identical output, proven at every prefix against the production
// Python oracle (tests/unit/test_pine_p1_sr_frontier_model.py).
//
// srCand* hold ABSOLUTE pivot indices, never window indices, so a cached
// candidate cannot go stale when the 300-bar window slides. srSnap is the
// previous swing set in ascending key order, which makes the delta an O(A) merge
// (detect_confirmed_swings emits swings ascending by pivot-end time).
// -----------------------------------------------------------------------------
var array<SRCand> srCandSupport = array.new<SRCand>()   // support origins, ascending confirmation time
var array<SRCand> srCandResist  = array.new<SRCand>()   // resistance origins, ascending confirmation time
var array<int>    srOppSupport  = array.new<int>()      // HIGH confirmation times, ascending
var array<int>    srOppResist   = array.new<int>()      // LOW  confirmation times, ascending
var array<SRCand> srSnap        = array.new<SRCand>()   // previous swing set, ascending key
var array<SRFold> srFold        = array.new<SRFold>()   // fold cache, ascending originKey
var array<SRFold> srFoldKeep    = array.new<SRFold>()   // reusable survivor buffer for retirement
var array<int>    srDirty       = array.new<int>()      // origin ABS indices whose reaction moved

// Reusable scratch buffers (P1-PERF-1): avoid per-call array allocation in the
// hot path. Each is cleared by its owner before use and is never aliased across
// two live users at the same time.
var array<float> scDispRange = array.new<float>()   // f_medianRange, displacement
var array<float> scTlAtr     = array.new<float>()   // trendline anchor-slice ATRs (kept sorted)

f_trueRange(float h, float l, float prevClose) =>
    float hl = h - l
    na(prevClose) ? hl : math.max(hl, math.abs(h - prevClose), math.abs(l - prevClose))

// Persistent "latest confirmed" summaries for the parity interface.
var float latestSwingHighPrice = na
var int   latestSwingHighTime  = na
var float latestSwingLowPrice  = na
var int   latestSwingLowTime   = na
var int   latestDispCode       = na   // signed: +/-(0 normal,1 fast,2 very_fast); sign = direction
var float latestDispRatio      = na
var float latestEqualHigh      = na
var float latestEqualLow       = na
var float latestSRTop          = na
var float latestSRBottom       = na
var int   latestSRType         = na
var float latestTLNormSlope    = na
var int   latestTLOrient       = na

// ---- P2-I2 adapter observation state (diagnostic only) ----------------------
// Written by the adapter, read only by the debug-gated P2_* plots below. No
// analytical value consumes these, so they cannot influence P1 output.
var int   p2SwingCount    = na
var int   p2LastKey       = na   // retained for I4+; not plotted (budget)
var int   p2LastType      = na
var float p2LastPrice     = na   // retained for I5+; not plotted (budget)
var float p2LastAtr       = na   // retained for I5+; not plotted (budget)
var int   p2LastConfTime  = na
var int   p2LastStartAbs  = na
var int   p2RelCount      = na   // P2-I3
var int   p2LastHighRel   = na
var int   p2LastLowRel    = na
var int   p2Direction     = C_ST_NA  // P2-I4. Seeded to the sentinel, not na:
                                    // these are compared against C_ST_NA, and
                                    // `na == x` propagates na in Pine.
var int   p2ProtHighKey   = C_ST_NA
var int   p2ProtLowKey    = C_ST_NA
var int   p2WeakHighKey   = C_ST_NA
var int   p2WeakLowKey    = C_ST_NA
var int   p2TransCount    = C_ST_NA  // P2-I5
var int   p2LastTransCode = C_ST_NA
var int   p2LastBrokenKey = C_ST_NA
var float p2LastBrokenLvl = na
var int   p2WeakHighBound = C_ST_NA  // not plotted; TD-B/I6 consumes it
var int   p2WeakLowBound  = C_ST_NA
var int   p2ChochAborts   = C_ST_NA  // not plotted; CHOCH abort count

// Swing-set change detection (so SWING-DERIVED detectors run only on change).
// S/R is deliberately NOT behind this gate — see the P1-CLOSEOUT note in MAIN.
var int lastSwingCount       = na
var int lastSwingConfTime    = na
var int lastSwingFingerprint = na
// S/R zone-set fingerprint — debug-drawing gate only, never an analytical gate.
var int lastSRFingerprint    = na

// Persistent draw-object handles (bounded, redrawn on change).
var array<label> swingLabelObjs = array.new<label>()
var array<line>  eqLineObjs     = array.new<line>()
var array<box>   srBoxObjs      = array.new<box>()
var array<line>  tlLineObjs     = array.new<line>()

f_clearLabels(array<label> a) =>
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            label.delete(array.get(a, i))
        array.clear(a)

f_clearLines(array<line> a) =>
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            line.delete(array.get(a, i))
        array.clear(a)

f_clearBoxes(array<box> a) =>
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            box.delete(array.get(a, i))
        array.clear(a)

// =============================================================================
// SWING PIPELINE — domain/swings.py (single-candle pivots -> plateau merge ->
// same-direction supersede -> alternation + meaningful-reversal confirmation).
// Parallel arrays are used instead of the Python _Pivot NamedTuple.
//
// P1-PERF-1: single-candle pivots are now maintained incrementally (one new
// candle decided per confirmed bar). Everything downstream of that — merge,
// supersede, alternation, meaningful-reversal confirmation — still runs over the
// bounded window on every confirmed bar and remains batch-faithful; it is cheap
// because it walks the pivot list (tens of entries), not the candle window.
// =============================================================================
// P1-PERF-1 — advance the single-candle pivot frontier by exactly one candle.
//
// Decides the newest candle that has just acquired C_WINDOW_RADIUS closed bars to
// its right (window index n-1-R), then retires pivots that have dropped out of
// the range the batch scan would cover. The resulting pivot set is identical to
// re-running _find_single_candle_pivots over the whole window.
f_advancePivotFrontier(array<float> highs, array<float> lows, array<float> atr, int absFirst, array<int> pAbs, array<int> pType, array<float> pPrice, array<float> pAtr, array<float> pTie) =>
    int n = array.size(highs)
    int idx = n - 1 - C_WINDOW_RADIUS
    if idx >= C_WINDOW_RADIUS
        float a = array.get(atr, idx)
        if not na(a)
            float tie = C_PIVOT_TIE_TOL_ATR * a
            float candHigh = array.get(highs, idx)
            float candLow  = array.get(lows, idx)
            bool qHigh = true
            bool qLow  = true
            for j = idx - C_WINDOW_RADIUS to idx + C_WINDOW_RADIUS
                if j != idx
                    if array.get(highs, j) > candHigh + tie
                        qHigh := false
                    if array.get(lows, j) < candLow - tie
                        qLow := false
            if qHigh and qLow
                qHigh := qHigh   // ambiguous (register 33I): emit neither
            else if qHigh
                array.push(pAbs, absFirst + idx)
                array.push(pType, SWING_HIGH)
                array.push(pPrice, candHigh)
                array.push(pAtr, a)
                array.push(pTie, tie)
            else if qLow
                array.push(pAbs, absFirst + idx)
                array.push(pType, SWING_LOW)
                array.push(pPrice, candLow)
                array.push(pAtr, a)
                array.push(pTie, tie)
    // The batch scan starts at window index C_WINDOW_RADIUS, i.e. absolute
    // absFirst + C_WINDOW_RADIUS. Anything older is outside its range.
    int minAbs = absFirst + C_WINDOW_RADIUS
    while array.size(pAbs) > 0 and array.get(pAbs, 0) < minAbs
        array.shift(pAbs)
        array.shift(pType)
        array.shift(pPrice)
        array.shift(pAtr)
        array.shift(pTie)
    array.size(pAbs)   // explicit return: live pivot count (callers may ignore it)

f_detectSwings(array<float> highs, array<float> lows, array<int> openT, array<int> availT, array<float> atr, array<int> pAbs, array<int> pType, array<float> pPrice, array<float> pAtr, array<float> pTie, int absFirst) =>
    array<SwingRec> outSwings = array.new<SwingRec>()
    int n = array.size(highs)
    int np = array.size(pAbs)
    if n >= 2 * C_WINDOW_RADIUS + 1 and np > 0
        // ---- _merge_adjacent_plateaus (swings.py:139): merge pivots of the same
        // type at consecutive indices within tie tolerance.
        //
        // P1-PERF-1: the frontier is already in ascending index order and holds at
        // most ONE pivot per candle, so two same-type pivots at consecutive
        // indices are necessarily neighbours in this list — nothing can sit
        // between them. A single ordered pass therefore produces exactly the
        // records Python's group-by-type pass produces, and emits them already
        // ordered by start index, which is what swings.py:179 sorts for. The
        // O(M^2) insertion sort is provably redundant and has been removed.
        // The two-element median is written as the mean of the pair — identical
        // by definition, without allocating a temporary array per merge.
        mType  = array.new<int>()
        mStart = array.new<int>()
        mEnd   = array.new<int>()
        mPrice = array.new<float>()
        mAtr   = array.new<float>()
        mTie   = array.new<float>()
        int gidx = 0
        while gidx < np
            int curType = array.get(pType, gidx)
            bool merged = false
            if gidx + 1 < np
                if array.get(pType, gidx + 1) == curType and array.get(pAbs, gidx + 1) == array.get(pAbs, gidx) + 1 and math.abs(array.get(pPrice, gidx + 1) - array.get(pPrice, gidx)) <= array.get(pTie, gidx)
                    float price = curType == SWING_HIGH ? math.max(array.get(pPrice, gidx), array.get(pPrice, gidx + 1)) : math.min(array.get(pPrice, gidx), array.get(pPrice, gidx + 1))
                    array.push(mType, curType)
                    array.push(mStart, array.get(pAbs, gidx) - absFirst)
                    array.push(mEnd, array.get(pAbs, gidx + 1) - absFirst)
                    array.push(mPrice, price)
                    array.push(mAtr, (array.get(pAtr, gidx) + array.get(pAtr, gidx + 1)) / 2.0)
                    array.push(mTie, array.get(pTie, gidx + 1))
                    gidx += 2
                    merged := true
            if not merged
                array.push(mType, curType)
                array.push(mStart, array.get(pAbs, gidx) - absFirst)
                array.push(mEnd, array.get(pAbs, gidx) - absFirst)
                array.push(mPrice, array.get(pPrice, gidx))
                array.push(mAtr, array.get(pAtr, gidx))
                array.push(mTie, array.get(pTie, gidx))
                gidx += 1

        // ---- _supersede_same_direction_runs (swings.py:183): keep extreme per run ----
        cType  = array.new<int>()
        cStart = array.new<int>()
        cEnd   = array.new<int>()
        cPrice = array.new<float>()
        cAtr   = array.new<float>()
        cTie   = array.new<float>()
        int runType = na
        int bestRel = na
        for [rel, _u337] in mType
            int thisType = array.get(mType, rel)
            if na(runType)
                runType := thisType
                bestRel := rel
            else if thisType != runType
                array.push(cType, array.get(mType, bestRel))
                array.push(cStart, array.get(mStart, bestRel))
                array.push(cEnd, array.get(mEnd, bestRel))
                array.push(cPrice, array.get(mPrice, bestRel))
                array.push(cAtr, array.get(mAtr, bestRel))
                array.push(cTie, array.get(mTie, bestRel))
                runType := thisType
                bestRel := rel
            else
                bool better = thisType == SWING_HIGH ? array.get(mPrice, rel) > array.get(mPrice, bestRel) : array.get(mPrice, rel) < array.get(mPrice, bestRel)
                if better
                    bestRel := rel
        if not na(bestRel)
            array.push(cType, array.get(mType, bestRel))
            array.push(cStart, array.get(mStart, bestRel))
            array.push(cEnd, array.get(mEnd, bestRel))
            array.push(cPrice, array.get(mPrice, bestRel))
            array.push(cAtr, array.get(mAtr, bestRel))
            array.push(cTie, array.get(mTie, bestRel))

        // ---- confirmation loop (swings.py:219): alternation + meaningful reversal ----
        int lastConfirmedType = na
        for [p, _u366] in cType
            int endIdx = array.get(cEnd, p)
            int localConfIdx = endIdx + C_WINDOW_RADIUS
            // swings.py:228 `pivot.swing_type == last_confirmed_type` is False while
            // last_confirmed_type is None, so the FIRST eligible pivot is never skipped.
            // Pine `!=` against an na int yields na (falsy), which would permanently
            // block that first confirmation; the na() guard restores the Python state.
            if localConfIdx < n and (na(lastConfirmedType) or array.get(cType, p) != lastConfirmedType)
                float refAtr = array.get(cAtr, p)
                float threshold = C_MEANINGFUL_REVERSAL_ATR * refAtr
                float pivotPrice = array.get(cPrice, p)
                int confIdx = na
                float excursion = 0.0
                int searchStart = localConfIdx + 1
                // P1-PERF-1: this is Python's `for j in range(search_start, n)`.
                // The previous `for [j, _] in lows` + `if j < searchStart: continue`
                // form re-walked the whole window from index 0 on every candidate
                // (~W/2 wasted iterations each) before reaching the first index it
                // could actually use. A `while` bounded at both ends visits exactly
                // the same indices in the same order, and cannot run backwards.
                if array.get(cType, p) == SWING_HIGH
                    float lowestLow = array.get(lows, localConfIdx)
                    int j = searchStart
                    while j < n
                        lowestLow := math.min(lowestLow, array.get(lows, j))
                        float exc = pivotPrice - lowestLow
                        if exc >= threshold
                            confIdx := j
                            excursion := exc
                            break
                        j += 1
                else
                    float highestHigh = array.get(highs, localConfIdx)
                    int j = searchStart
                    while j < n
                        highestHigh := math.max(highestHigh, array.get(highs, j))
                        float exc = highestHigh - pivotPrice
                        if exc >= threshold
                            confIdx := j
                            excursion := exc
                            break
                        j += 1
                if not na(confIdx)
                    SwingRec s = SwingRec.new(array.get(cType, p), pivotPrice, array.get(cStart, p), endIdx, array.get(openT, endIdx), array.get(availT, localConfIdx), array.get(availT, confIdx), refAtr, array.get(cTie, p), threshold, excursion)
                    array.push(outSwings, s)
                    lastConfirmedType := array.get(cType, p)
    outSwings

// =============================================================================
// P2-I2 — CANONICAL P1 SWING ADAPTER
// -----------------------------------------------------------------------------
// Projects the canonical confirmed-swing list onto StructSwingView. This is the
// ONLY way P2 may obtain swings: it performs no detection, applies no threshold
// and makes no ordering decision of its own.
//
// ORDERING. P1 emits `outSwings` in append order, which is ascending by
// pivotEndTime (f_srSwingHasKey binary-searches on exactly that invariant). That
// order is also what Python's validated swing stream requires, so the adapter
// maps 1:1 and NEVER sorts — re-sorting would silently redefine canonical order
// and is a semantic bug, not an optimisation.
//
// ALTERNATION. Python's _validate_swings rejects two consecutive same-type
// swings, and P1's own alternation gate guarantees the same, so the projection
// preserves alternation for free. The within-type predecessor a later phase needs
// is therefore always two positions back.
//
// pivotStartIdx is a WINDOW index and the window slides, but f_detectSwings is
// re-run over the live window on every confirmed bar, so pivotStartIdx is always
// valid against the `openT` passed here. Nothing can stale between the two.
//
// COST. O(number of live swings) per confirmed bar — tens of entries, the same
// class as the swing walk that produced them. No history traversal is added.
f_p2BuildSwingView(array<SwingRec> swings, array<int> openT, int absFirst) =>
    array<StructSwingView> out = array.new<StructSwingView>()
    int nT = array.size(openT)
    for [i, _p2a] in swings
        SwingRec s = array.get(swings, i)
        int startTime = s.pivotStartIdx >= 0 and s.pivotStartIdx < nT ? array.get(openT, s.pivotStartIdx) : s.pivotEndTime
        array.push(out, StructSwingView.new(s.pivotEndTime, s.swingType, s.price, s.referenceAtr, s.meaningfulConfTime, startTime, absFirst + s.pivotStartIdx))
    out

// =============================================================================
// P2-I3 — RELATIONSHIP CLASSIFICATION (structure/relationships.py)
// -----------------------------------------------------------------------------
// Labels ONLY. This phase does not bootstrap direction, does not select
// protected or weak levels, and emits no BOS or CHOCH.
// =============================================================================

// Pure transcription of _classify_label (relationships.py:53-79). No state, no
// mutation, no candle access.
//
//   tolerance = 0.10 * CURRENT swing's referenceAtr        <- current, not
//     predecessor, not a median, not the bar ATR (relationships.py:59-61)
//   price >  predecessor + tolerance -> HIGHER   (strict, :63)
//   price <  predecessor - tolerance -> LOWER    (strict, :69)
//   otherwise                        -> EQUAL    (:74)
//
// Because both comparisons are strict, a delta of exactly +tolerance or exactly
// -tolerance lands in the EQUAL band.
f_p2ClassifyRelationship(StructSwingView cur, StructSwingView prev) =>
    int code = C_ST_NA
    if cur.swingType == prev.swingType
        float tol = C_ST_REL_EQUAL_TOL_ATR * cur.referenceAtr
        bool isHigh = cur.swingType == SWING_HIGH
        if cur.pivotPrice > prev.pivotPrice + tol
            code := isHigh ? C_ST_REL_HIGHER_HIGH : C_ST_REL_HIGHER_LOW
        else if cur.pivotPrice < prev.pivotPrice - tol
            code := isHigh ? C_ST_REL_LOWER_HIGH : C_ST_REL_LOWER_LOW
        else
            code := isHigh ? C_ST_REL_EQUAL_HIGH : C_ST_REL_EQUAL_LOW
    code

// Transcription of detect_swing_relationships (relationships.py:82-116).
//
// ORDERING. Python filters `highs` then `lows` and appends in that order
// (:86-91), so the published tuple is ALL HIGH relationships followed by ALL LOW
// relationships — NOT chronologically interleaved. The two passes below
// reproduce that exactly; interleaving would silently change the output order.
//
// PREDECESSOR. Python compares `group[index]` to `group[index-1]` within the
// type-filtered list. This walks per type rather than assuming the predecessor
// is two positions back: alternation does make `i-2` correct today, but the
// per-type walk needs no such assumption and matches the Python shape directly.
//
// HISTORY BOUNDARY. Python classifies exactly the bounded input it is handed.
// `views` is P1's live canonical swing list, so when the window advances and the
// oldest same-type swing drops out, the new first swing of that type simply has
// no predecessor and yields no relationship — the same result Python gives for
// the same bounded input. No predecessor state is retained behind P1's window;
// retaining any would diverge from Python.
f_p2BuildRelationships(array<StructSwingView> views) =>
    array<StructRelRec> out = array.new<StructRelRec>()
    for pass = 0 to 1
        int wantType = pass == 0 ? SWING_HIGH : SWING_LOW
        int prevIdx = -1
        for [i, _p2r] in views
            StructSwingView v = array.get(views, i)
            if v.swingType == wantType
                if prevIdx >= 0
                    StructSwingView pv = array.get(views, prevIdx)
                    array.push(out, StructRelRec.new(v.stableKey, pv.stableKey, f_p2ClassifyRelationship(v, pv), math.max(v.meaningfulConfTime, pv.meaningfulConfTime), v.pivotStartAbs))
                prevIdx := i
    out

// =============================================================================
// P2-I4 — INITIAL DIRECTION BOOTSTRAP (transitions.py:355-381)
// -----------------------------------------------------------------------------
// UNDETERMINED -> BULLISH or BEARISH, once only. This phase emits NO transition,
// consumes no candle, and implements neither BOS nor CHOCH.
// =============================================================================

// Which side of the book a relationship code belongs to.
f_p2RelIsHigh(int relCode) =>
    relCode == C_ST_REL_HIGHER_HIGH or relCode == C_ST_REL_LOWER_HIGH or relCode == C_ST_REL_EQUAL_HIGH

// MERGED EVENT ORDER — the single highest-risk detail of this phase.
//
// f_p2BuildRelationships emits ALL HIGH relationships and then ALL LOW
// relationships, because that is the order detect_swing_relationships builds them
// in (relationships.py:86-91). That is an API/serialization artifact. It is NOT
// chronology, and neither Python consumer reads it as chronology:
// run_structure_walk re-sorts every event by availability (transitions.py:135) and
// analyze_structure_state re-sorts for publication (analyzer.py:346-353).
//
// Python's merged key is (availability_time, kind, tiebreak) with
// kind = _EVENT_RELATIONSHIP for all relationships, so restricted to
// relationships the effective key is
//     (availability_time_utc, current_swing.pivot_bar_index, str(record_id))
// (transitions.py:122-133). The record_id leg is UNREACHABLE in production:
// _find_single_candle_pivots emits at most one pivot per candle index and skips
// any index qualifying as both high and low (swings.py:112-114), so
// pivot_bar_index is unique across confirmed swings and (availability, index) is
// already a total order. Pine therefore reproduces the order exactly.
//
// Insertion sort over a bounded live relationship list (tens of entries), on
// integer comparisons only — deterministic and stable.
f_p2OrderRelationships(array<StructRelRec> rels) =>
    array<int> order = array.new<int>()
    for [i, _p2o] in rels
        StructRelRec r = array.get(rels, i)
        int n = array.size(order)
        int pos = n
        if n > 0
            for j = 0 to n - 1
                StructRelRec o = array.get(rels, array.get(order, j))
                bool earlier = r.availabilityTime < o.availabilityTime or (r.availabilityTime == o.availabilityTime and r.currentPivotStartAbs < o.currentPivotStartAbs)
                if earlier
                    pos := j
                    break
        if pos >= array.size(order)
            array.push(order, i)
        else
            array.insert(order, pos, i)
    order

// Transcription of the _EVENT_RELATIONSHIP branch of run_structure_walk
// (transitions.py:355-381).
//
//   latest_relationship_label[type] and latest_relationship_swing[type] are
//   overwritten UNCONDITIONALLY on every relationship event (:358-361). An EQUAL
//   therefore erases prior directional evidence for that side, and later
//   contradictory evidence replaces earlier evidence. Bootstrap is then re-tested
//   after every event while direction is still UNDETERMINED.
//
//   HH + HL -> BULLISH: protected_low = latest LOW swing, weak_high = latest HIGH
//                       swing; protected_high and weak_low stay unset (:366-373)
//   LH + LL -> BEARISH: protected_high = latest HIGH swing, weak_low = latest LOW
//                       swing; protected_low and weak_high stay unset (:374-381)
//
//   The swing that becomes protected/weak is the latest RELATIONSHIP's current
//   swing for that side, which may come from an EARLIER event than the one that
//   triggers the bootstrap.
//
//   last_change_availability is the TRIGGERING event's own availability (:373),
//   not the max of the two contributing relationships.
//
// ONCE-ONLY. The `dir == UNDETERMINED` guard means relationship evidence can
// never flip BULLISH <-> BEARISH afterwards; direction flips belong to CHOCH
// (P2-I5+). No transition is emitted here — Python appends none in this branch.
//
// BOUNDED. Rebuilt from the bounded relationship list on every confirmed bar and
// discarded; no evidence is retained behind P1's window.
// -----------------------------------------------------------------------------
// P2-I5 SUPPORT HELPERS
// -----------------------------------------------------------------------------

// Resolve a stableKey back to its index in the bounded view list. Called at most
// twice per walk (only when the bootstrap fires), so the linear scan is free.
f_p2ViewIndexByKey(array<StructSwingView> views, int key) =>
    int found = -1
    for [i, _p2v] in views
        if found < 0 and array.get(views, i).stableKey == key
            found := i
    found

// SWING_VISIBLE event order (transitions.py:109-121):
//   (meaningful_confirmation_time, pivot_bar_index, pivot_start_time, record_id)
// The record_id leg is unreachable for the same reason as in I4 (pivot_bar_index
// is unique across confirmed swings), but pivotStartTime is transcribed anyway
// because it costs nothing and keeps the key structurally identical.
f_p2OrderSwings(array<StructSwingView> views) =>
    array<int> order = array.new<int>()
    for [i, _p2s] in views
        StructSwingView v = array.get(views, i)
        int n = array.size(order)
        int pos = n
        if n > 0
            for j = 0 to n - 1
                StructSwingView o = array.get(views, array.get(order, j))
                bool earlier = v.meaningfulConfTime < o.meaningfulConfTime or (v.meaningfulConfTime == o.meaningfulConfTime and (v.pivotStartAbs < o.pivotStartAbs or (v.pivotStartAbs == o.pivotStartAbs and (v.pivotStartTime < o.pivotStartTime or (v.pivotStartTime == o.pivotStartTime and v.stableKey < o.stableKey)))))
                if earlier
                    pos := j
                    break
        if pos >= array.size(order)
            array.push(order, i)
        else
            array.insert(order, pos, i)
    order

// Transcription of _most_recent_unbroken (transitions.py:80-89).
//
//   candidates = [s for s in visible if s.record_id not in broken_ids]
//   return None if not candidates else max(
//       candidates, key=(pivot_bar_index, pivot_start_time_utc, str(record_id)))
//
// `visOrder` holds the indices of swings whose SWING_VISIBLE event has already
// fired, so the candidate set is exactly Python's visible_swings_by_type entry.
// All three key tiers are transcribed: the lower two are unreachable for valid
// production swings, but omitting them would silently bake that invariant into
// the port. Returns -1 for "no candidate" (Python's None).
f_p2MostRecentUnbroken(array<StructSwingView> views, array<int> visOrder, int wantType, array<int> brokenKeys) =>
    int best = -1
    for [_p2m, vi] in visOrder
        StructSwingView v = array.get(views, vi)
        if v.swingType == wantType and array.indexof(brokenKeys, v.stableKey) < 0
            if best < 0
                best := vi
            else
                StructSwingView b = array.get(views, best)
                bool newer = v.pivotStartAbs > b.pivotStartAbs or (v.pivotStartAbs == b.pivotStartAbs and (v.pivotStartTime > b.pivotStartTime or (v.pivotStartTime == b.pivotStartTime and v.stableKey > b.stableKey)))
                if newer
                    best := vi
    best

// =============================================================================
// P2-I4 / P2-I5 — MERGED STRUCTURE WALK
// -----------------------------------------------------------------------------
// One pass over the merged event stream, transcribing run_structure_walk
// (transitions.py:92-392) for the subset implemented so far:
//
//   I4  direction bootstrap on RELATIONSHIP events           (:355-381)
//   I5  BULLISH_BOS / BEARISH_BOS on CANDLE events           (:255-321)
//   I6  weak re-arm on SWING_VISIBLE events                  (:328-353)
//   I7  BULLISH_CHOCH / BEARISH_CHOCH on CANDLE events       (:183-253)
//
// The bounded batch-equivalent Structure walk is now semantically complete.
// What remains for a later phase is the PERSISTENT INCREMENTAL FRONTIER: this
// walk is still recomputed from the bounded window on every confirmed bar.
//
// EVENT ORDER. Python sorts every event by (availability_time, kind, tiebreak)
// with CANDLE=0 < SWING_VISIBLE=1 < RELATIONSHIP=2 (:75-77, :135). Each of the
// three streams is already sorted on its own key -- candles are chronological by
// construction, swings by f_p2OrderSwings, relationships by
// f_p2OrderRelationships -- so this is a linear 3-way merge rather than a sort of
// the combined list. Ties in availability are resolved by the kind ordinal,
// exactly as Python's tuple comparison does: the streams are tested in kind
// order and only a STRICTLY earlier time displaces the incumbent.
//
// CHOCH PRECEDENCE -- BOS SUPPRESSION ONLY, NOT CHOCH IMPLEMENTATION.
// Python evaluates CHOCH first and `continue`s past the BOS block on BOTH exits:
// the successful one (:253) and the aborting one (:190/:224). So the rule
// governing BOS emission is exactly "CHOCH predicate true => no BOS on this
// candle", with no dependence on whether the CHOCH would have succeeded. The
// guard below is that price test and nothing else: it creates no transition,
// flips no direction, consumes no swing and mutates no state. On such a candle
// this walk simply does nothing, which is incomplete relative to Python but
// never WRONG about BOS. Full CHOCH behaviour is a later phase.
f_p2StructureWalk(array<StructSwingView> views, array<StructRelRec> rels, array<int> relOrder, array<int> swingOrder, array<float> closes, array<int> availT, array<int> openT, int absFirst) =>
    int dir        = C_ST_DIR_UNDETERMINED
    int protHighIx = -1
    int protLowIx  = -1
    int weakHighIx = -1
    int weakLowIx  = -1
    int weakHighBoundaryAbs = -1
    int weakLowBoundaryAbs  = -1
    int lastChange = C_ST_NA
    int hiLabel    = C_ST_NA
    int loLabel    = C_ST_NA
    int hiSwingKey = C_ST_NA
    int loSwingKey = C_ST_NA
    int chochAborts = 0
    array<int> brokenKeys = array.new<int>()
    array<int> visOrder   = array.new<int>()
    array<StructEventRec> events = array.new<StructEventRec>()

    int ci = 0
    int si = 0
    int ri = 0
    int nc = array.size(closes)
    int ns = array.size(swingOrder)
    int nr = array.size(relOrder)
    int total = nc + ns + nr

    if total > 0
        for _p2e = 0 to total - 1
            // ---- pick the next event by (availability, kind) ----
            int pick  = -1
            int bestT = 0
            if ci < nc
                pick := 0
                bestT := array.get(availT, ci)
            if si < ns
                StructSwingView sv = array.get(views, array.get(swingOrder, si))
                if pick < 0 or sv.meaningfulConfTime < bestT
                    pick := 1
                    bestT := sv.meaningfulConfTime
            if ri < nr
                StructRelRec rr = array.get(rels, array.get(relOrder, ri))
                if pick < 0 or rr.availabilityTime < bestT
                    pick := 2
                    bestT := rr.availabilityTime

            if pick == 0
                float barClose = array.get(closes, ci)
                int   barAbs   = absFirst + ci

                // ---- P2-I7: CHOCH (transitions.py:170-175, :183-253).
                //
                // Exactly one candidate can be set, because the direction is
                // either BULLISH or BEARISH, never both. Strict, close-only:
                //   BEARISH and close > protectedHigh -> BULLISH_CHOCH
                //   BULLISH and close < protectedLow  -> BEARISH_CHOCH
                bool chochHigh = dir == C_ST_DIR_BEARISH and protHighIx >= 0 and barClose > array.get(views, protHighIx).pivotPrice
                bool chochLow  = dir == C_ST_DIR_BULLISH and protLowIx  >= 0 and barClose < array.get(views, protLowIx).pivotPrice

                if chochHigh or chochLow
                    // PRECEDENCE. Python handles CHOCH first and `continue`s past
                    // the BOS block on BOTH exits -- success (:253) and abort
                    // (:190/:224). So once the CHOCH predicate is true, BOS is
                    // never evaluated on this candle, whatever happens below.
                    // This `if` IS that precedence: there is no separate
                    // suppression path any more.
                    int chochBrokenIx = chochHigh ? protHighIx : protLowIx
                    StructSwingView chochBroken = array.get(views, chochBrokenIx)
                    int chochWant = chochHigh ? SWING_LOW : SWING_HIGH
                    // PRE-MUTATION ABORT. The replacement search happens BEFORE
                    // anything is consumed or written: Python tests the result
                    // for None and `continue`s while broken_ids, direction,
                    // protected, weak and the boundaries are all still untouched
                    // (:186-190 / :220-224). brokenKeys is deliberately NOT
                    // written above this line -- doing so would leak state on
                    // the abort path.
                    int chochReplIx = f_p2MostRecentUnbroken(views, visOrder, chochWant, brokenKeys)
                    if chochReplIx < 0
                        // ABORT: zero mutation, and BOS still skipped.
                        chochAborts := chochAborts + 1
                    else
                        array.push(brokenKeys, chochBroken.stableKey)
                        int chochAvail = math.max(array.get(availT, ci), chochBroken.meaningfulConfTime)
                        array.push(events, StructEventRec.new(chochHigh ? C_ST_TR_BULLISH_CHOCH : C_ST_TR_BEARISH_CHOCH, chochBroken.stableKey, chochBroken.pivotPrice, barClose, array.get(openT, ci), chochAvail, array.get(views, chochReplIx).stableKey))
                        // Only ONE boundary moves -- the NEW direction's weak
                        // side (:217 / :251). The opposite boundary is left
                        // exactly as it was.
                        if chochHigh
                            dir        := C_ST_DIR_BULLISH
                            protHighIx := -1
                            protLowIx  := chochReplIx
                            weakHighBoundaryAbs := barAbs
                        else
                            dir        := C_ST_DIR_BEARISH
                            protLowIx  := -1
                            protHighIx := chochReplIx
                            weakLowBoundaryAbs := barAbs
                        // BOTH weak levels clear -- unlike BOS, which clears only
                        // its own side (:215-216 / :249-250).
                        weakHighIx := -1
                        weakLowIx  := -1
                        lastChange := chochAvail
                else
                    // Strict, close-only, no tolerance (transitions.py:176-181).
                    bool bosHigh = dir == C_ST_DIR_BULLISH and weakHighIx >= 0 and barClose > array.get(views, weakHighIx).pivotPrice
                    bool bosLow  = dir == C_ST_DIR_BEARISH and weakLowIx  >= 0 and barClose < array.get(views, weakLowIx).pivotPrice
                    if bosHigh or bosLow
                        int brokenIx = bosHigh ? weakHighIx : weakLowIx
                        StructSwingView broken = array.get(views, brokenIx)
                        // Python consumes the broken swing BEFORE searching for a
                        // replacement (:260 precedes :262).
                        array.push(brokenKeys, broken.stableKey)
                        int wantType = bosHigh ? SWING_LOW : SWING_HIGH
                        int replIx   = f_p2MostRecentUnbroken(views, visOrder, wantType, brokenKeys)
                        int existing = bosHigh ? protLowIx : protHighIx
                        // DEFENSIVE FALLBACK (architecture doc 17.5a). Proven
                        // unreachable in valid production state and deliberately
                        // retained for structural parity with Python; it must not
                        // be optimised away, and no runtime assertion asserts the
                        // invariant here.
                        int newProtIx = replIx >= 0 ? replIx : existing
                        int availability = math.max(array.get(availT, ci), broken.meaningfulConfTime)
                        array.push(events, StructEventRec.new(bosHigh ? C_ST_TR_BULLISH_BOS : C_ST_TR_BEARISH_BOS, broken.stableKey, broken.pivotPrice, barClose, array.get(openT, ci), availability, newProtIx >= 0 ? array.get(views, newProtIx).stableKey : C_ST_NA))
                        if bosHigh
                            protLowIx  := newProtIx
                            weakHighIx := -1
                            weakHighBoundaryAbs := barAbs
                        else
                            protHighIx := newProtIx
                            weakLowIx  := -1
                            weakLowBoundaryAbs := barAbs
                        lastChange := availability
                ci := ci + 1

            else if pick == 1
                int vIx = array.get(swingOrder, si)
                StructSwingView vs = array.get(views, vIx)
                // Becomes eligible as a PROTECTED replacement candidate.
                array.push(visOrder, vIx)

                // ---- P2-I6: WEAK RE-ARM (transitions.py:328-353).
                //
                // Five conditions per side, and nothing else -- no price
                // relation, no relationship label, no protected-side relation:
                //   1 swing type matches the weak side
                //   2 direction matches
                //   3 the weak slot is UNSET
                //   4 pivot index STRICTLY past the boundary
                //   5 the swing is not already broken
                //
                // FIRST QUALIFYING SWING WINS -- not the newest. Condition 3
                // blocks every later candidate, so the slot fills once and is
                // never replaced; a swing passed over while the slot was
                // occupied does NOT return when it later empties. This is the
                // OPPOSITE of protected replacement, which deliberately takes
                // the NEWEST candidate, so f_p2MostRecentUnbroken must NOT be
                // used here.
                //
                // Condition 5 is defensive: a swing cannot already be broken at
                // its own SWING_VISIBLE, because broken keys always refer to
                // swings that were previously protected or weak and therefore
                // already visible. Retained deliberately (architecture 17.5a),
                // and no runtime assertion claims it cannot occur.
                //
                // ORIGIN-AGNOSTIC. This reads the boundary variables without
                // asking which transition wrote them, so when CHOCH lands it
                // will populate the same state with no change here. The boundary
                // is READ ONLY in this branch -- re-arming never moves it.
                if vs.swingType == SWING_HIGH and dir == C_ST_DIR_BULLISH and weakHighIx < 0 and vs.pivotStartAbs > weakHighBoundaryAbs and array.indexof(brokenKeys, vs.stableKey) < 0
                    weakHighIx := vIx
                    lastChange := lastChange == C_ST_NA ? vs.meaningfulConfTime : math.max(lastChange, vs.meaningfulConfTime)
                if vs.swingType == SWING_LOW and dir == C_ST_DIR_BEARISH and weakLowIx < 0 and vs.pivotStartAbs > weakLowBoundaryAbs and array.indexof(brokenKeys, vs.stableKey) < 0
                    weakLowIx := vIx
                    lastChange := lastChange == C_ST_NA ? vs.meaningfulConfTime : math.max(lastChange, vs.meaningfulConfTime)
                si := si + 1

            else
                StructRelRec r = array.get(rels, array.get(relOrder, ri))
                if f_p2RelIsHigh(r.relationshipCode)
                    hiLabel    := r.relationshipCode
                    hiSwingKey := r.swingKey
                else
                    loLabel    := r.relationshipCode
                    loSwingKey := r.swingKey
                if dir == C_ST_DIR_UNDETERMINED
                    if hiLabel == C_ST_REL_HIGHER_HIGH and loLabel == C_ST_REL_HIGHER_LOW
                        dir        := C_ST_DIR_BULLISH
                        protLowIx  := f_p2ViewIndexByKey(views, loSwingKey)
                        weakHighIx := f_p2ViewIndexByKey(views, hiSwingKey)
                        lastChange := r.availabilityTime
                    else if hiLabel == C_ST_REL_LOWER_HIGH and loLabel == C_ST_REL_LOWER_LOW
                        dir        := C_ST_DIR_BEARISH
                        protHighIx := f_p2ViewIndexByKey(views, hiSwingKey)
                        weakLowIx  := f_p2ViewIndexByKey(views, loSwingKey)
                        lastChange := r.availabilityTime
                ri := ri + 1

    int protHighKey = protHighIx >= 0 ? array.get(views, protHighIx).stableKey : C_ST_NA
    int protLowKey  = protLowIx  >= 0 ? array.get(views, protLowIx).stableKey  : C_ST_NA
    int weakHighKey = weakHighIx >= 0 ? array.get(views, weakHighIx).stableKey : C_ST_NA
    int weakLowKey  = weakLowIx  >= 0 ? array.get(views, weakLowIx).stableKey  : C_ST_NA
    [dir, protHighKey, protLowKey, weakHighKey, weakLowKey, lastChange, events, brokenKeys, weakHighBoundaryAbs, weakLowBoundaryAbs, chochAborts]

// =============================================================================
// EQUAL LEVELS — domain/equal_levels.py. Per type, ordered by meaningful
// confirmation time (record_id tiebreak replaced by deterministic
// (time, pivotEndTime, price) order — content preserved); grow a cluster while
// spread <= tolerance(median atr).
// =============================================================================
f_sweepEqualType(array<SwingRec> swings, int wantType) =>
    array<EqualLevelRec> out = array.new<EqualLevelRec>()
    idxs = array.new<int>()
    for [k, _u409] in swings
        if array.get(swings, k).swingType == wantType
            array.push(idxs, k)
    // insertion sort idxs by (meaningfulConfTime, pivotEndTime, price)
    for [a, _u413] in idxs
        if a < 1
            continue
        int key = array.get(idxs, a)
        SwingRec ks = array.get(swings, key)
        int b = a - 1
        bool placed = false
        while b >= 0 and not placed
            SwingRec bs = array.get(swings, array.get(idxs, b))
            bool greater = bs.meaningfulConfTime > ks.meaningfulConfTime or (bs.meaningfulConfTime == ks.meaningfulConfTime and (bs.pivotEndTime > ks.pivotEndTime or (bs.pivotEndTime == ks.pivotEndTime and bs.price > ks.price)))
            if greater
                array.set(idxs, b + 1, array.get(idxs, b))
                b -= 1
            else
                placed := true
        array.set(idxs, b + 1, key)

    members = array.new<int>()
    for [a, _u429] in idxs
        int si = array.get(idxs, a)
        bool closeIt = false
        if array.size(members) == 0
            array.push(members, si)
        else
            candPrices = array.new<float>()
            candAtrs = array.new<float>()
            for [m, _u437] in members
                SwingRec ms = array.get(swings, array.get(members, m))
                array.push(candPrices, ms.price)
                array.push(candAtrs, ms.referenceAtr)
            array.push(candPrices, array.get(swings, si).price)
            array.push(candAtrs, array.get(swings, si).referenceAtr)
            float refAtr = f_medianConsume(candAtrs)
            float tol = C_EQUAL_LEVEL_TOL_ATR * refAtr
            float spread = array.max(candPrices) - array.min(candPrices)
            if spread <= tol
                array.push(members, si)
            else
                closeIt := true
        if closeIt
            if array.size(members) >= 2
                prices = array.new<float>()
                atrs = array.new<float>()
                int firstT = na
                int confT = na
                for [m, _u456] in members
                    SwingRec ms = array.get(swings, array.get(members, m))
                    array.push(prices, ms.price)
                    array.push(atrs, ms.referenceAtr)
                    firstT := na(firstT) ? ms.meaningfulConfTime : math.min(firstT, ms.meaningfulConfTime)
                    confT := na(confT) ? ms.meaningfulConfTime : math.max(confT, ms.meaningfulConfTime)
                float refAtr = f_medianConsume(atrs)
                float zb = array.min(prices)
                float zt = array.max(prices)
                array.push(out, EqualLevelRec.new(wantType, zb, zt, (zb + zt) / 2.0, zt - zb, C_EQUAL_LEVEL_TOL_ATR * refAtr, array.size(members), firstT, confT))
            array.clear(members)
            array.push(members, si)
    // final close
    if array.size(members) >= 2
        prices = array.new<float>()
        atrs = array.new<float>()
        int firstT = na
        int confT = na
        for [m, _u474] in members
            SwingRec ms = array.get(swings, array.get(members, m))
            array.push(prices, ms.price)
            array.push(atrs, ms.referenceAtr)
            firstT := na(firstT) ? ms.meaningfulConfTime : math.min(firstT, ms.meaningfulConfTime)
            confT := na(confT) ? ms.meaningfulConfTime : math.max(confT, ms.meaningfulConfTime)
        float refAtr = f_medianConsume(atrs)
        float zb = array.min(prices)
        float zt = array.max(prices)
        array.push(out, EqualLevelRec.new(wantType, zb, zt, (zb + zt) / 2.0, zt - zb, C_EQUAL_LEVEL_TOL_ATR * refAtr, array.size(members), firstT, confT))
    out

f_detectEqualLevels(array<SwingRec> swings) =>
    out = array.new<EqualLevelRec>()
    highs = f_sweepEqualType(swings, SWING_HIGH)
    lows = f_sweepEqualType(swings, SWING_LOW)
    for [i, _u490] in highs
        array.push(out, array.get(highs, i))
    for [i, _u492] in lows
        array.push(out, array.get(lows, i))
    out

// =============================================================================
// LEG MEASUREMENT — measurements/legs.py measure_leg. Returns
// [classification (2=STRONG_FAST,1=FAST,0=SLOW/UNCLEAR), dirEfficiency, dirShare].
// =============================================================================
f_measureLeg(array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, int startIncl, int endIncl, bool isBull) =>
    int barCount = endIncl - startIncl + 1
    int classification = 0
    float dirEff = 0.0
    float dirShare = 0.0
    if barCount > 0
        float startPrice = array.get(opens, startIncl)
        float endPrice = array.get(closes, endIncl)
        float netDist = math.abs(endPrice - startPrice)
        atrs = array.new<float>()
        float legPath = 0.0
        int dirCloses = 0
        for i = startIncl to endIncl
            float av = array.get(atr, i)
            if not na(av)
                array.push(atrs, av)
            legPath += array.get(highs, i) - array.get(lows, i)
            bool dir = isBull ? array.get(closes, i) >= array.get(opens, i) : array.get(closes, i) <= array.get(opens, i)
            if dir
                dirCloses += 1
        float refAtr = f_medianConsume(atrs)
        dirShare := dirCloses / barCount
        if refAtr != 0.0 and legPath != 0.0
            float normSpeed = netDist / (barCount * refAtr)
            dirEff := netDist / legPath
            if normSpeed >= C_LEG_STRONG_SPEED and dirEff >= C_LEG_STRONG_EFF and dirShare >= C_LEG_STRONG_SHARE
                classification := 2
            else if normSpeed >= C_LEG_FAST_SPEED and dirEff >= C_LEG_FAST_EFF and dirShare >= C_LEG_FAST_SHARE
                classification := 1
    [classification, dirEff, dirShare]

// =============================================================================
// P1-SR-PERF-2 — INCREMENTAL SUPPORT/RESISTANCE REACTION FRONTIER
//
// support_resistance.py:80 searches `range(search_start_index, n)` for the
// reaction start and then evaluates a bounded window from there, so a reaction
// resolves as candles arrive, independently of swings — analyzer.py:923 states
// the requirement outright. P1-CLOSEOUT therefore lifted S/R out of the
// swing-change gate, but recomputing the whole detector every confirmed bar put
// the script back on TradingView's Basic 20s boundary (intermittent RE10110 on
// M1).
//
// This frontier keeps the corrected publication timing and removes the rescan.
// Per confirmed bar it advances only UNRESOLVED trackers; the origin x touch
// walk re-runs only when the swing set or some tracker's resolution actually
// changed, because the walk's output is a pure function of exactly those two
// things. Everything else is carried forward.
//
// A tracker is identified by (originAbs, searchStartAbs) — both absolute
// confirmed-bar indices, so a window shift cannot invalidate the key, and no
// UUID or random identity is introduced. Keys are packed into one int and kept
// ASCENDING, which makes retirement a prefix removal: the origin index lives in
// the high bits, so "every tracker whose origin has left the window" is exactly
// the front of the array.
//
// Window safety: a tracker is retired the moment its origin leaves the active
// window, and originAbs < reactionStartAbs < confirmingAbs < end always holds,
// so a live tracker can never reference a candle that has already scrolled out.
//
// The algorithm is validated against the production Python implementation at
// every prefix — including the 300-bar rollover — in
// tests/unit/test_pine_p1_sr_frontier_model.py.
// =============================================================================

// Key stride: 2^22. Both components are absolute bar indices, so this is safe
// for any chart shorter than 4,194,304 confirmed bars.
int C_SR_KEY_STRIDE = 4194304

// Index of `key` in an ascending array, or -1.
f_srFind(array<int> keys, int key) =>
    int lo = 0
    int hi = array.size(keys) - 1
    int found = -1
    while lo <= hi
        int mid = int((lo + hi) / 2)
        int probe = array.get(keys, mid)
        if probe == key
            found := mid
            break
        if probe < key
            lo := mid + 1
        else
            hi := mid - 1
    found

// First position in an ascending array whose key is >= `key`.
f_srLowerBound(array<int> keys, int key) =>
    int lo = 0
    int hi = array.size(keys)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(keys, mid) < key
            lo := mid + 1
        else
            hi := mid
    lo

// Advance one tracker by the candles that have arrived since it was last seen.
// Returns a tracker whose confirmingAbs is what a full _evaluate_reaction over
// the candles available NOW would return — reached without any rescan:
//   * before the reaction starts, each candle is examined at most ONCE per
//     tracker, and the anchor is accumulated in that same pass (which also
//     keeps it valid after the window's left edge passes searchStart);
//   * after it starts, only the bounded <= C_REACTION_WINDOW_BARS slice is read,
//     at most C_REACTION_WINDOW_BARS times, before `permanent` latches.
f_advanceSRTracker(SRTracker t, array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, array<int> availT, int absFirst) =>
    SRTracker outT = t
    if not t.permanent
        int nAbs = absFirst + array.size(highs)
        float zoneHeight = t.zoneTop - t.zoneBottom
        if zoneHeight <= 0.0
            outT := SRTracker.new(t.originAbs, t.searchStartAbs, t.zoneTop, t.zoneBottom, t.isSupport, nAbs - 1, na, na, true, na, na)
        else
            int reactionStart = t.reactionStartAbs
            float anchor = t.anchor
            int lastChecked = t.lastCheckedAbs
            if na(reactionStart)
                int scanFrom = math.max(lastChecked + 1, t.searchStartAbs)
                int i = scanFrom
                while i < nAbs
                    int w = i - absFirst
                    float extreme = t.isSupport ? array.get(lows, w) : array.get(highs, w)
                    anchor := na(anchor) ? extreme : (t.isSupport ? math.min(anchor, extreme) : math.max(anchor, extreme))
                    bool breached = t.isSupport ? (array.get(closes, w) > t.zoneTop) : (array.get(closes, w) < t.zoneBottom)
                    if breached
                        reactionStart := i
                        break
                    i += 1
                lastChecked := nAbs - 1
            if na(reactionStart)
                outT := SRTracker.new(t.originAbs, t.searchStartAbs, t.zoneTop, t.zoneBottom, t.isSupport, lastChecked, na, anchor, false, na, na)
            else
                int windowEnd = math.min(reactionStart + C_REACTION_WINDOW_BARS, nAbs)  // exclusive
                bool isFull = windowEnd == reactionStart + C_REACTION_WINDOW_BARS
                int confAbs = na
                int confTime = na
                if windowEnd > reactionStart
                    int rsW = reactionStart - absFirst
                    int weW = windowEnd - absFirst
                    float mfe = na
                    float zoneClearance = na
                    int mfeW = rsW
                    if t.isSupport
                        float hh = array.get(highs, rsW)
                        for i2 = rsW to weW - 1
                            if array.get(highs, i2) > hh
                                hh := array.get(highs, i2)
                                mfeW := i2
                        mfe := hh - anchor
                        zoneClearance := math.max(0.0, hh - t.zoneTop)
                    else
                        float ll = array.get(lows, rsW)
                        for i2 = rsW to weW - 1
                            if array.get(lows, i2) < ll
                                ll := array.get(lows, i2)
                                mfeW := i2
                        mfe := anchor - ll
                        zoneClearance := math.max(0.0, t.zoneBottom - ll)
                    float refAtr = array.get(atr, rsW)
                    if not na(refAtr) and refAtr != 0.0
                        float atrRatio = mfe / refAtr
                        float clearanceRatio = zoneClearance / zoneHeight
                        [legClass, legEff, legShare] = f_measureLeg(highs, lows, opens, closes, atr, rsW, mfeW, t.isSupport)
                        if atrRatio >= C_REACTION_STD_ATR_RATIO and clearanceRatio >= C_REACTION_STD_ZONE_CLEAR_RATIO and legEff >= C_REACTION_STD_DIR_EFF and legShare >= C_REACTION_STD_DIR_SHARE
                            confAbs := reactionStart + (mfeW - rsW)
                            confTime := array.get(availT, mfeW)
                outT := SRTracker.new(t.originAbs, t.searchStartAbs, t.zoneTop, t.zoneBottom, t.isSupport, lastChecked, reactionStart, anchor, isFull, confAbs, confTime)
    outT

// Find the tracker for (originAbs, searchStartAbs), creating and advancing it on
// first sight. Returns its index in the ascending key/tracker arrays.
f_srTrackerIndex(array<int> keys, array<SRTracker> trk, int originAbs, int searchStartAbs, float zoneTop, float zoneBottom, bool isSupport, array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, array<int> availT, int absFirst) =>
    int key = originAbs * C_SR_KEY_STRIDE + searchStartAbs
    int idx = f_srFind(keys, key)
    if idx < 0
        SRTracker fresh = SRTracker.new(originAbs, searchStartAbs, zoneTop, zoneBottom, isSupport, searchStartAbs - 1, na, na, false, na, na)
        SRTracker advanced = f_advanceSRTracker(fresh, highs, lows, opens, closes, atr, availT, absFirst)
        int pos = f_srLowerBound(keys, key)
        array.insert(keys, pos, key)
        array.insert(trk, pos, advanced)
        idx := pos
    idx


// =============================================================================
// P1-SR-PERF-3 — fold-cache helpers.
//
// Every loop below is bounded by A (confirmed swings inside the 300-bar window;
// measured max 73, theoretical max 150) or by F (cached folds, F <= A). No loop
// crosses two unbounded collections, and no array is mutated while an index into
// it is being reused.
// =============================================================================

// Index of `key` in a fold array kept ascending by originKey, or -1. Safe on an
// empty array: hi = -1 makes the loop body unreachable.
f_srFoldFind(array<SRFold> folds, int key) =>
    int lo = 0
    int hi = array.size(folds) - 1
    int found = -1
    while lo <= hi
        int mid = int((lo + hi) / 2)
        int probe = array.get(folds, mid).originKey
        if probe == key
            found := mid
            break
        if probe < key
            lo := mid + 1
        else
            hi := mid - 1
    found

// First position whose originKey is >= key. Safe on an empty array: returns 0.
f_srFoldLowerBound(array<SRFold> folds, int key) =>
    int lo = 0
    int hi = array.size(folds)
    while lo < hi
        int mid = int((lo + hi) / 2)
        if array.get(folds, mid).originKey < key
            lo := mid + 1
        else
            hi := mid
    lo

// Is `key` present among the live swings? They are ascending by pivotEndTime, so
// this is a binary search. Safe on an empty array.
f_srSwingHasKey(array<SwingRec> swings, int key) =>
    int lo = 0
    int hi = array.size(swings) - 1
    bool found = false
    while lo <= hi
        int mid = int((lo + hi) / 2)
        int probe = array.get(swings, mid).pivotEndTime
        if probe == key
            found := true
            break
        if probe < key
            lo := mid + 1
        else
            hi := mid - 1
    found

// Insertion sort SRCand by meaningfulConfTime. The size never changes, so
// iterating with `for ... in` while reordering elements is safe, and the a < 1
// guard keeps the counted prefix out of Pine's reversed-range trap. The previous
// build ran this sort on EVERY walk; it now runs only on a swing delta.
f_srSortCandByConfTime(array<SRCand> cands) =>
    for [a, _u910] in cands
        if a < 1
            continue
        SRCand keyCand = array.get(cands, a)
        int b = a - 1
        bool placed = false
        while b >= 0 and not placed
            if array.get(cands, b).meaningfulConfTime > keyCand.meaningfulConfTime
                array.set(cands, b + 1, array.get(cands, b))
                b -= 1
            else
                placed := true
        array.set(cands, b + 1, keyCand)

// Rebuild the orientation candidate lists and the ascending snapshot. O(A) plus
// two insertion sorts over a small A. Absolute indices are baked in here, once.
f_srRebuildCandidates(array<SwingRec> swings, int absFirst, array<SRCand> candS, array<SRCand> candR, array<int> oppS, array<int> oppR, array<SRCand> snap) =>
    array.clear(candS)
    array.clear(candR)
    array.clear(oppS)
    array.clear(oppR)
    array.clear(snap)
    for [k, _u911] in swings
        SwingRec sw = array.get(swings, k)
        SRCand cand = SRCand.new(sw.pivotEndTime, sw.swingType, sw.price, sw.referenceAtr, sw.meaningfulConfTime, sw.pivotEndIdx + absFirst)
        array.push(snap, cand)
        if sw.swingType == SWING_LOW
            array.push(candS, cand)
            array.push(oppR, sw.meaningfulConfTime)
        else
            array.push(candR, cand)
            array.push(oppS, sw.meaningfulConfTime)
    f_srSortCandByConfTime(candS)
    f_srSortCandByConfTime(candR)
    array.sort(oppS, order.ascending)
    array.sort(oppR, order.ascending)

// Apply a swing delta to the fold cache.
//
// The delta itself is an O(A) merge of two ascending-by-key lists — the previous
// snapshot and the live swing set — so it never scans the old array once per new
// item. Invalidation then follows the rule proven in the model:
//
//   * an OPPOSITE-type change feeds the has-opposite-between test for every
//     origin of that orientation, so it takes the whole orientation;
//   * a SAME-type change can only alter a fold if it lies inside that origin's
//     zone, because zone geometry is the fold's first gate on every touch and
//     depends on nothing else;
//   * an origin that no longer exists retires outright.
//
// Retirement rebuilds the array from survivors instead of removing by index, so
// no index can be invalidated mid-loop — safe for empty, single, adjacent, first,
// last and all-removed cases alike.
f_srApplyDelta(array<SwingRec> swings, array<SRCand> snap, array<SRFold> folds, array<SRFold> keep) =>
    chgType  = array.new<int>()
    chgPrice = array.new<float>()
    int i = 0
    int j = 0
    int oldN = array.size(snap)
    int newN = array.size(swings)
    while i < oldN or j < newN
        bool haveOld = i < oldN
        bool haveNew = j < newN
        bool takeOld = false
        bool takeNew = false
        // The two keys are read ONLY where both cursors are in range, so neither
        // is ever na and neither array is ever indexed one past the end. That
        // also keeps the comparison out of Pine's na-comparison trap, which is
        // the defect class that produced the original zero-swing bug.
        if haveOld and haveNew
            int oldKey = array.get(snap, i).key
            int newKey = array.get(swings, j).pivotEndTime
            if oldKey == newKey
                i += 1
                j += 1
            else if oldKey < newKey
                takeOld := true
            else
                takeNew := true
        else if haveOld
            takeOld := true
        else
            takeNew := true
        if takeOld
            SRCand gone = array.get(snap, i)
            array.push(chgType, gone.swingType)
            array.push(chgPrice, gone.price)
            i += 1
        if takeNew
            SwingRec added = array.get(swings, j)
            array.push(chgType, added.swingType)
            array.push(chgPrice, added.price)
            j += 1

    bool supportOppDelta = false
    bool resistOppDelta = false
    for [c, _u912] in chgType
        if array.get(chgType, c) == SWING_HIGH
            supportOppDelta := true    // a HIGH is the opposite of a SUPPORT origin
        else
            resistOppDelta := true

    array.clear(keep)
    for [f, _u913] in folds
        SRFold fold = array.get(folds, f)
        bool isSupport = fold.originType == SWING_LOW
        bool drop = not f_srSwingHasKey(swings, fold.originKey)
        if not drop and (isSupport ? supportOppDelta : resistOppDelta)
            drop := true
        if not drop
            float touchTol = C_SR_TOUCH_TOL_ATR * fold.referenceAtr
            float pierceTol = C_SR_PIERCE_TOL_ATR * fold.referenceAtr
            for [c2, _u914] in chgType
                if not drop and array.get(chgType, c2) == fold.originType
                    float p = array.get(chgPrice, c2)
                    bool inside = isSupport ? (p <= fold.zoneTop + touchTol and p >= fold.zoneBottom - pierceTol) : (p >= fold.zoneBottom - touchTol and p <= fold.zoneTop + pierceTol)
                    if inside
                        drop := true
        if not drop
            array.push(keep, fold)
    array.clear(folds)
    for [g, _u915] in keep
        array.push(folds, array.get(keep, g))

// =============================================================================
// SUPPORT / RESISTANCE WALK — domain/support_resistance.detect_support_resistance_zones.
//
// Identical control flow, ordering and tie-breaking to the previous batch
// detector; the ONLY change is that each reaction evaluation is now a tracker
// lookup instead of a forward scan. The `has opposite between` existence test
// also uses a monotone cursor over the opposite-type confirmation times rather
// than rescanning every swing per touch — `oi` is ascending by confirmation
// time and `lastTouchTime` never decreases, so the cursor only moves forward.
// =============================================================================
f_walkSR(array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> atr, array<int> availT, array<SRCand> candS, array<SRCand> candR, array<int> oppS, array<int> oppR, array<SRFold> folds, array<int> dirty, array<int> keys, array<SRTracker> trk, int absFirst) =>
    array<SRRec> out = array.new<SRRec>()
    for ot = 0 to 1
        bool isSupport = ot == 0
        int originType = isSupport ? SWING_LOW : SWING_HIGH
        array<SRCand> oi = isSupport ? candS : candR
        array<int> opp = isSupport ? oppS : oppR

        for [oo, _u615] in oi
            SRCand origin = array.get(oi, oo)

            // P1-SR-PERF-3: reuse this origin's fold unless one of ITS OWN
            // reactions moved. Everything else the fold depends on — ordering,
            // geometry, the opposite-swing test — is swing-derived, and a swing
            // change has already invalidated the affected folds via f_srApplyDelta.
            bool isDirty = false
            for [d, _u916] in dirty
                if array.get(dirty, d) == origin.pivotEndAbs
                    isDirty := true
                    break
            int foldIdx = f_srFoldFind(folds, origin.key)
            if foldIdx >= 0 and not isDirty
                SRFold cached = array.get(folds, foldIdx)
                if cached.hasZone
                    array.push(out, SRRec.new(cached.originType, cached.zoneTop, cached.zoneBottom, cached.zoneDepth, cached.touchCount, cached.confirmationTime))
                continue

            float zoneDepth = C_SR_ZONE_DEPTH_ATR * origin.referenceAtr
            float zoneTop = na
            float zoneBottom = na
            if isSupport
                zoneBottom := origin.price
                zoneTop := zoneBottom + zoneDepth
            else
                zoneTop := origin.price
                zoneBottom := zoneTop - zoneDepth
            int originTi = f_srTrackerIndex(keys, trk, origin.pivotEndAbs, origin.pivotEndAbs + 1, zoneTop, zoneBottom, isSupport, highs, lows, opens, closes, atr, availT, absFirst)
            int touchCount = 0
            int firstConfTime = na
            if not na(array.get(trk, originTi).confirmingAbs)
                float touchTol = C_SR_TOUCH_TOL_ATR * origin.referenceAtr
                float pierceTol = C_SR_PIERCE_TOL_ATR * origin.referenceAtr
                int lastTouchTime = origin.meaningfulConfTime
                int cursor = 0
                for [tt, _u634] in oi
                    SRCand touch = array.get(oi, tt)
                    if touch.meaningfulConfTime > lastTouchTime
                        bool geomOk = isSupport ? (touch.price <= zoneTop + touchTol and touch.price >= zoneBottom - pierceTol) : (touch.price >= zoneBottom - touchTol and touch.price <= zoneTop + pierceTol)
                        if geomOk
                            while cursor < array.size(opp) and array.get(opp, cursor) <= lastTouchTime
                                cursor += 1
                            bool oppositeBetween = cursor < array.size(opp) and array.get(opp, cursor) < touch.meaningfulConfTime
                            if oppositeBetween
                                int touchTi = f_srTrackerIndex(keys, trk, origin.pivotEndAbs, touch.pivotEndAbs + 1, zoneTop, zoneBottom, isSupport, highs, lows, opens, closes, atr, availT, absFirst)
                                SRTracker touchTracker = array.get(trk, touchTi)
                                if not na(touchTracker.confirmingAbs)
                                    touchCount += 1
                                    if na(firstConfTime)
                                        firstConfTime := touchTracker.confirmingTime
                                    lastTouchTime := touch.meaningfulConfTime
            bool hasZone = not na(firstConfTime)
            SRFold fresh = SRFold.new(origin.key, origin.pivotEndAbs, originType, zoneTop, zoneBottom, origin.referenceAtr, zoneDepth, hasZone, touchCount, firstConfTime)
            if foldIdx >= 0
                array.set(folds, foldIdx, fresh)
            else
                array.insert(folds, f_srFoldLowerBound(folds, origin.key), fresh)
            if hasZone
                array.push(out, SRRec.new(originType, zoneTop, zoneBottom, zoneDepth, touchCount, firstConfTime))

    // P1-SR-ORDERING: Python closes detect_support_resistance_zones with
    // `results.sort(key=confirmation_time_utc)` (support_resistance.py:303), and
    // list.sort is STABLE — so equal confirmation times keep the insertion order
    // built above (SUPPORT orientation first, then RESISTANCE; within each,
    // ascending origin meaningfulConfTime). Pine had no final sort at all, which
    // let it publish an older zone than Python's canonical latest whenever both
    // directions qualified. Both halves of the rule are reproduced explicitly
    // with a composite (confirmationTime, insertionIndex) key, so nothing rests
    // on incidental Pine array behaviour. Runs only when the resolved set is
    // rebuilt, and the set is tiny (bounded by the qualifying origins).
    ordIdx = array.new<int>()
    for [z0, _u860] in out
        array.push(ordIdx, z0)
    for [a2, _u862] in ordIdx
        if a2 < 1
            continue
        int keyIdx = array.get(ordIdx, a2)
        int keyTime = array.get(out, keyIdx).confirmationTime
        int b2 = a2 - 1
        bool placed2 = false
        while b2 >= 0 and not placed2
            int probeIdx = array.get(ordIdx, b2)
            int probeTime = array.get(out, probeIdx).confirmationTime
            if probeTime > keyTime or (probeTime == keyTime and probeIdx > keyIdx)
                array.set(ordIdx, b2 + 1, probeIdx)
                b2 -= 1
            else
                placed2 := true
        array.set(ordIdx, b2 + 1, keyIdx)
    ordered = array.new<SRRec>()
    for [s2, _u876] in ordIdx
        array.push(ordered, array.get(out, array.get(ordIdx, s2)))
    ordered

// =============================================================================
// TRENDLINES — domain/trendlines.detect_trendlines.
// =============================================================================
f_detectTrendlines(array<float> closes, array<float> atr, array<SwingRec> swings, array<float> atrSlice) =>
    array<TrendlineRec> out = array.new<TrendlineRec>()
    orientTypes = array.from(SWING_LOW, SWING_HIGH)  // BULLISH uses lows, BEARISH uses highs
    for ot = 0 to 1
        int orientation = array.get(orientTypes, ot)
        bool isBull = orientation == SWING_LOW
        si = array.new<int>()
        for [k, _u665] in swings
            if array.get(swings, k).swingType == orientation
                array.push(si, k)
        // order by pivotEndIdx (insertion sort)
        for [a, _u669] in si
            if a < 1
                continue
            int key = array.get(si, a)
            int b = a - 1
            bool placed = false
            while b >= 0 and not placed
                if array.get(swings, array.get(si, b)).pivotEndIdx > array.get(swings, key).pivotEndIdx
                    array.set(si, b + 1, array.get(si, b))
                    b -= 1
                else
                    placed := true
            array.set(si, b + 1, key)

        for [i, _u681] in si
            SwingRec a1 = array.get(swings, array.get(si, i))
            int a1Idx = a1.pivotEndIdx
            // P1-PERF-1: `si` is ordered by pivotEndIdx, so for a fixed first
            // anchor the ATR slice [a1Idx .. a2Idx] only ever GROWS as j advances.
            // Rebuilding and re-allocating it for every candidate pair re-read the
            // same bars O(pairs) times; instead extend one reused buffer. The
            // median is over a multiset, so growth order is irrelevant.
            array.clear(atrSlice)
            int slicedTo = a1Idx - 1
            for [j, _u684] in si
                if j <= i
                    continue
                SwingRec a2 = array.get(swings, array.get(si, j))
                int a2Idx = a2.pivotEndIdx
                if a2Idx - a1Idx >= C_TL_MIN_ANCHOR_SPACING
                    bool progressOk = isBull ? (a2.price > a1.price + a1.tieTolerance) : (a2.price < a1.price - a1.tieTolerance)
                    if progressOk
                        float rawSlope = (a2.price - a1.price) / (a2Idx - a1Idx)
                        if a2Idx > slicedTo
                            for bi = slicedTo + 1 to a2Idx
                                float av = array.get(atr, bi)
                                if not na(av)
                                    array.push(atrSlice, av)
                            slicedTo := a2Idx
                        if array.size(atrSlice) > 0
                            float refAtr = f_medianConsume(atrSlice)
                            if refAtr != 0.0
                                float normSlope = math.abs(rawSlope) / refAtr
                                if normSlope >= C_TL_HORIZONTAL_ATR and normSlope <= C_TL_TOO_STEEP_ATR
                                    float pierceTol = C_TL_PIERCE_TOL_ATR * refAtr
                                    float touchTol = C_TL_TOUCH_TOL_ATR * refAtr
                                    // P1-PERF-1: stop at the first pierce instead of
                                    // scanning the remaining bars with the result
                                    // already decided. Same verdict, fewer reads.
                                    bool integrityOk = true
                                    int ii = a1Idx + 1
                                    while ii <= a2Idx - 1
                                        float projected = a1.price + rawSlope * (ii - a1Idx)
                                        float cc = array.get(closes, ii)
                                        if isBull
                                            if projected - cc > pierceTol
                                                integrityOk := false
                                                break
                                        else
                                            if cc - projected > pierceTol
                                                integrityOk := false
                                                break
                                        ii += 1
                                    if integrityOk
                                        // P1-PERF-1: `si` is ascending by pivotEndIdx,
                                        // so the first qualifying touch encountered is
                                        // the one the original scan kept; break there.
                                        int confTime = na
                                        for [t, _u716] in si
                                            SwingRec touch = array.get(swings, array.get(si, t))
                                            int tIdx = touch.pivotEndIdx
                                            if tIdx > a2Idx
                                                float projected = a1.price + rawSlope * (tIdx - a1Idx)
                                                float diff = isBull ? (touch.price - projected) : (projected - touch.price)
                                                bool qualifies = math.abs(diff) <= touchTol or (diff >= -pierceTol and diff < -touchTol)
                                                if qualifies
                                                    confTime := touch.meaningfulConfTime
                                                    break
                                        if not na(confTime)
                                            array.push(out, TrendlineRec.new(orientation, a1.price, a2.price, a1.pivotEndTime, a2.pivotEndTime, rawSlope, normSlope, confTime))
    out

// =============================================================================
// DISPLACEMENT — domain/displacement for the most-recent confirmed candle.
// =============================================================================
f_latestDisplacement(array<float> highs, array<float> lows, array<float> opens, array<float> closes, array<float> scratch) =>
    int n = array.size(highs)
    int code = na
    float ratio = na
    if n > C_RANGE_CONTEXT_WINDOW
        int idx = n - 1
        float rangeValue = array.get(highs, idx) - array.get(lows, idx)
        int cls = 0
        if rangeValue == 0.0
            ratio := 0.0
            cls := 0
        else
            float baseline = f_medianRange(highs, lows, idx - C_RANGE_CONTEXT_WINDOW, idx, scratch)
            ratio := baseline == 0.0 ? 0.0 : rangeValue / baseline
            cls := ratio >= C_DISP_VERY_FAST_RATIO ? 2 : (ratio >= C_DISP_FAST_RATIO ? 1 : 0)
        bool isBull = array.get(closes, idx) >= array.get(opens, idx)
        code := isBull ? cls : -cls
    [code, ratio]

// =============================================================================
// MAIN — advance state ONLY on confirmed/closed bars (non-repaint).
// =============================================================================
if barstate.isconfirmed
    // ---- exact incremental Wilder ATR for THIS candle ----
    float tr = f_trueRange(high, low, atrPrevClose)
    float atrValue = na
    if not na(atrPrevFinal)
        atrValue := (atrPrevFinal * (C_ATR_PERIOD - 1) + tr) / C_ATR_PERIOD
        atrPrevFinal := atrValue
    else
        atrWarmSum := atrWarmSum + tr
        atrWarmCount := atrWarmCount + 1
        if atrWarmCount < C_ATR_PERIOD
            atrValue := na
        else
            atrValue := atrWarmSum / C_ATR_PERIOD
            atrPrevFinal := atrValue
    atrPrevClose := close

    // ---- push into rolling window; prune to lookbackWindow ----
    confirmedBarCount := confirmedBarCount + 1
    array.push(wHigh, high)
    array.push(wLow, low)
    array.push(wOpen, open)
    array.push(wClose, close)
    array.push(wOpenT, time)
    array.push(wAvailT, time_close)
    array.push(wAtr, atrValue)
    while array.size(wHigh) > lookbackWindow
        array.shift(wHigh)
        array.shift(wLow)
        array.shift(wOpen)
        array.shift(wClose)
        array.shift(wOpenT)
        array.shift(wAvailT)
        array.shift(wAtr)

    // ---- displacement (latest confirmed candle) ----
    [dispCode, dispRatio] = f_latestDisplacement(wHigh, wLow, wOpen, wClose, scDispRange)
    latestDispCode := dispCode
    latestDispRatio := dispRatio

    // ---- single-candle pivot frontier: decide ONE new candle, retire stale ----
    int absFirst = confirmedBarCount - array.size(wHigh)
    f_advancePivotFrontier(wHigh, wLow, wAtr, absFirst, pvAbs, pvType, pvPrice, pvAtr, pvTie)

    // ---- swing pipeline (every confirmed bar, from the maintained frontier) ----
    array<SwingRec> swings = f_detectSwings(wHigh, wLow, wOpenT, wAvailT, wAtr, pvAbs, pvType, pvPrice, pvAtr, pvTie, absFirst)

    // ---- P2-I2: canonical swing view. Built from CONFIRMED P1 state only, so a
    // forming bar cannot move it; no P1 value reads it back.
    array<StructSwingView> p2Swings = f_p2BuildSwingView(swings, wOpenT, absFirst)
    p2SwingCount := array.size(p2Swings)
    p2LastKey := na
    p2LastType := na
    p2LastPrice := na
    p2LastAtr := na
    p2LastConfTime := na
    p2LastStartAbs := na
    if p2SwingCount > 0
        StructSwingView lastView = array.get(p2Swings, p2SwingCount - 1)
        p2LastKey := lastView.stableKey
        p2LastType := lastView.swingType
        p2LastPrice := lastView.pivotPrice
        p2LastAtr := lastView.referenceAtr
        p2LastConfTime := lastView.meaningfulConfTime
        p2LastStartAbs := lastView.pivotStartAbs

    // ---- P2-I3: relationship labels. Derived purely from the adapted view, so
    // it inherits the confirmed-bar gate; no candle or forming-bar value is read.
    array<StructRelRec> p2Rels = f_p2BuildRelationships(p2Swings)
    p2RelCount := array.size(p2Rels)
    p2LastHighRel := na
    p2LastLowRel := na
    for [ri, _p2d] in p2Rels
        StructRelRec r = array.get(p2Rels, ri)
        if r.relationshipCode == C_ST_REL_HIGHER_HIGH or r.relationshipCode == C_ST_REL_LOWER_HIGH or r.relationshipCode == C_ST_REL_EQUAL_HIGH
            p2LastHighRel := r.relationshipCode
        else
            p2LastLowRel := r.relationshipCode

    // ---- P2-I4 + P2-I5: merged structure walk (bootstrap + BOS). Consumes only
    // CONFIRMED window state -- wClose/wOpenT/wAvailT are pushed above from the
    // just-closed bar -- so it inherits the confirmed-bar gate and never reads a
    // forming value, an intrabar price, or a wick.
    [p2bDir, p2bProtHigh, p2bProtLow, p2bWeakHigh, p2bWeakLow, _p2bLastChange, p2bEvents, _p2bBroken, p2bWhBound, p2bWlBound, p2bAborts] = f_p2StructureWalk(p2Swings, p2Rels, f_p2OrderRelationships(p2Rels), f_p2OrderSwings(p2Swings), wClose, wAvailT, wOpenT, absFirst)
    p2Direction   := p2bDir
    p2ProtHighKey := p2bProtHigh
    p2ProtLowKey  := p2bProtLow
    p2WeakHighKey := p2bWeakHigh
    p2WeakLowKey  := p2bWeakLow
    p2WeakHighBound := p2bWhBound
    p2WeakLowBound  := p2bWlBound
    p2ChochAborts   := p2bAborts
    p2TransCount    := array.size(p2bEvents)
    p2LastTransCode := C_ST_NA
    p2LastBrokenKey := C_ST_NA
    p2LastBrokenLvl := na
    if p2TransCount > 0
        StructEventRec lastEv = array.get(p2bEvents, p2TransCount - 1)
        p2LastTransCode := lastEv.transitionCode
        p2LastBrokenKey := lastEv.brokenSwingKey
        p2LastBrokenLvl := lastEv.brokenLevel

    // Latest confirmed of each direction. The list is append-ordered, so the last
    // entry of each type wins; scanning backwards lets us stop as soon as both
    // directions are known.
    int sc = array.size(swings)
    bool haveHigh = false
    bool haveLow = false
    int si2 = sc - 1
    while si2 >= 0 and not (haveHigh and haveLow)
        SwingRec s = array.get(swings, si2)
        if s.swingType == SWING_HIGH
            if not haveHigh
                latestSwingHighPrice := s.price
                latestSwingHighTime := s.pivotEndTime
                haveHigh := true
        else
            if not haveLow
                latestSwingLowPrice := s.price
                latestSwingLowTime := s.pivotEndTime
                haveLow := true
        si2 -= 1

    // ---- swing-set fingerprint (needed by BOTH gates below) ----
    // P1-PERF-1: (count, last confirmation time) alone could not see a change
    // confined to the MIDDLE of the list — which the window's left edge can cause,
    // because the alternation chain is re-seeded at that edge on every bar. The
    // fingerprint below is an order-sensitive rolling accumulator over EVERY
    // member, so a same-length reshuffle is detected too. It is O(S) and cheap,
    // and it can only ever trigger MORE recomputation than before, never less.
    int newCount = sc
    int newConfTime = sc > 0 ? array.get(swings, sc - 1).meaningfulConfTime : na
    int newFingerprint = 0
    for [k, _u797] in swings
        SwingRec sf = array.get(swings, k)
        newFingerprint := (newFingerprint * 31 + sf.swingType + sf.meaningfulConfTime % 1000000 + k) % 1000000007
    bool changed = na(lastSwingCount) or newCount != lastSwingCount or newConfTime != lastSwingConfTime or newFingerprint != lastSwingFingerprint

    // ---- SUPPORT / RESISTANCE — advanced on EVERY confirmed bar ----
    //
    // P1-CLOSEOUT (C1): S/R must NOT sit behind the swing-set change gate. Its
    // reaction search runs forward to the end of the available candles
    // (support_resistance.py:80 `for index in range(search_start_index, n)`), so a
    // reaction can first satisfy its gate on a candle that introduces NO new
    // swing. The Python incremental analyzer states this explicitly at
    // analyzer.py:923 — "Must run every candle (not only when confirmed_swings
    // changes): a reaction's bounded window can newly resolve purely from candle
    // growth with no new swing involved." Gating S/R on the swing fingerprint
    // therefore DELAYED a real state transition until the next swing mutation.
    //
    // Equal levels and trendlines are NOT exposed to this: both are pure
    // functions of the confirmed-swing set (a trendline's confirmation comes from
    // a touch SWING, not from a bar), so they stay behind the gate.
    //
    // P1-SR-PERF-2: recomputing the whole detector here every bar was correct but
    // put the script back on the Basic 20s boundary. The reaction frontier below
    // keeps the timing and removes the rescan.

    // (a) retire trackers whose origin has left the active window. Keys are
    //     ascending with originAbs in the high bits, so this is a prefix removal.
    int srMinKey = absFirst * C_SR_KEY_STRIDE
    while array.size(srKeys) > 0 and array.get(srKeys, 0) < srMinKey
        array.shift(srKeys)
        array.shift(srTrk)

    // (b) the ONLY unconditional per-bar S/R work: advance unresolved trackers.
    //     Permanent ones are skipped outright. A tracker whose resolution moves
    //     names its origin via SRTracker.originAbs, which is what P1-SR-PERF-3
    //     uses to re-run exactly that one fold instead of all of them.
    bool srTrackerChanged = false
    array.clear(srDirty)
    for [ti, _u940] in srKeys
        SRTracker before = array.get(srTrk, ti)
        if not before.permanent
            SRTracker after = f_advanceSRTracker(before, wHigh, wLow, wOpen, wClose, wAtr, wAvailT, absFirst)
            array.set(srTrk, ti, after)
            bool resolutionMoved = na(after.confirmingAbs) != na(before.confirmingAbs)
            if not resolutionMoved and not na(after.confirmingAbs)
                resolutionMoved := after.confirmingAbs != before.confirmingAbs
            if resolutionMoved
                srTrackerChanged := true
                int dirtyOrigin = before.originAbs
                bool alreadyDirty = false
                for [dd, _u941] in srDirty
                    if array.get(srDirty, dd) == dirtyOrigin
                        alreadyDirty := true
                        break
                if not alreadyDirty
                    array.push(srDirty, dirtyOrigin)
            else if after.permanent != before.permanent
                srTrackerChanged := true

    // (c) P1-SR-PERF-3: a swing change rebuilds the orientation candidate lists
    //     and retires only the folds the delta can reach. The delta must run
    //     BEFORE the rebuild, because it compares the previous snapshot against
    //     the live swing set.
    if changed or not srSeeded
        f_srApplyDelta(swings, srSnap, srFold, srFoldKeep)
        f_srRebuildCandidates(swings, absFirst, srCandSupport, srCandResist, srOppSupport, srOppResist, srSnap)

    // (d) the walk's output is a pure function of (swing set, tracker
    //     resolutions), so re-run it only when one of those actually moved — and
    //     inside it, only the folds those changes actually reach.
    if not srSeeded or srTrackerChanged or changed
        srSeeded := true
        array<SRRec> srFresh = f_walkSR(wHigh, wLow, wOpen, wClose, wAtr, wAvailT, srCandSupport, srCandResist, srOppSupport, srOppResist, srFold, srDirty, srKeys, srTrk, absFirst)
        array.clear(srCached)
        for [fi, _u950] in srFresh
            array.push(srCached, array.get(srFresh, fi))

    // srCached is in Python's canonical order (ascending confirmationTime,
    // stable), so its LAST element is the most recently confirmed zone — which
    // is what this parity scalar means.
    array<SRRec> srs = srCached
    latestSRTop := na
    latestSRBottom := na
    latestSRType := na
    if array.size(srs) > 0
        SRRec srLast = array.get(srs, array.size(srs) - 1)
        latestSRTop := srLast.zoneTop
        latestSRBottom := srLast.zoneBottom
        latestSRType := srLast.zoneType

    // Debug-only: gate the DRAWING on whether the zone set actually changed, so
    // that analytical progression never becomes a per-bar clear-and-redraw.
    int newSRFingerprint = 0
    for [k2, _u898] in srs
        SRRec srf = array.get(srs, k2)
        newSRFingerprint := (newSRFingerprint * 31 + srf.zoneType + srf.confirmationTime % 1000000 + srf.touchCount + k2) % 1000000007
    bool srChanged = na(lastSRFingerprint) or newSRFingerprint != lastSRFingerprint
    lastSRFingerprint := newSRFingerprint

    // ---- recompute SWING-DERIVED detectors only when the swing set changes ----
    if changed
        lastSwingCount := newCount
        lastSwingConfTime := newConfTime
        lastSwingFingerprint := newFingerprint

        // EQUAL LEVELS
        array<EqualLevelRec> eqs = f_detectEqualLevels(swings)
        latestEqualHigh := na
        latestEqualLow := na
        for [k, _u818] in eqs
            EqualLevelRec e = array.get(eqs, k)
            if e.clusterType == SWING_HIGH
                latestEqualHigh := e.representativePrice
            else
                latestEqualLow := e.representativePrice

        // TRENDLINES
        array<TrendlineRec> tls = f_detectTrendlines(wClose, wAtr, swings, scTlAtr)
        latestTLNormSlope := na
        latestTLOrient := na
        if array.size(tls) > 0
            TrendlineRec tl = array.get(tls, array.size(tls) - 1)
            latestTLNormSlope := tl.normalizedSlope
            latestTLOrient := tl.orientation

        // ---- bounded debug drawings (only on change; each family capped) ----
        if debugMode and showSwings
            f_clearLabels(swingLabelObjs)
            int startK = math.max(0, array.size(swings) - maxDrawPerFamily)
            for [k, _u849] in swings
                if k < startK
                    continue
                SwingRec s = array.get(swings, k)
                bool isHigh = s.swingType == SWING_HIGH
                label lb = label.new(x = s.pivotEndTime, y = s.price, xloc = xloc.bar_time, style = isHigh ? label.style_label_down : label.style_label_up, color = isHigh ? color.new(color.teal, 20) : color.new(color.maroon, 20), textcolor = color.white, size = size.tiny, text = isHigh ? "SH" : "SL")
                array.push(swingLabelObjs, lb)
        if debugMode and showEqualLevels
            f_clearLines(eqLineObjs)
            int startK = math.max(0, array.size(eqs) - maxDrawPerFamily)
            for [k, _u857] in eqs
                if k < startK
                    continue
                EqualLevelRec e = array.get(eqs, k)
                line ln = line.new(x1 = e.firstTime, y1 = e.representativePrice, x2 = e.confirmationTime, y2 = e.representativePrice, xloc = xloc.bar_time, color = e.clusterType == SWING_HIGH ? color.orange : color.blue, style = line.style_dotted, width = 1)
                array.push(eqLineObjs, ln)
        if debugMode and showTrendlines
            f_clearLines(tlLineObjs)
            int startK = math.max(0, array.size(tls) - maxDrawPerFamily)
            for [k, _u871] in tls
                if k < startK
                    continue
                TrendlineRec tl = array.get(tls, k)
                line ln = line.new(x1 = tl.anchor1Time, y1 = tl.anchor1Price, x2 = tl.anchor2Time, y2 = tl.anchor2Price, xloc = xloc.bar_time, color = tl.orientation == SWING_LOW ? color.green : color.red, style = line.style_solid, width = 1)
                array.push(tlLineObjs, ln)

    // S/R drawings sit OUTSIDE the swing-change gate because the zone set now
    // advances on candle growth alone; they are redrawn only when that set
    // actually changed, and stay capped per family.
    if debugMode and showSR and srChanged
        f_clearBoxes(srBoxObjs)
        int startSR = math.max(0, array.size(srs) - maxDrawPerFamily)
        for [k, _u1030] in srs
            if k < startSR
                continue
            SRRec srd = array.get(srs, k)
            box bx = box.new(left = srd.confirmationTime, top = srd.zoneTop, right = time_close, bottom = srd.zoneBottom, xloc = xloc.bar_time, border_color = srd.zoneType == SWING_LOW ? color.green : color.red, bgcolor = color.new(srd.zoneType == SWING_LOW ? color.green : color.red, 88))
            array.push(srBoxObjs, bx)

// P1-PERF-4A — HISTORY GUARD: CAPACITY *and* WARM-UP.
//
// These are two different questions and PERF-4 answered only the second:
//
//   CAPACITY — does the dataset TradingView actually handed this script contain
//              the approved execution horizon at all? A user who lowers the
//              generated "Calculated bars" input, or a symbol with a short
//              history, silently shrinks the run. Answered from dataset
//              metadata in O(1); no scan, no state.
//
//   WARM-UP  — has THIS bar accumulated enough causal history INSIDE that
//              dataset for its own 300-bar window to carry an exact ATR?
//              Answered from confirmedBarCount.
//
// last_bar_index is documented as one less than the total number of bars
// available to the script, so the accessible count is last_bar_index + 1 =
// min(chart bars, "Calculated bars"). Both terms are monotonically
// non-decreasing while the script runs: a newly opened realtime bar can only
// add to the chart, and the cap is fixed for the run. An open realtime bar can
// therefore never push the count BELOW what the historical pass saw, so no
// downward tolerance is needed here and none is applied — 1799 accessible bars
// must fail, because 1800 is the validated product horizon.
//
// FAIL CLOSED. Insufficient history is not a reason to publish a partially
// validated answer computed from whatever happens to exist; that answer sits
// outside the validated P1 history contract. All nine outputs go na and the
// debug table says so, without guessing which of the two causes applied.
//
// Publication guard only: no analytical rule, no stored state and no
// confirmed-bar boundary is affected, and last_bar_index is used NOWHERE else.
int  p1DatasetBars = last_bar_index + 1
bool p1CapacityOk  = p1DatasetBars >= C_P1_CALC_BARS
bool p1WarmupOk    = confirmedBarCount >= C_P1_MIN_CALC_BARS
bool p1HistoryOk   = p1CapacityOk and p1WarmupOk

// -----------------------------------------------------------------------------
// DISPLACEMENT MARKER (per-bar shape; drawn on the confirmed bar only).
// -----------------------------------------------------------------------------
bool dispFastNow = p1HistoryOk and barstate.isconfirmed and debugMode and showDisplacement and not na(latestDispCode) and math.abs(latestDispCode) >= 1
plotshape(dispFastNow and latestDispCode > 0, title = "Displacement up", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.tiny)
plotshape(dispFastNow and latestDispCode < 0, title = "Displacement down", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.tiny)

// =============================================================================
// PARITY INTERFACE — machine-readable latest-state values (Data Window) + table.
// =============================================================================
plot(p1HistoryOk ? latestSwingHighPrice : na, "P1_swing_high_price", color = color.teal,   display = display.data_window)
plot(p1HistoryOk ? latestSwingLowPrice  : na, "P1_swing_low_price",  color = color.maroon, display = display.data_window)
plot(p1HistoryOk ? latestDispCode       : na, "P1_disp_code",        color = color.gray,   display = display.data_window)
plot(p1HistoryOk ? latestDispRatio      : na, "P1_disp_ratio",       color = color.gray,   display = display.data_window)
plot(p1HistoryOk ? latestEqualHigh      : na, "P1_equal_high",       color = color.orange, display = display.data_window)
plot(p1HistoryOk ? latestEqualLow       : na, "P1_equal_low",        color = color.blue,   display = display.data_window)
plot(p1HistoryOk ? latestSRTop          : na, "P1_sr_top",           color = color.green,  display = display.data_window)
plot(p1HistoryOk ? latestSRBottom       : na, "P1_sr_bottom",        color = color.red,    display = display.data_window)
plot(p1HistoryOk ? latestTLNormSlope    : na, "P1_tl_norm_slope",    color = color.purple, display = display.data_window)

// =============================================================================
// P2-I2 ADAPTER DIAGNOSTICS — debug-gated, data-window only.
//
// Proves the P1 -> P2 projection on a live chart. Gated on `debugMode` so the
// product surface stays at P1's nine outputs; the plot declarations still count
// against the 64-plot budget (11 -> 17), which is documented and well clear.
// These describe the LAST adapted swing; there is no P2 behaviour to show yet.
// Times are epoch seconds (ms/1000) so a 2dp readout keeps full precision.
// =============================================================================
plot(debugMode and p1HistoryOk ? p2SwingCount   : na, "P2_adapted_swing_count", color = color.new(color.gray, 0),  display = display.data_window)
// P2_last_swing_type retired at P2-I5 to fund the BOS slots: swing type is
// contract-tested on the adapter and is already implied by the relationship
// codes, which are partitioned into high-side and low-side values.
// P2_last_swing_price / P2_last_swing_atr retired at P2-I4 to fund the bootstrap
// slots. Both were pure echoes of the I2 adapter, which is contract-tested; the
// analytically meaningful derivations (relationship codes, direction,
// protected/weak keys) all remain exposed below.
plot(debugMode and p1HistoryOk ? p2LastStartAbs : na, "P2_last_pivot_start_abs", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and not na(p2LastConfTime) ? p2LastConfTime / 1000 : na, "P2_last_conf_time", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk ? p2RelCount    : na, "P2_relationship_count", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk ? p2LastHighRel : na, "P2_last_high_relationship", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk ? p2LastLowRel  : na, "P2_last_low_relationship", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2Direction != C_ST_NA ? p2Direction : na, "P2_direction", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2ProtHighKey != C_ST_NA ? p2ProtHighKey / 1000 : na, "P2_protected_high", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2ProtLowKey  != C_ST_NA ? p2ProtLowKey  / 1000 : na, "P2_protected_low",  color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2WeakHighKey != C_ST_NA ? p2WeakHighKey / 1000 : na, "P2_weak_high", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2WeakLowKey  != C_ST_NA ? p2WeakLowKey  / 1000 : na, "P2_weak_low",  color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2TransCount    != C_ST_NA ? p2TransCount : na, "P2_transition_count", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2LastTransCode != C_ST_NA ? p2LastTransCode : na, "P2_last_transition_code", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk and p2LastBrokenKey != C_ST_NA ? p2LastBrokenKey / 1000 : na, "P2_last_broken_key", color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode and p1HistoryOk ? p2LastBrokenLvl : na, "P2_last_broken_level", color = color.new(color.gray, 0), display = display.data_window)

f_row(table t, int r, string k, string v) =>
    table.cell(t, 0, r, k, text_size = size.tiny, text_halign = text.align_left, text_color = color.gray)
    table.cell(t, 1, r, v, text_size = size.tiny, text_halign = text.align_right, text_color = color.white)

// P1-PERF-1: the parity table is development instrumentation. Declaring it here
// (inside the guarded branch) means no table object is created at all in normal
// client-style mode.
if barstate.islast and debugMode
    var table dbg = table.new(position.top_right, 2, 11, border_width = 1)
    f_row(dbg, 0, "P1 DEV — latest confirmed", "")
    f_row(dbg, 1, "Swing High", na(latestSwingHighPrice) ? "-" : str.tostring(latestSwingHighPrice, format.mintick))
    f_row(dbg, 2, "Swing Low",  na(latestSwingLowPrice)  ? "-" : str.tostring(latestSwingLowPrice, format.mintick))
    f_row(dbg, 3, "Disp code",  na(latestDispCode)  ? "-" : str.tostring(latestDispCode))
    f_row(dbg, 4, "Disp ratio", na(latestDispRatio) ? "-" : str.tostring(latestDispRatio, "#.###"))
    f_row(dbg, 5, "Equal High", na(latestEqualHigh) ? "-" : str.tostring(latestEqualHigh, format.mintick))
    f_row(dbg, 6, "Equal Low",  na(latestEqualLow)  ? "-" : str.tostring(latestEqualLow, format.mintick))
    f_row(dbg, 7, "SR top",     na(latestSRTop)     ? "-" : str.tostring(latestSRTop, format.mintick))
    f_row(dbg, 8, "SR bottom",  na(latestSRBottom)  ? "-" : str.tostring(latestSRBottom, format.mintick))
    f_row(dbg, 9, "TL n-slope", na(latestTLNormSlope) ? "-" : str.tostring(latestTLNormSlope, "#.###"))
    f_row(dbg, 10, "Calc history", p1HistoryOk ? str.tostring(p1DatasetBars) + " bars, warm " + str.tostring(confirmedBarCount) + " OK" : "INSUFFICIENT CALCULATED HISTORY (dataset " + str.tostring(p1DatasetBars) + "/" + str.tostring(C_P1_CALC_BARS) + ", warm " + str.tostring(confirmedBarCount) + "/" + str.tostring(C_P1_MIN_CALC_BARS) + ")")

// =============================================================================
// P3 — POI SEMANTIC FOUNDATION  (P3-I1)
// -----------------------------------------------------------------------------
// Everything ABOVE this banner is byte-identical to the frozen P2 DEV
// production scanner except the indicator() title. This block adds the
// canonical POI vocabulary, the two POI records and the persistent registry.
// It contains NO detector logic and NO lifecycle logic yet: later slices
// (P3-I2..P3-I6) fill those in against this foundation.
//
// SCOPE (P3-ACCEL-1 §33). P3 CORE is exactly the 18 lifecycle-eligible types
// (poi/enums.py:99-120). The 14 context types (EQH/EQL + 12 period levels) are
// P3 CONTEXT: their codes are RESERVED below for enum completeness but P3 CORE
// never emits them.
//
// ARCHITECTURE (P3-ACCEL-1 AD-5). Detection is bounded (a small ring of recent
// confirmed candles suffices — max dependency window 21 bars), but the POI
// REGISTRY and each POI's LIFECYCLE CURSOR are PERSISTENT: production has no
// expiry (lifecycle.py:389 age is descriptive only) and a POI whose origin has
// left the analytical window is still live. Geometry is immutable (PoiRec);
// only lifecycle state mutates (PoiLife). Rendering limits, when they arrive,
// must never truncate the semantic registry.
//
// IDENTITY (P3-ACCEL-1 AD-1). Pine never recreates Python's UUIDs. Python's
// semantic key is (symbol, timeframe, poi_type, *source_candle_record_ids,
// rule_version) (analyzer.py:410-436). Every pattern detector draws its source
// candles from a CONTIGUOUS run, so the triple (srcFirstTime, srcCount,
// srcLastTime) reproduces that candle set exactly; combined with poiType it is
// the Pine-side stable identity. Reference zones instead inherit their P1
// source record's anchor.
//
// CLOSED-BAR RULE (P3-ACCEL-1 C-3). Every P3 mutation is gated on
// barstate.isconfirmed, exactly as P1 and P2 are. A forming realtime candle
// can never mutate confirmed P3 state.
// =============================================================================

// ---- POI type codes: P3 CORE (the 18 lifecycle-eligible types) --------------
int C_POI_BUY_ORDER_BLOCK          = 1
int C_POI_SELL_ORDER_BLOCK         = 2
int C_POI_BUY_FAIR_VALUE_GAP       = 3
int C_POI_SELL_FAIR_VALUE_GAP      = 4
int C_POI_BUY_TO_SELL_CANDLE       = 5
int C_POI_SELL_TO_BUY_CANDLE       = 6
int C_POI_BASE_RALLY               = 7
int C_POI_BASE_DROP                = 8
int C_POI_BULLISH_PRESSURE_WICK    = 9
int C_POI_BEARISH_PRESSURE_WICK    = 10
int C_POI_BULLISH_ENGULFING        = 11
int C_POI_BEARISH_ENGULFING        = 12
int C_POI_HAMMER                   = 13
int C_POI_SHOOTING_STAR            = 14
int C_POI_MORNING_STAR             = 15
int C_POI_EVENING_STAR             = 16
int C_POI_SUPPORT_ZONE             = 17
int C_POI_RESISTANCE_ZONE          = 18

// ---- POI type codes: P3 CONTEXT (RESERVED, never emitted by P3 CORE) -------
int C_POI_EQUAL_HIGHS_LIQUIDITY    = 19
int C_POI_EQUAL_LOWS_LIQUIDITY     = 20
int C_POI_CURRENT_DAY_HIGH         = 21
int C_POI_CURRENT_DAY_LOW          = 22
int C_POI_CURRENT_WEEK_HIGH        = 23
int C_POI_CURRENT_WEEK_LOW         = 24
int C_POI_CURRENT_MONTH_HIGH       = 25
int C_POI_CURRENT_MONTH_LOW        = 26
int C_POI_PREVIOUS_DAY_HIGH        = 27
int C_POI_PREVIOUS_DAY_LOW         = 28
int C_POI_PREVIOUS_WEEK_HIGH       = 29
int C_POI_PREVIOUS_WEEK_LOW        = 30
int C_POI_PREVIOUS_MONTH_HIGH      = 31
int C_POI_PREVIOUS_MONTH_LOW       = 32

int C_POI_CORE_TYPE_MIN = 1
int C_POI_CORE_TYPE_MAX = 18

// ---- direction codes (identical values to the P2 structure vocabulary) -----
int C_POI_DIR_BULLISH = 1
int C_POI_DIR_BEARISH = -1

// ---- strength tier codes. NA is a real state: FVG and reference zones carry
// no tier at all in production (analyzer.py builds them without one).
int C_POI_TIER_NA       = 0
int C_POI_TIER_STANDARD = 1
int C_POI_TIER_STRONG   = 2

// ---- lifecycle status codes (poi/enums.py:55-66, order preserved) ----------
// RECLAIM_PENDING and DISPLACEMENT_PENDING are RESERVED / CURRENTLY
// UNREACHABLE per AD-2: production emits neither, so P3 never assigns them.
int C_POI_LC_NOT_APPLICABLE                       = 0
int C_POI_LC_NO_BREACH                            = 1
int C_POI_LC_CLOSE_BREACH_CANDIDATE               = 2
int C_POI_LC_RECLAIM_PENDING                      = 3   // RESERVED — never set
int C_POI_LC_RECLAIM_CONFIRMED                    = 4
int C_POI_LC_DISPLACEMENT_PENDING                 = 5   // RESERVED — never set
int C_POI_LC_DISPLACEMENT_AFTER_RECLAIM_CONFIRMED = 6
int C_POI_LC_RECLAIM_WITHOUT_DISPLACEMENT         = 7
int C_POI_LC_RECLAIM_FAILED                       = 8
int C_POI_LC_FALSE_INVALIDATION_CONFIRMED         = 9
int C_POI_LC_GENUINE_INVALIDATION_CONFIRMED       = 10

// ---- lifecycle transition codes. Only the two BTMM-consumed kinds matter
// downstream (btmm/analyzer.py:644-649); the rest are diagnostics.
int C_POI_TR_CLOSE_BREACH_CANDIDATE               = 2
int C_POI_TR_RECLAIM_CONFIRMED                    = 4
int C_POI_TR_DISPLACEMENT_AFTER_RECLAIM_CONFIRMED = 6
int C_POI_TR_RECLAIM_WITHOUT_DISPLACEMENT         = 7
int C_POI_TR_RECLAIM_FAILED                       = 8
int C_POI_TR_FALSE_INVALIDATION_CONFIRMED         = 9   // consumed by BTMM
int C_POI_TR_GENUINE_INVALIDATION_CONFIRMED       = 10  // consumed by BTMM

// The only two transition types any downstream consumer reads
// (btmm/analyzer.py:644-649).
f_poiIsDownstreamRelevant(int code) =>
    code == C_POI_TR_FALSE_INVALIDATION_CONFIRMED or code == C_POI_TR_GENUINE_INVALIDATION_CONFIRMED

// ---- production POI configuration (poi/configuration.py, verbatim) ---------
float C_POI_OB_RATIO_STANDARD        = 2.0
float C_POI_OB_RATIO_STRONG          = 3.0
float C_POI_SMALL_CANDLE_STANDARD    = 0.50
float C_POI_SMALL_CANDLE_STRONG      = 0.3333
int   C_POI_BASE_MIN_CANDLES         = 2
int   C_POI_BASE_MAX_CANDLES         = 6
float C_POI_BASE_HEIGHT_ATR_MULT     = 0.75
float C_POI_BASE_HEIGHT_DEP_MULT     = 0.60
float C_POI_BASE_MIDPOINT_DRIFT      = 0.25
float C_POI_BASE_OVERLAP_MIN         = 0.50
float C_POI_PW_SHARE_STANDARD        = 0.40
float C_POI_PW_BODY_EFF_STANDARD     = 0.25
float C_POI_PW_DOMINANCE_STANDARD    = 2.0
float C_POI_PW_CLOSE_POS_STANDARD    = 0.60
float C_POI_PW_SHARE_STRONG          = 0.50
float C_POI_PW_BODY_EFF_STRONG       = 0.30
float C_POI_PW_DOMINANCE_STRONG      = 3.0
float C_POI_PW_CLOSE_POS_STRONG      = 0.70
float C_POI_PW_RANGE_CONTEXT_STRONG  = 1.25
float C_POI_HSS_WICK_SHARE_STANDARD  = 0.60
float C_POI_HSS_BODY_EFF_STANDARD    = 0.30
float C_POI_HSS_OPP_WICK_STANDARD    = 0.10
float C_POI_HSS_WICK_SHARE_STRONG    = 0.70
float C_POI_HSS_BODY_EFF_STRONG      = 0.20
float C_POI_HSS_OPP_WICK_STRONG      = 0.05
float C_POI_DOJI_BODY_EFF_STANDARD   = 0.10
float C_POI_DOJI_BODY_EFF_STRONG     = 0.05
float C_POI_REV_RATIO_STANDARD       = 2.0
float C_POI_REV_RATIO_STRONG         = 3.0
float C_POI_REV_BODY_EFF_STANDARD    = 0.60
float C_POI_REV_BODY_EFF_STRONG      = 0.70
float C_POI_REV_CLOSE_POS_STANDARD   = 0.70
float C_POI_REV_CLOSE_POS_STRONG     = 0.80
float C_POI_CONTACT_TOL_ATR_MULT     = 0.05
float C_POI_CONTACT_TOL_HEIGHT_MULT  = 0.10
float C_POI_OVERSHOOT_TOL_ATR_MULT   = 0.10
float C_POI_OVERSHOOT_TOL_HEIGHT_MULT = 0.25
int   C_POI_RECLAIM_WINDOW_BARS      = 3
int   C_POI_DISPLACEMENT_WINDOW_BARS = 3

// Detector dependency windows (source-derived). The largest is the pressure
// wick baseline: the candle itself plus its 20 predecessors.
int C_POI_REV_LOOKBACK               = 3
int C_POI_REV_CONFIRM_WINDOW         = 3
int C_POI_PW_BASELINE_WINDOW         = 20
int C_POI_MAX_DEPENDENCY_BARS        = 21

// Displacement leg thresholds. These are HARD-CODED in production
// (lifecycle.py:262-267), not configuration, and are reproduced as such.
float C_POI_LEG_FAST_SPEED        = 0.50
float C_POI_LEG_FAST_EFFICIENCY   = 0.60
float C_POI_LEG_FAST_SHARE        = 0.67
float C_POI_LEG_STRONG_SPEED      = 0.75
float C_POI_LEG_STRONG_EFFICIENCY = 0.75
float C_POI_LEG_STRONG_SHARE      = 0.80

// -----------------------------------------------------------------------------
// RECORDS
//
// PoiRec is IMMUTABLE geometry + identity: once a detector emits it, nothing
// rewrites it (production never mutates an observation's bounds or times).
// PoiLife is the MUTABLE lifecycle/cursor state for that POI.
//
// The split mirrors production, where PoiObservation is a frozen contract and
// lifecycle state is recomputed/advanced separately. A single mutable record
// would blur that and make the BTMM-facing geometry look revisable.
// -----------------------------------------------------------------------------
type PoiRec
    int   poiType          // C_POI_* code
    int   direction        // C_POI_DIR_BULLISH / C_POI_DIR_BEARISH
    float zoneTop          // inclusive upper bound
    float zoneBottom       // inclusive lower bound
    int   candidateTime    // first source candle event time (ms)
    int   confirmTime      // confirming candle availability time (ms)
    int   availTime        // == confirmTime for every production detector
    int   strengthTier     // C_POI_TIER_*
    int   srcFirstTime     // identity: first source candle event time (ms)
    int   srcCount         // identity: number of source candles
    int   srcLastTime      // identity: last source candle event time (ms)

type PoiLife
    int   status           // C_POI_LC_* — current lifecycle status
    bool  terminal         // true only after GENUINE_INVALIDATION_CONFIRMED
    int   resumeIdx        // absolute confirmed-bar index the walk resumes at
    int   breachIdx        // absolute index of the open breach, or C_ST_NA
    int   reclaimIdx       // absolute index of the confirmed reclaim, or C_ST_NA
    int   windowSeen       // window bars examined since the open breach
    int   sustainedCloses  // window bars that re-satisfied the breach test
    bool  lastWindowBreach // whether the most recent window bar breached
    int   tapCount         // maximal touching runs since the POI became live
    bool  inTap            // whether the previous confirmed bar was touching

// -----------------------------------------------------------------------------
// PERSISTENT REGISTRY (AD-5)
//
// Parallel arrays rather than an array<PoiRec>: Pine's UDT arrays are heavier
// and the registry is append-only, so parallel primitives keep the per-bar cost
// flat. Index i identifies one POI across every array.
// -----------------------------------------------------------------------------
var array<int>   poiType        = array.new<int>()
var array<int>   poiDirection   = array.new<int>()
var array<float> poiZoneTop     = array.new<float>()
var array<float> poiZoneBottom  = array.new<float>()
var array<int>   poiCandTime    = array.new<int>()
var array<int>   poiConfirmTime = array.new<int>()
var array<int>   poiAvailTime   = array.new<int>()
var array<int>   poiTier        = array.new<int>()
var array<int>   poiSrcFirst    = array.new<int>()
var array<int>   poiSrcCount    = array.new<int>()
var array<int>   poiSrcLast     = array.new<int>()

var array<int>  poiStatus       = array.new<int>()
var array<bool> poiTerminal     = array.new<bool>()
var array<int>  poiResumeIdx    = array.new<int>()
var array<int>  poiBreachIdx    = array.new<int>()
var array<int>  poiReclaimIdx   = array.new<int>()
var array<int>  poiWindowSeen   = array.new<int>()
var array<int>  poiSustained    = array.new<int>()
var array<bool> poiLastWinBreach = array.new<bool>()
var array<int>  poiTapCount     = array.new<int>()
var array<bool> poiInTap        = array.new<bool>()

// Provisional (reported) status, kept distinct from the committed status:
// the walk re-derives it every bar, while the committed one only advances
// past final outcomes.
var array<int>  poiReported      = array.new<int>()

// Downstream projection state (P3-I7). BTMM addresses a lifecycle event by
// POI identity plus its timing, so the registry carries the COMMITTED event
// tally and the latest committed event, then re-derives the pending tail
// each bar exactly as the status does. That is what stops a later bar from
// re-emitting an event it already reported.
//
// These are declared HERE, beside the rest of the registry, because
// f_poiAppend below pushes to every one of them and Pine resolves
// identifiers in source order.
var array<int> poiCommTransCount = array.new<int>()
var array<int> poiCommLastCode   = array.new<int>()
var array<int> poiCommLastEvent  = array.new<int>()
var array<int> poiCommLastAvail  = array.new<int>()
var array<int> poiCommRelevant   = array.new<int>()
// P4. A genuine invalidation is terminal, so poiRepLastCode identifies it and
// poiRepLastEvent/Avail time it. A FALSE invalidation is not terminal -- a POI
// can sweep, reclaim, and be genuinely invalidated later -- so the last-code
// arrays cannot answer 'did this POI ever false-invalidate?'. BTMM's derived
// liquidity asks exactly that, so it gets its own monotone flag. Additive:
// nothing already in P3 reads these.
var array<bool> poiCommFalseInv  = array.new<bool>()
var array<int> poiRepTransCount  = array.new<int>()
var array<int> poiRepLastCode    = array.new<int>()
var array<int> poiRepLastEvent   = array.new<int>()
var array<int> poiRepLastAvail   = array.new<int>()
var array<int> poiRepRelevant    = array.new<int>()
var array<bool> poiRepFalseInv   = array.new<bool>()

// -----------------------------------------------------------------------------
// PRIMITIVES
// -----------------------------------------------------------------------------

// Price -> integer ticks. The parity contract hashes ticks, never floats, so
// this is the single normalisation point (identical to the P2 digest rule).
f_poiTicks(float price) =>
    na(price) ? 0 : int(math.round(price / syminfo.mintick))

// Identity equality. Mirrors Python's semantic key: same type over the same
// contiguous source-candle run, plus the zone bounds.
//
// WHY BOUNDS ARE PART OF IDENTITY. Reference zones are projections of P1
// records and have NO source candles, so their (first, count, last) triple
// degenerates to the confirmation time. Two support zones confirmed by the
// same candle but built from different origin swings would then collide.
// Including the bounds separates them. For every candle-derived family the
// bounds are a deterministic function of the source candles already in the
// identity, so this refines and never splits.
f_poiSameIdentity(int i, int typeCode, int srcFirst, int srcCount, int srcLast, int lowTicks, int highTicks) =>
    array.get(poiType, i) == typeCode and array.get(poiSrcFirst, i) == srcFirst and array.get(poiSrcCount, i) == srcCount and array.get(poiSrcLast, i) == srcLast and f_poiTicks(array.get(poiZoneBottom, i)) == lowTicks and f_poiTicks(array.get(poiZoneTop, i)) == highTicks

// Registry lookup by identity. Returns the index, or -1 when absent.
// Scans newest-first: a re-emitted POI is almost always recent, so the common
// case exits after a handful of comparisons.
f_poiFind(int typeCode, int srcFirst, int srcCount, int srcLast, int lowTicks, int highTicks) =>
    int found = -1
    int n = array.size(poiType)
    int i = n - 1
    while i >= 0 and found == -1
        if f_poiSameIdentity(i, typeCode, srcFirst, srcCount, srcLast, lowTicks, highTicks)
            found := i
        i -= 1
    found

// Append a POI. Callers MUST have checked f_poiFind first: production emits a
// given semantic POI exactly once, and the registry preserves that.
f_poiAppend(PoiRec rec) =>
    array.push(poiType, rec.poiType)
    array.push(poiDirection, rec.direction)
    array.push(poiZoneTop, rec.zoneTop)
    array.push(poiZoneBottom, rec.zoneBottom)
    array.push(poiCandTime, rec.candidateTime)
    array.push(poiConfirmTime, rec.confirmTime)
    array.push(poiAvailTime, rec.availTime)
    array.push(poiTier, rec.strengthTier)
    array.push(poiSrcFirst, rec.srcFirstTime)
    array.push(poiSrcCount, rec.srcCount)
    array.push(poiSrcLast, rec.srcLastTime)

    array.push(poiStatus, C_POI_LC_NO_BREACH)
    array.push(poiTerminal, false)
    array.push(poiResumeIdx, C_ST_NA)
    array.push(poiBreachIdx, C_ST_NA)
    array.push(poiReclaimIdx, C_ST_NA)
    array.push(poiWindowSeen, 0)
    array.push(poiSustained, 0)
    array.push(poiLastWinBreach, false)
    array.push(poiTapCount, 0)
    array.push(poiInTap, false)
    array.push(poiReported, C_POI_LC_NO_BREACH)
    array.push(poiCommTransCount, 0)
    array.push(poiCommLastCode, C_ST_NA)
    array.push(poiCommLastEvent, C_ST_NA)
    array.push(poiCommLastAvail, C_ST_NA)
    array.push(poiCommRelevant, 0)
    array.push(poiCommFalseInv, false)
    array.push(poiRepTransCount, 0)
    array.push(poiRepLastCode, C_ST_NA)
    array.push(poiRepLastEvent, C_ST_NA)
    array.push(poiRepLastAvail, C_ST_NA)
    array.push(poiRepRelevant, 0)
    array.push(poiRepFalseInv, false)
    array.size(poiType) - 1

// Inclusive wick overlap — the production interaction test verbatim
// (lifecycle.py:111-114). Close position is irrelevant here by design.
f_poiTouches(int i, float candleHigh, float candleLow) =>
    candleLow <= array.get(poiZoneTop, i) and candleHigh >= array.get(poiZoneBottom, i)

// Tolerance. Mirrors lifecycle.py:179-186 exactly, including the zero-height
// fallback (bound_b := bound_a) and the two-tick floor.
f_poiTolerance(float zoneHeight, float referenceAtr, float atrMult, float heightMult) =>
    float boundA = atrMult * referenceAtr
    float boundB = zoneHeight > 0 ? heightMult * zoneHeight : boundA
    math.max(2 * syminfo.mintick, math.min(boundA, boundB))

// Reference ATR with the production fallback: the candle's own range whenever
// the ATR is unavailable or non-positive (lifecycle.py:66-72).
f_poiReferenceAtr(float atrValue, float fallbackRange) =>
    na(atrValue) or atrValue <= 0 ? fallbackRange : atrValue

// Strict close-only breach (lifecycle.py:75-84). A wick through the zone never
// breaches; the comparison is STRICTLY greater than the tolerance.
f_poiIsBreach(int direction, float zoneTop, float zoneBottom, float closePrice, float overshootTol) =>
    direction == C_POI_DIR_BULLISH ? (zoneBottom - closePrice) > overshootTol : (closePrice - zoneTop) > overshootTol

// Non-strict close-only reclaim of the near boundary (lifecycle.py:87-96).
f_poiIsReclaim(int direction, float zoneTop, float zoneBottom, float closePrice, float contactTol) =>
    direction == C_POI_DIR_BULLISH ? closePrice >= zoneBottom + contactTol : closePrice <= zoneTop - contactTol

// Non-strict close beyond the FAR boundary (lifecycle.py:99-108). This is only
// half of a displacement: the leg must also classify FAST or STRONG_FAST.
f_poiIsDisplacement(int direction, float zoneTop, float zoneBottom, float closePrice, float contactTol) =>
    direction == C_POI_DIR_BULLISH ? closePrice >= zoneTop + contactTol : closePrice <= zoneBottom - contactTol

// Whether a type code belongs to P3 CORE (the 18 lifecycle-eligible types).
f_poiIsCoreType(int typeCode) =>
    typeCode >= C_POI_CORE_TYPE_MIN and typeCode <= C_POI_CORE_TYPE_MAX

// ---- diagnostics: registry size, closed bars only ---------------------------
var int p3RegistrySize = 0
if barstate.isconfirmed
    p3RegistrySize := array.size(poiType)

// =============================================================================
// P3-I2 — FIXED-WINDOW DETECTORS  (order blocks, FVG, engulfing, stars,
//         single-candle reversals)
// -----------------------------------------------------------------------------
// Each detector runs on the CONFIRMED bar that production would use as the
// candidate's confirming candle, and emits exactly the POIs whose confirmation
// is that bar. That makes emission exactly-once without any rescan: batch
// production assigns confirmation_time = the confirming candle's availability,
// so "emit at t" and "batch over the whole array" produce the same set.
//
// All five read the P1 window arrays (wOpen/wHigh/wLow/wClose/wOpenT/wAvailT)
// that the frozen P2 engine already maintains — no second candle store, and no
// second ATR implementation.
//
// Window index convention: `wn` is the current window size, so `wn - 1` is the
// bar just confirmed. Detectors that need k predecessors require wn >= k + 1.
// =============================================================================

// Candle metrics, transcribed from measurements/candle_metrics.py.
f_poiRange(int wi) =>
    array.get(wHigh, wi) - array.get(wLow, wi)

f_poiBody(int wi) =>
    math.abs(array.get(wClose, wi) - array.get(wOpen, wi))

f_poiBodyEff(int wi) =>
    float r = f_poiRange(wi)
    r == 0 ? 0.0 : f_poiBody(wi) / r

f_poiUpperWick(int wi) =>
    array.get(wHigh, wi) - math.max(array.get(wOpen, wi), array.get(wClose, wi))

f_poiLowerWick(int wi) =>
    math.min(array.get(wOpen, wi), array.get(wClose, wi)) - array.get(wLow, wi)

f_poiBullClosePos(int wi) =>
    float r = f_poiRange(wi)
    r == 0 ? 0.0 : (array.get(wClose, wi) - array.get(wLow, wi)) / r

f_poiBearClosePos(int wi) =>
    float r = f_poiRange(wi)
    r == 0 ? 0.0 : (array.get(wHigh, wi) - array.get(wClose, wi)) / r

f_poiIsBullCandle(int wi) =>
    array.get(wClose, wi) > array.get(wOpen, wi)

f_poiIsBearCandle(int wi) =>
    array.get(wClose, wi) < array.get(wOpen, wi)

// Emit one POI if its identity is not already in the registry. Production emits
// each semantic POI once; the registry preserves that across the sliding window.
f_poiEmit(int typeCode, int direction, float zoneTop, float zoneBottom, int tier, int srcFirstT, int srcCount, int srcLastT, int candT, int confT) =>
    if f_poiFind(typeCode, srcFirstT, srcCount, srcLastT, f_poiTicks(zoneBottom), f_poiTicks(zoneTop)) == -1
        f_poiAppend(PoiRec.new(typeCode, direction, zoneTop, zoneBottom, candT, confT, confT, tier, srcFirstT, srcCount, srcLastT))

// ---- ORDER BLOCKS (order_blocks.py:27) --------------------------------------
// Adjacent pair only: production performs NO backward search for "the last
// opposite candle before an impulse". Zone is the ORIGIN candle's full range.
f_poiDetectOrderBlocks(int wn) =>
    if wn >= 2
        int oi = wn - 2
        int di = wn - 1
        float originRange = f_poiRange(oi)
        if originRange > 0
            float ratio = f_poiRange(di) / originRange
            if ratio >= C_POI_OB_RATIO_STANDARD
                int typeCode = 0
                int direction = 0
                if f_poiIsBearCandle(oi) and f_poiIsBullCandle(di) and array.get(wClose, di) > array.get(wHigh, oi)
                    typeCode := C_POI_BUY_ORDER_BLOCK
                    direction := C_POI_DIR_BULLISH
                else if f_poiIsBullCandle(oi) and f_poiIsBearCandle(di) and array.get(wClose, di) < array.get(wLow, oi)
                    typeCode := C_POI_SELL_ORDER_BLOCK
                    direction := C_POI_DIR_BEARISH
                if typeCode != 0
                    int tier = ratio >= C_POI_OB_RATIO_STRONG ? C_POI_TIER_STRONG : C_POI_TIER_STANDARD
                    f_poiEmit(typeCode, direction, array.get(wHigh, oi), array.get(wLow, oi), tier, array.get(wOpenT, oi), 2, array.get(wOpenT, di), array.get(wOpenT, oi), array.get(wAvailT, di))

// ---- FAIR VALUE GAPS (fair_value_gaps.py:25) --------------------------------
// STRICT inequality, NO minimum gap size, middle candle unconstrained, and no
// strength tier at all (production builds FVGs without one).
f_poiDetectFvg(int wn) =>
    if wn >= 3
        int fi = wn - 3
        int mi = wn - 2
        int ti = wn - 1
        int typeCode = 0
        int direction = 0
        float zoneTop = 0.0
        float zoneBottom = 0.0
        if array.get(wLow, ti) > array.get(wHigh, fi)
            typeCode := C_POI_BUY_FAIR_VALUE_GAP
            direction := C_POI_DIR_BULLISH
            zoneTop := array.get(wLow, ti)
            zoneBottom := array.get(wHigh, fi)
        else if array.get(wHigh, ti) < array.get(wLow, fi)
            typeCode := C_POI_SELL_FAIR_VALUE_GAP
            direction := C_POI_DIR_BEARISH
            zoneTop := array.get(wLow, fi)
            zoneBottom := array.get(wHigh, ti)
        if typeCode != 0
            f_poiEmit(typeCode, direction, zoneTop, zoneBottom, C_POI_TIER_NA, array.get(wOpenT, fi), 3, array.get(wOpenT, ti), array.get(wOpenT, fi), array.get(wAvailT, ti))
        int _unusedMi = mi

// ---- ENGULFING (engulfing.py:27) --------------------------------------------
// Range ratio + opposite colours ONLY. Production has no body-engulfment test,
// so a candle whose body does not span its predecessor still qualifies.
f_poiDetectEngulfing(int wn) =>
    if wn >= 2
        int ei = wn - 2
        int gi = wn - 1
        float engulfedRange = f_poiRange(ei)
        if engulfedRange > 0
            float ratio = f_poiRange(gi) / engulfedRange
            if ratio >= C_POI_OB_RATIO_STANDARD
                int typeCode = 0
                int direction = 0
                if f_poiIsBearCandle(ei) and f_poiIsBullCandle(gi)
                    typeCode := C_POI_BULLISH_ENGULFING
                    direction := C_POI_DIR_BULLISH
                else if f_poiIsBullCandle(ei) and f_poiIsBearCandle(gi)
                    typeCode := C_POI_BEARISH_ENGULFING
                    direction := C_POI_DIR_BEARISH
                if typeCode != 0
                    int tier = ratio >= C_POI_OB_RATIO_STRONG ? C_POI_TIER_STRONG : C_POI_TIER_STANDARD
                    f_poiEmit(typeCode, direction, array.get(wHigh, ei), array.get(wLow, ei), tier, array.get(wOpenT, ei), 2, array.get(wOpenT, gi), array.get(wOpenT, ei), array.get(wAvailT, gi))

// ---- THREE-CANDLE STARS (three_candle_stars.py:29) --------------------------
// Doji middle by body efficiency; third must close beyond the FIRST candle's
// midpoint. No gap rules and no size rules. Zone is the MIDDLE candle.
f_poiDetectStars(int wn) =>
    if wn >= 3
        int fi = wn - 3
        int mi = wn - 2
        int ti = wn - 1
        if f_poiRange(mi) > 0
            float middleEff = f_poiBodyEff(mi)
            if middleEff <= C_POI_DOJI_BODY_EFF_STANDARD
                float firstMidpoint = (array.get(wHigh, fi) + array.get(wLow, fi)) / 2
                int typeCode = 0
                int direction = 0
                if f_poiIsBearCandle(fi) and f_poiIsBullCandle(ti) and array.get(wClose, ti) > firstMidpoint
                    typeCode := C_POI_MORNING_STAR
                    direction := C_POI_DIR_BULLISH
                else if f_poiIsBullCandle(fi) and f_poiIsBearCandle(ti) and array.get(wClose, ti) < firstMidpoint
                    typeCode := C_POI_EVENING_STAR
                    direction := C_POI_DIR_BEARISH
                if typeCode != 0
                    int tier = middleEff <= C_POI_DOJI_BODY_EFF_STRONG ? C_POI_TIER_STRONG : C_POI_TIER_STANDARD
                    f_poiEmit(typeCode, direction, array.get(wHigh, mi), array.get(wLow, mi), tier, array.get(wOpenT, fi), 3, array.get(wOpenT, ti), array.get(wOpenT, fi), array.get(wAvailT, ti))

// ---- SINGLE-CANDLE REVERSALS (single_candle_reversals.py:32) ----------------
// Hammer / shooting star by wick share, body efficiency and opposite wick.
// No trend filter. Zone is the WICK only.
f_poiDetectSingleCandleReversals(int wn) =>
    if wn >= 1
        int ci = wn - 1
        float candleRange = f_poiRange(ci)
        if candleRange > 0
            float lwShare = f_poiLowerWick(ci) / candleRange
            float uwShare = f_poiUpperWick(ci) / candleRange
            float eff = f_poiBodyEff(ci)
            bool hammerOk = lwShare >= C_POI_HSS_WICK_SHARE_STANDARD and eff <= C_POI_HSS_BODY_EFF_STANDARD and uwShare <= C_POI_HSS_OPP_WICK_STANDARD
            bool starOk = uwShare >= C_POI_HSS_WICK_SHARE_STANDARD and eff <= C_POI_HSS_BODY_EFF_STANDARD and lwShare <= C_POI_HSS_OPP_WICK_STANDARD
            int typeCode = 0
            int direction = 0
            float zoneTop = 0.0
            float zoneBottom = 0.0
            bool strong = false
            if hammerOk
                typeCode := C_POI_HAMMER
                direction := C_POI_DIR_BULLISH
                zoneTop := math.min(array.get(wOpen, ci), array.get(wClose, ci))
                zoneBottom := array.get(wLow, ci)
                strong := lwShare >= C_POI_HSS_WICK_SHARE_STRONG and eff <= C_POI_HSS_BODY_EFF_STRONG and uwShare <= C_POI_HSS_OPP_WICK_STRONG
            else if starOk
                typeCode := C_POI_SHOOTING_STAR
                direction := C_POI_DIR_BEARISH
                zoneTop := array.get(wHigh, ci)
                zoneBottom := math.max(array.get(wOpen, ci), array.get(wClose, ci))
                strong := uwShare >= C_POI_HSS_WICK_SHARE_STRONG and eff <= C_POI_HSS_BODY_EFF_STRONG and lwShare <= C_POI_HSS_OPP_WICK_STRONG
            if typeCode != 0
                f_poiEmit(typeCode, direction, zoneTop, zoneBottom, strong ? C_POI_TIER_STRONG : C_POI_TIER_STANDARD, array.get(wOpenT, ci), 1, array.get(wOpenT, ci), array.get(wOpenT, ci), array.get(wAvailT, ci))

// =============================================================================
// P3-I3 — BASELINE / DELAYED-CONFIRMATION DETECTORS
//         (pressure wicks, reversal candles)
// -----------------------------------------------------------------------------
// Neither uses ATR. Both need more than their own candle:
//
//   pressure wicks   the median range of up to 20 predecessors, which is the
//                    widest dependency in the whole detector set (21 bars) and
//                    therefore what fixes C_POI_MAX_DEPENDENCY_BARS;
//   reversal candles a 3-bar size baseline BEFORE the candidate and a DELAYED
//                    confirmation up to 3 bars AFTER it, so the emitting bar is
//                    not the candidate bar.
//
// The median reuses the frozen P1 helper f_medianRange (identical odd/even
// semantics to measurements/candle_metrics.median_total_range) rather than
// introducing a second median implementation. It gets its own scratch array:
// the P1 comment forbids aliasing one scratch across two live users.
// =============================================================================

var array<float> scPoiRange = array.new<float>()

// ---- PRESSURE WICKS (pressure_wicks.py:38) ----------------------------------
// Single candle. The `uw == 0` / `lw == 0` escapes are production's guard
// against dividing by a zero opposite wick, and are reproduced verbatim.
// With no predecessors the baseline is the candle's OWN range, which makes the
// context ratio exactly 1.0 and therefore never STRONG.
f_poiDetectPressureWicks(int wn) =>
    if wn >= 1
        int ci = wn - 1
        float candleRange = f_poiRange(ci)
        if candleRange > 0
            int precStart = math.max(0, ci - C_POI_PW_BASELINE_WINDOW)
            float baseline = precStart < ci ? f_medianRange(wHigh, wLow, precStart, ci, scPoiRange) : candleRange
            float rangeContextRatio = baseline > 0 ? candleRange / baseline : 1.0

            float lw = f_poiLowerWick(ci)
            float uw = f_poiUpperWick(ci)
            float lwShare = lw / candleRange
            float uwShare = uw / candleRange
            float eff = f_poiBodyEff(ci)
            float bullPos = f_poiBullClosePos(ci)
            float bearPos = f_poiBearClosePos(ci)

            bool dominanceBull = uw == 0 or lw >= C_POI_PW_DOMINANCE_STANDARD * uw
            bool dominanceBear = lw == 0 or uw >= C_POI_PW_DOMINANCE_STANDARD * lw

            bool bullCandidate = lwShare >= C_POI_PW_SHARE_STANDARD and eff >= C_POI_PW_BODY_EFF_STANDARD and dominanceBull and bullPos >= C_POI_PW_CLOSE_POS_STANDARD
            bool bearCandidate = uwShare >= C_POI_PW_SHARE_STANDARD and eff >= C_POI_PW_BODY_EFF_STANDARD and dominanceBear and bearPos >= C_POI_PW_CLOSE_POS_STANDARD

            int typeCode = 0
            int direction = 0
            float zoneTop = 0.0
            float zoneBottom = 0.0
            bool strong = false
            if bullCandidate
                typeCode := C_POI_BULLISH_PRESSURE_WICK
                direction := C_POI_DIR_BULLISH
                zoneTop := math.min(array.get(wOpen, ci), array.get(wClose, ci))
                zoneBottom := array.get(wLow, ci)
                strong := lwShare >= C_POI_PW_SHARE_STRONG and eff >= C_POI_PW_BODY_EFF_STRONG and lw >= C_POI_PW_DOMINANCE_STRONG * uw and bullPos >= C_POI_PW_CLOSE_POS_STRONG and rangeContextRatio >= C_POI_PW_RANGE_CONTEXT_STRONG
            else if bearCandidate
                typeCode := C_POI_BEARISH_PRESSURE_WICK
                direction := C_POI_DIR_BEARISH
                zoneTop := array.get(wHigh, ci)
                zoneBottom := math.max(array.get(wOpen, ci), array.get(wClose, ci))
                strong := uwShare >= C_POI_PW_SHARE_STRONG and eff >= C_POI_PW_BODY_EFF_STRONG and uw >= C_POI_PW_DOMINANCE_STRONG * lw and bearPos >= C_POI_PW_CLOSE_POS_STRONG and rangeContextRatio >= C_POI_PW_RANGE_CONTEXT_STRONG

            if typeCode != 0
                f_poiEmit(typeCode, direction, zoneTop, zoneBottom, strong ? C_POI_TIER_STRONG : C_POI_TIER_STANDARD, array.get(wOpenT, ci), 1, array.get(wOpenT, ci), array.get(wOpenT, ci), array.get(wAvailT, ci))

// ---- REVERSAL CANDLES (reversal_candles.py:36) ------------------------------
// NAMING IS INVERTED BY DESIGN (AD-3): a RED candidate emits SELL_TO_BUY with
// BULLISH direction, a GREEN candidate emits BUY_TO_SELL with BEARISH. The name
// describes the transition being set up, not the candle's own colour.
//
// Confirmation is DELAYED: the candidate needs a later close beyond its own
// midpoint within 3 bars. This detector therefore runs at the CONFIRMING bar
// and looks back for candidates, emitting only when THIS bar is the FIRST
// qualifying probe — which is what makes emission exactly-once.
f_poiDetectReversalCandles(int wn) =>
    for k = 1 to C_POI_REV_CONFIRM_WINDOW
        int ci = wn - 1 - k
        if ci >= C_POI_REV_LOOKBACK
            float baseline = 0.0
            for b = ci - C_POI_REV_LOOKBACK to ci - 1
                baseline := math.max(baseline, f_poiRange(b))
            if baseline > 0
                float ratio = f_poiRange(ci) / baseline
                if ratio >= C_POI_REV_RATIO_STANDARD
                    float eff = f_poiBodyEff(ci)
                    if eff >= C_POI_REV_BODY_EFF_STANDARD
                        int typeCode = 0
                        int direction = 0
                        float closePos = 0.0
                        if f_poiIsBearCandle(ci)
                            closePos := f_poiBearClosePos(ci)
                            typeCode := C_POI_SELL_TO_BUY_CANDLE
                            direction := C_POI_DIR_BULLISH
                        else if f_poiIsBullCandle(ci)
                            closePos := f_poiBullClosePos(ci)
                            typeCode := C_POI_BUY_TO_SELL_CANDLE
                            direction := C_POI_DIR_BEARISH
                        if typeCode != 0 and closePos >= C_POI_REV_CLOSE_POS_STANDARD
                            float midpoint = (array.get(wHigh, ci) + array.get(wLow, ci)) / 2
                            int confirmIdx = -1
                            int probeEnd = math.min(ci + 1 + C_POI_REV_CONFIRM_WINDOW, wn)
                            // EMPTY-RANGE GUARD. Pine's `for` counts DOWN when
                            // `to` < `from`, so an empty probe window would step
                            // BACKWARDS off the window instead of not running at
                            // all -- Python's range() is simply empty here. Clamp
                            // the bound and gate the body so the two agree.
                            for p = ci + 1 to math.max(ci + 1, probeEnd - 1)
                                if p < probeEnd and confirmIdx == -1
                                    bool hit = direction == C_POI_DIR_BULLISH ? array.get(wClose, p) > midpoint : array.get(wClose, p) < midpoint
                                    if hit
                                        confirmIdx := p
                            // Emit ONLY when this bar is the first qualifying
                            // probe: an earlier one already emitted, a later one
                            // has not happened yet.
                            if confirmIdx == wn - 1
                                bool strong = ratio >= C_POI_REV_RATIO_STRONG and eff >= C_POI_REV_BODY_EFF_STRONG and closePos >= C_POI_REV_CLOSE_POS_STRONG
                                f_poiEmit(typeCode, direction, array.get(wHigh, ci), array.get(wLow, ci), strong ? C_POI_TIER_STRONG : C_POI_TIER_STANDARD, array.get(wOpenT, ci), 1, array.get(wOpenT, ci), array.get(wOpenT, ci), array.get(wAvailT, confirmIdx))

// =============================================================================
// P3-I4 — ATR-DEPENDENT DETECTOR (base formations)
// -----------------------------------------------------------------------------
// Bases are the ONLY detector family that consumes ATR directly. It reads the
// CONTINUOUS Wilder ATR the frozen P1 engine already maintains (wAtr), never a
// window-local recomputation: production calls compute_atr_series over the whole
// candle array, so a ring-local ATR would diverge exactly the way P1-PERF-4
// documented for truncated execution.
//
// The reference ATR is taken at the LAST BASE candle (production indexes
// atr_values[end - 1], where `end` is the departure), NOT at the departure.
//
// Production loops (start, length) over the whole array with
// `departure = candles[start + length]`. For a departure at index d the
// qualifying pairs are exactly start = d - length for length 2..6, so this
// detector checks five candidate bases at the departure bar and is bounded by
// C_POI_BASE_MAX_CANDLES + 1 bars. Every qualifying (start, length) emits its
// own POI: production does NOT pick a single best base per departure.
// =============================================================================

f_poiDetectBases(int wn) =>
    int di = wn - 1
    if di >= C_POI_BASE_MIN_CANDLES
        float departureRange = f_poiRange(di)
        if departureRange > 0
            for length = C_POI_BASE_MIN_CANDLES to C_POI_BASE_MAX_CANDLES
                int si = di - length
                if si >= 0
                    float maxBaseRange = 0.0
                    float baseHigh = array.get(wHigh, si)
                    float baseLow = array.get(wLow, si)
                    for b = si to di - 1
                        maxBaseRange := math.max(maxBaseRange, f_poiRange(b))
                        baseHigh := math.max(baseHigh, array.get(wHigh, b))
                        baseLow := math.min(baseLow, array.get(wLow, b))

                    bool ok = maxBaseRange > 0
                    if ok and maxBaseRange > C_POI_SMALL_CANDLE_STANDARD * departureRange
                        ok := false

                    float ratio = ok ? departureRange / maxBaseRange : 0.0
                    if ok and ratio < C_POI_OB_RATIO_STANDARD
                        ok := false

                    float baseHeight = baseHigh - baseLow
                    if ok
                        // Production: `atr_values[end - 1]`, falling back to the
                        // departure range when the ATR is unavailable or zero.
                        // The comparison is `is None or == 0` here, which is the
                        // BASES rule; the lifecycle uses `> 0` instead, so the
                        // two are deliberately not shared.
                        float atrRaw = array.get(wAtr, di - 1)
                        float referenceAtr = na(atrRaw) or atrRaw == 0 ? departureRange : atrRaw
                        if baseHeight > C_POI_BASE_HEIGHT_ATR_MULT * referenceAtr
                            ok := false
                        else if baseHeight > C_POI_BASE_HEIGHT_DEP_MULT * departureRange
                            ok := false

                    if ok and baseHeight > 0
                        float baseMidpoint = (baseHigh + baseLow) / 2
                        for b = si to di - 1
                            if ok
                                float candleMid = (array.get(wHigh, b) + array.get(wLow, b)) / 2
                                if math.abs(candleMid - baseMidpoint) > C_POI_BASE_MIDPOINT_DRIFT * baseHeight
                                    ok := false

                    if ok
                        for b = si to di - 2
                            if ok
                                float overlapTop = math.min(array.get(wHigh, b), array.get(wHigh, b + 1))
                                float overlapBottom = math.max(array.get(wLow, b), array.get(wLow, b + 1))
                                float overlap = math.max(0.0, overlapTop - overlapBottom)
                                float minRange = math.min(f_poiRange(b), f_poiRange(b + 1))
                                // A zero-range member is SKIPPED, not rejected.
                                if minRange != 0 and overlap / minRange < C_POI_BASE_OVERLAP_MIN
                                    ok := false

                    if ok
                        int typeCode = 0
                        int direction = 0
                        if f_poiIsBullCandle(di) and array.get(wClose, di) > baseHigh
                            typeCode := C_POI_BASE_RALLY
                            direction := C_POI_DIR_BULLISH
                        else if f_poiIsBearCandle(di) and array.get(wClose, di) < baseLow
                            typeCode := C_POI_BASE_DROP
                            direction := C_POI_DIR_BEARISH
                        if typeCode != 0
                            bool strong = ratio >= C_POI_OB_RATIO_STRONG and maxBaseRange <= C_POI_SMALL_CANDLE_STRONG * departureRange
                            f_poiEmit(typeCode, direction, baseHigh, baseLow, strong ? C_POI_TIER_STRONG : C_POI_TIER_STANDARD, array.get(wOpenT, si), length + 1, array.get(wOpenT, di), array.get(wOpenT, si), array.get(wAvailT, di))

// =============================================================================
// P3-I5 — REFERENCE ZONE PROJECTION (support / resistance)
// -----------------------------------------------------------------------------
// These are NOT candle detectors: production projects existing P1 records 1:1
// (reference_zones.py:26), copying bounds verbatim and inheriting the P1
// record's own times. So this reads the S/R zones the frozen P1 engine already
// published (srCached) instead of re-running any S/R detection.
//
// All three POI timestamps collapse to the zone's confirmation time, because
// the P1 finalizer sets a zone's availability to its confirmation time
// (domain/analyzer.py:377).
//
// Reference zones carry NO strength tier: production builds them without one.
//
// EQH/EQL clusters are the other half of production's reference projection but
// are lifecycle-INELIGIBLE and therefore P3 CONTEXT (AD-6); they are
// deliberately not emitted here.
// =============================================================================

f_poiDetectReferenceZones() =>
    int m = array.size(srCached)
    if m > 0
        for zi = 0 to m - 1
            SRRec z = array.get(srCached, zi)
            bool isSupport = z.zoneType == SWING_LOW
            int typeCode = isSupport ? C_POI_SUPPORT_ZONE : C_POI_RESISTANCE_ZONE
            int direction = isSupport ? C_POI_DIR_BULLISH : C_POI_DIR_BEARISH
            f_poiEmit(typeCode, direction, z.zoneTop, z.zoneBottom, C_POI_TIER_NA, z.confirmationTime, 1, z.confirmationTime, z.confirmationTime, z.confirmationTime)

// =============================================================================
// P3-I6 — PERSISTENT POI LIFECYCLE
// -----------------------------------------------------------------------------
// Production's walk LOOKS AHEAD: a breach at bar i is resolved by scanning up
// to three bars forward for a reclaim, then up to three bars past the reclaim
// for a fast displacement leg. Pine sees one confirmed bar at a time, so a
// naive port would have to re-walk each POI's whole post-origin history every
// bar — unbounded work, and the thing AD-5 forbids.
//
// THE COMMITTED BOUNDARY. An episode's outcome is final only once the windows
// it depends on are complete:
//
//   * a bar that does not breach is final immediately;
//   * a breach whose 3-bar reclaim window is complete is final, because no
//     later bar can produce an EARLIER reclaim;
//   * a reclaim is final as soon as it is found, for the same reason;
//   * a reclaim WITHOUT displacement is provisional until the displacement
//     window completes, because a later fast leg upgrades it to a false
//     invalidation;
//   * genuine invalidation needs a full window, so it is final by construction.
//
// poiResumeIdx holds that boundary and advances only past final outcomes;
// everything after it is re-derived each bar. An episode spans at most
// 1 + 3 + 3 = 7 bars, so the re-walk is a handful of iterations per POI per
// bar rather than a function of history.
//
// The reported status at bar T is therefore identical to
// run_poi_lifecycle(candles[0..T]) — INCLUDING the provisional tail production
// itself produces on a truncated window. The prefix campaign asserts exactly
// that equivalence at every bar.
//
// Absolute confirmed-bar indices are used throughout; a window index is
// (absolute - absFirst). Since the boundary never lags more than ~8 bars, the
// 300-bar P1 window always contains the span being re-walked.
// =============================================================================

// ---- leg speed classification (measurements/legs.py, transcribed) ----------
// Returns true iff the leg classifies FAST or STRONG_FAST, which is the only
// thing the lifecycle asks of it.
f_poiLegQualifies(int fromAbs, int toAbs, int absFirst, int dir) =>
    int barCount = toAbs - fromAbs + 1
    bool qualifies = false
    if barCount > 0
        int wFrom = fromAbs - absFirst
        int wTo = toAbs - absFirst
        float startPrice = array.get(wOpen, wFrom)
        float endPrice = array.get(wClose, wTo)
        float netDistance = math.abs(endPrice - startPrice)

        array.clear(scPoiRange)
        float pathDistance = 0.0
        int directionalCloses = 0
        for w = wFrom to wTo
            pathDistance := pathDistance + f_poiRange(w)
            float atrW = array.get(wAtr, w)
            if not na(atrW)
                array.push(scPoiRange, atrW)
            bool directional = dir == C_POI_DIR_BULLISH ? array.get(wClose, w) >= array.get(wOpen, w) : array.get(wClose, w) <= array.get(wOpen, w)
            if directional
                directionalCloses += 1

        // Production medians only the KNOWN ATR values and yields 0 when none
        // are known, which then classifies the leg SLOW_OR_UNCLEAR.
        array.sort(scPoiRange, order.ascending)
        float referenceAtr = f_medianOfSorted(scPoiRange)
        float share = directionalCloses / barCount

        if referenceAtr != 0 and pathDistance != 0
            float speed = netDistance / (barCount * referenceAtr)
            float efficiency = netDistance / pathDistance
            bool strong = speed >= C_POI_LEG_STRONG_SPEED and efficiency >= C_POI_LEG_STRONG_EFFICIENCY and share >= C_POI_LEG_STRONG_SHARE
            bool fast = speed >= C_POI_LEG_FAST_SPEED and efficiency >= C_POI_LEG_FAST_EFFICIENCY and share >= C_POI_LEG_FAST_SHARE
            qualifies := strong or fast
    qualifies

// Per-bar tolerance at an absolute index, with the production ATR fallback.
f_poiTolAt(int absIdx, int absFirst, float zoneHeight, float atrMult, float heightMult) =>
    int wi = absIdx - absFirst
    f_poiTolerance(zoneHeight, f_poiReferenceAtr(array.get(wAtr, wi), f_poiRange(wi)), atrMult, heightMult)

// ---- advance ONE POI by one confirmed bar ----------------------------------
f_poiAdvanceLifecycle(int i, int absFirst, int cbc) =>
    int tAbs = cbc - 1
    int wLast = tAbs - absFirst
    float zTop = array.get(poiZoneTop, i)
    float zBot = array.get(poiZoneBottom, i)
    float zoneHeight = zTop - zBot
    int dir = array.get(poiDirection, i)

    // Taps are an INDEPENDENT subsystem: they keep counting after a terminal
    // invalidation, exactly as production does.
    bool touching = f_poiTouches(i, array.get(wHigh, wLast), array.get(wLow, wLast))
    if touching and not array.get(poiInTap, i)
        array.set(poiTapCount, i, array.get(poiTapCount, i) + 1)
        array.set(poiInTap, i, true)
    else if not touching
        array.set(poiInTap, i, false)

    if not array.get(poiTerminal, i)
        int status = array.get(poiStatus, i)
        int commitIdx = array.get(poiResumeIdx, i)
        int commitStatus = status
        bool terminal = false
        int idx = commitIdx
        int n = cbc
        int trCount = 0
        int trLastCode = C_ST_NA
        int trLastEvent = C_ST_NA
        int trLastAvail = C_ST_NA
        int trRelevant = 0
        int cTrCount = 0
        int cTrLastCode = C_ST_NA
        int cTrLastEvent = C_ST_NA
        int cTrLastAvail = C_ST_NA
        int cTrRelevant = 0
        bool cTrSeen = false
        bool falseSeen = false
        bool cFalseSeen = false

        // The boundary never lags more than one episode, so this loop runs a
        // handful of times; the guard is a backstop, never a semantic bound.
        int guard = 0
        while idx < n and not terminal and guard < 64
            guard += 1
            float overshoot = f_poiTolAt(idx, absFirst, zoneHeight, C_POI_OVERSHOOT_TOL_ATR_MULT, C_POI_OVERSHOOT_TOL_HEIGHT_MULT)
            if f_poiIsBreach(dir, zTop, zBot, array.get(wClose, idx - absFirst), overshoot)
                status := C_POI_LC_CLOSE_BREACH_CANDIDATE
                trCount += 1
                trLastCode := C_POI_TR_CLOSE_BREACH_CANDIDATE
                trLastEvent := array.get(wOpenT, idx - absFirst)
                trLastAvail := array.get(wAvailT, idx - absFirst)
                int windowEnd = math.min(idx + 1 + C_POI_RECLAIM_WINDOW_BARS, n)
                bool windowComplete = (idx + 1 + C_POI_RECLAIM_WINDOW_BARS) <= n

                int reclaimIdx = -1
                // EMPTY-RANGE GUARD (see f_poiDetectReversalCandles): an
                // incomplete reclaim window must run ZERO times, not backwards.
                for j = idx + 1 to math.max(idx + 1, windowEnd - 1)
                    if j < windowEnd and reclaimIdx == -1
                        float contact = f_poiTolAt(j, absFirst, zoneHeight, C_POI_CONTACT_TOL_ATR_MULT, C_POI_CONTACT_TOL_HEIGHT_MULT)
                        if f_poiIsReclaim(dir, zTop, zBot, array.get(wClose, j - absFirst), contact)
                            reclaimIdx := j

                if reclaimIdx != -1
                    status := C_POI_LC_RECLAIM_CONFIRMED
                    trCount += 1
                    trLastCode := C_POI_TR_RECLAIM_CONFIRMED
                    trLastEvent := array.get(wOpenT, reclaimIdx - absFirst)
                    trLastAvail := array.get(wAvailT, reclaimIdx - absFirst)
                    int dispEnd = math.min(reclaimIdx + 1 + C_POI_DISPLACEMENT_WINDOW_BARS, n)
                    bool dispComplete = (reclaimIdx + 1 + C_POI_DISPLACEMENT_WINDOW_BARS) <= n
                    int dispIdx = -1
                    // EMPTY-RANGE GUARD: an incomplete displacement window must
                    // run ZERO times, not backwards.
                    for k = reclaimIdx + 1 to math.max(reclaimIdx + 1, dispEnd - 1)
                        if k < dispEnd and dispIdx == -1
                            float contactK = f_poiTolAt(k, absFirst, zoneHeight, C_POI_CONTACT_TOL_ATR_MULT, C_POI_CONTACT_TOL_HEIGHT_MULT)
                            if f_poiIsDisplacement(dir, zTop, zBot, array.get(wClose, k - absFirst), contactK)
                                if f_poiLegQualifies(reclaimIdx + 1, k, absFirst, dir)
                                    dispIdx := k

                    bool episodeFinal = false
                    if dispIdx != -1
                        // DISPLACEMENT_AFTER_RECLAIM then FALSE_INVALIDATION are
                        // emitted back to back on the same candle; the settled
                        // status is the false invalidation.
                        trCount += 2
                        trRelevant += 1
                        trLastCode := C_POI_TR_FALSE_INVALIDATION_CONFIRMED
                        falseSeen := true
                        trLastEvent := array.get(wOpenT, dispIdx - absFirst)
                        trLastAvail := array.get(wAvailT, dispIdx - absFirst)
                        status := C_POI_LC_FALSE_INVALIDATION_CONFIRMED
                        episodeFinal := true
                    else
                        trCount += 1
                        trLastCode := C_POI_TR_RECLAIM_WITHOUT_DISPLACEMENT
                        trLastEvent := array.get(wOpenT, reclaimIdx - absFirst)
                        trLastAvail := array.get(wAvailT, reclaimIdx - absFirst)
                        status := C_POI_LC_RECLAIM_WITHOUT_DISPLACEMENT
                        episodeFinal := dispComplete
                    idx := reclaimIdx + 1
                    if episodeFinal
                        commitIdx := idx
                        commitStatus := status
                        cTrCount := trCount
                        cTrLastCode := trLastCode
                        cTrLastEvent := trLastEvent
                        cTrLastAvail := trLastAvail
                        cTrRelevant := trRelevant
                        cTrSeen := true
                        cFalseSeen := falseSeen
                else
                    int windowCount = windowEnd - (idx + 1)
                    int qualifying = 0
                    // EMPTY-RANGE GUARD: same hazard, and here the body has no
                    // condition of its own, so the guard becomes the body.
                    for j = idx + 1 to math.max(idx + 1, windowEnd - 1)
                        if j < windowEnd
                            float ov = f_poiTolAt(j, absFirst, zoneHeight, C_POI_OVERSHOOT_TOL_ATR_MULT, C_POI_OVERSHOOT_TOL_HEIGHT_MULT)
                            if f_poiIsBreach(dir, zTop, zBot, array.get(wClose, j - absFirst), ov)
                                qualifying += 1

                    bool bar3 = false
                    if windowCount == C_POI_RECLAIM_WINDOW_BARS and qualifying >= 2
                        float ovLast = f_poiTolAt(windowEnd - 1, absFirst, zoneHeight, C_POI_OVERSHOOT_TOL_ATR_MULT, C_POI_OVERSHOOT_TOL_HEIGHT_MULT)
                        bar3 := f_poiIsBreach(dir, zTop, zBot, array.get(wClose, (windowEnd - 1) - absFirst), ovLast)

                    if bar3
                        trCount += 1
                        trRelevant += 1
                        trLastCode := C_POI_TR_GENUINE_INVALIDATION_CONFIRMED
                        trLastEvent := array.get(wOpenT, (windowEnd - 1) - absFirst)
                        trLastAvail := array.get(wAvailT, (windowEnd - 1) - absFirst)
                        status := C_POI_LC_GENUINE_INVALIDATION_CONFIRMED
                        terminal := true
                        idx := windowEnd
                        commitIdx := idx
                        commitStatus := status
                        cTrCount := trCount
                        cTrLastCode := trLastCode
                        cTrLastEvent := trLastEvent
                        cTrLastAvail := trLastAvail
                        cTrRelevant := trRelevant
                        cTrSeen := true
                        cFalseSeen := falseSeen
                    else
                        if windowCount > 0
                            trCount += 1
                            trLastCode := C_POI_TR_RECLAIM_FAILED
                            trLastEvent := array.get(wOpenT, (windowEnd - 1) - absFirst)
                            trLastAvail := array.get(wAvailT, (windowEnd - 1) - absFirst)
                            status := C_POI_LC_RECLAIM_FAILED
                        idx := windowEnd
                        if windowComplete
                            commitIdx := idx
                            commitStatus := status
                            cTrCount := trCount
                            cTrLastCode := trLastCode
                            cTrLastEvent := trLastEvent
                            cTrLastAvail := trLastAvail
                            cTrRelevant := trRelevant
                            cTrSeen := true
                            cFalseSeen := falseSeen
            else
                idx := idx + 1
                commitIdx := idx
                commitStatus := status
                cTrCount := trCount
                cTrLastCode := trLastCode
                cTrLastEvent := trLastEvent
                cTrLastAvail := trLastAvail
                cTrRelevant := trRelevant
                cTrSeen := true
                cFalseSeen := falseSeen

        array.set(poiResumeIdx, i, commitIdx)
        array.set(poiStatus, i, commitStatus)
        array.set(poiReported, i, status)

        // Committed tallies grow only by transitions whose episode is final;
        // the reported tallies add the pending tail, which is re-derived next
        // bar. A later bar therefore never re-emits an already-committed event.
        int priorCount = array.get(poiCommTransCount, i)
        int priorRelevant = array.get(poiCommRelevant, i)
        if cTrSeen
            array.set(poiCommTransCount, i, priorCount + cTrCount)
            array.set(poiCommRelevant, i, priorRelevant + cTrRelevant)
            if cFalseSeen
                array.set(poiCommFalseInv, i, true)
            if cTrCount > 0
                array.set(poiCommLastCode, i, cTrLastCode)
                array.set(poiCommLastEvent, i, cTrLastEvent)
                array.set(poiCommLastAvail, i, cTrLastAvail)
        array.set(poiRepTransCount, i, array.get(poiCommTransCount, i) + (trCount - cTrCount))
        array.set(poiRepRelevant, i, array.get(poiCommRelevant, i) + (trRelevant - cTrRelevant))
        array.set(poiRepFalseInv, i, array.get(poiCommFalseInv, i) or falseSeen)
        if trCount > 0
            array.set(poiRepLastCode, i, trLastCode)
            array.set(poiRepLastEvent, i, trLastEvent)
            array.set(poiRepLastAvail, i, trLastAvail)
        else
            array.set(poiRepLastCode, i, array.get(poiCommLastCode, i))
            array.set(poiRepLastEvent, i, array.get(poiCommLastEvent, i))
            array.set(poiRepLastAvail, i, array.get(poiCommLastAvail, i))
        if terminal
            array.set(poiTerminal, i, true)

// ---- advance EVERY live POI by one confirmed bar ---------------------------
// Terminal POIs are skipped for the walk (their state is frozen in source) but
// still receive tap updates, because taps keep counting after invalidation.
f_poiAdvanceAllLifecycles(int absFirst, int cbc) =>
    int m = array.size(poiType)
    if m > 0
        for i = 0 to m - 1
            // A POI becomes live on the first confirmed bar whose availability
            // is strictly later than its own (lifecycle.py:164-170). Production
            // SCANS the candle array for that bar; it has no notion of when an
            // engine happened to discover the POI. Most POIs are registered by
            // the bar that confirms them, so that bar IS the current one and the
            // distinction never shows. Reference zones are different: they are a
            // copy of P1's published S/R, and a zone whose origin is outranked by
            // an earlier same-direction pivot stays invisible until that pivot
            // leaves the scan range -- so the window can hand P3 a zone whose
            // availability is already far behind. Starting such a POI HERE would
            // silently skip its whole early life.
            //
            // The scan below is production's, bounded to the window. That is
            // always enough: the origin is only unblocked once the blocker falls
            // out of [T-W+1+R, T-R], so the delay is at most W-4 bars and the
            // bar we need is still retained.
            if array.get(poiResumeIdx, i) == C_ST_NA
                if array.get(wAvailT, cbc - 1 - absFirst) > array.get(poiAvailTime, i)
                    int nW = array.size(wAvailT)
                    int startAbs = cbc - 1
                    for j = 0 to nW - 1
                        if array.get(wAvailT, j) > array.get(poiAvailTime, i)
                            startAbs := absFirst + j
                            break
                    // Taps are counted per bar as bars arrive, so the bars the
                    // walk is about to skip have to be replayed here or their
                    // taps are lost (_compute_freshness_and_taps counts from the
                    // same start_index). The current bar is left to
                    // f_poiAdvanceLifecycle, which counts it as usual.
                    // The guard keeps an empty range from running BACKWARDS,
                    // which is what a Pine `for` does when `to` < `from`.
                    if startAbs <= cbc - 2
                        for k = startAbs to cbc - 2
                            int wk = k - absFirst
                            bool tch = f_poiTouches(i, array.get(wHigh, wk), array.get(wLow, wk))
                            if tch and not array.get(poiInTap, i)
                                array.set(poiTapCount, i, array.get(poiTapCount, i) + 1)
                                array.set(poiInTap, i, true)
                            else if not tch
                                array.set(poiInTap, i, false)
                    array.set(poiResumeIdx, i, startAbs)
            if array.get(poiResumeIdx, i) != C_ST_NA
                f_poiAdvanceLifecycle(i, absFirst, cbc)

// =============================================================================
// P3-I8 — PER-BAR DRIVER
// =============================================================================
// Everything above this line is a library: pure functions over the P1 window
// and the POI registry. NOTHING CALLED THEM. P3 shipped with no entry point, so
// the registry stayed empty on every real execution while the synthetic suite
// stayed green -- those tests drive the Python transcription of these functions
// directly, which proves the SEMANTICS but never that the script invokes them.
// The atomic real-data capture at anchor 1787949000000 reported nregistry=0 and
// exposed it. This block is the missing entry point; it adds no new semantics.
//
// Order per confirmed bar mirrors the verified model exactly:
//
//   1. DETECTION -- p3_pine_model.run_frontier: every detector over the current
//      window, with emission guarded exactly-once by identity inside f_poiEmit,
//      so re-running a bar cannot duplicate a POI.
//   2. LIFECYCLE -- PoiLifecycleCursor.advance for every registered POI, via
//      f_poiAdvanceAllLifecycles.
//
// The two steps cannot interfere within one bar: a POI emitted on this bar
// carries this bar's availability, and f_poiAdvanceAllLifecycles only starts a
// POI once a confirmed bar's availability is STRICTLY later, so it first moves
// on the NEXT bar. That is the same gate lifecycle.py:165-170 applies.
//
// absFirst is recomputed here rather than shared: it is a local of the P1
// confirmed-bar block, and confirmedBarCount - windowSize reproduces it exactly
// (P1 computes it the same way, from the same two quantities).
//
// Runs only on CONFIRMED bars, so the forming realtime bar never mutates P3
// state -- the non-repaint contract the whole port is built on.

// =============================================================================
// P4 — BTMM SETUP ENGINE  (P4-I1 .. P4-I8)
// -----------------------------------------------------------------------------
// Everything ABOVE this banner is the P3 DEV scanner, unchanged except the
// indicator title and the two additive poi*FalseInv arrays declared with the
// P3 lifecycle tallies. No P3 semantics are altered.
//
// WHAT THIS IS. One BTMM setup per BTMM-eligible POI, advanced one confirmed
// bar at a time. This is a transcription of btmm/lifecycle_cursor.py, NOT of
// run_btmm_lifecycle: the batch walk re-runs the whole cascade over candles[0:]
// every bar, which Pine cannot do, while the cursor commits each price stage
// once and never rescans. The cursor is proven byte-identical to the batch at
// every prefix on the Python side, and the Pine-shaped transcription this file
// follows is proven against analyze_btmm in
// tests/unit/test_p4_btmm_pine_model_parity.py.
//
// UPSTREAM. P4 reads P3 POI observations, the two BTMM-consumed P3 lifecycle
// facts, candles and ATR. It reads NO P1 detector output and nothing from P2,
// so no new upstream dependency is introduced here.
//
// SINGLE TIMEFRAME. analyze_btmm takes a tuple of timeframe bundles, but each
// setup only ever observes its own POI's timeframe; a combined call equals the
// union of independent single-timeframe calls (proven in
// tests/unit/test_btmm_timeframe_partition.py). That is what makes a
// single-chart port faithful, and why there is no request.security here.
//
// REVIEWED EVIDENCE — THE ONE THING THIS ENGINE WILL NOT DO. Confirmation is
// gated on liquidity_evidence_status, which production assigns ONLY from a
// human-reviewed BtmmReviewedEvidence record. TradingView has no authorized
// transport for such a record, so the runtime supplies none and every setup
// that reaches the final gate cancels with NO_LIQUIDITY_EVIDENCE. That is the
// contract behaving correctly, not a missing feature, and it must never be
// papered over: no defaulting a gate to PASS, no treating a Pine calculation as
// expert evidence, no confirming without review. The complete engine including
// BTMM_CONFIRMED is implemented and proven against the oracle with evidence
// fixtures; only the transport is absent.
//
// DERIVED LIQUIDITY IS NOT REVIEW. A P3 FALSE_INVALIDATION_CONFIRMED does give
// LIQUIDITY_AFTER_POI with source RULE_BASED, and that is ported below. It
// writes the location and the source and nothing else -- it cannot set
// liquidity_evidence_status, which is what the gate reads. Derived evidence
// says WHERE liquidity was taken; only review says THAT it was reviewed.
//
// CLOSED-BAR RULE. Every P4 mutation is gated on barstate.isconfirmed, exactly
// as P1, P2 and P3 are.
// =============================================================================

// ---- lifecycle status codes -------------------------------------------------
int C_BTMM_ST_NA        = 0
int C_BTMM_ST_CANDIDATE = 1
int C_BTMM_ST_FORMING   = 2
int C_BTMM_ST_BLOCKED   = 3
int C_BTMM_ST_CONFIRMED = 4
int C_BTMM_ST_CANCELLED = 5

// ---- formation stages. Three of the six declared stages are RESERVED in
// production (CONTEXT_CHECK, LIQUIDITY_MONITORING, APPROACH_MONITORING are
// never assigned); the engine reports from POI interaction onward.
int C_BTMM_STAGE_NA         = 0
int C_BTMM_STAGE_INTERACTION = 4
int C_BTMM_STAGE_REACTION    = 5
int C_BTMM_STAGE_FINAL_GATE  = 6

// ---- gate status ------------------------------------------------------------
int C_BTMM_GATE_PENDING = 0
int C_BTMM_GATE_PASS    = 1
int C_BTMM_GATE_FAIL    = 2

// ---- interaction classes. Seven of the nine declared classes are produced;
// NO_CONTACT and NEAR_MISS are reserved vocabulary that production never
// assigns (find_first_interaction returns nothing rather than labelling an
// absence), so they are deliberately absent here.
int C_BTMM_IC_NONE            = 0
int C_BTMM_IC_EDGE_TOUCH      = 1
int C_BTMM_IC_PARTIAL_ENTRY   = 2
int C_BTMM_IC_DEEP_ENTRY      = 3
int C_BTMM_IC_FAR_BOUNDARY    = 4
int C_BTMM_IC_CONTROLLED_OVER = 5
int C_BTMM_IC_EXCESSIVE_OVER  = 6
int C_BTMM_IC_NONCANONICAL    = 9

f_btmmInteractionEligible(int code) =>
    code == C_BTMM_IC_EDGE_TOUCH or code == C_BTMM_IC_PARTIAL_ENTRY or code == C_BTMM_IC_DEEP_ENTRY or code == C_BTMM_IC_FAR_BOUNDARY or code == C_BTMM_IC_CONTROLLED_OVER

// ---- reaction tiers (AWAITING_REACTION / REACTION_IN_PROGRESS reserved) -----
int C_BTMM_RC_NONE     = 0
int C_BTMM_RC_WEAK     = 3
int C_BTMM_RC_STANDARD = 4
int C_BTMM_RC_STRONG   = 5

// ---- leg speed (measurements/legs.py) --------------------------------------
int C_BTMM_SPD_NONE        = 0
int C_BTMM_SPD_SLOW        = 1
int C_BTMM_SPD_FAST        = 2
int C_BTMM_SPD_STRONG_FAST = 3

// ---- context / session / volume. PENDING is the runtime value: with no
// reviewed evidence these never move.
int C_BTMM_CTX_PENDING    = 0
int C_BTMM_CTX_ALIGNED    = 1
int C_BTMM_CTX_MISALIGNED = 2
int C_BTMM_CTX_UNKNOWN    = 3

int C_BTMM_SESS_PENDING  = 0
int C_BTMM_SESS_ACTIVE   = 1
int C_BTMM_SESS_INACTIVE = 2
int C_BTMM_SESS_UNKNOWN  = 3

int C_BTMM_VOL_PENDING    = 0
int C_BTMM_VOL_SUPPORTS   = 1
int C_BTMM_VOL_FAILS      = 2
int C_BTMM_VOL_MISSING    = 3
int C_BTMM_VOL_UNRESOLVED = 4

// ---- liquidity. Only LIQUIDITY_AFTER_POI is derivable: it is the sole return
// of find_automatic_liquidity_evidence, and reviewed evidence carries no
// location field at all. The other five locations are reserved.
int C_BTMM_LQS_PENDING = 0
int C_BTMM_LQS_PRESENT = 1
int C_BTMM_LQL_NA        = 0
int C_BTMM_LQL_AFTER_POI = 3

// ---- evidence sources. MODEL_PROPOSED is deliberately absent: it is rejected
// by every reviewed-source validator and never produced internally, so no BTMM
// record can carry it.
int C_BTMM_SRC_NA            = 0
int C_BTMM_SRC_EXPERT        = 1
int C_BTMM_SRC_RULE_BASED    = 2
int C_BTMM_SRC_HYBRID_REV    = 4
int C_BTMM_SRC_RULE_BASED_REV = 5

// ---- terminal reasons -------------------------------------------------------
int C_BTMM_CANCEL_NA          = 0
int C_BTMM_CANCEL_POI_REJECTED = 1
int C_BTMM_CANCEL_INELIGIBLE  = 2
int C_BTMM_CANCEL_WEAK        = 3
int C_BTMM_CANCEL_SPEED       = 4
int C_BTMM_CANCEL_CONTEXT     = 5
int C_BTMM_CANCEL_SESSION     = 6
int C_BTMM_CANCEL_VOLUME      = 7
int C_BTMM_CANCEL_NO_LIQUIDITY = 8

int C_BTMM_BLOCK_NA            = 0
int C_BTMM_BLOCK_CONTEXT       = 1
int C_BTMM_BLOCK_LIQ_PENDING   = 2
int C_BTMM_BLOCK_VOLUME_PENDING = 3
int C_BTMM_BLOCK_FORMATION_TF  = 4

// ---- transition codes -------------------------------------------------------
int C_BTMM_TR_ENTERED_FORMING = 1
int C_BTMM_TR_ACCURACY_GATE   = 2
int C_BTMM_TR_INELIGIBLE      = 3
int C_BTMM_TR_REACTION_GATE   = 4
int C_BTMM_TR_WEAK_REACTION   = 5
int C_BTMM_TR_SPEED_GATE      = 6
int C_BTMM_TR_SPEED_FAILED    = 7
int C_BTMM_TR_BLOCKED         = 8
int C_BTMM_TR_RESUMED_FORMING = 9
int C_BTMM_TR_CONFIRMED       = 10
int C_BTMM_TR_POI_REJECTED    = 11
int C_BTMM_TR_CONTEXT_REJECTED = 12
int C_BTMM_TR_SESSION_INACTIVE = 13
int C_BTMM_TR_VOLUME_FAILED   = 14
int C_BTMM_TR_NO_LIQUIDITY    = 15

// ---- production BTMM configuration (btmm/configuration.py, verbatim) --------
float C_BTMM_OVERSHOOT_TOL_ATR_MULT    = 0.10
float C_BTMM_OVERSHOOT_TOL_HEIGHT_MULT = 0.25
float C_BTMM_EDGE_TOUCH_MAX_RATIO      = 0.25
float C_BTMM_PARTIAL_ENTRY_MAX_RATIO   = 0.50
int   C_BTMM_REACTION_WINDOW_BARS      = 5
float C_BTMM_STD_ATR_RATIO             = 0.75
float C_BTMM_STD_CLEARANCE_RATIO       = 1.00
float C_BTMM_STD_EFFICIENCY            = 0.50
float C_BTMM_STD_CANDLE_SHARE          = 0.60
float C_BTMM_STRONG_ATR_RATIO          = 1.25
float C_BTMM_STRONG_CLEARANCE_RATIO    = 1.50
float C_BTMM_STRONG_EFFICIENCY         = 0.60
float C_BTMM_STRONG_CANDLE_SHARE       = 0.67
float C_BTMM_FAST_SPEED                = 0.50
float C_BTMM_FAST_EFFICIENCY           = 0.60
float C_BTMM_FAST_CANDLE_SHARE         = 0.67
float C_BTMM_SFAST_SPEED               = 0.75
float C_BTMM_SFAST_EFFICIENCY          = 0.75
float C_BTMM_SFAST_CANDLE_SHARE        = 0.80

// M5 and M15 form setups; M1 is supporting-only. On a single-timeframe chart
// both are properties of the chart's own timeframe, decided once.
//
// SUPPORTED is not the same as FORMATION, and conflating them is wrong in both
// directions. analyze_btmm skips any POI whose source_timeframe is outside
// formation_timeframes | supporting_only_timeframes (analyzer.py:400-416), so
// on H1, H4 or D1 production creates NO setups at all -- not supporting-only
// ones. The engine below must create nothing there rather than quietly treating
// an unsupported chart as a supporting timeframe.
bool C_BTMM_IS_FORMATION_TF = timeframe.period == "5" or timeframe.period == "15"
bool C_BTMM_TF_SUPPORTED    = timeframe.period == "1" or C_BTMM_IS_FORMATION_TF

// -----------------------------------------------------------------------------
// P4-I1 — the setup registry
// -----------------------------------------------------------------------------
// One slot per BTMM-eligible POI, append-only, keyed by the POI's own registry
// index (btmmPoi). analyze_btmm creates exactly one setup per eligible POI and
// never removes it, so the registry mirrors that: no expiry, no compaction.
// The reaction window is a flat stride-C_BTMM_REACTION_WINDOW_BARS buffer rather
// than a nested array, which is the Pine-idiomatic bounded ring.

var array<int>   btmmPoi        = array.new<int>()    // index into the POI registry
var array<int>   btmmDir        = array.new<int>()
var array<float> btmmZTop       = array.new<float>()
var array<float> btmmZBot       = array.new<float>()
var array<float> btmmZHeight    = array.new<float>()
var array<float> btmmEntryB     = array.new<float>()
var array<float> btmmFarB       = array.new<float>()
var array<int>   btmmCandAvail  = array.new<int>()

// committed price-stage frontier (-1 = not reached)
var array<int>   btmmFormIdx    = array.new<int>()
var array<int>   btmmFormEvent  = array.new<int>()
var array<int>   btmmFormAvail  = array.new<int>()
var array<int>   btmmIntIdx     = array.new<int>()
var array<int>   btmmIntCode    = array.new<int>()
var array<int>   btmmIntEvent   = array.new<int>()
var array<int>   btmmIntAvail   = array.new<int>()
var array<float> btmmAnchor     = array.new<float>()  // running min/max since interaction
var array<int>   btmmRxStart    = array.new<int>()
var array<float> btmmRxAnchor   = array.new<float>()
var array<int>   btmmWinCount   = array.new<int>()
var array<int>   btmmTier       = array.new<int>()
var array<int>   btmmSpeed      = array.new<int>()
var array<int>   btmmCloseEvent = array.new<int>()
var array<int>   btmmCloseAvail = array.new<int>()

// bounded reaction-window ring, stride C_BTMM_REACTION_WINDOW_BARS
var array<float> btmmWinO   = array.new<float>()
var array<float> btmmWinH   = array.new<float>()
var array<float> btmmWinL   = array.new<float>()
var array<float> btmmWinC   = array.new<float>()
var array<float> btmmWinAtr = array.new<float>()

// reported state, rewritten every confirmed bar by the materialization
var array<int> btmmState      = array.new<int>()
var array<int> btmmStage      = array.new<int>()
var array<int> btmmCtxDir     = array.new<int>()
var array<int> btmmCtxFw      = array.new<int>()
var array<int> btmmSession    = array.new<int>()
var array<int> btmmAccGate    = array.new<int>()
var array<int> btmmIntClass   = array.new<int>()
var array<int> btmmRxGate     = array.new<int>()
var array<int> btmmRxClass    = array.new<int>()
var array<int> btmmSpdGate    = array.new<int>()
var array<int> btmmSpdClass   = array.new<int>()
var array<int> btmmFormGate   = array.new<int>()
var array<int> btmmVolume     = array.new<int>()
var array<int> btmmLqStatus   = array.new<int>()
var array<int> btmmLqLoc      = array.new<int>()
var array<int> btmmLqSrc      = array.new<int>()
var array<int> btmmEvidTime   = array.new<int>()
var array<int> btmmCancel     = array.new<int>()
var array<int> btmmBlock      = array.new<int>()
var array<int> btmmAvail      = array.new<int>()
var array<int> btmmTrCount    = array.new<int>()
var array<int> btmmTrLastCode = array.new<int>()
var array<int> btmmTrLastEvent = array.new<int>()
var array<int> btmmTrLastAvail = array.new<int>()

// ---- the reviewed-evidence channel -----------------------------------------
// LAYER A / LAYER B. The engine below implements the complete BTMM state
// machine, confirmation included, and reads its human-reviewed inputs from
// these arrays. NOTHING IN THIS SCRIPT WRITES THEM, and nothing may: a
// BtmmReviewedEvidence record is produced by human review, and TradingView has
// no authorized transport for one. btmmEvHas is therefore false for every setup
// at runtime, every setup that reaches the final gate cancels with
// NO_LIQUIDITY_EVIDENCE, and BTMM_CONFIRMED is unreachable here.
//
// That is the contract working. Populating these from any market-derived
// calculation -- an ATR test, a session clock, a volume study, anything the
// script can compute -- would convert an engineering signal into a claim of
// expert review, which is the one thing this port must never do. The
// confirmation path is implemented and proven against the Python oracle with
// evidence fixtures in tests/unit/test_p4_btmm_pine_model_parity.py; only the
// transport is missing, and it is missing on purpose.
var array<bool> btmmEvHas      = array.new<bool>()
var array<int>  btmmEvTime     = array.new<int>()
var array<int>  btmmEvCtxDir   = array.new<int>()
var array<int>  btmmEvCtxFw    = array.new<int>()
var array<int>  btmmEvSession  = array.new<int>()
var array<int>  btmmEvVolume   = array.new<int>()
var array<int>  btmmEvLqStatus = array.new<int>()
var array<int>  btmmEvLqSrc    = array.new<int>()

var array<int> btmmSetupByPoi = array.new<int>()      // poi index -> setup slot, -1 if none
//: Slots created on the current bar, so the driver can backfill exactly those.
var array<int> btmmNewSlots   = array.new<int>()

f_btmmAppend(int poiIdx, int dir, float zTop, float zBot, int candAvail) =>
    bool bull = dir == C_POI_DIR_BULLISH
    array.push(btmmPoi, poiIdx)
    array.push(btmmDir, dir)
    array.push(btmmZTop, zTop)
    array.push(btmmZBot, zBot)
    array.push(btmmZHeight, zTop - zBot)
    array.push(btmmEntryB, bull ? zTop : zBot)
    array.push(btmmFarB, bull ? zBot : zTop)
    array.push(btmmCandAvail, candAvail)
    array.push(btmmFormIdx, -1)
    array.push(btmmFormEvent, -1)
    array.push(btmmFormAvail, -1)
    array.push(btmmIntIdx, -1)
    array.push(btmmIntCode, C_BTMM_IC_NONE)
    array.push(btmmIntEvent, -1)
    array.push(btmmIntAvail, -1)
    array.push(btmmAnchor, na)
    array.push(btmmRxStart, -1)
    array.push(btmmRxAnchor, na)
    array.push(btmmWinCount, 0)
    array.push(btmmTier, C_BTMM_RC_NONE)
    array.push(btmmSpeed, C_BTMM_SPD_NONE)
    array.push(btmmCloseEvent, -1)
    array.push(btmmCloseAvail, -1)
    for k = 0 to C_BTMM_REACTION_WINDOW_BARS - 1
        array.push(btmmWinO, na)
        array.push(btmmWinH, na)
        array.push(btmmWinL, na)
        array.push(btmmWinC, na)
        array.push(btmmWinAtr, na)
    array.push(btmmState, C_BTMM_ST_CANDIDATE)
    array.push(btmmStage, C_BTMM_STAGE_NA)
    array.push(btmmCtxDir, C_BTMM_CTX_PENDING)
    array.push(btmmCtxFw, C_BTMM_CTX_PENDING)
    array.push(btmmSession, C_BTMM_SESS_PENDING)
    array.push(btmmAccGate, C_BTMM_GATE_PENDING)
    array.push(btmmIntClass, C_BTMM_IC_NONE)
    array.push(btmmRxGate, C_BTMM_GATE_PENDING)
    array.push(btmmRxClass, C_BTMM_RC_NONE)
    array.push(btmmSpdGate, C_BTMM_GATE_PENDING)
    array.push(btmmSpdClass, C_BTMM_SPD_NONE)
    array.push(btmmFormGate, C_BTMM_GATE_PENDING)
    array.push(btmmVolume, C_BTMM_VOL_PENDING)
    array.push(btmmLqStatus, C_BTMM_LQS_PENDING)
    array.push(btmmLqLoc, C_BTMM_LQL_NA)
    array.push(btmmLqSrc, C_BTMM_SRC_NA)
    array.push(btmmEvidTime, -1)
    array.push(btmmCancel, C_BTMM_CANCEL_NA)
    array.push(btmmBlock, C_BTMM_BLOCK_NA)
    array.push(btmmAvail, candAvail)
    array.push(btmmTrCount, 0)
    array.push(btmmTrLastCode, C_BTMM_ST_NA)
    array.push(btmmTrLastEvent, -1)
    array.push(btmmTrLastAvail, -1)
    array.push(btmmEvHas, false)
    array.push(btmmEvTime, -1)
    array.push(btmmEvCtxDir, C_BTMM_CTX_PENDING)
    array.push(btmmEvCtxFw, C_BTMM_CTX_PENDING)
    array.push(btmmEvSession, C_BTMM_SESS_PENDING)
    array.push(btmmEvVolume, C_BTMM_VOL_PENDING)
    array.push(btmmEvLqStatus, C_BTMM_LQS_PENDING)
    array.push(btmmEvLqSrc, C_BTMM_SRC_NA)

// A POI is BTMM-eligible when its type is one of the 18 lifecycle-eligible
// types AND its source timeframe is supported. The timeframe test is the
// chart's own, decided once above: on an unsupported chart the registry stays
// empty, which is exactly what production produces there.
// Returns the setup slots created on this bar, for the caller to backfill.
f_btmmSyncSetups() =>
    array.clear(btmmNewSlots)
    int m = array.size(poiType)
    int have = array.size(btmmSetupByPoi)
    if m > have
        for i = have to m - 1
            // The watermark tracks POIs seen and advances on every chart, so an
            // unsupported timeframe is a setup-creation gate, not a stalled
            // cursor that would re-scan the whole registry every bar.
            array.push(btmmSetupByPoi, -1)
            int tc = array.get(poiType, i)
            if C_BTMM_TF_SUPPORTED and tc >= C_POI_CORE_TYPE_MIN and tc <= C_POI_CORE_TYPE_MAX
                f_btmmAppend(i, array.get(poiDirection, i), array.get(poiZoneTop, i), array.get(poiZoneBottom, i), array.get(poiAvailTime, i))
                array.set(btmmSetupByPoi, i, array.size(btmmPoi) - 1)
                array.push(btmmNewSlots, array.size(btmmPoi) - 1)

// -----------------------------------------------------------------------------
// P4-I4 — leg measurement (measurements/legs.py)
// -----------------------------------------------------------------------------
// Four details a paraphrase of the rule gets wrong, each of which moves the
// speed gate: the reference ATR is the MEDIAN of the known values, not their
// mean; the leg distance is |last.close - first.open|, not the excursion to the
// favourable extreme; efficiency divides that by the summed high-low path; and
// the directional-candle test is inclusive, so a doji counts.
// Writes [referenceAtr, directionalEfficiency, directionalCandleShare,
// speedCode] into btmmLegOut for the first `count` bars of setup `s`'s window
// ring. A scratch array rather than a tuple return because the caller evaluates
// one leg per window prefix inside a loop, and Pine will not destructure a
// tuple there.
var array<float> btmmLegOut = array.from(0.0, 0.0, 0.0, 0.0)
int C_BTMM_LEG_ATR   = 0
int C_BTMM_LEG_EFF   = 1
int C_BTMM_LEG_SHARE = 2
int C_BTMM_LEG_SPEED = 3

f_btmmLeg(int s, int count, bool bull) =>
    float refAtr = 0.0
    float eff = 0.0
    float share = 0.0
    int speed = C_BTMM_SPD_SLOW
    if count > 0
        int base = s * C_BTMM_REACTION_WINDOW_BARS
        array<float> known = array.new<float>()
        float path = 0.0
        int directional = 0
        for k = 0 to count - 1
            float a = array.get(btmmWinAtr, base + k)
            if not na(a)
                array.push(known, a)
            path += array.get(btmmWinH, base + k) - array.get(btmmWinL, base + k)
            float o = array.get(btmmWinO, base + k)
            float c = array.get(btmmWinC, base + k)
            if bull ? c >= o : c <= o
                directional += 1
        refAtr := f_medianConsume(known)
        share := directional / float(count)
        float net = math.abs(array.get(btmmWinC, base + count - 1) - array.get(btmmWinO, base))
        if refAtr != 0.0 and path != 0.0
            float spd = net / (float(count) * refAtr)
            eff := net / path
            if spd >= C_BTMM_SFAST_SPEED and eff >= C_BTMM_SFAST_EFFICIENCY and share >= C_BTMM_SFAST_CANDLE_SHARE
                speed := C_BTMM_SPD_STRONG_FAST
            else if spd >= C_BTMM_FAST_SPEED and eff >= C_BTMM_FAST_EFFICIENCY and share >= C_BTMM_FAST_CANDLE_SHARE
                speed := C_BTMM_SPD_FAST
    array.set(btmmLegOut, C_BTMM_LEG_ATR, refAtr)
    array.set(btmmLegOut, C_BTMM_LEG_EFF, eff)
    array.set(btmmLegOut, C_BTMM_LEG_SHARE, share)
    array.set(btmmLegOut, C_BTMM_LEG_SPEED, speed)

// -----------------------------------------------------------------------------
// P4-I2 — interaction classification, one candle at a time
// -----------------------------------------------------------------------------
f_btmmTolerance(float refAtr, float zoneHeight, float atrMult, float heightMult) =>
    math.max(2.0 * syminfo.mintick, math.min(atrMult * refAtr, heightMult * zoneHeight))

// find_first_interaction reduced to the single-candle test the cursor performs.
// prevClose is na only on the very first bar, where production falls back to the
// candle's own open for the canonical-side test.
f_btmmClassify(float prevClose, float o, float h, float l, float atrValue, float zTop, float zBot, int dir) =>
    int outCode = C_BTMM_IC_NONE
    if l <= zTop and h >= zBot
        float zoneHeight = zTop - zBot
        float fallback = h - l
        float refAtr = (not na(atrValue)) and atrValue > 0 ? atrValue : fallback
        float prior = na(prevClose) ? o : prevClose
        bool bull = dir == C_POI_DIR_BULLISH
        bool canonical = bull ? prior >= zTop : prior <= zBot
        if not canonical
            outCode := C_BTMM_IC_NONCANONICAL
        else
            float overTol = f_btmmTolerance(refAtr, zoneHeight, C_BTMM_OVERSHOOT_TOL_ATR_MULT, C_BTMM_OVERSHOOT_TOL_HEIGHT_MULT)
            float rawPen = bull ? zTop - l : h - zBot
            float overDist = 0.0
            float penRatio = 0.0
            if rawPen >= zoneHeight
                overDist := rawPen - zoneHeight
                penRatio := 1.0
            else
                penRatio := zoneHeight > 0 ? rawPen / zoneHeight : 0.0
            if overDist > overTol
                outCode := C_BTMM_IC_EXCESSIVE_OVER
            else if overDist > 0
                outCode := C_BTMM_IC_CONTROLLED_OVER
            else if penRatio >= 1
                outCode := C_BTMM_IC_FAR_BOUNDARY
            else if penRatio > C_BTMM_PARTIAL_ENTRY_MAX_RATIO
                outCode := C_BTMM_IC_DEEP_ENTRY
            else if penRatio > C_BTMM_EDGE_TOUCH_MAX_RATIO
                outCode := C_BTMM_IC_PARTIAL_ENTRY
            else
                outCode := C_BTMM_IC_EDGE_TOUCH
    outCode

// -----------------------------------------------------------------------------
// P4-I3 — reaction window evaluation over the filled ring
// -----------------------------------------------------------------------------
// Two details a summary of the rule loses: the tier is the HIGHEST reached over
// every prefix k = 1..window, not the tier at the close; and the speed leg is
// measured to the bar of maximum favourable excursion, which is generally not
// the last bar of the window.
f_btmmEvaluateWindow(int s, float anchor, float farB, float zoneHeight, bool bull) =>
    int base = s * C_BTMM_REACTION_WINDOW_BARS
    int highestTier = 0
    for k = 1 to C_BTMM_REACTION_WINDOW_BARS
        f_btmmLeg(s, k, bull)
        float refAtr = array.get(btmmLegOut, C_BTMM_LEG_ATR)
        float eff = array.get(btmmLegOut, C_BTMM_LEG_EFF)
        float share = array.get(btmmLegOut, C_BTMM_LEG_SHARE)
        int spd = int(array.get(btmmLegOut, C_BTMM_LEG_SPEED))
        float favorable = na
        for j = 0 to k - 1
            float cand = bull ? array.get(btmmWinH, base + j) : array.get(btmmWinL, base + j)
            if na(favorable) or (bull ? cand > favorable : cand < favorable)
                favorable := cand
        float mfe = math.abs(favorable - anchor)
        float atrRatio = refAtr > 0 ? mfe / refAtr : 0.0
        float clearance = bull ? favorable - farB : farB - favorable
        float clearRatio = zoneHeight > 0 ? clearance / zoneHeight : 0.0
        bool standard = atrRatio >= C_BTMM_STD_ATR_RATIO and clearRatio >= C_BTMM_STD_CLEARANCE_RATIO and eff >= C_BTMM_STD_EFFICIENCY and share >= C_BTMM_STD_CANDLE_SHARE
        bool strong = atrRatio >= C_BTMM_STRONG_ATR_RATIO and clearRatio >= C_BTMM_STRONG_CLEARANCE_RATIO and eff >= C_BTMM_STRONG_EFFICIENCY and share >= C_BTMM_STRONG_CANDLE_SHARE and (spd == C_BTMM_SPD_FAST or spd == C_BTMM_SPD_STRONG_FAST)
        if strong
            highestTier := math.max(highestTier, 2)
        if standard
            highestTier := math.max(highestTier, 1)

    int tier = highestTier == 2 ? C_BTMM_RC_STRONG : highestTier == 1 ? C_BTMM_RC_STANDARD : C_BTMM_RC_WEAK

    int bestOffset = 0
    float bestExtreme = na
    for j = 0 to C_BTMM_REACTION_WINDOW_BARS - 1
        float cand = bull ? array.get(btmmWinH, base + j) : array.get(btmmWinL, base + j)
        if na(bestExtreme) or (bull ? cand > bestExtreme : cand < bestExtreme)
            bestExtreme := cand
            bestOffset := j
    f_btmmLeg(s, bestOffset + 1, bull)
    int speedCode = int(array.get(btmmLegOut, C_BTMM_LEG_SPEED))
    [tier, speedCode]

// -----------------------------------------------------------------------------
// P4-I9 — advance every setup by one confirmed bar
// -----------------------------------------------------------------------------
// Transcription of advance_btmm_cursor. Each setup tests this candle against its
// ONE currently-open stage; committed stages are never revisited and history is
// never rescanned. Two stages must see every candle and can never be skipped:
// the reaction-start scan (its anchor accumulates a running min/max whether or
// not the reaction starts) and the bounded window buffer.
f_btmmAdvanceOne(int s, int m, float prevClose, float o, float h, float l, float c, float atrValue, int eventT, int availT) =>
    bool bull = array.get(btmmDir, s) == C_POI_DIR_BULLISH

    // 1. forming: the first candle strictly after the candidate's availability
    if array.get(btmmFormIdx, s) < 0 and availT > array.get(btmmCandAvail, s)
        array.set(btmmFormIdx, s, m)
        array.set(btmmFormEvent, s, eventT)
        array.set(btmmFormAvail, s, availT)

    // 2. first interaction
    if array.get(btmmFormIdx, s) >= 0 and array.get(btmmIntIdx, s) < 0 and m >= array.get(btmmFormIdx, s)
        int code = f_btmmClassify(m == 0 ? na : prevClose, o, h, l, atrValue, array.get(btmmZTop, s), array.get(btmmZBot, s), array.get(btmmDir, s))
        if code != C_BTMM_IC_NONE
            array.set(btmmIntIdx, s, m)
            array.set(btmmIntCode, s, code)
            array.set(btmmIntEvent, s, eventT)
            array.set(btmmIntAvail, s, availT)
            if f_btmmInteractionEligible(code)
                array.set(btmmAnchor, s, bull ? l : h)

    // 3. reaction start
    if array.get(btmmIntIdx, s) >= 0 and f_btmmInteractionEligible(array.get(btmmIntCode, s)) and array.get(btmmRxStart, s) < 0 and m > array.get(btmmIntIdx, s)
        float anchor = array.get(btmmAnchor, s)
        bool started = false
        if bull
            anchor := math.min(anchor, l)
            started := c > array.get(btmmEntryB, s)
        else
            anchor := math.max(anchor, h)
            started := c < array.get(btmmEntryB, s)
        array.set(btmmAnchor, s, anchor)
        if started
            array.set(btmmRxStart, s, m)
            array.set(btmmRxAnchor, s, anchor)

    // 4. bounded reaction window
    if array.get(btmmRxStart, s) >= 0 and array.get(btmmTier, s) == C_BTMM_RC_NONE and m >= array.get(btmmRxStart, s) and m < array.get(btmmRxStart, s) + C_BTMM_REACTION_WINDOW_BARS
        int w = array.get(btmmWinCount, s)
        int slot = s * C_BTMM_REACTION_WINDOW_BARS + w
        array.set(btmmWinO, slot, o)
        array.set(btmmWinH, slot, h)
        array.set(btmmWinL, slot, l)
        array.set(btmmWinC, slot, c)
        array.set(btmmWinAtr, slot, atrValue)
        array.set(btmmWinCount, s, w + 1)
        if w + 1 == C_BTMM_REACTION_WINDOW_BARS
            [tier, speed] = f_btmmEvaluateWindow(s, array.get(btmmRxAnchor, s), array.get(btmmFarB, s), array.get(btmmZHeight, s), bull)
            array.set(btmmTier, s, tier)
            array.set(btmmSpeed, s, speed)
            array.set(btmmCloseEvent, s, eventT)
            array.set(btmmCloseAvail, s, availT)

// Sweep the whole registry for one confirmed bar.
f_btmmAdvance(int m, float prevClose, float o, float h, float l, float c, float atrValue, int eventT, int availT) =>
    int n = array.size(btmmPoi)
    if n > 0
        for s = 0 to n - 1
            f_btmmAdvanceOne(s, m, prevClose, o, h, l, c, atrValue, eventT, availT)

// -----------------------------------------------------------------------------
// P4-I9b — backfill a LATE-CREATED setup from its POI's own availability
// -----------------------------------------------------------------------------
// SEMANTIC AVAILABILITY IS NOT ENGINE DISCOVERY. `analyze_btmm` walks a setup
// from its source POI's availability_time_utc, whatever bar the POI was found
// on. Pine only learns a POI exists when P3 emits it, and the reference-zone
// family is emitted from a rolling S/R projection that can surface a zone many
// bars after the zone's own confirmation. A setup created at discovery would
// therefore skip every bar in between -- including, in the case that exposed
// this, the interaction that production cancels on, leaving the setup to be
// truncated by a later POI invalidation instead.
//
// This is the same defect P3 fixed for POI lifecycles in be1df56; the BTMM
// cursor needed its own copy of the correction. Measured on the M15 atomic
// capture: one reference zone whose POI became available at bar 739 was not
// discovered until bar 892 -- a 153-bar delay, and its POI was genuinely
// invalidated at bar 753, before the setup existed at all.
//
// BOUNDED. The replay covers only the retained analytical window, and only bars
// strictly after the candidate's availability, so it is at most
// `lookbackWindow` iterations, once, for a newly created setup. The newest bar
// is deliberately excluded: the caller advances it immediately afterwards
// through the normal per-bar path, so it must not be applied twice.
f_btmmBackfill(int s, int absFirst, int n) =>
    int candAvail = array.get(btmmCandAvail, s)
    if n > 1
        for j = 0 to n - 2
            if array.get(wAvailT, j) > candAvail
                f_btmmAdvanceOne(s, absFirst + j, j > 0 ? array.get(wClose, j - 1) : na, array.get(wOpen, j), array.get(wHigh, j), array.get(wLow, j), array.get(wClose, j), array.get(wAtr, j), array.get(wOpenT, j), array.get(wAvailT, j))

// -----------------------------------------------------------------------------
// P4-I5..I8 — resolution: fixed cost, no candle scan
// -----------------------------------------------------------------------------
// Gate precedence is strict and order-sensitive -- liquidity, then context, then
// session, then volume. A setup failing two gates reports the first.
// Returns [kind, cancelReason, blockReason] with kind 0 = CANCEL, 1 = CONFIRM,
// 2 = BLOCKED.
f_btmmResolveGates(int ctxDir, int ctxFw, int session, int volState, int liqStatus, bool isFormationTf) =>
    int kind = 2
    int cancelReason = C_BTMM_CANCEL_NA
    int blockReason = C_BTMM_BLOCK_NA
    if liqStatus != C_BTMM_LQS_PRESENT
        kind := 0
        cancelReason := C_BTMM_CANCEL_NO_LIQUIDITY
    else if ctxDir == C_BTMM_CTX_MISALIGNED or ctxFw == C_BTMM_CTX_MISALIGNED
        kind := 0
        cancelReason := C_BTMM_CANCEL_CONTEXT
    else if session == C_BTMM_SESS_INACTIVE
        kind := 0
        cancelReason := C_BTMM_CANCEL_SESSION
    else if volState == C_BTMM_VOL_FAILS
        kind := 0
        cancelReason := C_BTMM_CANCEL_VOLUME
    else
        bool fullyAligned = ctxDir == C_BTMM_CTX_ALIGNED and ctxFw == C_BTMM_CTX_ALIGNED and session == C_BTMM_SESS_ACTIVE and volState == C_BTMM_VOL_SUPPORTS
        if isFormationTf and fullyAligned
            kind := 1
        else if not isFormationTf
            blockReason := C_BTMM_BLOCK_FORMATION_TF
        else if ctxDir != C_BTMM_CTX_ALIGNED or ctxFw != C_BTMM_CTX_ALIGNED or session != C_BTMM_SESS_ACTIVE
            blockReason := C_BTMM_BLOCK_CONTEXT
        else
            blockReason := C_BTMM_BLOCK_VOLUME_PENDING
    [kind, cancelReason, blockReason]

f_btmmCancelTransition(int reason) =>
    reason == C_BTMM_CANCEL_NO_LIQUIDITY ? C_BTMM_TR_NO_LIQUIDITY : reason == C_BTMM_CANCEL_CONTEXT ? C_BTMM_TR_CONTEXT_REJECTED : reason == C_BTMM_CANCEL_SESSION ? C_BTMM_TR_SESSION_INACTIVE : C_BTMM_TR_VOLUME_FAILED

// Materialize one setup from its committed price frontier plus the current
// derived-liquidity and POI-invalidation inputs. Because the runtime supplies no
// reviewed evidence, the evidence branch below is the no-evidence contract; the
// full-evidence branches live in the model and are proven there against the
// oracle with fixtures.
//
// TRUNCATION. A genuine invalidation of the source POI cuts the walk at its own
// availability whatever stage the setup reached, so every step is guarded: once
// one step falls at or after the invalidation, nothing later is applied.
f_btmmMaterialize(int s) =>
    int poiIdx = array.get(btmmPoi, s)
    bool hasFalseInv = array.get(poiRepFalseInv, poiIdx)
    int cutAvail = array.get(poiRepLastCode, poiIdx) == C_POI_TR_GENUINE_INVALIDATION_CONFIRMED ? array.get(poiRepLastAvail, poiIdx) : -1
    int cutEvent = array.get(poiRepLastEvent, poiIdx)

    int state = C_BTMM_ST_CANDIDATE
    int stage = C_BTMM_STAGE_NA
    int accGate = C_BTMM_GATE_PENDING
    int intClass = C_BTMM_IC_NONE
    int rxGate = C_BTMM_GATE_PENDING
    int rxClass = C_BTMM_RC_NONE
    int spdGate = C_BTMM_GATE_PENDING
    int spdClass = C_BTMM_SPD_NONE
    int lqLoc = C_BTMM_LQL_NA
    int lqSrc = C_BTMM_SRC_NA
    int lqStatus = C_BTMM_LQS_PENDING
    int ctxDir = C_BTMM_CTX_PENDING
    int ctxFw = C_BTMM_CTX_PENDING
    int session = C_BTMM_SESS_PENDING
    int volState = C_BTMM_VOL_PENDING
    int formGate = C_BTMM_GATE_PENDING
    int evidTime = -1
    int block = C_BTMM_BLOCK_NA
    int cancel = C_BTMM_CANCEL_NA
    int avail = array.get(btmmCandAvail, s)
    int trCount = 0
    int trLastCode = C_BTMM_ST_NA
    int trLastEvent = -1
    int trLastAvail = -1
    bool stopped = false

    if array.get(btmmFormIdx, s) >= 0
        int fAvail = array.get(btmmFormAvail, s)
        if cutAvail >= 0 and fAvail >= cutAvail
            stopped := true
        else
            state := C_BTMM_ST_FORMING
            stage := C_BTMM_STAGE_INTERACTION
            avail := fAvail
            trCount += 1
            trLastCode := C_BTMM_TR_ENTERED_FORMING
            trLastEvent := array.get(btmmFormEvent, s)
            trLastAvail := fAvail

        if not stopped and array.get(btmmIntIdx, s) >= 0
            int code = array.get(btmmIntCode, s)
            int iAvail = array.get(btmmIntAvail, s)
            int iEvent = array.get(btmmIntEvent, s)
            if cutAvail >= 0 and iAvail >= cutAvail
                stopped := true
            else if f_btmmInteractionEligible(code)
                accGate := C_BTMM_GATE_PASS
                intClass := code
                stage := C_BTMM_STAGE_REACTION
                avail := iAvail
                trCount += 1
                trLastCode := C_BTMM_TR_ACCURACY_GATE
                trLastEvent := iEvent
                trLastAvail := iAvail

                if array.get(btmmTier, s) != C_BTMM_RC_NONE
                    int cAvail = array.get(btmmCloseAvail, s)
                    int cEvent = array.get(btmmCloseEvent, s)
                    if cutAvail >= 0 and cAvail >= cutAvail
                        stopped := true
                    else if array.get(btmmTier, s) == C_BTMM_RC_WEAK
                        state := C_BTMM_ST_CANCELLED
                        rxGate := C_BTMM_GATE_FAIL
                        rxClass := C_BTMM_RC_WEAK
                        cancel := C_BTMM_CANCEL_WEAK
                        avail := cAvail
                        trCount += 1
                        trLastCode := C_BTMM_TR_WEAK_REACTION
                        trLastEvent := cEvent
                        trLastAvail := cAvail
                    else
                        rxGate := C_BTMM_GATE_PASS
                        rxClass := array.get(btmmTier, s)
                        avail := cAvail
                        trCount += 1
                        trLastCode := C_BTMM_TR_REACTION_GATE
                        trLastEvent := cEvent
                        trLastAvail := cAvail

                        if array.get(btmmSpeed, s) == C_BTMM_SPD_SLOW
                            state := C_BTMM_ST_CANCELLED
                            spdGate := C_BTMM_GATE_FAIL
                            spdClass := array.get(btmmSpeed, s)
                            cancel := C_BTMM_CANCEL_SPEED
                            trCount += 1
                            trLastCode := C_BTMM_TR_SPEED_FAILED
                        else
                            spdGate := C_BTMM_GATE_PASS
                            spdClass := array.get(btmmSpeed, s)
                            stage := C_BTMM_STAGE_FINAL_GATE
                            trCount += 1
                            trLastCode := C_BTMM_TR_SPEED_GATE

                            // Derived liquidity: location and source only. It
                            // cannot set liquidity_evidence_status, which is
                            // what the gate reads, so it never confirms
                            // anything on its own.
                            if hasFalseInv
                                lqLoc := C_BTMM_LQL_AFTER_POI
                                lqSrc := C_BTMM_SRC_RULE_BASED

                            if not array.get(btmmEvHas, s)
                                // No reviewed evidence: the runtime contract.
                                state := C_BTMM_ST_CANCELLED
                                cancel := C_BTMM_CANCEL_NO_LIQUIDITY
                                trCount += 1
                                trLastCode := C_BTMM_TR_NO_LIQUIDITY
                            else
                                int tEv = array.get(btmmEvTime, s)
                                int evCtxDir = array.get(btmmEvCtxDir, s)
                                int evCtxFw = array.get(btmmEvCtxFw, s)
                                int evSess = array.get(btmmEvSession, s)
                                int evVol = array.get(btmmEvVolume, s)
                                int evLiq = array.get(btmmEvLqStatus, s)
                                [kind, cancelReason, blockReason] = f_btmmResolveGates(evCtxDir, evCtxFw, evSess, evVol, evLiq, C_BTMM_IS_FORMATION_TF)
                                if tEv > cAvail
                                    // Review arrives after the reaction closes:
                                    // BLOCKED first, then resolved on the
                                    // evidence bar.
                                    state := C_BTMM_ST_BLOCKED
                                    block := C_BTMM_BLOCK_LIQ_PENDING
                                    trCount += 1
                                    trLastCode := C_BTMM_TR_BLOCKED
                                ctxDir := evCtxDir
                                ctxFw := evCtxFw
                                session := evSess
                                volState := evVol
                                lqStatus := evLiq
                                evidTime := tEv
                                if evLiq == C_BTMM_LQS_PRESENT
                                    lqSrc := array.get(btmmEvLqSrc, s)
                                int outAvail = tEv > cAvail ? tEv : cAvail
                                int outEvent = tEv > cAvail ? tEv : cEvent
                                // A resolution landing at or after a genuine
                                // invalidation is truncated with everything
                                // else the walk would have produced.
                                if cutAvail >= 0 and outAvail >= cutAvail
                                    stopped := true
                                else if kind == 0
                                    state := C_BTMM_ST_CANCELLED
                                    cancel := cancelReason
                                    block := C_BTMM_BLOCK_NA
                                    trLastCode := f_btmmCancelTransition(cancelReason)
                                else if kind == 1
                                    state := C_BTMM_ST_CONFIRMED
                                    formGate := C_BTMM_GATE_PASS
                                    block := C_BTMM_BLOCK_NA
                                    trLastCode := C_BTMM_TR_CONFIRMED
                                else if tEv > cAvail
                                    state := C_BTMM_ST_FORMING
                                    block := C_BTMM_BLOCK_NA
                                    trLastCode := C_BTMM_TR_RESUMED_FORMING
                                else
                                    state := C_BTMM_ST_BLOCKED
                                    block := blockReason
                                    trLastCode := C_BTMM_TR_BLOCKED
                                trCount += 1
                                trLastEvent := outEvent
                                trLastAvail := outAvail
                                avail := outAvail
            else
                state := C_BTMM_ST_CANCELLED
                accGate := C_BTMM_GATE_FAIL
                intClass := code
                cancel := C_BTMM_CANCEL_INELIGIBLE
                avail := iAvail
                trCount += 1
                trLastCode := C_BTMM_TR_INELIGIBLE
                trLastEvent := iEvent
                trLastAvail := iAvail

    if cutAvail >= 0 and state != C_BTMM_ST_CANCELLED
        state := C_BTMM_ST_CANCELLED
        cancel := C_BTMM_CANCEL_POI_REJECTED
        block := C_BTMM_BLOCK_NA
        avail := cutAvail
        trCount += 1
        trLastCode := C_BTMM_TR_POI_REJECTED
        trLastEvent := cutEvent
        trLastAvail := cutAvail

    array.set(btmmState, s, state)
    array.set(btmmStage, s, stage)
    array.set(btmmAccGate, s, accGate)
    array.set(btmmIntClass, s, intClass)
    array.set(btmmRxGate, s, rxGate)
    array.set(btmmRxClass, s, rxClass)
    array.set(btmmSpdGate, s, spdGate)
    array.set(btmmSpdClass, s, spdClass)
    array.set(btmmLqLoc, s, lqLoc)
    array.set(btmmLqSrc, s, lqSrc)
    array.set(btmmLqStatus, s, lqStatus)
    array.set(btmmCtxDir, s, ctxDir)
    array.set(btmmCtxFw, s, ctxFw)
    array.set(btmmSession, s, session)
    array.set(btmmVolume, s, volState)
    array.set(btmmFormGate, s, formGate)
    array.set(btmmEvidTime, s, evidTime)
    array.set(btmmBlock, s, block)
    array.set(btmmCancel, s, cancel)
    array.set(btmmAvail, s, avail)
    array.set(btmmTrCount, s, trCount)
    array.set(btmmTrLastCode, s, trLastCode)
    array.set(btmmTrLastEvent, s, trLastEvent)
    array.set(btmmTrLastAvail, s, trLastAvail)

f_btmmMaterializeAll() =>
    int n = array.size(btmmPoi)
    if n > 0
        for s = 0 to n - 1
            f_btmmMaterialize(s)

// -----------------------------------------------------------------------------
// P4-I10 — reported diagnostics
// -----------------------------------------------------------------------------
// Counts only: no drawing, no alerts, no orders, no strategy calls. The parity
// digest lives in the separate atomic bundle probe, exactly as P2 and P3 keep
// theirs out of the DEV scanner.
//
// NOTE ON THE LATEST TRANSITION. Production reduces "last write wins" over the
// PRE-SORT, natural walk-emission order and applies the canonical sort only
// afterwards (analyzer.py:1020-1032). btmmTrLastCode therefore follows the
// emission order of the materialization above and must never be recomputed by
// sorting a transition list -- on any bar carrying more than one transition the
// two disagree, and confirmation shares its bar with both reaction gates.

// Pine will not let a function reassign a global scalar, so the counters live
// in one array and the function mutates its cells -- the same discipline the
// P3 registry uses.
var array<int> p4Counts = array.from(0, 0, 0, 0, 0)
int C_P4_N_REGISTRY   = 0
int C_P4_N_CANDIDATE  = 1
int C_P4_N_FORMING    = 2
int C_P4_N_CANCELLED  = 3
int C_P4_N_FINAL_GATE = 4

f_btmmReportCounts() =>
    int n = array.size(btmmPoi)
    array.set(p4Counts, C_P4_N_REGISTRY, n)
    array.set(p4Counts, C_P4_N_CANDIDATE, 0)
    array.set(p4Counts, C_P4_N_FORMING, 0)
    array.set(p4Counts, C_P4_N_CANCELLED, 0)
    array.set(p4Counts, C_P4_N_FINAL_GATE, 0)
    if n > 0
        for s = 0 to n - 1
            int st = array.get(btmmState, s)
            if st == C_BTMM_ST_CANCELLED
                array.set(p4Counts, C_P4_N_CANCELLED, array.get(p4Counts, C_P4_N_CANCELLED) + 1)
            else if st == C_BTMM_ST_FORMING
                array.set(p4Counts, C_P4_N_FORMING, array.get(p4Counts, C_P4_N_FORMING) + 1)
            else if st == C_BTMM_ST_CANDIDATE
                array.set(p4Counts, C_P4_N_CANDIDATE, array.get(p4Counts, C_P4_N_CANDIDATE) + 1)
            if array.get(btmmStage, s) == C_BTMM_STAGE_FINAL_GATE
                array.set(p4Counts, C_P4_N_FINAL_GATE, array.get(p4Counts, C_P4_N_FINAL_GATE) + 1)

// The engine indexes bars by the ABSOLUTE confirmed-bar index, so a bar replayed
// by the backfill and a bar seen live sit on the same axis and the committed
// stage indices stay comparable. m == 0 is then genuinely the first confirmed
// bar of the dataset, which is the case where production falls back to the
// candle's own open for the canonical-side test.

if barstate.isconfirmed
    int p3Wn = array.size(wClose)
    if p3Wn > 0
        f_poiDetectOrderBlocks(p3Wn)
        f_poiDetectFvg(p3Wn)
        f_poiDetectEngulfing(p3Wn)
        f_poiDetectStars(p3Wn)
        f_poiDetectSingleCandleReversals(p3Wn)
        f_poiDetectPressureWicks(p3Wn)
        f_poiDetectReversalCandles(p3Wn)
        f_poiDetectBases(p3Wn)
        f_poiDetectReferenceZones()
        f_poiAdvanceAllLifecycles(confirmedBarCount - p3Wn, confirmedBarCount)

        // ---- P4: BTMM setups, after P3 has advanced this bar ---------------
        // Order matters: the setup registry mirrors the POI registry, and the
        // materialization reads the P3 lifecycle facts committed just above.
        f_btmmSyncSetups()
        int p4AbsFirst = confirmedBarCount - p3Wn
        int p4New = array.size(btmmNewSlots)
        if p4New > 0
            for k = 0 to p4New - 1
                f_btmmBackfill(array.get(btmmNewSlots, k), p4AbsFirst, p3Wn)
        f_btmmAdvance(confirmedBarCount - 1, p3Wn > 1 ? array.get(wClose, p3Wn - 2) : na, array.get(wOpen, p3Wn - 1), array.get(wHigh, p3Wn - 1), array.get(wLow, p3Wn - 1), array.get(wClose, p3Wn - 1), array.get(wAtr, p3Wn - 1), array.get(wOpenT, p3Wn - 1), array.get(wAvailT, p3Wn - 1))
        f_btmmMaterializeAll()
        f_btmmReportCounts()

// ---- P4 diagnostics in the data window (no drawing, no alerts, no orders) ---
plot(debugMode ? array.get(p4Counts, C_P4_N_REGISTRY)   : na, "P4_setup_registry",  color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode ? array.get(p4Counts, C_P4_N_CANDIDATE)  : na, "P4_candidate",       color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode ? array.get(p4Counts, C_P4_N_FORMING)    : na, "P4_forming",         color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode ? array.get(p4Counts, C_P4_N_CANCELLED)  : na, "P4_cancelled",       color = color.new(color.gray, 0), display = display.data_window)
plot(debugMode ? array.get(p4Counts, C_P4_N_FINAL_GATE) : na, "P4_at_final_gate",   color = color.new(color.gray, 0), display = display.data_window)

// =============================================================================
// P6 — CROSS-TIMEFRAME SUBSTRATE  (SLICE 2: minimal P1 projection)
// -----------------------------------------------------------------------------
// Everything ABOVE this banner is the P4 DEV scanner, unchanged except the
// indicator title. That inheritance is the whole point: P6 does not re-implement
// P1, it CALLS the closed P1 functions. `f_advancePivotFrontier`,
// `f_detectSwings`, `f_detectEqualLevels` and `f_measureLeg` were verified to
// reference ZERO of this file's 174 global `var`s -- they are pure functions of
// their array arguments -- so a requested context can hand them its OWN arrays
// and get the same semantics the closed layers were proven on. A second,
// divergent definition of P1 would have been the easiest and worst mistake
// available here.
//
// WHY P6 EXISTS. BTRC fuses timeframes; P4 does not.
// `trend_engine._resolve_global` reduces W1, D1 and H4 together into one
// `global_direction` that feeds AnalyticalPermission, so that value does not
// exist until three timeframes are in hand.
//
// THE HISTORY ARCHITECTURE, MEASURED (artifacts/p6_lab/P6_PHASE22_LAB_RESULTS.txt)
//
//   host      calc_bars_count = 1800                     <- P1's frozen envelope
//   requests  calc_bars_count = C_P1_MIN_CALC_BARS + 1   <- 1251, see below
//
// Those look contradictory and are not: the host runs over max(indicator,
// largest request), and 1251 sits BELOW 1800, so the host stays at 1800 while
// every requested timeframe still gets its full warm-up. Measured both ways --
// requesting 5000 pulled the host to 5000; requesting 1250 left it at 1800.
// Removing the per-request argument clamps each context to the host's TIME
// span, which on an M15 host is 18.75 days: two weekly bars against 1250.
//
// WHY 1251 AND NOT 1250. calc_bars_count counts the bars the context is GIVEN,
// and one of them is always the current, still-forming bar. Measured live at
// 1250: dataset 1250, confirmed 1249. P1's publication guard is
// `confirmedBarCount >= C_P1_MIN_CALC_BARS`, so a 1250-bar request can never
// make a context warm -- it is permanently one confirmed bar short of the
// Wilder-ATR convergence the contract requires. 1251 is the MINIMAL envelope
// that yields 1250 confirmed plus the forming bar.
//
// This is a transport/execution correction. C_P1_MIN_CALC_BARS stays 1250 and
// no P1/P2/P3/P4 semantics move. The envelope is derived from the semantic
// minimum rather than written as a literal, so the two can never drift apart,
// and raising every request to the host's 1800 merely for symmetry is
// explicitly NOT done: the contract is at least 1250 confirmed bars per
// context, not identical bar counts across contexts.
//
// WHAT IS TRANSPORTED. Only what BTRC reads. Of P1's five published collections
// it reads three (confirmed swings, displacement, equal levels) and of P2's
// three it reads two. `support_resistance_zones` and `trendlines` are LEAVES --
// they consume swings and nothing consumes them (proven in
// tests/unit/test_p6_dependency_closure.py) -- so omitting them cannot change a
// required value, and it skips the tracker and fold-cache machinery that
// dominated P3. POI lifecycle is read once, flat, at symbol level: there are no
// six P3 engines. Session needs no transport at all.
//
// NON-REPAINT. The requested expression advances only on that context's own
// confirmed bars, exactly as the host does.
// =============================================================================

int C_P6_HOST_CALC_BARS    = 1800                       // P1's validated horizon.
// Derived, never a literal: the request envelope must always be one more than
// the semantic minimum, because the forming bar occupies one of the bars given.
int C_P6_REQUEST_CALC_BARS = C_P1_MIN_CALC_BARS + 1     // 1251

// T1's authority order. T2's regime order is DIFFERENT (D1, H4, W1, ...) and the
// two must never share one ordering helper. Only W1/D1/H4 are load-bearing for
// global_direction; H1/M15/M5 populate per-timeframe assessments only.
string C_P6_TF_W1  = "W"
string C_P6_TF_D1  = "D"
string C_P6_TF_H4  = "240"
string C_P6_TF_H1  = "60"
string C_P6_TF_M15 = "15"
string C_P6_TF_M5  = "5"

// -----------------------------------------------------------------------------
// P5 transport extension — ADDITIVE
// -----------------------------------------------------------------------------
// Everything below is new. Nothing above it changed, and the projection's first
// fourteen return positions are untouched: the extension is appended as ONE
// object in position 15.
//
// WHY AN OBJECT AND NOT MORE SCALARS. Pine caps the COMBINED tuple elements
// returned by every request.* call in one script at 127. The measured inventory
// is 84 here and 114 in the atomic twin, so the ~20 extra values P5 needs —
// 6 x 34 = 204 — cannot be spelled as a wider tuple. One appended object costs
// one element per context instead of twenty, landing this file at 90.
//
// WHY THESE FIELDS. The complete P5 transport audit
// (docs/architecture/BTRC_V1_P5_TRANSPORT_AUDIT.md) found no input requiring a
// new semantic engine. Every field here is a bounded REDUCTION of state this
// context already maintains for the closed P6 surface — no second ATR, swing
// detector, equal-level detector or structure walk is introduced.
//
// WHY RAW VALUES. P6 transports evidence; P5 owns thresholds. The displacement
// speed ratios cross unmodified rather than as an "expansion" verdict, because
// 1.50 is RegimeEngineConfiguration and 2.00 is T3 configuration. An earlier
// draft carried a CHOCH alternation COUNT and was withdrawn for the same
// reason: `_alternation_count` is parameterised by `range_window`, so shipping
// its result would freeze a P5 constant in here where nothing could see it go
// stale. The last four transition TYPES cross instead, and P5 counts.
//
// WHY DIRECTION IS ITS OWN FIELD. The legacy `dispCode` scalar is
// `isBull ? cls : -cls`, so bullish NORMAL and bearish NORMAL both encode 0 —
// direction is destroyed on the commonest classification. `assess_momentum`
// counts direction regardless of class, so the window carries Dir and Cls
// separately. The legacy scalar keeps its old position and its old meaning.
//
// SLOT ORDER. Both windows are LEFT-ALIGNED, OLDEST -> NEWEST: slot 1 is the
// oldest retained, slot {count} the newest, and slots above the count hold
// C_ST_NA. So breakout's `ordered_transitions[-2]` is slot {count-1}, not a
// fixed slot.
int C_P5X_TRANS_CAP = 4      // transition window capacity; >= range_window
int C_P5X_DISP_CAP  = 3      // displacement window capacity; >= momentum_window

type P5TransportExt
    // Field defaults below spell the absent-integer sentinel as the LITERAL
    // -99, not as C_ST_NA. Pine requires a `type` field's default value to be a
    // compile-time literal -- CE10132, "the default value cannot be a function,
    // variable or calculation" -- and rejects a reference to C_ST_NA even though
    // it is itself declared as a plain top-level `int`. This is a Pine syntax
    // constraint on the DECLARATION only: every comparison and assignment in
    // f_p6TfProjection below still reads and writes C_ST_NA, so the sentinel
    // stays one number, defined in exactly one place, everywhere but here.
    // --- T1 trend: scalars over this context's FULL confirmed history --------
    int   stateAvailT      = -99
    int   contStreak       = 0
    int   priorOppStreak   = 0
    int   exhaustFlag      = 0
    // --- bounded transition window ------------------------------------------
    int   transWindowCount = 0
    int   trans1Type       = -99
    int   trans2Type       = -99
    int   trans3Type       = -99
    int   trans4Type       = -99
    int   lastTransAvailT  = -99
    // --- bounded displacement window (shared by T2 regime and T3 momentum) ---
    int   dispWindowCount  = 0
    int   disp1Dir         = -99
    int   disp1Cls         = -99
    float disp1Ratio       = na
    int   disp2Dir         = -99
    int   disp2Cls         = -99
    float disp2Ratio       = na
    int   disp3Dir         = -99
    int   disp3Cls         = -99
    float disp3Ratio       = na
    int   dispAvailT       = -99
    // --- breakout ------------------------------------------------------------
    int   dispClsAtTrans   = -99
    // --- pullback ------------------------------------------------------------
    float pbImpulsePrice   = na
    float pbOriginPrice    = na
    float pbPullbackPrice  = na
    bool  pbValid          = false

// -----------------------------------------------------------------------------
// The requested-context P1 projection
// -----------------------------------------------------------------------------
// Mirrors the host's own confirmed-bar maintenance exactly -- incremental Wilder
// ATR, rolling window pruned to lookbackWindow, single-candle pivot frontier --
// but over `var` state declared INSIDE this function, which Phase-22 proved is
// instantiated per requested context and never aliased across timeframes.
//
// Returns the minimal P1 surface BTRC consumes, plus the two diagnostics the
// isolation and envelope guards need.
f_p6TfProjection() =>
    var array<float> qHigh   = array.new<float>()
    var array<float> qLow    = array.new<float>()
    var array<float> qOpen   = array.new<float>()
    var array<float> qClose  = array.new<float>()
    var array<int>   qOpenT  = array.new<int>()
    var array<int>   qAvailT = array.new<int>()
    var array<float> qAtr    = array.new<float>()
    var array<int>   qpAbs   = array.new<int>()
    var array<int>   qpType  = array.new<int>()
    var array<float> qpPrice = array.new<float>()
    var array<float> qpAtr   = array.new<float>()
    var array<float> qpTie   = array.new<float>()
    var array<float> qDispRange = array.new<float>()   // f_medianRange scratch, as scDispRange
    var int   qBars         = 0
    var float qAtrPrevFinal = na
    var float qAtrPrevClose = na
    var float qAtrWarmSum   = 0.0
    var int   qAtrWarmCount = 0
    var float qFingerprint  = 0.0

    // PERSISTENT, not per-call locals. A requested context is evaluated on every
    // host bar, but its own bar is confirmed only occasionally; plain locals would
    // reset to 0 on every intervening evaluation and the projection would read
    // "no swings" between higher-timeframe closes. Holding the last CONFIRMED
    // value is also the staleness semantics BTRC requires of a higher timeframe.
    var int   swingCount = 0
    var int   lastType   = C_ST_NA
    var float lastPrice  = na
    var int   lastConfT  = C_ST_NA
    var int   eqCount    = 0
    // displacement_observations -- read by T2 and T3
    var int   dispCode   = C_ST_NA
    var float dispRatio  = na
    // P2: structure_transitions and current_state -- read by T1, T3
    var int   p2Dir       = C_ST_NA
    var int   p2TransCount = 0
    var int   p2LastTrans  = C_ST_NA
    var float p2LastBrokenLvl = na

    // ---- P5 transport extension state (additive) ---------------------------
    // One per-candle displacement observation, retained for the same window the
    // candle arrays use. Python emits exactly one observation per candle from
    // `range_context_window` onward, so pushing once per confirmed bar — and
    // only once `f_latestDisplacement` has warmed up — reproduces that series.
    // The window is kept at lookbackWindow rather than at C_P5X_DISP_CAP
    // because `_displacement_at` matches a TRANSITION's availability time,
    // which can be older than the last three candles; the three-slot window is
    // then just the tail of this array.
    var array<int>   xDspDir   = array.new<int>()
    var array<int>   xDspCls   = array.new<int>()
    var array<float> xDspRatio = array.new<float>()
    var array<int>   xDspAvail = array.new<int>()
    // The published extension. `var` for the same staleness reason the P1/P2
    // outputs above are var: a requested context is evaluated on every host bar
    // but confirms its own only occasionally.
    var P5TransportExt xExt = P5TransportExt.new()

    // Dataset size AS SEEN BY THIS CONTEXT, so the history envelope is measured
    // rather than inferred. The host reads capacity the same way (p1DatasetBars).
    int qDataset = last_bar_index + 1

    if barstate.isconfirmed
        // exact incremental Wilder ATR, same rule as the host
        float qTr = f_trueRange(high, low, qAtrPrevClose)
        float qAtrValue = na
        if not na(qAtrPrevFinal)
            qAtrValue := (qAtrPrevFinal * (C_ATR_PERIOD - 1) + qTr) / C_ATR_PERIOD
            qAtrPrevFinal := qAtrValue
        else
            qAtrWarmSum := qAtrWarmSum + qTr
            qAtrWarmCount := qAtrWarmCount + 1
            if qAtrWarmCount < C_ATR_PERIOD
                qAtrValue := na
            else
                qAtrValue := qAtrWarmSum / C_ATR_PERIOD
                qAtrPrevFinal := qAtrValue
        qAtrPrevClose := close

        qBars := qBars + 1
        qFingerprint := qFingerprint + close
        array.push(qHigh, high)
        array.push(qLow, low)
        array.push(qOpen, open)
        array.push(qClose, close)
        array.push(qOpenT, time)
        array.push(qAvailT, time_close)
        array.push(qAtr, qAtrValue)
        while array.size(qHigh) > lookbackWindow
            array.shift(qHigh)
            array.shift(qLow)
            array.shift(qOpen)
            array.shift(qClose)
            array.shift(qOpenT)
            array.shift(qAvailT)
            array.shift(qAtr)

        // ---- displacement (latest confirmed candle), the host's order exactly
        [qDispCode, qDispRatio] = f_latestDisplacement(qHigh, qLow, qOpen, qClose, qDispRange)
        dispCode  := qDispCode
        dispRatio := qDispRatio

        int qAbsFirst = qBars - array.size(qHigh)
        f_advancePivotFrontier(qHigh, qLow, qAtr, qAbsFirst, qpAbs, qpType, qpPrice, qpAtr, qpTie)
        array<SwingRec> qSwings = f_detectSwings(qHigh, qLow, qOpenT, qAvailT, qAtr, qpAbs, qpType, qpPrice, qpAtr, qpTie, qAbsFirst)
        swingCount := array.size(qSwings)
        if swingCount > 0
            SwingRec sr = array.get(qSwings, swingCount - 1)
            lastType  := sr.swingType
            lastPrice := sr.price
            lastConfT := sr.meaningfulConfTime
        eqCount := array.size(f_detectEqualLevels(qSwings))

        // ---- P2 structure: the same closed walk the host runs, over this
        // context's own confirmed window. f_p2BuildSwingView,
        // f_p2BuildRelationships, f_p2OrderRelationships, f_p2OrderSwings and
        // f_p2StructureWalk were all audited to reference ZERO of the file's
        // globals, so they are as safe to hand a q* window as the P1 functions.
        array<StructSwingView> qP2Swings = f_p2BuildSwingView(qSwings, qOpenT, qAbsFirst)
        array<StructRelRec>    qP2Rels   = f_p2BuildRelationships(qP2Swings)
        [qP2Dir, _qProtH, _qProtL, _qWeakH, _qWeakL, qLastChange, qP2Events, _qBroken, _qWhB, _qWlB, _qAborts] = f_p2StructureWalk(qP2Swings, qP2Rels, f_p2OrderRelationships(qP2Rels), f_p2OrderSwings(qP2Swings), qClose, qAvailT, qOpenT, qAbsFirst)
        p2Dir        := qP2Dir
        p2TransCount := array.size(qP2Events)
        if p2TransCount > 0
            StructEventRec qLastEv = array.get(qP2Events, p2TransCount - 1)
            p2LastTrans      := qLastEv.transitionCode
            p2LastBrokenLvl  := qLastEv.brokenLevel

        // =====================================================================
        // P5 TRANSPORT EXTENSION — bounded reductions only
        // ---------------------------------------------------------------------
        // Every value below is derived from state this context already built for
        // the fourteen outputs above: qSwings, qP2Events, qAvailT/qOpenT and the
        // per-candle displacement series. No detector, walk or ATR is re-run.
        //
        // The extension is REBUILT from scratch on every confirmed bar rather
        // than accumulated. That differs deliberately from the legacy fields
        // above, which hold their last non-empty value: the structure walk is
        // recomputed over a SLIDING window, so transitions and swings can leave
        // it, and Python computes every one of these reductions from the current
        // collections. Carrying a stale slot forward would silently disagree.
        // =====================================================================

        // ---- per-candle displacement series (dir kept separately, see the type)
        if not na(qDispCode)
            int qLastIx = array.size(qClose) - 1
            array.push(xDspDir, array.get(qClose, qLastIx) >= array.get(qOpen, qLastIx) ? 1 : -1)
            array.push(xDspCls, math.abs(qDispCode))
            array.push(xDspRatio, qDispRatio)
            array.push(xDspAvail, array.get(qAvailT, qLastIx))
        while array.size(xDspDir) > lookbackWindow
            array.shift(xDspDir)
            array.shift(xDspCls)
            array.shift(xDspRatio)
            array.shift(xDspAvail)

        P5TransportExt qX = P5TransportExt.new()

        // ---- current_state.availability_time_utc
        // structure/analyzer.py:404 — the walk's last change, FALLING BACK to
        // the newest candle's availability when the walk reports none. The
        // fallback is not cosmetic: an unbroken window would otherwise publish
        // an absent state time while Python publishes a real one.
        qX.stateAvailT := qLastChange != C_ST_NA ? qLastChange : array.get(qAvailT, array.size(qAvailT) - 1)

        int qNEv = array.size(qP2Events)

        // ---- transition window, oldest -> newest, left aligned
        qX.transWindowCount := math.min(qNEv, C_P5X_TRANS_CAP)
        if qNEv > 0
            int qBase = qNEv - qX.transWindowCount
            for qi = 0 to qX.transWindowCount - 1
                int qCode = array.get(qP2Events, qBase + qi).transitionCode
                if qi == 0
                    qX.trans1Type := qCode
                else if qi == 1
                    qX.trans2Type := qCode
                else if qi == 2
                    qX.trans3Type := qCode
                else
                    qX.trans4Type := qCode
            qX.lastTransAvailT := array.get(qP2Events, qNEv - 1).availabilityTime

        // ---- continuation and prior-opposite streaks
        // Backward scans over the FULL event array, so neither is capped by the
        // four-slot window. `while` rather than a descending `for`, which this
        // codebase has been bitten by before.
        if qNEv > 0 and (p2Dir == C_ST_DIR_BULLISH or p2Dir == C_ST_DIR_BEARISH)
            int qCont = p2Dir == C_ST_DIR_BULLISH ? C_ST_TR_BULLISH_BOS : C_ST_TR_BEARISH_BOS
            int qOpp  = p2Dir == C_ST_DIR_BULLISH ? C_ST_TR_BEARISH_BOS : C_ST_TR_BULLISH_BOS
            int qa = qNEv - 1
            while qa >= 0 and array.get(qP2Events, qa).transitionCode == qCont
                qX.contStreak := qX.contStreak + 1
                qa := qa - 1
            // The newest transition is the CHOCH being explained, so it is
            // excluded from its own evidence: trend_engine.py scans
            // `transitions[:-1]`, i.e. this scan starts at qNEv - 2.
            int qb = qNEv - 2
            while qb >= 0 and array.get(qP2Events, qb).transitionCode == qOpp
                qX.priorOppStreak := qX.priorOppStreak + 1
                qb := qb - 1

        // ---- exhaustion: the two most recent swings OF THE RELEVANT TYPE,
        // which is not the same as the two most recent swings.
        if (p2Dir == C_ST_DIR_BULLISH or p2Dir == C_ST_DIR_BEARISH) and swingCount > 1
            int   qWant   = p2Dir == C_ST_DIR_BULLISH ? SWING_HIGH : SWING_LOW
            float qLatest = na
            float qPrev   = na
            int   qc = swingCount - 1
            while qc >= 0 and na(qPrev)
                SwingRec qsw = array.get(qSwings, qc)
                if qsw.swingType == qWant
                    if na(qLatest)
                        qLatest := qsw.price
                    else
                        qPrev := qsw.price
                qc := qc - 1
            if not na(qLatest) and not na(qPrev)
                bool qExh = p2Dir == C_ST_DIR_BULLISH ? qLatest < qPrev : qLatest > qPrev
                qX.exhaustFlag := qExh ? 1 : 0

        // ---- displacement window: the tail of the per-candle series
        int qNDsp = array.size(xDspDir)
        qX.dispWindowCount := math.min(qNDsp, C_P5X_DISP_CAP)
        if qX.dispWindowCount > 0
            int qDBase = qNDsp - qX.dispWindowCount
            for qj = 0 to qX.dispWindowCount - 1
                int   qDir = array.get(xDspDir, qDBase + qj)
                int   qCls = array.get(xDspCls, qDBase + qj)
                float qRat = array.get(xDspRatio, qDBase + qj)
                if qj == 0
                    qX.disp1Dir := qDir
                    qX.disp1Cls := qCls
                    qX.disp1Ratio := qRat
                else if qj == 1
                    qX.disp2Dir := qDir
                    qX.disp2Cls := qCls
                    qX.disp2Ratio := qRat
                else
                    qX.disp3Dir := qDir
                    qX.disp3Cls := qCls
                    qX.disp3Ratio := qRat
            qX.dispAvailT := array.get(xDspAvail, qNDsp - 1)

        // ---- _displacement_at: the MAXIMUM class among every displacement
        // sharing the newest transition's availability time — not the first
        // match, and not the latest displacement overall.
        if qNEv > 0
            int qTargetT = array.get(qP2Events, qNEv - 1).availabilityTime
            for qk = 0 to array.size(xDspAvail) - 1
                if array.get(xDspAvail, qk) == qTargetT
                    int qCandidate = array.get(xDspCls, qk)
                    if qX.dispClsAtTrans == C_ST_NA or qCandidate > qX.dispClsAtTrans
                        qX.dispClsAtTrans := qCandidate

        // ---- pullback swing roles (t3_engine._retracement_depth)
        // Bullish: impulse is the newest SWING_HIGH; origin is the last
        // SWING_LOW whose pivot start is AT OR BEFORE the impulse's; pullback is
        // the last SWING_LOW STRICTLY AFTER it. The comparators differ on the
        // two branches and must not be normalised. The depth ratio itself is NOT
        // computed here — P5 owns the division and the 0.382 / 0.618 bands.
        if (p2Dir == C_ST_DIR_BULLISH or p2Dir == C_ST_DIR_BEARISH) and swingCount > 0
            int qImpType = p2Dir == C_ST_DIR_BULLISH ? SWING_HIGH : SWING_LOW
            int qCntType = p2Dir == C_ST_DIR_BULLISH ? SWING_LOW  : SWING_HIGH
            int qImpIx   = -1
            int qd = swingCount - 1
            while qd >= 0 and qImpIx < 0
                if array.get(qSwings, qd).swingType == qImpType
                    qImpIx := qd
                qd := qd - 1
            if qImpIx >= 0
                SwingRec qImp     = array.get(qSwings, qImpIx)
                int      qImpStrT = array.get(qOpenT, qImp.pivotStartIdx)
                float    qOrigin  = na
                float    qPull    = na
                for qe = 0 to swingCount - 1
                    SwingRec qCand = array.get(qSwings, qe)
                    if qCand.swingType == qCntType
                        int qCandStrT = array.get(qOpenT, qCand.pivotStartIdx)
                        if qCandStrT <= qImpStrT
                            qOrigin := qCand.price
                        else
                            qPull := qCand.price
                if not na(qOrigin) and not na(qPull)
                    float qLeg = p2Dir == C_ST_DIR_BULLISH ? qImp.price - qOrigin : qOrigin - qImp.price
                    if qLeg > 0
                        qX.pbImpulsePrice  := qImp.price
                        qX.pbOriginPrice   := qOrigin
                        qX.pbPullbackPrice := qPull
                        qX.pbValid         := true

        xExt := qX

    [qBars, swingCount, lastType, lastPrice, lastConfT, eqCount, qFingerprint, qDataset, dispCode, dispRatio, p2Dir, p2TransCount, p2LastTrans, p2LastBrokenLvl, xExt]

[w1Bars,  w1Sw,  w1Type,  w1Price,  w1Conf,  w1Eq,  w1Fp , w1Ds, w1Dc, w1Dr, w1P2d, w1Tc, w1Lt, w1Bl, w1Ext] = request.security(syminfo.tickerid, C_P6_TF_W1,  f_p6TfProjection(), calc_bars_count = C_P6_REQUEST_CALC_BARS)
[d1Bars,  d1Sw,  d1Type,  d1Price,  d1Conf,  d1Eq,  d1Fp , d1Ds, d1Dc, d1Dr, d1P2d, d1Tc, d1Lt, d1Bl, d1Ext] = request.security(syminfo.tickerid, C_P6_TF_D1,  f_p6TfProjection(), calc_bars_count = C_P6_REQUEST_CALC_BARS)
[h4Bars,  h4Sw,  h4Type,  h4Price,  h4Conf,  h4Eq,  h4Fp , h4Ds, h4Dc, h4Dr, h4P2d, h4Tc, h4Lt, h4Bl, h4Ext] = request.security(syminfo.tickerid, C_P6_TF_H4,  f_p6TfProjection(), calc_bars_count = C_P6_REQUEST_CALC_BARS)
[h1Bars,  h1Sw,  h1Type,  h1Price,  h1Conf,  h1Eq,  h1Fp , h1Ds, h1Dc, h1Dr, h1P2d, h1Tc, h1Lt, h1Bl, h1Ext] = request.security(syminfo.tickerid, C_P6_TF_H1,  f_p6TfProjection(), calc_bars_count = C_P6_REQUEST_CALC_BARS)
[m15Bars, m15Sw, m15Type, m15Price, m15Conf, m15Eq, m15Fp, m15Ds, m15Dc, m15Dr, m15P2d, m15Tc, m15Lt, m15Bl, m15Ext] = request.security(syminfo.tickerid, C_P6_TF_M15, f_p6TfProjection(), calc_bars_count = C_P6_REQUEST_CALC_BARS)
[m5Bars,  m5Sw,  m5Type,  m5Price,  m5Conf,  m5Eq,  m5Fp , m5Ds, m5Dc, m5Dr, m5P2d, m5Tc, m5Lt, m5Bl, m5Ext] = request.security(syminfo.tickerid, C_P6_TF_M5,  f_p6TfProjection(), calc_bars_count = C_P6_REQUEST_CALC_BARS)

// -----------------------------------------------------------------------------
// Isolation and envelope guards
// -----------------------------------------------------------------------------
// Aliasing would silently invalidate every later parity claim, so it is asserted
// continuously rather than checked once: two distinct contexts must not report
// the same (bars, fingerprint) pair.
f_p6Aliased(float aBars, float aFp, float bBars, float bFp) =>
    aBars == bBars and aFp == bFp

var int p6AliasHits   = 0
var int p6HostBarsMax = 0
if barstate.isconfirmed
    bool hit = false
    hit := hit or f_p6Aliased(w1Bars,  w1Fp,  d1Bars,  d1Fp)
    hit := hit or f_p6Aliased(d1Bars,  d1Fp,  h4Bars,  h4Fp)
    hit := hit or f_p6Aliased(h4Bars,  h4Fp,  h1Bars,  h1Fp)
    hit := hit or f_p6Aliased(h1Bars,  h1Fp,  m15Bars, m15Fp)
    hit := hit or f_p6Aliased(m15Bars, m15Fp, m5Bars,  m5Fp)
    if hit
        p6AliasHits := p6AliasHits + 1
    p6HostBarsMax := math.max(p6HostBarsMax, bar_index + 1)

// Mirrors the host's own two-part history guard (p1CapacityOk / p1WarmupOk):
// capacity is the dataset the context was given, warm-up is CONFIRMED bars against
// P1's validated minimum. They are separate questions and are reported separately.
f_p6Capacity(int dataset) =>
    dataset >= C_P6_REQUEST_CALC_BARS

f_p6Warm(int bars) =>
    bars >= C_P1_MIN_CALC_BARS

// -----------------------------------------------------------------------------
// Diagnostics (data window only; nothing is drawn on the price scale, which P7
// has just been closed on)
// -----------------------------------------------------------------------------
plot(w1Bars,  "P6_W1_bars",  display = display.data_window)
plot(d1Bars,  "P6_D1_bars",  display = display.data_window)

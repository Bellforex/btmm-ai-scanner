// -----------------------------------------------------------------------------
// P5 transport extension — live smoke emitter
// -----------------------------------------------------------------------------
// ZERO new plots: P6 DEV already sits at 63 of Pine's 64, and the atomic capture
// proved log.info carries far more than the data window ever could. This emits
// once, at the live edge, so a deployment can be checked for non-vacuity,
// correct sentinels and context differentiation without touching the plot budget
// or any semantic path.
//
// It is diagnostic output only. Nothing reads it back, and no field above is
// computed differently because of it.
f_p5xLine(string tf, P5TransportExt e) =>
    na(e) ? "P5X|" + tf + "|NULL_OBJECT" :
      "P5X|" + tf +
      "|stateAvailT=" + str.tostring(e.stateAvailT) +
      "|contStreak=" + str.tostring(e.contStreak) +
      "|priorOppStreak=" + str.tostring(e.priorOppStreak) +
      "|exhaustFlag=" + str.tostring(e.exhaustFlag) +
      "|transWindowCount=" + str.tostring(e.transWindowCount) +
      "|trans1Type=" + str.tostring(e.trans1Type) +
      "|trans2Type=" + str.tostring(e.trans2Type) +
      "|trans3Type=" + str.tostring(e.trans3Type) +
      "|trans4Type=" + str.tostring(e.trans4Type) +
      "|lastTransAvailT=" + str.tostring(e.lastTransAvailT) +
      "|dispWindowCount=" + str.tostring(e.dispWindowCount) +
      "|disp1Dir=" + str.tostring(e.disp1Dir) +
      "|disp1Cls=" + str.tostring(e.disp1Cls) +
      "|disp1Ratio=" + str.tostring(e.disp1Ratio) +
      "|disp2Dir=" + str.tostring(e.disp2Dir) +
      "|disp2Cls=" + str.tostring(e.disp2Cls) +
      "|disp2Ratio=" + str.tostring(e.disp2Ratio) +
      "|disp3Dir=" + str.tostring(e.disp3Dir) +
      "|disp3Cls=" + str.tostring(e.disp3Cls) +
      "|disp3Ratio=" + str.tostring(e.disp3Ratio) +
      "|dispAvailT=" + str.tostring(e.dispAvailT) +
      "|dispClsAtTrans=" + str.tostring(e.dispClsAtTrans) +
      "|pbImpulsePrice=" + str.tostring(e.pbImpulsePrice) +
      "|pbOriginPrice=" + str.tostring(e.pbOriginPrice) +
      "|pbPullbackPrice=" + str.tostring(e.pbPullbackPrice) +
      "|pbValid=" + str.tostring(e.pbValid)

var bool p5xEmitted = false
if barstate.islast and not p5xEmitted
    p5xEmitted := true
    log.info("P5X_META|feed=" + syminfo.prefix + ":" + syminfo.ticker + "|host_tf=" + timeframe.period + "|semanticMin=" + str.tostring(C_P1_MIN_CALC_BARS) + "|request=" + str.tostring(C_P6_REQUEST_CALC_BARS) + "|host=" + str.tostring(C_P6_HOST_CALC_BARS) + "|aliasHits=" + str.tostring(p6AliasHits))
    log.info(f_p5xLine("W1",  w1Ext))
    log.info(f_p5xLine("D1",  d1Ext))
    log.info(f_p5xLine("H4",  h4Ext))
    log.info(f_p5xLine("H1",  h1Ext))
    log.info(f_p5xLine("M15", m15Ext))
    log.info(f_p5xLine("M5",  m5Ext))

// =============================================================================
// P5 — BTRC-T1..T5 SUPERVISORY CONFLUENCE  (BTMM+POI+BTRC Scanner [P5 DEV] only)
// -----------------------------------------------------------------------------
// Ports btrc/trend_engine.py, regime_engine.py, t3_engine.py, t4_engine.py,
// t5_engine.py onto the ALREADY-CLOSED P6 transport (26-field wire, 156/156
// real-data parity) and the ALREADY-CLOSED P3 POI / P4 BTMM registries. NO P1-P4
// or P6 calculation is touched by anything below this banner — every function
// here only READS w1Ext..m5Ext, w1P2d..m5P2d, w1Sw..m5Sw, and the P3/P4 arrays.
//
// Wire-sufficiency for every one of these was proven in Python BEFORE this Pine
// code was written -- see docs/architecture/BTRC_V1_P5_COMPLETION_MATRIX.md and
// tests/parity_support/t1_trend_pine_model.py through t5_aggregator_pine_model.py
// (+ t2/t3/t4/t5 test files). This Pine code is a direct, function-for-function
// transcription of those already-differential-tested Python models -- variable
// names below deliberately mirror the Python ones.
//
// KNOWN, DISCLOSED, ACCEPTED RESIDUAL: momentum_score/acceleration cross a real
// Decimal-exact-vs-float64-wire boundary (proven bounded: score off by at most
// 1, acceleration only ties into STEADY -- test_t3_transport_sufficiency.py).
// An exhaustive adversarial search (p5_float64_boundary_study.py) proved this
// CAN, in ~0.135% of an adversarially-constructed 15.55M-combination space,
// cross the 45/65 permission boundary by exactly 1 point. Project-owner
// decision 2026-09-04: accept and disclose this bounded residual rather than
// eliminate it -- see docs/architecture/BTRC_V1_P5_FLOAT64_BOUNDARY_CLASSIFICATION.md.
//
// ACTIVE-POI LOOP: assess_confluence stays single-POI-in/single-result-out in
// Python. This file adds an EXTERNAL loop over the P3 POI registry (poiStatus/
// poiTerminal/poiDirection/poiTier/poiAvailTime), per the project's frozen
// contract: evaluate every active/non-terminal POI every confirmed bar; a POI
// that goes terminal on the current bar still gets that bar's final
// evaluation, then is excluded from every later bar. Terminality is not
// invented here -- poiTerminal already exists and is set in exactly the same
// place production sets it (GENUINE_INVALIDATION_CONFIRMED only), so the loop
// reads it rather than re-deriving it.
//
// ZERO new plots (Phase 18): debugMode-gated log.info only, matching the
// existing P3/P4 diagnostics-in-data-window convention plus the P5X live
// smoke emitter's own log-only precedent.
// =============================================================================

// ---- result codes (Pine has no string enums; magnitudes/order carry no
// meaning beyond identity -- these are never compared with < or >, only ==) --
int C_TS_UNKNOWN     = 0
int C_TS_FORMING     = 1
int C_TS_TRENDING    = 2
int C_TS_TRANSITION  = 3
int C_TS_EXHAUSTING  = 4
int C_TS_RANGE       = 5

int C_DIR2_NEUTRAL        = 0
int C_DIR2_BULLISH        = 1
int C_DIR2_STRONG_BULLISH = 2
int C_DIR2_BEARISH        = -1
int C_DIR2_STRONG_BEARISH = -2

int C_RG_UNCERTAIN        = 0
int C_RG_TRANSITION       = 1
int C_RG_TREND            = 2
int C_RG_DECELERATION     = 3
int C_RG_RANGE            = 4
int C_RG_EXPANSION        = 5
int C_RG_BREAKOUT_PENDING = 6
int C_RG_COMPRESSION      = 7

int C_MA_ACCELERATING = 1
int C_MA_STEADY       = 0
int C_MA_DECELERATING = -1

int C_BRK_WEAK_BREAK      = 1
int C_BRK_VALID_BREAK     = 2
int C_BRK_STRONG_BREAK    = 3
int C_BRK_EXPLOSIVE_BREAK = 4
int C_BRK_FAILED_BREAK    = 5
// C_ST_NA (-99) means "no breakout" (Python None), matching the same sentinel
// P6's own UDT already uses for absence -- one sentinel, everywhere.

int C_PB_SHALLOW_PULLBACK    = 1
int C_PB_HEALTHY_PULLBACK    = 2
int C_PB_DEEP_PULLBACK       = 3
int C_PB_STRUCTURAL_FAILURE  = 4
// C_ST_NA means "no pullback" (Python None), same convention as breakout.

int C_SESS_ASIAN              = 0
int C_SESS_LONDON_PREOPEN     = 1
int C_SESS_LONDON             = 2
int C_SESS_NEW_YORK_PREOPEN   = 3
int C_SESS_LONDON_NY_OVERLAP  = 4
int C_SESS_NEW_YORK           = 5
int C_SESS_POST_NY            = 6

int C_VOL_VERY_LOW = 0
int C_VOL_LOW       = 1
int C_VOL_NORMAL    = 2
int C_VOL_HIGH      = 3
int C_VOL_EXTREME   = 4

int C_AL_ALIGNED       = 0
int C_AL_PARTIAL       = 1
int C_AL_NEUTRAL       = 2
int C_AL_COUNTER_TREND = 3

int C_PERM_BUY_BIAS          = 0
int C_PERM_SELL_BIAS         = 1
int C_PERM_ALLOW_BOTH_CONTEXT = 2
int C_PERM_COUNTER_TREND     = 3
int C_PERM_WATCH_ONLY        = 4
int C_PERM_NO_TRADE_CONTEXT  = 5

int C_LC_DETECTED               = 0
int C_LC_STRUCTURALLY_VALIDATED = 1
// C_LC_BTMM_VALIDATED intentionally has no constant: t5_engine._lifecycle
// assigns it then immediately overwrites it with POI_VALIDATED, no
// intervening return -- provably unreachable as a terminal result
// (test_t5_aggregator_sufficiency.py::test_exhaustive_lifecycle_covers_
// every_reachable_state). Manufacturing a transition through it here would
// fabricate a state the source itself never actually reaches.
int C_LC_POI_VALIDATED          = 3
int C_LC_TREND_VALIDATED        = 4
int C_LC_REGIME_VALIDATED       = 5
int C_LC_MOMENTUM_VALIDATED     = 6
int C_LC_LIQUIDITY_VALIDATED    = 7

// -----------------------------------------------------------------------------
// T1 trend — trend_engine._assess_timeframe, via t1_trend_pine_model.py
// -----------------------------------------------------------------------------
// T1Config: min_swings_for_assessment=2, trend_min_streak=1, strong_streak=3,
// range_window=4 (== TRANSITION_WINDOW_CAPACITY, so every populated slot is
// "recent" -- nothing older to exclude), range_choch_count=3.
f_p5T1(int p2Dir, int swCount, P5TransportExt ext) =>
    int trendState = C_TS_UNKNOWN
    int direction = C_DIR2_NEUTRAL
    // RUNTIME-SAFETY GUARD (host-warm-up hazard, not a source semantic): on
    // an early bar of a host timeframe that must sync a SUB-timeframe
    // request.security context (e.g. an H1 host requesting M15), `ext` can
    // itself be `na` for one or more bars before that context's first real
    // value arrives -- a request.security/UDT warm-up lag, never modeled in
    // the Python source because P6's own contract only ever promises a
    // well-formed record once EVERY context is warm. Folded into the SAME
    // "not enough data yet" branch `swCount < 2` already produces --
    // UNKNOWN/NEUTRAL is exactly what this timeframe would report if it had
    // no swing history yet either, so this adds no new classification, no
    // new threshold, and changes zero already-reachable M15 output (once
    // warm, `ext` is never na again for that context).
    if swCount < 2 or na(ext)
        trendState := C_TS_UNKNOWN
        direction := C_DIR2_NEUTRAL
    else if p2Dir == C_ST_DIR_UNDETERMINED
        trendState := C_TS_FORMING
        direction := C_DIR2_NEUTRAL
    else
        bool isBull = p2Dir == C_ST_DIR_BULLISH
        int streak = ext.contStreak
        // LEFT-ALIGNED window (slot1..slot{count} populated, slot{count}
        // newest) -- every populated slot counted since range_window ==
        // TRANSITION_WINDOW_CAPACITY exactly (the T1 alignment trap this
        // campaign's own randomized differential caught once already).
        int altCount = 0
        if ext.transWindowCount >= 1 and (ext.trans1Type == C_ST_TR_BULLISH_CHOCH or ext.trans1Type == C_ST_TR_BEARISH_CHOCH)
            altCount += 1
        if ext.transWindowCount >= 2 and (ext.trans2Type == C_ST_TR_BULLISH_CHOCH or ext.trans2Type == C_ST_TR_BEARISH_CHOCH)
            altCount += 1
        if ext.transWindowCount >= 3 and (ext.trans3Type == C_ST_TR_BULLISH_CHOCH or ext.trans3Type == C_ST_TR_BEARISH_CHOCH)
            altCount += 1
        if ext.transWindowCount >= 4 and (ext.trans4Type == C_ST_TR_BULLISH_CHOCH or ext.trans4Type == C_ST_TR_BEARISH_CHOCH)
            altCount += 1

        if altCount >= 3
            trendState := C_TS_RANGE
        else if streak == 0
            trendState := ext.priorOppStreak >= 1 ? C_TS_TRANSITION : C_TS_FORMING
        else if ext.exhaustFlag == 1
            trendState := C_TS_EXHAUSTING
        else
            trendState := C_TS_TRENDING

        if trendState == C_TS_TRENDING and streak >= 3
            direction := isBull ? C_DIR2_STRONG_BULLISH : C_DIR2_STRONG_BEARISH
        else
            direction := isBull ? C_DIR2_BULLISH : C_DIR2_BEARISH
    [trendState, direction]

// -----------------------------------------------------------------------------
// T2 regime — regime_engine._regime_for_timeframe, via t2_regime_pine_model.py
// -----------------------------------------------------------------------------
// Direction-neutral by construction: reads only trendState + the shared
// displacement window, never p2Dir/contStreak's sign.
f_p5T2(int trendState, P5TransportExt ext) =>
    int regime = C_RG_UNCERTAIN
    if trendState == C_TS_UNKNOWN
        regime := C_RG_UNCERTAIN
    else if trendState == C_TS_TRANSITION
        regime := C_RG_TRANSITION
    else if trendState == C_TS_TRENDING
        regime := C_RG_TREND
    else if trendState == C_TS_EXHAUSTING
        regime := C_RG_DECELERATION
    else if trendState == C_TS_RANGE
        regime := C_RG_RANGE
    else if na(ext)
        // RUNTIME-SAFETY GUARD -- same host-warm-up hazard as f_p5T1 above.
        // Treated exactly as the zero-displacement-window case already
        // below (`ext.dispWindowCount > 0` false) would be: COMPRESSION,
        // never a new state.
        regime := C_RG_COMPRESSION
    else
        // FORMING: refine via the shared last-3 displacement window (capacity
        // == recent_displacement_window default exactly, so every populated
        // slot is "recent").
        bool fast = false
        if ext.dispWindowCount >= 1 and not na(ext.disp1Ratio) and ext.disp1Ratio >= 1.50
            fast := true
        if ext.dispWindowCount >= 2 and not na(ext.disp2Ratio) and ext.disp2Ratio >= 1.50
            fast := true
        if ext.dispWindowCount >= 3 and not na(ext.disp3Ratio) and ext.disp3Ratio >= 1.50
            fast := true
        if fast
            regime := C_RG_EXPANSION
        else if ext.dispWindowCount > 0
            regime := C_RG_BREAKOUT_PENDING
        else
            regime := C_RG_COMPRESSION
    regime

// -----------------------------------------------------------------------------
// Banker's rounding — defined here, ahead of every T3+ function that needs it
// (Pine requires a function be defined before its first use; no hoisting).
// Python's round() is banker's rounding (ties to even); Pine's math.round
// rounds ties AWAY from zero -- they disagree at exact .5 boundaries, which
// become reachable the moment any weight is 0 (an even total_weight, in the
// T5 aggregator below). This function implements Python's rule by hand
// rather than reaching for math.round, per the frozen 9dc5792 finding. Also
// used by T3 momentum's own score (t3_pine_model.py uses Python round() for
// the identical reason, one level earlier in the pipeline).
// -----------------------------------------------------------------------------
f_p5BankersRound(float x) =>
    float fl = math.floor(x)
    int ifl = int(fl)
    float diff = x - fl
    int result = ifl
    if diff > 0.5
        result := ifl + 1
    else if diff == 0.5
        result := ifl % 2 == 0 ? ifl : ifl + 1
    result

// -----------------------------------------------------------------------------
// T3 momentum — t3_engine._assess_timeframe_momentum, via t3_pine_model.py
// -----------------------------------------------------------------------------
// momentum_window == DISPLACEMENT_WINDOW_CAPACITY (3) exactly, so the wire
// window IS the momentum window -- no further trimming needed.
f_p5T3Mom(P5TransportExt ext) =>
    // RUNTIME-SAFETY GUARD -- same host-warm-up hazard as f_p5T1 above:
    // `ext` can be `na` for one or more bars on a host that must sync a
    // sub-timeframe request.security context. `n := 0` reaches exactly the
    // same NEUTRAL/STEADY/0 defaults this function already returns for a
    // real, warm context whose displacement window happens to be empty --
    // no new classification, no new threshold.
    int n = na(ext) ? 0 : ext.dispWindowCount
    int momDir = C_DIR2_NEUTRAL
    int momAccel = C_MA_STEADY
    int momScore = 0
    if n > 0
        int d1 = ext.disp1Dir
        int d2 = ext.disp2Dir
        int d3 = ext.disp3Dir
        int c1 = ext.disp1Cls
        int c2 = ext.disp2Cls
        int c3 = ext.disp3Cls
        float r1 = ext.disp1Ratio
        float r2 = ext.disp2Ratio
        float r3 = ext.disp3Ratio

        int bull = 0
        bool hasVeryFast = false
        if n >= 1
            bull := d1 == 1 ? bull + 1 : bull
            hasVeryFast := hasVeryFast or c1 == 2
        if n >= 2
            bull := d2 == 1 ? bull + 1 : bull
            hasVeryFast := hasVeryFast or c2 == 2
        if n >= 3
            bull := d3 == 1 ? bull + 1 : bull
            hasVeryFast := hasVeryFast or c3 == 2
        int bear = n - bull
        bool strong = n >= 2 or hasVeryFast

        if bull > 0 and bear == 0
            momDir := strong ? C_DIR2_STRONG_BULLISH : C_DIR2_BULLISH
        else if bear > 0 and bull == 0
            momDir := strong ? C_DIR2_STRONG_BEARISH : C_DIR2_BEARISH
        else if bull > bear
            momDir := C_DIR2_BULLISH
        else if bear > bull
            momDir := C_DIR2_BEARISH
        else
            momDir := C_DIR2_NEUTRAL

        // acceleration: len < 2 -> STEADY (checked first, matching the
        // source's own early-return before the mid-split logic runs at all).
        if n >= 2
            float earlierMean = r1
            float recentMean = n == 2 ? r2 : (r2 + r3) / 2.0
            if earlierMean == 0.0
                momAccel := C_MA_STEADY
            else if recentMean > earlierMean * 1.15
                momAccel := C_MA_ACCELERATING
            else if recentMean < earlierMean * 0.85
                momAccel := C_MA_DECELERATING
            else
                momAccel := C_MA_STEADY
        else
            momAccel := C_MA_STEADY

        float sumRatio = r1
        if n >= 2
            sumRatio := sumRatio + r2
        if n >= 3
            sumRatio := sumRatio + r3
        float meanRatio = sumRatio / n
        float magnitude = math.min(1.0, meanRatio / 2.00)
        float consistency = math.max(bull, bear) / n
        momScore := f_p5BankersRound(magnitude * consistency * 100.0)
    [momDir, momAccel, momScore]

// -----------------------------------------------------------------------------
// T3 breakout — t3_engine._assess_timeframe_breakout, via t3_pine_model.py
// -----------------------------------------------------------------------------
// equal_level_clusters is NEVER read (LIQUIDITY_SWEEP stays unemitted in V1).
// dispClsAtTrans is already the precomputed MAX classification at the newest
// transition's availability time -- not re-derived here.
f_p5T3Brk(P5TransportExt ext) =>
    int brkState = C_ST_NA
    int brkScore = 0
    // RUNTIME-SAFETY GUARD -- same host-warm-up hazard as f_p5T1 above.
    // `and` short-circuits, so `ext.transWindowCount` is never dereferenced
    // when `ext` is na; the result is the same C_ST_NA/0 default this
    // function already returns for a real, warm context with an empty
    // transition window.
    if not na(ext) and ext.transWindowCount > 0
        int count = math.min(ext.transWindowCount, 4)
        int last = count == 1 ? ext.trans1Type : count == 2 ? ext.trans2Type : count == 3 ? ext.trans3Type : ext.trans4Type
        bool failed = false
        if count >= 2
            int prev = count == 2 ? ext.trans1Type : count == 3 ? ext.trans2Type : ext.trans3Type
            bool lastChoch = last == C_ST_TR_BULLISH_CHOCH or last == C_ST_TR_BEARISH_CHOCH
            bool prevChoch = prev == C_ST_TR_BULLISH_CHOCH or prev == C_ST_TR_BEARISH_CHOCH
            if lastChoch and prevChoch and prev != last
                failed := true
        if failed
            brkState := C_BRK_FAILED_BREAK
            brkScore := 10
        else if ext.dispClsAtTrans == C_ST_NA
            brkState := C_BRK_WEAK_BREAK
            brkScore := 25
        else if ext.dispClsAtTrans == 0
            brkState := C_BRK_VALID_BREAK
            brkScore := 50
        else if ext.dispClsAtTrans == 1
            brkState := C_BRK_STRONG_BREAK
            brkScore := 75
        else
            brkState := C_BRK_EXPLOSIVE_BREAK
            brkScore := 90
    [brkState, brkScore]

// -----------------------------------------------------------------------------
// T3 pullback — t3_engine._assess_timeframe_pullback, via t3_pine_model.py
// -----------------------------------------------------------------------------
// depth = (impulse - pullback) / (impulse - origin) is DIRECTION-SYMMETRIC
// (proven, not assumed, by test_t3_transport_sufficiency.py's randomized
// differential) -- p2Dir gates whether a pullback applies at all, never which
// formula to use.
f_p5T3Pb(int p2Dir, P5TransportExt ext) =>
    int pbState = C_ST_NA
    // RUNTIME-SAFETY GUARD -- same host-warm-up hazard as f_p5T1 above.
    // `and` short-circuits before `ext.pbValid` when `ext` is na; result is
    // the same C_ST_NA default this function already returns whenever no
    // pullback applies.
    if p2Dir != C_ST_DIR_UNDETERMINED and not na(ext) and ext.pbValid
        float depth = (ext.pbImpulsePrice - ext.pbPullbackPrice) / (ext.pbImpulsePrice - ext.pbOriginPrice)
        if depth > 1.0
            pbState := C_PB_STRUCTURAL_FAILURE
        else if depth <= 0.382
            pbState := C_PB_SHALLOW_PULLBACK
        else if depth <= 0.618
            pbState := C_PB_HEALTHY_PULLBACK
        else
            pbState := C_PB_DEEP_PULLBACK
    pbState

// -----------------------------------------------------------------------------
// T4 session — t4_engine.assess_session, via t4_pine_model.py
// -----------------------------------------------------------------------------
// Pine's hour()/minute() overloads accept an IANA timezone string and resolve
// DST correctly from the tz database -- the same guarantee Python's zoneinfo
// gives assess_session, proven by a real GMT->BST transition case in
// test_t4_transport_sufficiency.py. Needs NO P5/P6 wire at all.
f_p5T4Session(int evalMs) =>
    int ldnMin = hour(evalMs, "Europe/London") * 60 + minute(evalMs, "Europe/London")
    int nyMin = hour(evalMs, "America/New_York") * 60 + minute(evalMs, "America/New_York")
    bool ldnActive = ldnMin >= 480 and ldnMin < 990   // 08:00-16:30 London local
    bool ldnPre = ldnMin >= 420 and ldnMin < 480      // 07:00-08:00 London local
    bool nyActive = nyMin >= 480 and nyMin < 1020     // 08:00-17:00 NY local
    bool nyPre = nyMin >= 420 and nyMin < 480         // 07:00-08:00 NY local
    int utcH = hour(evalMs, "UTC")
    bool inAsian = utcH >= 22 or utcH < 6

    int ctx = C_SESS_POST_NY
    if ldnActive and nyActive
        ctx := C_SESS_LONDON_NY_OVERLAP
    else if nyActive
        ctx := C_SESS_NEW_YORK
    else if nyPre
        ctx := C_SESS_NEW_YORK_PREOPEN
    else if ldnActive
        ctx := C_SESS_LONDON
    else if ldnPre
        ctx := C_SESS_LONDON_PREOPEN
    else if inAsian
        ctx := C_SESS_ASIAN
    ctx

// -----------------------------------------------------------------------------
// T4 volatility — t4_engine.assess_volatility, via t4_pine_model.py
// -----------------------------------------------------------------------------
// Reads the host's OWN candle window (wHigh/wLow, already 300-bar deep) and
// its OWN incremental ATR (wAtr) -- P3 POI is host-only (single M15 context in
// this deployment), so poi.effective_timeframe is always this same host, and
// "the POI timeframe's own candle history" needs no new P6 transport. ATR
// itself is reused (the proven P1 measurement), not re-derived; only the
// percentile/banding/abnormal-spike logic is new.
var array<float> scP5VolRange = array.new<float>()

f_p5T4Vol() =>
    int volState = C_VOL_NORMAL
    bool abnormal = false
    int suitability = 100
    int total = array.size(wHigh)
    if total >= 14
        int wn = math.min(50, total)
        array.clear(scP5VolRange)
        for k = total - wn to total - 1
            array.push(scP5VolRange, array.get(wHigh, k) - array.get(wLow, k))
        float current = array.get(scP5VolRange, wn - 1)
        int atOrBelow = 0
        for k = 0 to wn - 1
            if array.get(scP5VolRange, k) <= current
                atOrBelow += 1
        float percentile = atOrBelow / wn
        // f_medianConsume sorts scP5VolRange in place -- current/atOrBelow are
        // already captured above, so losing chronological order here is safe.
        float median = f_medianConsume(scP5VolRange)
        abnormal := median > 0.0 and current >= 2.5 * median

        if percentile < 0.10
            volState := C_VOL_VERY_LOW
        else if percentile < 0.30
            volState := C_VOL_LOW
        else if percentile < 0.70
            volState := C_VOL_NORMAL
        else if percentile < 0.90
            volState := C_VOL_HIGH
        else
            volState := C_VOL_EXTREME
        suitability := volState == C_VOL_VERY_LOW ? 40 : volState == C_VOL_LOW ? 75 : volState == C_VOL_NORMAL ? 100 : volState == C_VOL_HIGH ? 60 : 20
    [volState, abnormal, suitability]

// -----------------------------------------------------------------------------
// T5 global trend resolution — trend_engine._resolve_global, via
// t5_trend_pine_model.py. A THIRD, distinct authority pattern from T1's own
// per-timeframe list and T2's PRIMARY_ORDER -- D1 primary, W1+H4 agreement
// can only strengthen an already-D1-led direction (or, D1 absent/neutral,
// provide a provisional non-strong direction on their own agreement); H1/M15/
// M5 never participate. Exhaustively proven over all 216 combinations.
// -----------------------------------------------------------------------------
f_p5T5Global(int d1Dir, int w1Dir, int h4Dir) =>
    bool d1Bull = d1Dir == C_DIR2_BULLISH or d1Dir == C_DIR2_STRONG_BULLISH
    bool d1Bear = d1Dir == C_DIR2_BEARISH or d1Dir == C_DIR2_STRONG_BEARISH
    bool w1Bull = w1Dir == C_DIR2_BULLISH or w1Dir == C_DIR2_STRONG_BULLISH
    bool w1Bear = w1Dir == C_DIR2_BEARISH or w1Dir == C_DIR2_STRONG_BEARISH
    bool h4Bull = h4Dir == C_DIR2_BULLISH or h4Dir == C_DIR2_STRONG_BULLISH
    bool h4Bear = h4Dir == C_DIR2_BEARISH or h4Dir == C_DIR2_STRONG_BEARISH

    int gd = C_DIR2_NEUTRAL
    if d1Bull
        gd := (w1Bull and h4Bull) ? C_DIR2_STRONG_BULLISH : C_DIR2_BULLISH
    else if d1Bear
        gd := (w1Bear and h4Bear) ? C_DIR2_STRONG_BEARISH : C_DIR2_BEARISH
    else if w1Bull and h4Bull
        gd := C_DIR2_BULLISH
    else if w1Bear and h4Bear
        gd := C_DIR2_BEARISH
    else
        gd := C_DIR2_NEUTRAL
    gd

// -----------------------------------------------------------------------------
// T5 component scores — t5_engine.assess_confluence (inline formulas), via
// t5_component_scores_pine_model.py. Every input is already wire-proven (T1-T4
// above) or an already-existing P3/P4 Pine output -- no new transport needed.
// -----------------------------------------------------------------------------
f_p5Alignment(int globalDir, int operCtx, bool poiBullish) =>
    bool globalBull = globalDir == C_DIR2_BULLISH or globalDir == C_DIR2_STRONG_BULLISH
    bool globalBear = globalDir == C_DIR2_BEARISH or globalDir == C_DIR2_STRONG_BEARISH
    bool operBull = operCtx == C_DIR2_BULLISH or operCtx == C_DIR2_STRONG_BULLISH
    bool operBear = operCtx == C_DIR2_BEARISH or operCtx == C_DIR2_STRONG_BEARISH
    int align = C_AL_NEUTRAL
    if poiBullish
        if globalBull
            align := operBear ? C_AL_PARTIAL : C_AL_ALIGNED
        else if globalBear
            align := C_AL_COUNTER_TREND
    else
        if globalBear
            align := operBull ? C_AL_PARTIAL : C_AL_ALIGNED
        else if globalBull
            align := C_AL_COUNTER_TREND
    align

f_p5TrendScore(int align, int globalDir) =>
    int score = 50
    if align == C_AL_ALIGNED
        score := (globalDir == C_DIR2_STRONG_BULLISH or globalDir == C_DIR2_STRONG_BEARISH) ? 100 : 80
    else if align == C_AL_PARTIAL
        score := 60
    else if align == C_AL_NEUTRAL
        score := 50
    else
        score := 20
    score

// t5_engine._REGIME_SCORE, transcribed verbatim.
f_p5RegimeScore(int regime) =>
    int score = 30
    if regime == C_RG_TREND
        score := 90
    else if regime == C_RG_EXPANSION
        score := 80
    else if regime == C_RG_BREAKOUT_PENDING
        score := 65
    else if regime == C_RG_DECELERATION
        score := 50
    else if regime == C_RG_COMPRESSION
        score := 45
    else if regime == C_RG_TRANSITION
        score := 40
    else if regime == C_RG_RANGE
        score := 35
    else
        score := 30
    score

f_p5MomentumScoreConfluence(int momDir, int momRawScore, bool poiBullish) =>
    int halfRaw = int(math.floor(momRawScore / 2.0))
    int score = 50
    if momDir == C_DIR2_NEUTRAL
        score := 50
    else
        bool momBull = momDir == C_DIR2_BULLISH or momDir == C_DIR2_STRONG_BULLISH
        if momBull == poiBullish
            score := math.min(100, 50 + halfRaw)
        else
            score := math.max(0, 50 - halfRaw)
    score

// breakout_score/volatility_score confluence inputs pass THROUGH the T3/T4
// score directly -- the source's own "missing assessment" 40/50 defaults are
// structurally unreachable here (M15 T3/T4 are always computed once the host
// has warmed, unlike Python's general multi-caller framing where a timeframe
// could genuinely be absent from the dict).

f_p5PoiScoreConfluence(int tier) =>
    tier == C_POI_TIER_STRONG ? 85 : tier == C_POI_TIER_STANDARD ? 60 : 50

// btmm_bullish == poi_bullish is a TAUTOLOGY whenever btmmValid is true (the
// BTMM registry's direction is copied from the SAME poi's own direction at
// creation -- f_btmmAppend(i, array.get(poiDirection, i), ...)), so the ==70
// branch below is provably unreachable. Kept in its general, source-faithful
// form rather than "optimized" to a two-way branch, matching how the Python
// source itself does not special-case the tautology either.
f_p5BtmmScoreConfluence(bool btmmValid, bool btmmBullish, bool poiBullish) =>
    btmmValid ? (btmmBullish == poiBullish ? 85 : 70) : 25

f_p5LiquidityScoreConfluence(bool btmmValid) =>
    btmmValid ? 60 : 40

// -----------------------------------------------------------------------------
// T5 aggregator / permission / lifecycle — t5_engine._weighted_final /
// _permission / _lifecycle, via t5_aggregator_pine_model.py.
// -----------------------------------------------------------------------------
// A missing weight (0) EXCLUDES that component from both the numerator and
// the denominator -- not the same as scoring it 0 -- which falls out
// automatically here because every weight multiplies its own score term AND
// contributes to totalW identically; there is no separate "missing" path to
// get wrong.
f_p5WeightedFinal(int vBtmm, int vPoi, int vTrend, int vRegime, int vMomentum, int vBreakout, int vLiquidity, int vVolatility, int wBtmm, int wPoi, int wTrend, int wRegime, int wMomentum, int wBreakout, int wLiquidity, int wVolatility) =>
    int totalW = wBtmm + wPoi + wTrend + wRegime + wMomentum + wBreakout + wLiquidity + wVolatility
    int finalScore = 0
    if totalW > 0
        float weighted = vBtmm * wBtmm + vPoi * wPoi + vTrend * wTrend + vRegime * wRegime + vMomentum * wMomentum + vBreakout * wBreakout + vLiquidity * wLiquidity + vVolatility * wVolatility
        finalScore := f_p5BankersRound(weighted / totalW)
    finalScore

// COUNTER_TREND uses strict `<`; every other branch uses `>=` -- stated
// asymmetry in the source (t5_engine._permission), not a rounding accident.
f_p5Permission(int align, bool poiBullish, int finalScore, int watchOnlyMin, int highConfMin, bool downgradeExtremeVol, int volState) =>
    int perm = C_PERM_NO_TRADE_CONTEXT
    if align == C_AL_COUNTER_TREND
        perm := finalScore < watchOnlyMin ? C_PERM_WATCH_ONLY : C_PERM_COUNTER_TREND
    else if align == C_AL_NEUTRAL
        perm := finalScore >= watchOnlyMin ? C_PERM_ALLOW_BOTH_CONTEXT : C_PERM_WATCH_ONLY
    else
        if finalScore >= highConfMin
            perm := poiBullish ? C_PERM_BUY_BIAS : C_PERM_SELL_BIAS
        else if finalScore >= watchOnlyMin
            perm := C_PERM_WATCH_ONLY
        else
            perm := C_PERM_NO_TRADE_CONTEXT
        if downgradeExtremeVol and volState == C_VOL_EXTREME and (perm == C_PERM_BUY_BIAS or perm == C_PERM_SELL_BIAS)
            perm := C_PERM_WATCH_ONLY
    perm

// hasStructure is always true here (all 6 MTF contexts are always assessed
// once the host has warmed -- unlike Python's general framing where
// `trend.timeframe_assessments` could genuinely be empty for a caller that
// never ran assess_trend at all). BTMM_VALIDATED is skipped exactly as the
// source itself skips it (see the C_LC_* comment above).
f_p5Lifecycle(bool btmmValid, int align, bool favorableRegime, bool momentumAligned, bool liquidityOk) =>
    int state = C_LC_STRUCTURALLY_VALIDATED
    if btmmValid
        state := C_LC_POI_VALIDATED
        if align == C_AL_ALIGNED or align == C_AL_PARTIAL
            state := C_LC_TREND_VALIDATED
            if favorableRegime
                state := C_LC_REGIME_VALIDATED
                if momentumAligned
                    state := C_LC_MOMENTUM_VALIDATED
                    if liquidityOk
                        state := C_LC_LIQUIDITY_VALIDATED
    state

// -----------------------------------------------------------------------------
// P5 configuration — ENGINEERING-PROVISIONAL, per ConfluenceConfiguration's own
// defaults. Never claimed calibrated, optimal, or production-approved.
// -----------------------------------------------------------------------------
grpP5 = "P5 — BTRC Confluence (ENGINEERING-PROVISIONAL, not production-approved)"
p5WBtmm       = input.int(3, "Weight: BTMM", group = grpP5)
p5WPoi        = input.int(3, "Weight: POI", group = grpP5)
p5WTrend      = input.int(2, "Weight: Trend", group = grpP5)
p5WRegime     = input.int(1, "Weight: Regime", group = grpP5)
p5WMomentum   = input.int(1, "Weight: Momentum", group = grpP5)
p5WBreakout   = input.int(1, "Weight: Breakout", group = grpP5)
p5WLiquidity  = input.int(1, "Weight: Liquidity", group = grpP5)
p5WVolatility = input.int(1, "Weight: Volatility", group = grpP5)
p5WatchOnlyMin        = input.int(45, "Watch-only min (permission band)", group = grpP5)
p5HighConfMin         = input.int(65, "High-confluence min (permission band)", group = grpP5)
p5DowngradeExtremeVol = input.bool(true, "Downgrade BUY/SELL bias on EXTREME volatility", group = grpP5)

// =============================================================================
// P7 — presentation layer. PRESENTATION ONLY: every function below is a pure
// display-label lookup on an already-computed P1-P5 integer code, or a table
// render that reads already-computed P1-P5 values. Nothing here recomputes
// trend, regime, momentum, breakout, pullback, session, volatility, alignment,
// score, permission or lifecycle -- see BTRC_V1_P7_UI_CLOSURE.md Section 3 for
// the audited claim. No new request.security call, no new plot()/plotshape()/
// plotchar()/alertcondition() (P5 already sits at 63/64 plots -- see
// test_p5_resource_budget.py); P7 output goes entirely through table/label
// objects, matching the project's existing "log.info / table, not plot" P5
// convention for anything beyond the original nine P1 outputs.
// =============================================================================
grpP7 = "P7 — Scanner UI"
p7ShowUi        = input.bool(true, "Show BTRC scanner panel", group = grpP7)
p7ShowActivePois = input.bool(true, "Show active-POI table", group = grpP7)
p7MaxVisiblePois = input.int(8, "Max active POIs shown", minval = 1, maxval = 20, group = grpP7)

// ---- pure label lookups, one per P1-P5 enum family. Each is a straight
// switch on an already-computed Pine integer code (the SAME codes P5EVAL logs)
// -- no branch here decides anything a P1-P5 function did not already decide.
f_p7DirLabel(int code) =>
    switch code
        C_DIR2_STRONG_BULLISH => "STRONG BULL"
        C_DIR2_BULLISH        => "BULLISH"
        C_DIR2_NEUTRAL        => "NEUTRAL"
        C_DIR2_BEARISH        => "BEARISH"
        C_DIR2_STRONG_BEARISH => "STRONG BEAR"
        => "-"

f_p7TrendStateLabel(int code) =>
    switch code
        C_TS_UNKNOWN    => "UNKNOWN"
        C_TS_FORMING    => "FORMING"
        C_TS_TRENDING   => "TRENDING"
        C_TS_TRANSITION => "TRANSITION"
        C_TS_EXHAUSTING => "EXHAUSTING"
        C_TS_RANGE      => "RANGE"
        => "-"

f_p7RegimeLabel(int code) =>
    switch code
        C_RG_UNCERTAIN        => "UNCERTAIN"
        C_RG_TRANSITION       => "TRANSITION"
        C_RG_TREND            => "TREND"
        C_RG_DECELERATION     => "DECELERATION"
        C_RG_RANGE            => "RANGE"
        C_RG_EXPANSION        => "EXPANSION"
        C_RG_BREAKOUT_PENDING => "BREAKOUT PENDING"
        C_RG_COMPRESSION      => "COMPRESSION"
        => "-"

f_p7MomAccelLabel(int code) =>
    switch code
        C_MA_ACCELERATING => "ACCELERATING"
        C_MA_STEADY       => "STEADY"
        C_MA_DECELERATING => "DECELERATING"
        => "-"

f_p7BrkLabel(int code) =>
    switch code
        C_BRK_WEAK_BREAK      => "WEAK BREAK"
        C_BRK_VALID_BREAK     => "VALID BREAK"
        C_BRK_STRONG_BREAK    => "STRONG BREAK"
        C_BRK_EXPLOSIVE_BREAK => "EXPLOSIVE BREAK"
        C_BRK_FAILED_BREAK    => "FAILED BREAK"
        => "NONE"

f_p7PbLabel(int code) =>
    switch code
        C_PB_SHALLOW_PULLBACK   => "SHALLOW"
        C_PB_HEALTHY_PULLBACK   => "HEALTHY"
        C_PB_DEEP_PULLBACK      => "DEEP"
        C_PB_STRUCTURAL_FAILURE => "STRUCTURAL FAILURE"
        => "NONE"

f_p7SessionLabel(int code) =>
    switch code
        C_SESS_ASIAN             => "ASIAN"
        C_SESS_LONDON_PREOPEN    => "LONDON PRE-OPEN"
        C_SESS_LONDON            => "LONDON"
        C_SESS_NEW_YORK_PREOPEN  => "NEW YORK PRE-OPEN"
        C_SESS_LONDON_NY_OVERLAP => "LONDON/NY OVERLAP"
        C_SESS_NEW_YORK          => "NEW YORK"
        C_SESS_POST_NY           => "POST NY"
        => "-"

f_p7VolLabel(int code) =>
    switch code
        C_VOL_VERY_LOW => "VERY LOW"
        C_VOL_LOW      => "LOW"
        C_VOL_NORMAL   => "NORMAL"
        C_VOL_HIGH     => "HIGH"
        C_VOL_EXTREME  => "EXTREME"
        => "-"

f_p7AlignLabel(int code) =>
    switch code
        C_AL_ALIGNED       => "ALIGNED"
        C_AL_PARTIAL       => "PARTIAL"
        C_AL_NEUTRAL       => "NEUTRAL"
        C_AL_COUNTER_TREND => "COUNTER-TREND"
        => "-"

f_p7PermLabel(int code) =>
    switch code
        C_PERM_BUY_BIAS           => "BUY BIAS"
        C_PERM_SELL_BIAS          => "SELL BIAS"
        C_PERM_ALLOW_BOTH_CONTEXT => "ALLOW (BOTH)"
        C_PERM_COUNTER_TREND      => "COUNTER-TREND"
        C_PERM_WATCH_ONLY         => "WATCH ONLY"
        C_PERM_NO_TRADE_CONTEXT   => "NO TRADE"
        => "-"

f_p7LifecycleLabel(int code) =>
    switch code
        C_LC_DETECTED               => "DETECTED"
        C_LC_STRUCTURALLY_VALIDATED => "STRUCTURAL"
        C_LC_POI_VALIDATED          => "POI VALIDATED"
        C_LC_TREND_VALIDATED        => "TREND VALIDATED"
        C_LC_REGIME_VALIDATED       => "REGIME VALIDATED"
        C_LC_MOMENTUM_VALIDATED     => "MOMENTUM VALIDATED"
        C_LC_LIQUIDITY_VALIDATED    => "LIQUIDITY VALIDATED"
        => "-"

f_p7TierLabel(int code) =>
    switch code
        C_POI_TIER_STRONG   => "STRONG"
        C_POI_TIER_STANDARD => "STANDARD"
        => "-"

f_p7PermColor(int code) =>
    switch code
        C_PERM_BUY_BIAS           => color.new(color.lime, 0)
        C_PERM_SELL_BIAS          => color.new(color.red, 0)
        C_PERM_ALLOW_BOTH_CONTEXT => color.new(color.aqua, 0)
        C_PERM_COUNTER_TREND      => color.new(color.orange, 0)
        C_PERM_WATCH_ONLY         => color.new(color.yellow, 0)
        => color.new(color.gray, 0)

// -----------------------------------------------------------------------------
// Active-POI evaluation loop — additive to the P3 registry, per the project's
// frozen contract (see this section's banner comment above).
// -----------------------------------------------------------------------------
var array<bool> poiP5FinalDone = array.new<bool>()

// ---- P7 display state: the LAST confirmed bar's bar-level assessment and
// active-POI set, persisted as `var` so the table render below (gated on
// `barstate.islast`, which fires on every tick of the still-forming realtime
// bar, not only on close) has something to read -- the exact pattern the
// existing P1 debug table already uses for `latestSwingHighPrice` etc. These
// are PURE COPIES of values `if barstate.isconfirmed` already computed above;
// nothing here computes a new decision.
var bool p7HasData      = false
var int  p7LastGlobalDir = C_DIR2_NEUTRAL
var int  p7LastRegime    = C_RG_UNCERTAIN
var int  p7LastMomDir    = C_DIR2_NEUTRAL
var int  p7LastMomAccel  = C_MA_STEADY
var int  p7LastMomScore  = 0
var int  p7LastBrk       = C_ST_NA
var int  p7LastPb        = C_ST_NA
var int  p7LastSession   = C_SESS_ASIAN
var int  p7LastVol       = C_VOL_NORMAL
var bool p7LastVolAbnormal = false

// ---- P7 active-POI display arrays: the SAME eligible-POI set the loop below
// already evaluates, copied for the table render. Cleared and repopulated
// every confirmed bar (never accumulated), bounded only by however many POIs
// are actually eligible that bar -- the render step below caps how many ROWS
// are drawn, per the Phase 7 "decision engine still evaluates all M, only
// presentation is bounded" rule; nothing here drops a POI from evaluation.
var array<int>  p7PoiIdx    = array.new<int>()
var array<bool> p7PoiBull   = array.new<bool>()
var array<int>  p7PoiTier   = array.new<int>()
var array<bool> p7PoiBtmmValid = array.new<bool>()
var array<int>  p7PoiAlign  = array.new<int>()
var array<int>  p7PoiFinal  = array.new<int>()
var array<int>  p7PoiPerm   = array.new<int>()
var array<int>  p7PoiLc     = array.new<int>()

if barstate.isconfirmed
    int p5N = array.size(poiStatus)
    int p5Have = array.size(poiP5FinalDone)
    if p5N > p5Have
        for i = p5Have to p5N - 1
            array.push(poiP5FinalDone, false)

    // ---- bar-level assessments, computed ONCE per bar (independent of which
    // POI is evaluated -- P3 POI is host-only, so every POI shares the SAME
    // M15 T3/T4 assessment and the same D1/W1/H4-derived T1/T2/T5-global) ----
    [d1Trend, d1P5Dir] = f_p5T1(d1P2d, d1Sw, d1Ext)
    [w1Trend, w1P5Dir] = f_p5T1(w1P2d, w1Sw, w1Ext)
    [h4Trend, h4P5Dir] = f_p5T1(h4P2d, h4Sw, h4Ext)
    int d1Regime = f_p5T2(d1Trend, d1Ext)
    // T2's PRIMARY_ORDER (D1,H4,W1,H1,M15,M5) picks the first PRESENT
    // timeframe -- always D1 in this deployment, since all 6 MTF contexts are
    // always present once the host has warmed (t2_regime_pine_model.py's own
    // docstring states this explicitly). The general "first present" scan is
    // therefore not written out here: every branch past D1 would be
    // structurally dead code in this deployment, and writing it would only
    // invite exactly the "T1-order-reuse" mistake the campaign's own
    // adversarial test exists to catch, for no reachable behavior change.
    int p5RegimeGlobal = d1Regime
    [p5MomDir, p5MomAccel, p5MomScore] = f_p5T3Mom(m15Ext)
    [p5BrkState, p5BrkScore] = f_p5T3Brk(m15Ext)
    int p5PbState = f_p5T3Pb(m15P2d, m15Ext)
    int p5SessionCtx = f_p5T4Session(time_close)
    [p5VolState, p5VolAbnormal, p5VolSuitability] = f_p5T4Vol()
    int p5GlobalDir = f_p5T5Global(d1P5Dir, w1P5Dir, h4P5Dir)
    int p5OperCtx = h4P5Dir
    bool p5FavorableRegime = p5RegimeGlobal == C_RG_TREND or p5RegimeGlobal == C_RG_EXPANSION or p5RegimeGlobal == C_RG_BREAKOUT_PENDING

    // ---- P7: copy this bar's already-computed bar-level assessment for the
    // summary table (see the `var p7Last*` declarations above) ----
    p7HasData := true
    p7LastGlobalDir   := p5GlobalDir
    p7LastRegime      := p5RegimeGlobal
    p7LastMomDir      := p5MomDir
    p7LastMomAccel    := p5MomAccel
    p7LastMomScore    := p5MomScore
    p7LastBrk         := p5BrkState
    p7LastPb          := p5PbState
    p7LastSession     := p5SessionCtx
    p7LastVol         := p5VolState
    p7LastVolAbnormal := p5VolAbnormal
    array.clear(p7PoiIdx)
    array.clear(p7PoiBull)
    array.clear(p7PoiTier)
    array.clear(p7PoiBtmmValid)
    array.clear(p7PoiAlign)
    array.clear(p7PoiFinal)
    array.clear(p7PoiPerm)
    array.clear(p7PoiLc)

    if p5N > 0
        for i = 0 to p5N - 1
            bool isTerminal = array.get(poiTerminal, i)
            bool finalDone = array.get(poiP5FinalDone, i)
            // Eligible iff non-terminal (always re-evaluated), or terminal on
            // EXACTLY this bar (finalDone still false) -- the one-time final
            // evaluation Phase 11 requires. A POI already excluded in a prior
            // bar has finalDone == true and isTerminal == true, so it is
            // correctly skipped forever after.
            bool eligible = not isTerminal or not finalDone
            if eligible
                bool poiBullish = array.get(poiDirection, i) == C_POI_DIR_BULLISH
                int setupIdx = array.get(btmmSetupByPoi, i)
                bool btmmValid = setupIdx != -1
                bool btmmBullish = btmmValid and array.get(btmmDir, setupIdx) == C_POI_DIR_BULLISH

                int align = f_p5Alignment(p5GlobalDir, p5OperCtx, poiBullish)
                int trendScore = f_p5TrendScore(align, p5GlobalDir)
                int regimeScore = f_p5RegimeScore(p5RegimeGlobal)
                int momentumScore = f_p5MomentumScoreConfluence(p5MomDir, p5MomScore, poiBullish)
                int breakoutScore = p5BrkScore
                int poiScore = f_p5PoiScoreConfluence(array.get(poiTier, i))
                int btmmScore = f_p5BtmmScoreConfluence(btmmValid, btmmBullish, poiBullish)
                int liquidityScore = f_p5LiquidityScoreConfluence(btmmValid)
                int volatilityScore = p5VolSuitability

                int finalScore = f_p5WeightedFinal(btmmScore, poiScore, trendScore, regimeScore, momentumScore, breakoutScore, liquidityScore, volatilityScore, p5WBtmm, p5WPoi, p5WTrend, p5WRegime, p5WMomentum, p5WBreakout, p5WLiquidity, p5WVolatility)
                int permission = f_p5Permission(align, poiBullish, finalScore, p5WatchOnlyMin, p5HighConfMin, p5DowngradeExtremeVol, p5VolState)
                bool momentumAligned = momentumScore >= 60
                bool liquidityOk = liquidityScore >= 60
                int lifecycle = f_p5Lifecycle(btmmValid, align, p5FavorableRegime, momentumAligned, liquidityOk)

                // ---- P5 log schema (Phase 37): every field the closure
                // evidence needs, zero new plots. debugMode-gated to avoid
                // unconditional log volume, matching the P3/P4 diagnostics
                // convention already established in this file.
                if debugMode
                    log.info("P5EVAL|bar=" + str.tostring(time_close) +
                      "|poiIdx=" + str.tostring(i) +
                      "|poiDir=" + (poiBullish ? "BULL" : "BEAR") +
                      "|poiTier=" + str.tostring(array.get(poiTier, i)) +
                      "|poiStatus=" + str.tostring(array.get(poiStatus, i)) +
                      "|poiTerminal=" + str.tostring(isTerminal) +
                      "|d1Trend=" + str.tostring(d1Trend) + "|w1Trend=" + str.tostring(w1Trend) + "|h4Trend=" + str.tostring(h4Trend) +
                      "|globalDir=" + str.tostring(p5GlobalDir) + "|operCtx=" + str.tostring(p5OperCtx) +
                      "|regime=" + str.tostring(p5RegimeGlobal) +
                      "|momDir=" + str.tostring(p5MomDir) + "|momAccel=" + str.tostring(p5MomAccel) + "|momRaw=" + str.tostring(p5MomScore) +
                      "|brk=" + str.tostring(p5BrkState) + "|brkScoreRaw=" + str.tostring(p5BrkScore) +
                      "|pb=" + str.tostring(p5PbState) +
                      "|session=" + str.tostring(p5SessionCtx) +
                      "|vol=" + str.tostring(p5VolState) + "|volAbnormal=" + str.tostring(p5VolAbnormal) + "|volSuitability=" + str.tostring(p5VolSuitability) +
                      "|btmmValid=" + str.tostring(btmmValid) + "|btmmBullish=" + str.tostring(btmmBullish) +
                      "|align=" + str.tostring(align) +
                      "|sBtmm=" + str.tostring(btmmScore) + "|sPoi=" + str.tostring(poiScore) + "|sTrend=" + str.tostring(trendScore) + "|sRegime=" + str.tostring(regimeScore) +
                      "|sMomentum=" + str.tostring(momentumScore) + "|sBreakout=" + str.tostring(breakoutScore) + "|sLiquidity=" + str.tostring(liquidityScore) + "|sVolatility=" + str.tostring(volatilityScore) +
                      "|wBtmm=" + str.tostring(p5WBtmm) + "|wPoi=" + str.tostring(p5WPoi) + "|wTrend=" + str.tostring(p5WTrend) + "|wRegime=" + str.tostring(p5WRegime) +
                      "|wMomentum=" + str.tostring(p5WMomentum) + "|wBreakout=" + str.tostring(p5WBreakout) + "|wLiquidity=" + str.tostring(p5WLiquidity) + "|wVolatility=" + str.tostring(p5WVolatility) +
                      "|final=" + str.tostring(finalScore) +
                      "|permission=" + str.tostring(permission) +
                      "|lifecycle=" + str.tostring(lifecycle))

                // ---- P7: copy this POI's already-computed decision for the
                // active-POI table. Same values `debugMode`'s P5EVAL line
                // above just logged -- copied here unconditionally (not
                // debug-gated), since the active-POI table is P7's normal
                // product surface, not a diagnostics feature.
                array.push(p7PoiIdx, i)
                array.push(p7PoiBull, poiBullish)
                array.push(p7PoiTier, array.get(poiTier, i))
                array.push(p7PoiBtmmValid, btmmValid)
                array.push(p7PoiAlign, align)
                array.push(p7PoiFinal, finalScore)
                array.push(p7PoiPerm, permission)
                array.push(p7PoiLc, lifecycle)

                if isTerminal
                    array.set(poiP5FinalDone, i, true)

// =============================================================================
// P7 — panel render. Reads ONLY `var p7Last*`/`var p7Poi*` state written above
// (itself a pure copy of P1-P6 output) plus `syminfo`/`timeframe` built-ins for
// the feed/host-TF header cells. No decision is computed in this block.
//
// Two tables, deliberately at DIFFERENT screen anchors than the P1 debug table
// (`position.top_right`, gated on `debugMode`) so the two never overlap
// regardless of `debugMode`'s state -- summary at top-left, active-POI list at
// bottom-right. Both are `var table`, created once and overwritten in place via
// `table.cell` every render (the same object-reuse idiom the P1 debug table
// already established), so this adds exactly two persistent table objects,
// zero new plots, and a bounded, fixed number of cell writes per bar.
// =============================================================================
if barstate.islast and p7ShowUi
    // Debug-gated per the P5EVAL convention (matching test_p5_resource_budget's
    // "unconditional log volume" concern) -- verified once, real FXCM data,
    // during P7 UI validation; see BTRC_V1_P7_UI_CLOSURE.md.
    if debugMode
        log.info("P7DIAG|hasData=" + str.tostring(p7HasData) + "|active=" + str.tostring(array.size(p7PoiIdx)) + "|showActive=" + str.tostring(p7ShowActivePois) + "|maxVisible=" + str.tostring(p7MaxVisiblePois))
    var table p7Summary = table.new(position.top_left, 2, 12, border_width = 1, bgcolor = color.new(color.black, 15))
    f_row(p7Summary, 0, "P7 — BTRC Scanner", "")
    f_row(p7Summary, 1, "Feed", syminfo.prefix + ":" + syminfo.ticker)
    f_row(p7Summary, 2, "Host TF", timeframe.period)
    if p7HasData
        f_row(p7Summary, 3,  "Global direction", f_p7DirLabel(p7LastGlobalDir))
        f_row(p7Summary, 4,  "Regime",           f_p7RegimeLabel(p7LastRegime))
        f_row(p7Summary, 5,  "Momentum",         f_p7DirLabel(p7LastMomDir))
        f_row(p7Summary, 6,  "Momentum accel.",  f_p7MomAccelLabel(p7LastMomAccel))
        f_row(p7Summary, 7,  "Breakout",         f_p7BrkLabel(p7LastBrk))
        f_row(p7Summary, 8,  "Pullback",         f_p7PbLabel(p7LastPb))
        f_row(p7Summary, 9,  "Session",          f_p7SessionLabel(p7LastSession))
        f_row(p7Summary, 10, "Volatility",       f_p7VolLabel(p7LastVol) + (p7LastVolAbnormal ? " (abnormal)" : ""))
        f_row(p7Summary, 11, "Active POIs",      str.tostring(array.size(p7PoiIdx)))
    else
        // Phase 14 zero-state: no confirmed bar processed yet -- every row
        // reads "-", never a stale or fabricated value.
        for r = 3 to 11
            f_row(p7Summary, r, "-", "-")

    if p7ShowActivePois
        int p7Active = array.size(p7PoiIdx)
        int p7Shown  = math.min(p7Active, p7MaxVisiblePois)
        var table p7Pois = table.new(position.bottom_right, 8, p7MaxVisiblePois + 2, border_width = 1, bgcolor = color.new(color.black, 15))
        table.cell(p7Pois, 0, 0, "#",     text_size = size.tiny, text_color = color.gray, text_halign = text.align_left)
        table.cell(p7Pois, 1, 0, "Dir",   text_size = size.tiny, text_color = color.gray)
        table.cell(p7Pois, 2, 0, "Tier",  text_size = size.tiny, text_color = color.gray)
        table.cell(p7Pois, 3, 0, "BTMM",  text_size = size.tiny, text_color = color.gray)
        table.cell(p7Pois, 4, 0, "Align", text_size = size.tiny, text_color = color.gray)
        table.cell(p7Pois, 5, 0, "Score", text_size = size.tiny, text_color = color.gray)
        table.cell(p7Pois, 6, 0, "Permission", text_size = size.tiny, text_color = color.gray)
        table.cell(p7Pois, 7, 0, "State", text_size = size.tiny, text_color = color.gray)
        for r = 1 to p7MaxVisiblePois
            int rowIdx = r - 1
            if rowIdx < p7Shown
                // Stable order: ascending POI-registry index, the SAME order
                // the evaluation loop above already iterates in -- no ranking
                // or "best setup" reordering is introduced here.
                int poiI      = array.get(p7PoiIdx, rowIdx)
                bool bull     = array.get(p7PoiBull, rowIdx)
                int tier      = array.get(p7PoiTier, rowIdx)
                bool btmmOk   = array.get(p7PoiBtmmValid, rowIdx)
                int align     = array.get(p7PoiAlign, rowIdx)
                int fin       = array.get(p7PoiFinal, rowIdx)
                int perm      = array.get(p7PoiPerm, rowIdx)
                int lc        = array.get(p7PoiLc, rowIdx)
                table.cell(p7Pois, 0, r, str.tostring(poiI), text_size = size.tiny, text_color = color.white, text_halign = text.align_left)
                table.cell(p7Pois, 1, r, bull ? "BULL" : "BEAR", text_size = size.tiny, text_color = bull ? color.new(color.lime, 0) : color.new(color.red, 0))
                table.cell(p7Pois, 2, r, f_p7TierLabel(tier), text_size = size.tiny, text_color = color.white)
                table.cell(p7Pois, 3, r, btmmOk ? "YES" : "NO", text_size = size.tiny, text_color = color.white)
                table.cell(p7Pois, 4, r, f_p7AlignLabel(align), text_size = size.tiny, text_color = color.white)
                table.cell(p7Pois, 5, r, str.tostring(fin), text_size = size.tiny, text_color = color.white)
                table.cell(p7Pois, 6, r, f_p7PermLabel(perm), text_size = size.tiny, text_color = f_p7PermColor(perm))
                table.cell(p7Pois, 7, r, f_p7LifecycleLabel(lc), text_size = size.tiny, text_color = color.white)
            else
                // Blank out any row not currently occupied -- the table is a
                // fixed `p7MaxVisiblePois` size (Pine tables cannot resize in
                // place), so a bar with fewer active POIs than the previous
                // one must not leave a prior bar's row visually stuck.
                for c = 0 to 7
                    table.cell(p7Pois, c, r, "", text_size = size.tiny)
        // Phase 7 overflow policy: presentation is bounded, evaluation is not
        // -- the loop above evaluated all `p7Active` eligible POIs regardless
        // of how many rows are visible here.
        table.cell(p7Pois, 0, p7MaxVisiblePois + 1, str.tostring(p7Shown) + " shown / " + str.tostring(p7Active) + " active", text_size = size.tiny, text_color = color.gray, text_halign = text.align_left)
        for c = 1 to 7
            table.cell(p7Pois, c, p7MaxVisiblePois + 1, "", text_size = size.tiny)

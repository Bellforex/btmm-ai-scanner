plot(w1Sw,    "P6_W1_swings",  display = display.data_window)
plot(d1Sw,    "P6_D1_swings",  display = display.data_window)
plot(h4Sw,    "P6_H4_swings",  display = display.data_window)
plot(h1Sw,    "P6_H1_swings",  display = display.data_window)
plot(m15Sw,   "P6_M15_swings", display = display.data_window)
plot(m5Sw,    "P6_M5_swings",  display = display.data_window)
plot(w1Dc,  "P6_W1_disp_code", display = display.data_window)
plot(d1Dc,  "P6_D1_disp_code", display = display.data_window)
plot(h4Dc,  "P6_H4_disp_code", display = display.data_window)
plot(h1Dc,  "P6_H1_disp_code", display = display.data_window)
plot(m15Dc,  "P6_M15_disp_code", display = display.data_window)
plot(m5Dc,  "P6_M5_disp_code", display = display.data_window)
plot(w1P2d, "P6_W1_p2_dir",    display = display.data_window)
plot(d1P2d, "P6_D1_p2_dir",    display = display.data_window)
plot(h4P2d, "P6_H4_p2_dir",    display = display.data_window)
